COMPOSE_PROJECT_NAME=knowpulse

POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_USER=root
POSTGRES_PASSWORD=myPassword
POSTGRES_DB=KnowPulse
KNOWPULSE_POSTGRES_PORT=5432

MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=knowpulse
MINIO_ROOT_PASSWORD=knowpulse-local-password
KNOWPULSE_MINIO_API_PORT=9000
KNOWPULSE_MINIO_CONSOLE_PORT=9001

QDRANT_IMAGE=qdrant/qdrant:v1.15.1
KNOWPULSE_QDRANT_HTTP_PORT=6333
KNOWPULSE_QDRANT_GRPC_PORT=6334

LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
KNOWPULSE_LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-local-dev-only
KNOWPULSE_LITELLM_API_KEY=sk-local-dev-only
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
