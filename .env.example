COMPOSE_PROJECT_NAME=knowpulse

# Local app endpoints used by development scripts and deployment documentation.
KNOWPULSE_API_HOST_URL=https://localhost:44305
KNOWPULSE_BLAZOR_URL=https://localhost:44307

POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_USER=root
POSTGRES_PASSWORD=myPassword
POSTGRES_DB=KnowPulse
KNOWPULSE_POSTGRES_PORT=5432
ConnectionStrings__Default=Host=localhost;Port=5432;Database=KnowPulse;User ID=root;Password=myPassword;

MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_ROOT_USER=knowpulse
MINIO_ROOT_PASSWORD=knowpulse-local-password
KNOWPULSE_MINIO_API_PORT=9000
KNOWPULSE_MINIO_CONSOLE_PORT=9001
BlobStoring__Minio__BucketName=knowpulse-knowledge
BlobStoring__Minio__EndPoint=localhost:9000
BlobStoring__Minio__AccessKey=knowpulse
BlobStoring__Minio__SecretKey=knowpulse-local-password
BlobStoring__Minio__WithSSL=false
BlobStoring__Minio__CreateBucketIfNotExists=true

QDRANT_IMAGE=qdrant/qdrant:v1.15.1
KNOWPULSE_QDRANT_HTTP_PORT=6333
KNOWPULSE_QDRANT_GRPC_PORT=6334
QDRANT__SERVICE__API_KEY=
KNOWPULSE_QDRANT_API_KEY=
RagAI__VectorStore__Endpoint=http://localhost:6333

LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.89.4
KNOWPULSE_LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-local-dev-only
KNOWPULSE_LITELLM_API_KEY=sk-local-dev-only
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
RagAI__LiteLlm__BaseUrl=http://localhost:4000

App__SelfUrl=https://localhost:44305
App__CorsOrigins=https://localhost:44307
App__RedirectAllowedUrls=https://localhost:44307
AuthServer__Authority=https://localhost:44305
StringEncryption__DefaultPassPhrase=local-dev-only-change-before-demo
