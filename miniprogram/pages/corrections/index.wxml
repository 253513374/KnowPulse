<view class="page"><view class="card"><text class="heading">我的订正任务</text><text>订正独立于首答与正式成绩；列表不表示已阅读或上交。</text><button bindtap="load" disabled="{{busy}}">刷新当前学校任务</button></view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}<button bindtap="login">核对登录身份</button></view>
  <text wx:if="{{busy}}" class="muted">正在核对…</text><text wx:if="{{!busy && !items.length}}">暂无可查看的订正。</text>
  <view class="card" wx:for="{{items}}" wx:key="id"><text class="heading">{{item.subject}} · {{item.className}}</text><text>{{item.teacher}} · 版本 {{item.version}}</text><text>{{item.status}} · {{item.workState}}</text><text>截止 {{item.due}}</text><button bindtap="open" data-id="{{item.id}}" disabled="{{busy}}">核对原题与订正记录</button></view>
  <view class="actions"><button bindtap="paginate" data-direction="-1" disabled="{{busy || offset === 0}}">上一页</button><text>{{offset + items.length}} / {{total}}</text><button bindtap="paginate" data-direction="1" disabled="{{busy || offset + 20 >= total}}">下一页</button></view>
</view>
