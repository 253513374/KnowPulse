<view class="page"><view class="hero"><text class="title">我的任教关系更正</text><text class="heading">{{school}}</text><text class="muted">查看本人任教并向学校申请核对。提交不会改变权限；学校核验后才可更正，历史关系与个人资料归属保留。</text></view>
<view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view>
<view class="card"><text class="heading">选择原任教或说明任教缺失</text><picker range="{{choices}}" range-key="title" value="{{index}}" bindchange="choose" disabled="{{busy || pending}}"><view class="field">{{index &gt; 0 ? choices[index].title : '请明确选择'}}</view></picker>
<view class="pager"><button bindtap="relationPage" data-direction="-1" disabled="{{busy || pending || relationOffset === 0}}">上一页任教</button><text>{{relationTotal}} 条本人任教</text><button bindtap="relationPage" data-direction="1" disabled="{{busy || pending || relationOffset + 20 >= relationTotal}}">下一页任教</button></view>
<textarea maxlength="2000" value="{{text}}" bindinput="input" disabled="{{busy || pending}}" placeholder="说明希望核对的班级、学科、时间及原因，请勿写无关学生隐私。" /><text class="muted">未提交说明只保留本页内存，离开或退到后台会清除；提交后可从原申请记录核对。</text><checkbox-group bindchange="share"><label class="field"><checkbox value="shared" checked="{{shared}}" disabled="{{busy || pending}}" />同意向本校管理员发送这份说明</label></checkbox-group><button bindtap="submit" disabled="{{busy || pending || !shared || index &lt;= 0 || !text}}">确认提交更正申请</button></view>
<view wx:for="{{items}}" wx:key="id" class="card"><text class="heading">{{item.school}}（{{item.schoolCode}}） · {{item.state}}</text><text>{{item.at}}</text><button bindtap="open" data-id="{{item.id}}" disabled="{{busy || pending}}">核对申请及处理</button></view><view class="pager"><button bindtap="paginate" data-direction="-1" disabled="{{busy || pending || offset === 0}}">上一页申请</button><text>{{total}} 份申请</text><button bindtap="paginate" data-direction="1" disabled="{{busy || pending || offset + 20 >= total}}">下一页申请</button></view>
<view wx:if="{{selected}}" class="card"><text class="heading">{{selected.state}}</text><text class="body">{{selected.text}}</text><text wx:if="{{selected.original}}">原任教当前记录：{{selected.original.title}} · {{selected.original.from}} 至 {{selected.original.to}}</text><text wx:if="{{selected.status === 0 &amp;&amp; selected.originalChanged}}" class="notice">原任教已变化，学校须重新核对，不能直接按旧版申请变更。</text><text wx:if="{{selected.resolutionText}}" class="body">学校说明：{{selected.resolutionText}}</text><text wx:if="{{selected.resulting}}">结果任教：{{selected.resulting.title}} · {{selected.resulting.from}} 至 {{selected.resulting.to}}</text><text class="muted">历史处理不证明当前任教仍有效；请回工作区核对当前范围。</text><button wx:if="{{selected.canWithdraw}}" bindtap="withdraw" disabled="{{busy || pending}}">撤回待处理申请</button></view>
<view wx:if="{{pending}}" class="card"><text class="heading">待确认操作</text><text>先查原回执，离开不自动重发；仅保留编号，说明只在当前页面内存。</text><button bindtap="recover" disabled="{{busy}}">查询原回执</button><button bindtap="retry" disabled="{{busy || !canRetry}}">重试原操作</button><button bindtap="abandon" disabled="{{busy}}">核对后清除本机标识</button></view>
<button bindtap="load" disabled="{{busy}}">刷新当前学校申请</button><button bindtap="workspace" disabled="{{busy}}">返回工作区核对任教</button></view>
