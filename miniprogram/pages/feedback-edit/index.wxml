<view class="page">
  <view class="hero"><text class="title">单个学生评语</text><text class="muted">先保存云端草稿，再预览、确认发布。私有观察与个人常用语独立保存，明确选择后才进入评语编辑。正文不写本机持久存储；关闭运行可能丢失未确认文字。</text></view>
  <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <text wx:if="{{busy}}">正在核对，请勿重复发送…</text>
  <button wx:if="{{!ready}}" bindtap="reauthenticate" disabled="{{busy}}">微信重新验证并核对同一账号</button>
  <view wx:if="{{pending}}" class="notice"><text>操作结果待确认：{{pending.kind}} · {{pending.operationId}}</text><text>不会自动重试或替换操作编号。</text>
    <button bindtap="recover" disabled="{{busy || !ready}}">查询原操作回执</button><button bindtap="retry" disabled="{{busy || !ready || !canRetry}}">明确重试同一请求</button>
    <text wx:if="{{!canRetry}}">本次内存已没有原请求正文，只能查询回执，不能伪造重试。</text><button bindtap="abandon" disabled="{{busy || !ready}}">核对风险后关闭本机追踪</button>
  </view>
  <block wx:if="{{ready}}">
    <view class="card"><text class="heading">{{target.student.studentName}}（{{target.student.accountName}}）</text><text>{{target.teaching.schoolName}} · {{target.teaching.className}} · {{target.teaching.subjectName}}</text><text class="muted">接收人与学科固定。更换学生请返回中心新建记录。</text>
      <text wx:if="{{record}}">{{record.status}} · 当前修订 v{{record.version}} · {{record.opened ? '正式版本已打开' : '正式版本未打开'}}</text>
      <text>{{dirty ? '有本机未保存修改' : '当前编辑与已读取基准一致'}}；保存草稿不改变正式版本。</text>
    </view>
    <view wx:if="{{conflict}}" class="error"><text>云端已出现其他版本，本机文字保留，未自动覆盖。</text><text class="prewrap">云端当前正文：{{cloudText}}</text></view>
    <button bindtap="openPrivate" disabled="{{busy}}">打开本人私有观察与个人常用语</button>
    <view wx:if="{{privateOpen}}" class="card"><text class="heading">本人私有观察</text><text class="muted">仅当前记录教师可读；学校和其他教师不能读取。保存不发布、不通知学生；更正观察请另记一条。正文只在本次运行内存，云端确认后供本人跨端查看。</text>
      <text>观察时间（按本机时区）</text><view class="pager"><picker mode="date" value="{{observationDate}}" data-field="observationDate" bindchange="privateChange" disabled="{{busy || pending}}"><view class="field">{{observationDate}}</view></picker><picker mode="time" value="{{observationTime}}" data-field="observationTime" bindchange="privateChange" disabled="{{busy || pending}}"><view class="field">{{observationTime}}</view></picker></view>
      <text>私有观察正文（最多 4000 字符）</text><textarea class="feedback-text" maxlength="4000" value="{{observationText}}" data-field="observationText" bindinput="privateChange" disabled="{{busy || pending}}" />
      <button bindtap="saveObservation" disabled="{{busy || pending || !observationText}}">保存为本人私有观察</button>
      <view wx:for="{{observations}}" wx:key="id" class="card"><text>{{item.at}}</text><text class="prewrap">{{item.text}}</text><button bindtap="selectObservation" data-id="{{item.id}}" disabled="{{busy || pending}}">明确选择此条，复制到评语编辑区</button></view>
      <text>共 {{observationTotal}} 条{{observationTotal ? '，当前从 ' + (observationOffset + 1) + ' 条起' : ''}}；无记录不代表没有教学观察。</text><view class="pager"><button bindtap="privatePage" data-kind="observations" data-direction="-1" disabled="{{busy || observationOffset === 0}}">上一页观察</button><button bindtap="privatePage" data-kind="observations" data-direction="1" disabled="{{busy || observationOffset + 20 >= observationTotal}}">下一页观察</button></view>
    </view>
    <view wx:if="{{privateOpen}}" class="card"><text class="heading">个人常用语</text><text class="muted">仅本人管理，跨本人任教学校复用。不放学生姓名、诊断或私有观察；选择仅替换本机评语正文，不自动保存或发送。更新、归档或恢复不改写已保存评语。</text>
      <checkbox-group bindchange="archived"><label class="check-row"><checkbox value="archived" checked="{{includeArchived}}" disabled="{{busy || pending}}" />同时显示已归档常用语</label></checkbox-group>
      <view wx:for="{{phrases}}" wx:key="id" class="card"><text>v{{item.version}} · {{item.archived ? '已归档' : '可选用'}} · {{item.at}}</text><text class="prewrap">{{item.text}}</text>
        <button bindtap="usePhrase" data-id="{{item.id}}" disabled="{{busy || pending || item.archived}}">读取当前版本并选入评语</button><button bindtap="editPhrase" data-id="{{item.id}}" disabled="{{busy || pending}}">核对后读取并编辑</button><button bindtap="archivePhrase" data-id="{{item.id}}" disabled="{{busy || pending || phraseDirty}}">{{item.archived ? '确认恢复' : '确认归档'}}</button>
      </view>
      <view class="pager"><button bindtap="privatePage" data-kind="phrases" data-direction="-1" disabled="{{busy || phraseOffset === 0}}">上一页常用语</button><button bindtap="privatePage" data-kind="phrases" data-direction="1" disabled="{{busy || phraseOffset + 20 >= phraseTotal}}">下一页常用语</button></view><text>共 {{phraseTotal}} 条；每页最多 20 条。</text>
      <text>{{phrase ? '正在编辑原常用语' : '新建本人常用语'}}{{phrase ? ' · v' + phrase.version : ''}}</text><textarea class="feedback-text" maxlength="4000" value="{{phraseText}}" data-field="phraseText" bindinput="privateChange" disabled="{{busy || pending}}" />
      <text>{{phraseDirty ? '常用语有未保存文字' : '常用语与已读取基准一致'}}</text><view wx:if="{{phraseCloudText}}" class="notice"><text>云端当前正文（仅供比较，未改写本机基准）：</text><text class="prewrap">{{phraseCloudText}}</text></view>
      <text wx:if="{{phraseConflict}}" class="error">云端修订已变化。请先核对原回执，再明确重新读取；不会覆盖新版本。</text>
      <button bindtap="savePhrase" disabled="{{busy || pending || phraseConflict || !phraseText}}">保存个人常用语</button><button bindtap="comparePhrase" disabled="{{busy || !phrase}}">读取云端当前版本供比较</button><button wx:if="{{phrase}}" bindtap="editPhrase" data-id="{{phrase.id}}" disabled="{{busy || pending}}">确认放弃本机编辑后重新读取</button><button bindtap="newPhrase" disabled="{{busy || pending}}">确认后新建另一条常用语</button>
    </view>
    <view class="card" wx:if="{{form}}">
      <picker range="{{kinds}}" value="{{form.kind}}" data-field="kind" bindchange="change" disabled="{{busy || pending}}"><view class="field">{{kinds[form.kind]}}</view></picker>
      <text>评语背景</text><input class="field" maxlength="256" value="{{form.context}}" data-field="context" bindinput="change" disabled="{{busy || pending}}" />
      <text>发生时间（按本机时区）</text><view class="pager"><picker mode="date" value="{{form.date}}" data-field="date" bindchange="change" disabled="{{busy || pending}}"><view class="field">{{form.date}}</view></picker><picker mode="time" value="{{form.time}}" data-field="time" bindchange="change" disabled="{{busy || pending}}"><view class="field">{{form.time}}</view></picker></view>
      <block wx:if="{{form.kind === 2}}"><text>阶段结束时间</text><view class="pager"><picker mode="date" value="{{form.endDate}}" data-field="endDate" bindchange="change" disabled="{{busy || pending}}"><view class="field">{{form.endDate}}</view></picker><picker mode="time" value="{{form.endTime}}" data-field="endTime" bindchange="change" disabled="{{busy || pending}}"><view class="field">{{form.endTime}}</view></picker></view></block>
      <text>学生评语正文（最多 4000 字符）</text><textarea class="feedback-text" maxlength="4000" value="{{form.text}}" data-field="text" bindinput="change" disabled="{{busy || pending}}" />
      <text class="strong">明确关联正文引用的测评事实</text><text class="muted">日常、阶段评语也须关联引用的测评。正文等待所有关联测评完整讲评；系统不自动识别自由文本中的测评信息。</text>
      <checkbox-group bindchange="tasks"><label class="check-row" wx:for="{{gates}}" wx:key="taskId"><checkbox value="{{item.taskId}}" checked="{{item.selected}}" disabled="{{busy || pending}}" />{{item.title}} · {{item.isReviewOpen ? '完整讲评已开放' : '等待完整讲评'}}</label></checkbox-group>
      <button type="primary" bindtap="save" disabled="{{busy || pending || conflict}}">保存云端草稿</button><button bindtap="reload" disabled="{{busy}}">核对后重新读取云端</button>
      <button bindtap="previewPublish" disabled="{{busy || pending || dirty || conflict || !record || !record.draftCurrent}}">预览已保存的当前草稿</button>
    </view>
    <view wx:if="{{preview}}" class="card"><text class="heading">发布核对 · v{{preview.version}}</text><text>{{preview.name}}（{{preview.accountName}}）· {{preview.className}} · {{preview.subjectName}}</text><text>{{preview.context}}</text><text class="prewrap">{{preview.text}}</text>
      <text>{{preview.waiting ? '发布后仍等待关联测评全部开放完整讲评，学生暂看不到正文。' : '发布后按当前条件向该学生开放。'}}</text>
      <text wx:for="{{preview.assessments}}" wx:key="taskId">{{item.title}} · {{item.isReviewOpen ? '已开放' : '等待完整讲评'}}</text>
      <checkbox-group bindchange="confirm"><label class="check-row"><checkbox value="confirmed" checked="{{confirmed}}" disabled="{{busy || pending}}" />我已核对确切学生、版本及正文；涉及的测评事实均已明确关联。</label></checkbox-group>
      <button type="primary" bindtap="publish" disabled="{{busy || pending || !confirmed || dirty}}">确认发布此版本</button>
    </view>
    <view class="card"><text>更正、重新发布或撤回原因（更正与撤回必填）</text><textarea class="feedback-text short-text" maxlength="2048" value="{{reason}}" bindinput="reason" disabled="{{busy || pending}}" />
      <button bindtap="withdraw" disabled="{{busy || pending || dirty || !record || !record.canWithdraw}}">确认原因后撤回正式版本</button>
      <button bindtap="continueOnWeb" disabled="{{busy || !record || dirty || pending || observationText || phraseDirty}}">复制已保存记录的网页地址</button>
    </view>
  </block>
</view>
