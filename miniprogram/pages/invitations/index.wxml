<view class="page">
  <view class="hero"><text class="title">学校邀请</text><text class="muted">仅显示发给当前账号的邀请。核对本人身份、学校和角色后再确认；信息不符请拒绝并联系学校。</text></view>
  <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <label class="field">查看已处理及过期邀请<switch checked="{{includeInactive}}" bindchange="toggle" disabled="{{busy || pending}}" /></label>
  <view wx:for="{{items}}" wx:key="id" class="card"><text class="heading">{{item.school}}（{{item.schoolCode}}） · {{item.roleName}}</text><text>{{item.statusName}} · 截止 {{item.expires}}</text><button bindtap="select" data-id="{{item.id}}" disabled="{{busy || pending}}">核对这份邀请</button></view>
  <text wx:if="{{!busy &amp;&amp; total === 0}}" class="notice">当前范围暂无邀请。</text>
  <view class="pager"><button bindtap="paginate" data-direction="-1" disabled="{{busy || pending || offset === 0}}">上一页</button><text>{{total}} 份邀请</text><button bindtap="paginate" data-direction="1" disabled="{{busy || pending || offset + 20 >= total}}">下一页</button></view>
  <view wx:if="{{selected}}" class="card"><text class="heading">{{selected.school}}（{{selected.schoolCode}}） · {{selected.roleName}}</text><text>{{selected.statusName}}</text><text>计划成员有效期：{{selected.from}} 至 {{selected.to}}</text><text>确认截止：{{selected.expires}}</text><text class="muted">实际加入不早于本人确认时刻，不自动建立班级、授课或成绩访问权限。历史确认不证明当前成员仍有效；个人资料归属不变。</text>
    <block wx:if="{{selected.canRespond &amp;&amp; !pending}}"><checkbox-group bindchange="acknowledge"><label class="field"><checkbox value="confirmed" checked="{{ack}}" disabled="{{busy}}" />我已核对这是本人的学校和角色</label></checkbox-group><button bindtap="accept" disabled="{{busy || !ack}}">确认加入这个学校角色</button><picker range="{{reasons}}" value="{{reason}}" bindchange="chooseReason" disabled="{{busy}}"><view class="field">拒绝原因：{{reasons[reason]}}</view></picker><button bindtap="decline" disabled="{{busy}}">拒绝并反馈所选原因</button></block>
    <text wx:if="{{!selected.canRespond &amp;&amp; selected.status === 0}}" class="notice">邀请当前不可确认，请联系学校核对发起人资格。</text><text wx:if="{{selected.declineText}}">已反馈：{{selected.declineText}}</text>
  </view>
  <view wx:if="{{pending}}" class="card"><text class="heading">存在待确认操作</text><text class="muted">操作可能已经成功。先查询原回执；离开页面后不会自动重发。</text><button bindtap="recover" disabled="{{busy}}">查询原回执</button><button bindtap="retry" disabled="{{busy || !canRetry}}">重试原操作</button><button bindtap="abandon" disabled="{{busy}}">核对后清除本机待确认标识</button></view>
  <button bindtap="load" disabled="{{busy}}">刷新邀请</button><button bindtap="workspace" disabled="{{busy}}">返回工作区核对身份</button>
</view>
