<view class="page">
  <view class="hero"><text class="title">{{mode === 'teacher' ? '测评催办与对象预览' : '我的测评站内提醒'}}</text><text class="muted">提醒、微信投递、已读和实际开考分别记录。当前微信未配置，未投递；不影响站内主流程。</text></view>
  <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view><view wx:if="{{notice}}" class="notice">{{notice}}</view>
  <view wx:if="{{pending}}" class="card"><text class="heading">原催办待确认</text><text>只保留操作与范围编号、原预览指纹，不保存姓名或任务正文。</text><text wx:if="{{pending.invalid}}">本机标识格式不可用，请核对网页记录后关闭追踪。</text><button bindtap="recover" disabled="{{busy || pending.invalid}}">查询原回执</button><button bindtap="retry" disabled="{{busy || pending.invalid}}">明确重试原操作</button><button bindtap="abandon" disabled="{{busy}}">关闭本机追踪</button></view>
  <view wx:if="{{receipt}}" class="card"><text class="heading">已确认站内记录</text><text>{{receipt.at}} · {{receipt.weChat}} · {{receipt.read}}</text></view>
  <view wx:if="{{preview}}" class="card"><text class="heading">核对接收人：{{preview.name}}</text><text>{{preview.title}}</text><text>{{preview.status}} · 截止 {{preview.ends}}</text><text>同一学生同一任务至少间隔一小时；下次允许时间 {{preview.next}}</text><button bindtap="send" type="primary" disabled="{{busy || pending || !preview.canSend}}">再次确认并发送站内催办</button></view>
  <view wx:for="{{items}}" wx:key="id" class="card">
    <block wx:if="{{mode === 'teacher'}}"><text class="heading">{{item.name}}</text><text>{{item.status}}</text><button bindtap="choose" data-id="{{item.id}}" disabled="{{busy || pending}}">刷新并预览这位学生</button></block>
    <block wx:else><text class="heading">{{item.message}}</text><text>站内开放 {{item.at}} · {{item.read}}</text><text class="muted">不包含成绩、答案或薄弱项。打开后重新核对来源和权限，不自动开考。</text><text wx:if="{{!item.canOpen}}" class="notice">原结果已被替代或重新隐藏。可标记消息已读，再从当前成绩入口明确重选。</text><button bindtap="open" data-id="{{item.id}}" disabled="{{busy}}">{{item.canOpen ? '打开消息并查看对应来源' : '仅标记这条消息已读'}}</button></block>
  </view>
  <text wx:if="{{!busy &amp;&amp; total === 0}}" class="notice">当前范围暂无记录。</text>
  <view class="pager"><button bindtap="paginate" data-direction="-1" disabled="{{busy || pending || offset === 0}}">上一页</button><text>{{total}} 条</text><button bindtap="paginate" data-direction="1" disabled="{{busy || pending || offset + 20 >= total}}">下一页</button></view>
  <button bindtap="load" disabled="{{busy || pending}}">刷新当前范围</button><button wx:if="{{error}}" bindtap="login">返回登录核对身份</button>
</view>
