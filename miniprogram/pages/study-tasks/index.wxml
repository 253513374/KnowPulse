<view class="page">
  <view class="hero"><text class="eyebrow">学生工作区</text><text class="title">我的材料学习</text><text class="muted">查看列表不代表已经阅读或开始。进入任务后可阅读当前获准的材料。</text></view>
  <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view>
  <text wx:if="{{busy}}" class="muted">正在核对当前学校任务…</text>
  <view wx:if="{{!busy &amp;&amp; !error &amp;&amp; items.length === 0}}" class="card">当前没有可查看的材料任务。</view>
  <view wx:for="{{items}}" wx:key="id" class="card">
    <text class="heading">{{item.title}}</text><text>{{item.subject}} · {{item.className}} · {{item.teacher}}</text>
    <text class="muted">版本 {{item.version}} · {{item.status}} · {{item.stateLabel}}</text>
    <text class="muted">截止 {{item.ends}} · 预计 {{item.minutes}} 分钟</text>
    <button data-id="{{item.id}}" bindtap="open" disabled="{{busy}}">查看任务与我的记录</button>
  </view>
  <view class="pager"><button data-direction="-1" bindtap="paginate" disabled="{{busy || offset === 0}}">上一页</button><text>{{total}} 项</text><button data-direction="1" bindtap="paginate" disabled="{{busy || offset + 20 >= total}}">下一页</button></view>
  <button bindtap="load" disabled="{{busy}}">刷新任务</button><button wx:if="{{error}}" bindtap="login">返回登录</button>
</view>
