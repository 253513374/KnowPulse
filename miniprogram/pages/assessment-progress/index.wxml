<view class="page">
  <view class="hero"><text class="title">任务与评分进度</text><text class="muted">本人当前有效任教范围，统计仅反映本次已发布测评。</text></view>
  <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}<button bindtap="login">重新登录</button></view><text wx:if="{{busy}}">正在重新核对…</text>
  <block wx:if="{{detail}}">
    <button bindtap="reminders" disabled="{{busy}}">预览指定学生并发送站内催办</button>
    <view class="card"><text class="heading">{{detail.title}}</text><text>{{detail.subjectName}} · {{detail.className}}</text><text class="muted">任务更新时间 {{detail.updatedAt}}</text>
      <text>已分配 {{detail.recipientCount}} 人</text><text>{{detail.closed ? '封卷时未开始' : '未开始'}} {{detail.unstartedCount}} 人 · 作答中 {{detail.inProgressCount}} 人</text>
      <text>已交卷 {{detail.submittedCount}} 人 · 评分完整 {{detail.gradingCompleteCount}} 份</text><text>待确认评分 {{detail.pendingQuestionCount}} 题 · 确认评分集合版本 {{detail.confirmedGradeSetVersion}}</text>
      <text>任务{{detail.closed ? '已封卷' : '尚未封卷'}} · {{detail.released ? '已有正式成绩发布' : '尚未正式发布成绩'}}</text>
      <text class="muted">评分完整不代表已发布或学生已可见。缺考不计零分；这里的完整答卷分数是教师评分摘要，学生仍遵守正式开放规则。</text>
      <button bindtap="continueOnWeb" disabled="{{busy}}">到网页继续批改与统一发布</button>
    </view>
    <view wx:if="{{notice}}" class="notice">{{notice}}</view>
    <view class="card" wx:for="{{detail.submissions}}" wx:key="id"><text class="heading">{{item.name}}</text><text class="muted">账号 {{item.accountName}}</text>
      <text>已确认 {{item.confirmed}} / {{item.questions}} 题</text><text>{{item.complete ? '评分完整' : '待批改或确认'}}</text><text>总分 {{item.total}} / {{item.max}}</text>
    </view>
  </block>
  <button bindtap="load" disabled="{{busy}}">刷新进度</button>
</view>
