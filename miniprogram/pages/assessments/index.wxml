<view class="page">
  <view class="hero"><text class="title">{{title}}</text><text class="muted">当前学校、本人的已发布测评。每页 20 条，结果开放以教师正式发布为准。</text></view>
  <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}<button bindtap="login">重新登录</button></view>
  <text wx:if="{{busy}}" class="muted">正在核对身份并加载…</text>
  <view class="card" wx:for="{{items}}" wx:key="id">
    <text class="heading">{{item.title}}</text><text>{{item.subjectName}} · {{item.className}}</text>
    <text class="muted">截止 {{item.endsAt}}</text><text>{{item.status}}</text>
    <button data-id="{{item.id}}" bindtap="open" disabled="{{busy}}">{{mode === 'teacher' ? '查看任务与评分进度' : '查看本人成绩与回顾'}}</button>
    <button wx:if="{{mode === 'student'}}" data-id="{{item.id}}" bindtap="answer" disabled="{{busy}}">查看考前说明 / 开始或继续作答</button>
  </view>
  <block wx:if="{{!busy}}"><text wx:if="{{items.length === 0}}" class="muted">当前没有可查看的测评。</text></block>
  <view class="pager"><button bindtap="previous" disabled="{{busy || offset === 0}}">上一页</button><text>共 {{total}} 条</text><button bindtap="next" disabled="{{busy || offset + pageSize >= total}}">下一页</button></view>
  <button bindtap="load" disabled="{{busy}}">刷新</button>
</view>
