<view class="page">
  <view class="hero"><text class="eyebrow">KnowPulse</text><text class="title">教学工作区</text><text class="muted">身份与班级以学校当前确认的记录为准。</text></view>
  <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view>
  <view wx:if="{{!authenticated}}" class="card"><text>当前账号已退出。</text><button bindtap="loginPage">返回登录</button></view>
  <block wx:else>
    <view class="card"><text class="heading">账号帮助</text><text class="muted">找回原账号、处理本人微信绑定，或核对学校身份。</text><button bindtap="accountHelp" disabled="{{busy}}">复制账号帮助页网址</button></view>
    <view class="card"><text class="heading">学校邀请</text><text class="muted">核对发给本人账号的学校和角色，信息不符可反馈学校；无需先拥有学校身份。</text><button bindtap="invitations" disabled="{{busy}}">查看本人学校邀请</button></view>
    <view wx:if="{{notebookAllowed}}" class="card"><text class="heading">我的私有笔记</text><text class="muted">属于当前账号，教师和学生均可使用；无需当前学校身份。</text><button bindtap="notebooks" disabled="{{busy}}">打开本人笔记、附件和版本历史</button></view>
    <view class="card"><text class="heading">选择学校身份</text><text wx:if="{{busy}}" class="muted">正在核对当前身份…</text><block wx:if="{{!busy}}"><text wx:if="{{roles.length === 0}}" class="muted">暂无有效的学校教师或学生身份，请联系学校核对成员记录。</text></block>
      <button wx:for="{{roles}}" wx:key="id" data-role="{{item.id}}" bindtap="selectRole" type="{{selectedRole === item.id ? 'primary' : 'default'}}" disabled="{{busy}}">{{item.title}}</button>
    </view>
    <view class="card" wx:for="{{workspaces}}" wx:key="schoolId"><text class="heading">{{item.schoolName}}</text>
      <button wx:if="{{selectedRole === 1}}" bindtap="relationRequests" data-school-id="{{item.schoolId}}" disabled="{{busy}}">本人任教记录与更正申请</button>
      <text wx:if="{{item.classes.length === 0}}" class="muted">{{selectedRole === 1 ? '暂无当前有效任教关系。' : '暂无当前有效在班关系。'}}</text>
      <view class="class-row" wx:for="{{item.classes}}" wx:for-item="group" wx:key="relationId"><text class="strong">{{group.className}}</text><text class="muted">{{group.academicTermName}}</text><text wx:if="{{group.subjectName}}">{{group.subjectName}}</text></view>
      <button wx:if="{{item.assessmentAllowed}}" bindtap="assessments" data-school-id="{{item.schoolId}}" data-role="{{selectedRole}}" disabled="{{busy}}">{{selectedRole === 1 ? '查看测评与评分进度' : '测评作答、成绩与回顾'}}</button>
      <button wx:if="{{item.feedbackAllowed}}" bindtap="feedback" data-school-id="{{item.schoolId}}" data-role="{{selectedRole}}" disabled="{{busy}}">{{selectedRole === 1 ? '学生评语中心' : '查看我的教师评语'}}</button>
      <button wx:if="{{item.studyAllowed}}" bindtap="study" data-school-id="{{item.schoolId}}" disabled="{{busy}}">材料学习与我的上交记录</button>
      <button wx:if="{{item.studyAllowed}}" bindtap="workload" data-school-id="{{item.schoolId}}" disabled="{{busy}}">统一学习安排与预计工作量</button>
      <button wx:if="{{selectedRole === 2 &amp;&amp; (item.assessmentAllowed || item.feedbackAllowed || item.planAllowed)}}" bindtap="reminders" data-school-id="{{item.schoolId}}" disabled="{{busy}}">站内消息（测评、评语、教学方案）</button>
      <button wx:if="{{item.teacherPlanAllowed}}" bindtap="teacherPlans" data-school-id="{{item.schoolId}}" disabled="{{busy}}">查看方案执行与记录私有跟进</button>
      <button wx:if="{{item.planAllowed}}" bindtap="plans" data-school-id="{{item.schoolId}}" disabled="{{busy}}">我的教学方案与学习活动</button>
      <button wx:if="{{item.correctionAllowed}}" bindtap="corrections" data-school-id="{{item.schoolId}}" disabled="{{busy}}">订正上交与教师复核</button>
      <button wx:if="{{item.collectionAllowed}}" bindtap="practices" data-school-id="{{item.schoolId}}" disabled="{{busy}}">同题复练与独立上交记录</button>
      <button wx:if="{{item.collectionAllowed}}" bindtap="collections" data-school-id="{{item.schoolId}}" disabled="{{busy}}">本人题目收藏与原结果回顾</button>
      <button wx:if="{{selectedRole === 2 &amp;&amp; item.assessmentAllowed}}" bindtap="growth" data-school-id="{{item.schoolId}}" disabled="{{busy}}">本人的学科成长、成绩记录与知识点依据</button>
      <button wx:if="{{item.analysisAllowed}}" bindtap="reports" data-school-id="{{item.schoolId}}" disabled="{{busy}}">班级、学生学情与知识点依据</button>
    </view>
    <view wx:if="{{cleanupWarning}}" class="error" aria-role="alert">本机私有草稿或图片清理未确认，请核对共享设备应用数据。</view>
    <button bindtap="refresh" disabled="{{busy}}">刷新身份</button><button class="secondary" bindtap="logout">退出当前会话</button>
    <text class="footnote">退出只清除当前会话，不解除账号绑定。需要终止所有微信会话时，请在账号网页解除绑定。</text>
  </block>
</view>
