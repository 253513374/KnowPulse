<view class="page">
  <view class="hero"><text class="title">本人私有笔记</text><text class="muted">保存自己的想法与附件。老师、学校管理员不会因此获得读取权限；这不是学习上交。</text></view>
  <view wx:if="{{error}}" class="error" aria-role="alert">{{error}}</view><view wx:if="{{notice}}" class="notice" aria-role="status">{{notice}}</view>
  <view wx:if="{{pending}}" class="card"><text class="heading">原操作结果待确认</text><text class="muted">{{pending.operationId}}。先查原回执；未查到不代表失败。不会自动重发或更换操作编号。</text>
    <button bindtap="recover" disabled="{{busy}}">查询原回执</button><button bindtap="recover" data-kind="retry" disabled="{{busy || !pending.canRetry}}">明确重试原请求</button>
    <button wx:if="{{pending.kind === 'notebook-file' &amp;&amp; pending.canRetry}}" bindtap="chooseFile" data-kind="reselect" disabled="{{busy}}">重新选择同一原文件</button><button bindtap="abandon" disabled="{{busy}}">仅关闭本机追踪</button>
  </view>
  <view wx:if="{{metadata}}" class="card"><text class="heading">{{metadata.title}}</text><text class="muted">{{metadata.subjectName}} {{metadata.materialYear || ''}} · 云端最新 v{{metadata.latestVersionNumber}}</text><button bindtap="latest" disabled="{{busy}}">查看云端最新版本</button></view>
  <view wx:if="{{current}}" class="card"><text class="heading">正在查看 v{{current.versionNumber}} · {{current.title}}</text><text class="muted">{{current.created}}</text><text class="prewrap">{{current.contentText}}</text><button wx:if="{{local}}" bindtap="copyVersion" disabled="{{busy || pending}}">将本版正文复制到编辑区</button></view>
  <view class="card"><text class="heading">编辑本人笔记</text><text class="muted">每次保存生成新版本。先允许本机暂存后编辑，最长 24 小时；本机草稿不会自动上交。</text>
    <button wx:if="{{!local}}" bindtap="allowLocal" disabled="{{busy || pending}}">了解并允许本机暂存</button>
    <block wx:if="{{form}}">
      <input class="field" aria-label="笔记标题" placeholder="标题，必填" maxlength="256" value="{{form.title}}" data-field="title" bindinput="change" disabled="{{busy || pending}}" />
      <input class="field" aria-label="笔记学科" placeholder="学科，可留空" maxlength="128" value="{{form.subjectName}}" data-field="subjectName" bindinput="change" disabled="{{busy || pending}}" />
      <input class="field" aria-label="笔记年份" placeholder="年份，可留空" type="number" maxlength="4" value="{{form.yearText}}" data-field="year" bindinput="change" disabled="{{busy || pending}}" />
      <input class="field" aria-label="笔记标签" placeholder="标签，用中文或英文逗号分隔，最多 20 个" maxlength="1299" value="{{form.tagsText}}" data-field="tags" bindinput="change" disabled="{{busy || pending}}" />
      <textarea class="feedback-text short-text" aria-label="笔记摘要" placeholder="摘要，最多 1024 字" maxlength="1024" value="{{form.summary}}" data-field="summary" bindinput="change" disabled="{{busy || pending}}" />
      <textarea class="feedback-text" aria-label="笔记正文" placeholder="只写自己的想法，最多 8192 字" maxlength="8192" value="{{form.contentText}}" data-field="contentText" bindinput="change" disabled="{{busy || pending}}" />
      <view wx:if="{{conflict}}" class="notice">云端版本或组织信息已变化。本机文字保留，请比较后明确选择新的保存基础。</view><button wx:if="{{conflict}}" bindtap="rebase" disabled="{{busy || pending}}">保留本机文字，确认以当前云端版本继续</button>
      <button type="primary" bindtap="save" disabled="{{busy || pending || conflict}}">保存本人笔记为新版本</button>
    </block>
  </view>
  <view wx:if="{{metadata}}" class="card"><text class="heading">版本历史（{{versionTotal}}）</text><button wx:for="{{versions}}" wx:key="id" bindtap="selectVersion" data-id="{{item.id}}" disabled="{{busy}}">v{{item.versionNumber}} · {{item.title}}</button><view class="pager"><button bindtap="page" data-kind="version" data-direction="-1" disabled="{{busy || versionOffset === 0}}">上一页</button><button bindtap="page" data-kind="version" data-direction="1" disabled="{{busy || versionOffset + 20 >= versionTotal}}">下一页</button></view></view>
  <view wx:if="{{current}}" class="card"><text class="heading">本版附件（{{attachmentTotal}}）</text><text class="muted">每个附件最多 20 MB。常见图片、PDF 和 Office 文档可预览；其他文件请在网页查看。附件固定属于上传时的版本。</text>
    <button wx:for="{{attachments}}" wx:key="id" bindtap="attachment" data-id="{{item.id}}" disabled="{{busy || !item.type}}">{{item.name}} · {{item.size}} 字节 {{item.type ? '' : '（请到网页查看）'}}</button>
    <view class="pager"><button bindtap="page" data-kind="attachment" data-direction="-1" disabled="{{busy || attachmentOffset === 0}}">上一页</button><button bindtap="page" data-kind="attachment" data-direction="1" disabled="{{busy || attachmentOffset + 20 >= attachmentTotal}}">下一页</button></view>
    <button wx:if="{{local &amp;&amp; current.status === 0}}" bindtap="chooseFile" data-kind="file" disabled="{{busy || pending}}">从微信选择原文件</button><button wx:if="{{local &amp;&amp; current.status === 0}}" bindtap="chooseFile" data-kind="photo" disabled="{{busy || pending}}">添加笔记图片</button>
  </view>
  <view wx:if="{{current}}" class="card"><text class="heading">本版来源引用（{{sourceTotal}}）</text><text class="muted">只关联标识，不复制来源正文。撤回或身份结束后，原资料可能无法再打开；本人笔记仍保留。</text>
    <view wx:for="{{sources}}" wx:key="id"><text>{{item.removed ? '引用已移除' : item.title}}</text><button wx:if="{{item.available}}" bindtap="openSource" data-id="{{item.id}}" disabled="{{busy}}">显式打开原来源</button><button wx:if="{{!item.removed}}" bindtap="removeSource" data-id="{{item.id}}" disabled="{{busy || pending}}">移除此引用</button></view>
    <view class="pager"><button bindtap="page" data-kind="source" data-direction="-1" disabled="{{busy || sourceOffset === 0}}">上一页</button><button bindtap="page" data-kind="source" data-direction="1" disabled="{{busy || sourceOffset + 20 >= sourceTotal}}">下一页</button></view>
    <button wx:if="{{hasSourceTarget}}" bindtap="previewSource" disabled="{{busy || pending}}">核对从原题或材料带来的来源</button><text wx:if="{{target}}">{{target.available ? target.title : '当前来源不可关联'}}</text><button wx:if="{{target.available}}" bindtap="addSource" disabled="{{busy || pending}}">确认只关联引用</button>
  </view>
  <button bindtap="load" disabled="{{busy}}">刷新并比较云端记录</button><button bindtap="web" disabled="{{busy}}">复制笔记网页地址</button><button wx:if="{{metadata}}" bindtap="remove" disabled="{{busy || pending}}">删除本人笔记</button><button bindtap="login">返回登录</button>
  <view wx:if="{{imagePath}}" class="image-panel"><view class="image-area"><image class="image-view" src="{{imagePath}}" mode="aspectFit" aria-label="本人笔记附件" /></view><button bindtap="closeImage">关闭图片</button></view>
</view>
