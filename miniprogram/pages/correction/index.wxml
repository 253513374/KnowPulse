<view class="page">
  <view class="card"><text class="heading">订正与教师复核</text><text>原思路可选；首答、订正与复练分别记录。订正不修改正式成绩，也不表示已掌握。</text><button bindtap="load" disabled="{{busy}}">刷新云端记录</button></view>
  <view wx:if="{{error}}" class="error" role="alert">{{error}}<button bindtap="login">核对登录身份</button></view><view wx:if="{{notice}}" class="notice" role="status">{{notice}}</view>
  <view wx:if="{{unpersisted}}" class="error" role="alert">当前输入尚未成功暂存，请勿离开。<button bindtap="saveLocal" disabled="{{busy || !consent}}">重新保存本机草稿</button></view>
  <view wx:if="{{pending}}" class="card"><text class="heading">原操作待核对</text><text>{{pending.kind === 'image' ? '图片上传' : '订正上交'}} · {{pending.operationId}}</text><text>只查回执不等于重新上交；关闭本机追踪不会撤销云端操作。</text><button bindtap="recover" disabled="{{busy}}">查询原回执</button><button bindtap="retry" disabled="{{busy || !consent || !pending.canRetry}}">先查回执再明确重试</button><button wx:if="{{pending.kind === 'image'}}" bindtap="reselect" disabled="{{busy || !consent}}">先查回执，再重选同一原图</button><button bindtap="abandon" disabled="{{busy}}">关闭本机追踪</button></view>
  <block wx:if="{{detail}}">
    <view class="card"><text class="heading">{{detail.title}}</text><text>{{detail.subject}} · {{detail.className}} · {{detail.teacher}}</text><text>版本 {{detail.version}} · {{detail.status}} · {{detail.workState}}</text><text>开始 {{detail.starts}} · 截止 {{detail.due}}</text><text class="prewrap">{{detail.instructions}}</text><text wx:if="{{detail.publicReason}}" class="prewrap">{{detail.publicReason}}</text><button bindtap="web" disabled="{{busy}}">复制这份交付的网页地址</button></view>
    <view wx:if="{{detail.question}}" class="card"><text class="heading">原题与已开放讲评</text><text>{{detail.question.title}} · {{detail.question.total}} / {{detail.question.max}}</text><text class="prewrap">{{detail.question.stem}}</text><text wx:for="{{detail.question.options}}" wx:key="key">{{item.key}}. {{item.content}}</text><text class="prewrap">首答：{{detail.question.responseText}}</text><text>{{detail.question.selected}}</text><text wx:for="{{detail.question.blanks}}" wx:key="id">{{item.marker}}：{{item.text}}</text><text>正确选项：{{detail.question.answers}}</text><text class="prewrap">{{detail.question.reference}}</text><text wx:for="{{detail.question.blankAnswers}}" wx:key="id">{{item.marker}}：{{item.answers}}</text><text class="prewrap">{{detail.question.analysis}}</text><text class="prewrap">{{detail.question.feedback}}</text><text wx:for="{{detail.question.points}}" wx:key="id">{{item.description}} · {{item.total}} / {{item.max}}</text><button bindtap="original" disabled="{{busy}}">查看原题图片与完整成绩讲评</button></view>
    <view class="card"><text class="heading">本机私人草稿</text><text>按本账号与交付暂存，24 小时有效期在后续使用时清理。退出或失权尝试清除；共享设备不能据此认定物理擦除。只有明确上交才与教师共享。</text><button bindtap="allowLocal" disabled="{{busy || consent}}">{{consent ? '本次已允许本机暂存' : '了解并允许本机暂存 / 继续编辑'}}</button><button bindtap="clearLocal" disabled="{{busy || pending}}">清除本机未上交草稿</button>
      <view wx:if="{{conflict}}" class="error" role="alert"><text>本机原基准与云端上交版本不同。请比较下方云端副本；不会自动覆盖或换基准。</text><button bindtap="rebase" disabled="{{busy || pending || !consent}}">比较后保留本机内容，明确改用当前基准</button></view>
      <block wx:if="{{form}}"><label>原思路（可选）<textarea class="feedback-text" data-field="originalThinking" bindinput="change" value="{{form.originalThinking}}" maxlength="4000" disabled="{{busy || !consent || pending || !detail.canSubmit}}" /></label><label>当前解法（文字或至少一张图）<textarea class="feedback-text" data-field="currentSolution" bindinput="change" value="{{form.currentSolution}}" maxlength="8192" disabled="{{busy || !consent || pending || !detail.canSubmit}}" /></label><label>检查策略（必填）<textarea class="feedback-text" data-field="checkingStrategy" bindinput="change" value="{{form.checkingStrategy}}" maxlength="4000" disabled="{{busy || !consent || pending || !detail.canSubmit}}" /></label>
        <view wx:for="{{form.images}}" wx:key="attachmentId"><text>图片 {{index + 1}} · {{item.rotationDegrees}}°</text><button bindtap="image" data-id="{{item.attachmentId}}" disabled="{{busy}}">预览原图</button><button bindtap="editImage" data-id="{{item.attachmentId}}" data-action="rotate" disabled="{{busy || !consent || pending || !detail.canSubmit}}">旋转引用</button><button bindtap="editImage" data-id="{{item.attachmentId}}" data-action="up" disabled="{{busy || !consent || pending || !detail.canSubmit || index === 0}}">上移</button><button bindtap="editImage" data-id="{{item.attachmentId}}" data-action="remove" disabled="{{busy || !consent || pending || !detail.canSubmit}}">从本机草稿移除</button></view>
        <button bindtap="upload" disabled="{{busy || !consent || pending || !detail.canSubmit || form.images.length >= 5}}">选择或拍摄图片（最多 5 张，每张 5 MB）</button><button bindtap="saveLocal" disabled="{{busy || !consent}}">保存本机草稿</button><button bindtap="preview" disabled="{{busy || !consent || pending || conflict || unpersisted || !detail.canSubmit}}">核对即将上交的内容</button>
      </block>
    </view>
    <view wx:if="{{cloud}}" class="card"><text class="heading">当前云端上交副本 {{cloud.number}}</text><text>{{cloud.at}}</text><text class="prewrap">{{cloud.content.originalThinking}}</text><text class="prewrap">{{cloud.content.currentSolution}}</text><text class="prewrap">{{cloud.content.checkingStrategy}}</text><button wx:for="{{cloud.content.images}}" wx:key="attachmentId" bindtap="image" data-id="{{item.attachmentId}}" disabled="{{busy}}">已上交图片 {{index + 1}} · {{item.rotationDegrees}}°</button></view>
    <view wx:if="{{detail.review}}" class="card"><text class="heading">针对当前上交的教师复核</text><text>{{detail.review.label}} · {{detail.review.at}}</text><text class="prewrap">{{detail.review.feedback}}</text></view>
    <view wx:if="{{preview}}" class="card"><text class="heading">本次将共享给教师的确切内容</text><text class="prewrap">{{preview.originalThinking}}</text><text class="prewrap">{{preview.currentSolution}}</text><text class="prewrap">{{preview.checkingStrategy}}</text><button wx:for="{{preview.images}}" wx:key="attachmentId" bindtap="image" data-id="{{item.attachmentId}}" disabled="{{busy}}">核对图片 {{index + 1}} · {{item.rotationDegrees}}°</button><checkbox-group bindchange="sharing"><label><checkbox value="yes" checked="{{share}}" disabled="{{busy}}" />我确认将上方文字与选中图片共享给本任务教师</label></checkbox-group><button type="primary" bindtap="submit" disabled="{{busy || !share || pending || conflict || unpersisted}}">明确上交独立订正版本</button></view>
    <view class="card"><text class="heading">本人上交历史</text><text>原题讲评或评分门槛关闭时，教师复核正文隐藏，本人上交副本按当前身份保留。</text><view wx:for="{{history}}" wx:key="id"><text>副本 {{item.submission.number}} · {{item.submission.at}}</text><text class="prewrap">{{item.submission.content.originalThinking}}</text><text class="prewrap">{{item.submission.content.currentSolution}}</text><text class="prewrap">{{item.submission.content.checkingStrategy}}</text><button wx:for="{{item.submission.content.images}}" wx:for-item="image" wx:key="attachmentId" bindtap="image" data-id="{{image.attachmentId}}" disabled="{{busy}}">历史图片 · {{image.rotationDegrees}}°</button><view wx:for="{{item.reviews}}" wx:for-item="review" wx:key="id"><text>{{review.label}} · {{review.at}}</text><text class="prewrap">{{review.feedback}}</text></view></view>
      <button bindtap="historySelect" data-direction="-1" disabled="{{busy || historyIndex === 0}}">上一份副本</button><text>{{historyCount ? historyIndex + 1 : 0}} / 本页 {{historyCount}} 份</text><button bindtap="historySelect" data-direction="1" disabled="{{busy || historyIndex + 1 >= historyCount}}">下一份副本</button><button bindtap="paginate" data-direction="-1" disabled="{{busy || historyOffset === 0}}">上一页历史</button><text>共 {{historyTotal}} 份</text><button bindtap="paginate" data-direction="1" disabled="{{busy || historyOffset + 20 >= historyTotal}}">下一页历史</button>
    </view>
  </block>
  <view wx:if="{{imagePath}}" class="image-panel"><movable-area class="image-area"><movable-view class="image-view" direction="all" scale="true" scale-min="1" scale-max="4"><image class="answer-image" mode="aspectFit" src="{{imagePath}}" aria-label="本人订正原始图片" style="transform: rotate({{imageRotation}}deg);" /></movable-view></movable-area><button bindtap="closeImage">关闭原图</button></view>
</view>
