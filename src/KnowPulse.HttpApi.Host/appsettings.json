{
  "App": {
    "SelfUrl": "https://localhost:44305",
    "CorsOrigins": "https://*.KnowPulse.com,https://localhost:44307",
    "RedirectAllowedUrls": "https://localhost:44307"
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=KnowPulse;User ID=root;Password=myPassword;"
  },
  "BlobStoring": {
    "Minio": {
      "BucketName": "knowpulse-knowledge",
      "EndPoint": "localhost:9000",
      "AccessKey": "knowpulse",
      "SecretKey": "knowpulse-local-password",
      "WithSSL": false,
      "CreateBucketIfNotExists": true
    }
  },
  "RagAI": {
    "Embedding": {
      "Provider": "LiteLLM",
      "ModelName": "knowpulse-embedding-default",
      "ModelVersion": "2026-06-mvp1",
      "VectorDimension": 1536,
      "CollectionName": "knowledge_chunks_1536_mvp1",
      "MaxBatchSize": 64,
      "TimeoutSeconds": 60
    },
    "VectorStore": {
      "Provider": "Qdrant",
      "Endpoint": "http://localhost:6333",
      "KnowledgeCollectionName": "knowledge_chunks_1536_mvp1",
      "VectorDimension": 1536,
      "Distance": "Cosine",
      "PayloadIndexMode": "Explicit",
      "ApiKeyEnvironmentVariable": "KNOWPULSE_QDRANT_API_KEY"
    },
    "LiteLlm": {
      "BaseUrl": "http://localhost:4000",
      "EmbeddingModel": "knowpulse-embedding-default",
      "ChatModel": "knowpulse-chat-default",
      "ApiKeyEnvironmentVariable": "KNOWPULSE_LITELLM_API_KEY",
      "TimeoutSeconds": 60,
      "ChatMaxTokens": 800,
      "ChatTemperature": 0.2,
      "FallbackModels": [
        "knowpulse-embedding-fallback"
      ]
    },
    "AiQuestionGeneration": {
      "PromptTemplateKey": "mvp2-ai-question-candidate",
      "PromptVersion": "mvp2-ai-question-v1",
      "ModelProvider": "LiteLLM",
      "ModelName": "knowpulse-chat-default",
      "ModelVersion": "2026-06-mvp2-questioning",
      "MaxQuestionsPerTask": 10,
      "MaxContextChunks": 6,
      "MaxPromptChunkLength": 1200,
      "MaxCitationExcerptLength": 220,
      "MaxOutputTokens": 800,
      "Temperature": 0.2
    }
  },
  "AuthServer": {
    "Authority": "https://localhost:44305",
    "RequireHttpsMetadata": false,
    "SwaggerClientId": "KnowPulse_Swagger"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "mgigscLQCeNprVlp"
  }
}
