@page
@using Microsoft.AspNetCore.Mvc.Localization
@using Volo.Abp.Account.Localization
@using Volo.Abp.Account.Web.Pages.Account
@using Volo.Abp.AspNetCore.Mvc.UI.Layout
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@addTagHelper *, Volo.Abp.AspNetCore.Mvc.UI.Bootstrap
@addTagHelper *, Volo.Abp.AspNetCore.Mvc.UI.Bundling
@inject IPageLayout PageLayout
@inject IHtmlLocalizer<AccountResource> L
@model ManageModel
@{
    Layout = "~/Pages/Shared/_AccountManageLayout.cshtml";
    PageLayout.Content.Title = L["MyAccount"].Value;
}
@section scripts {
    <abp-script-bundle name="@typeof(ManageModel).FullName" />
}
@section styles {
    <abp-style src="/Pages/Account/Manage.css" />
}

<header class="kp-account-heading">
    <h1>@L["MyAccount"]</h1>
    <p>维护个人信息与登录密码。</p>
</header>
@if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
{
    <a class="kp-account-return" href="@Model.ReturnUrl">@L["ReturnToApplication"]</a>
}
<div id="ProfileManagementWrapper">
    <abp-card>
        <abp-card-body>
            <abp-tabs tab-style="PillVertical" vertical-header-size="_3">
                @foreach (var group in Model.ProfileManagementPageCreationContext.Groups)
                {
                    <abp-tab title="@group.DisplayName">
                        @await Component.InvokeAsync(group.ComponentType, new { parameter = group.Parameter })
                    </abp-tab>
                }
            </abp-tabs>
        </abp-card-body>
    </abp-card>
</div>
