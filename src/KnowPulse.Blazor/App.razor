<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>KnowPulse.Blazor</title>
    <base href="/" />

    <AbpStyles BundleName="@BlazorWebAssemblyMudBlazorStandardBundles.Styles.Global" />


    <HeadOutlet @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)" />
</head>

<body class="abp-application-layout kp-app">

    <div id="ApplicationContainer">
        <div class="spinner">
            <div class="double-bounce1"></div>
            <div class="double-bounce2"></div>
        </div>

        <Routes @rendermode="new InteractiveWebAssemblyRenderMode(prerender: false)"/>
    </div>

    <AbpScripts BundleName="@BlazorWebAssemblyMudBlazorStandardBundles.Scripts.Global" />
    <script src="_framework/blazor.web.js"></script>

</body>
</html>
