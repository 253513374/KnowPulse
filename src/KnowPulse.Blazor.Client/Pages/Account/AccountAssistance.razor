@page "/account/assistance"
@attribute [AllowAnonymous]
@inherits KnowPulseComponentBase
@using KnowPulse.AccountSupport
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using Microsoft.Extensions.Options
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Volo.Abp.Users.ICurrentUser Account
@inject NavigationManager Navigation
@inject IOptionsSnapshot<RemoteAuthenticationOptions<OidcProviderOptions>> AuthenticationOptions

<PageTitle>@L["AccountHelp:Title"]</PageTitle>
<h1 class="kp-heading-4">@L["AccountHelp:Title"]</h1><p>@L["AccountHelp:Intro"]</p>
<AuthorizeView><Authorized><p class="kp-text-semibold">@L["WeChat:CurrentAccount", Account.UserName ?? ""]</p></Authorized></AuthorizeView>
@if (PasswordRecoveryUrl == null) { <p class="kp-alert kp-alert--info" role="status">@L["AccountHelp:NotConfigured"]</p> }
<div class="kp-grid kp-grid-gap-3">
    <section class="kp-col-12 col-lg-6"><div class="kp-card kp-full-height"><div class="kp-card__body"><h2 class="kp-heading-5">@L["AccountHelp:Password"]</h2><p>@L["AccountHelp:PasswordHint"]</p>
        @if (PasswordRecoveryUrl != null) { <a class="kp-button kp-button--primary-outline kp-me-2" href="@PasswordRecoveryUrl" @onclick="OpenRecovery" @onclick:preventDefault="true">@L["AccountHelp:OpenRecovery"]</a><a class="kp-button kp-button--secondary" href="@LoginPath" @onclick="OpenLogin" @onclick:preventDefault="true">@L["AccountHelp:OpenLogin"]</a> }
    </div></div></section>
    <section class="kp-col-12 col-lg-6"><div class="kp-card kp-full-height"><div class="kp-card__body"><h2 class="kp-heading-5">@L["AccountHelp:Binding"]</h2><p>@L["AccountHelp:BindingHint"]</p><a class="kp-button kp-button--primary-outline" href="/account/wechat-bindings">@L["AccountHelp:OpenBinding"]</a></div></div></section>
    <section class="kp-col-12 col-lg-6"><div class="kp-card kp-full-height"><div class="kp-card__body"><h2 class="kp-heading-5">@L["AccountHelp:School"]</h2><p>@L["AccountHelp:SchoolHint"]</p><a class="kp-button kp-button--primary-outline kp-me-2" href="/education/workspace">@L["EducationWorkspace:Title"]</a><a class="kp-button kp-button--secondary" href="/education/invitations">@L["SchoolInvites:Mine"]</a></div></div></section>
    <section class="kp-col-12 col-lg-6"><div class="kp-card kp-full-height"><div class="kp-card__body"><h2 class="kp-heading-5">@L["AccountHelp:Unable"]</h2><p>@L["AccountHelp:UnableHint"]</p><p>@L["AccountHelp:LearningHint"]</p></div></div></section>
</div>

@code {
    private string? PasswordRecoveryUrl;
    private string LoginPath => AuthenticationOptions.Value.AuthenticationPaths.LogInPath;
    protected override void OnInitialized() => PasswordRecoveryUrl = AccountAssistanceLinks.GetPasswordRecoveryUrl(Configuration["AuthServer:Authority"]);
    private void OpenRecovery() { if (PasswordRecoveryUrl != null) Navigation.NavigateTo(PasswordRecoveryUrl, forceLoad: true); }
    private void OpenLogin() { if (PasswordRecoveryUrl != null) Navigation.NavigateToLogin(LoginPath); }
}
