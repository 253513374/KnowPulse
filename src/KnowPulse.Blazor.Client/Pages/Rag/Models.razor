    private sealed class ModelFormModel
    {
        public Guid? Id { get; set; }
        public bool IsEditing { get; set; }

        [Required(ErrorMessage = "请输入 Alias。")]
        [StringLength(AiModelConsts.MaxAliasLength)]
        public string Alias { get; set; } = string.Empty;

        public AiModelProviderType ProviderType { get; set; } = AiModelProviderType.LiteLLM;
        public AiModelCapability Capability { get; set; } = AiModelCapability.Chat;

        [Required(ErrorMessage = "请输入上游模型。")]
        [StringLength(AiModelConsts.MaxUpstreamModelNameLength)]
        public string UpstreamModelName { get; set; } = string.Empty;

        [Required(ErrorMessage = "请输入业务版本。")]
        [StringLength(AiModelConsts.MaxModelVersionLength)]
        public string ModelVersion { get; set; } = string.Empty;

        [StringLength(AiModelConsts.MaxEnvironmentVariableLength)]
        public string? ApiKeyEnvironmentVariable { get; set; }

        [StringLength(AiModelConsts.MaxBaseUrlLength)]
        public string? BaseUrl { get; set; }

        public int? ContextWindowTokens { get; set; }
        public int? MaxOutputTokens { get; set; }
        public int? EmbeddingDimension { get; set; }
        public decimal? PromptTokenPriceUsd { get; set; }
        public decimal? CompletionTokenPriceUsd { get; set; }
        public bool IsActive { get; set; } = true;

        [StringLength(AiModelConsts.MaxDescriptionLength)]
        public string? Description { get; set; }

        public CreateUpdateAiModelDeploymentDto ToDto() => new()
        {
            Alias = Alias,
            ProviderType = ProviderType,
            Capability = Capability,
            UpstreamModelName = UpstreamModelName,
            ModelVersion = ModelVersion,
            ApiKeyEnvironmentVariable = ApiKeyEnvironmentVariable,
            BaseUrl = BaseUrl,
            ContextWindowTokens = ContextWindowTokens,
            MaxOutputTokens = MaxOutputTokens,
            EmbeddingDimension = EmbeddingDimension,
            PromptTokenPriceUsd = PromptTokenPriceUsd,
            CompletionTokenPriceUsd = CompletionTokenPriceUsd,
            IsActive = IsActive,
            Description = Description
        };
    }

