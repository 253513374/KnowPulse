@page "/rag/models"
@attribute [Authorize(KnowPulsePermissions.AiModels.View)]
@inherits KnowPulseComponentBase
@inject IAiModelCatalogAppService AiModelCatalogAppService
@inject IPermissionChecker PermissionChecker

<PageTitle>模型管理</PageTitle>

<div class="admin-page rag-admin-page rag-model-console">
    <header class="admin-page-header rag-model-header">
        <div>
            <h1>@(ActiveSection == ModelWorkspaceSection.Catalog ? "AI 模型目录" : ActiveSection == ModelWorkspaceSection.Bindings ? "模型用途与健康" : "模型健康记录")</h1>
            <p>维护模型部署信息，明确凭据配置与可用状态。</p>
        </div>
        <div class="rag-model-header-actions">
            @if (!string.IsNullOrWhiteSpace(Overview?.LiteLlmAdminUrl))
            {
                <a class="kp-button kp-button--secondary" href="@Overview.LiteLlmAdminUrl" target="_blank" rel="noopener">
                    LiteLLM 控制台 <i class="fa fa-external-link-alt" aria-hidden="true"></i>
                </a>
            }
            @if (CanTest)
            {
                <button class="kp-button kp-button--secondary" type="button" @onclick="TestAllAsync" disabled="@IsBusy">检查全部模型</button>
            }
            @if (CanManage && ActiveSection == ModelWorkspaceSection.Catalog)
            {
                <button class="kp-button kp-button--primary" type="button" @onclick="NewModelAsync" disabled="@IsBusy">新增模型</button>
            }
            <button class="kp-button kp-button--secondary" type="button" @onclick="ReloadAsync" disabled="@IsBusy">
                <i class="fa fa-sync-alt" aria-hidden="true"></i> 刷新
            </button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="kp-alert kp-alert--error" role="alert">@ErrorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="kp-alert kp-alert--success" role="status">@SuccessMessage</div>
    }

    @if (Overview == null)
    {
        <div class="rag-model-loading" role="status">
            @if (IsBusy) { <span class="kp-spinner kp-spinner--sm" aria-hidden="true"></span><span>正在读取模型配置</span> }
            else { <span>模型配置未能加载，请重试。</span> }
        </div>
    }
    else
    {
        <RagAdminTabs Active="@(ActiveSection.ToString().ToLowerInvariant())" />

        @if (ActiveSection == ModelWorkspaceSection.Bindings)
        {
            <div class="rag-model-bindings-layout">
            <section class="rag-model-surface">
                <div class="rag-model-section-heading">
                    <div>
                        <h2>用途绑定</h2>
                        <p>业务代码只依赖稳定用途；切换默认模型前必须先完成健康检查。</p>
                    </div>
                    @if (CanTest)
                    {
                        <button class="kp-button kp-button--sm kp-button--primary-outline" type="button" @onclick="TestAllAsync" disabled="@IsBusy">
                            <i class="fa fa-stethoscope" aria-hidden="true"></i> 检查全部模型
                        </button>
                    }
                </div>

                <div class="rag-model-purpose-filter rag-field">
                    <label for="model-purpose">用途</label>
                    <select id="model-purpose" class="kp-select" @bind="SelectedUsage" disabled="@IsBusy">
                        @foreach (var binding in BindingForms) { <option value="@binding.Usage">@GetUsageText(binding.Usage)</option> }
                    </select>
                </div>

                <div class="rag-binding-list">
                    @foreach (var binding in BindingForms.Where(x => x.Usage == SelectedUsage))
                    {
                        var selectedDeployment = GetSelectedDeployment(binding);
                        var isChanging = binding.OriginalDeploymentId != binding.DeploymentId;
                        <article class="rag-binding-row">
                            <div class="rag-binding-purpose">
                                <span class="rag-usage-icon @GetUsageIconCss(binding.Usage)">
                                    <i class="fa @GetUsageIcon(binding.Usage)" aria-hidden="true"></i>
                                </span>
                                <div>
                                    <h3>@GetUsageText(binding.Usage)</h3>
                                    <p>@GetUsageDescription(binding.Usage)</p>
                                </div>
                            </div>

                            <div class="rag-binding-controls">
                                <div class="rag-field">
                                    <label for="binding-model-@binding.Usage">默认模型</label>
                                    <InputSelect id="@($"binding-model-{binding.Usage}")" class="kp-select" @bind-Value="binding.DeploymentId" disabled="@(!CanSwitchDefaults)">
                                        @foreach (var model in GetDeploymentsForUsage(binding.Usage))
                                        {
                                            <option value="@model.Id">@model.Alias</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="rag-field">
                                    <label for="binding-version-@binding.Usage">业务版本</label>
                                    <InputText id="@($"binding-version-{binding.Usage}")" class="kp-input" @bind-Value="binding.BusinessModelVersion" disabled="@(!CanSwitchDefaults)" />
                                </div>
                            </div>

                            <div class="rag-binding-state">
                                <span class="rag-model-status @GetHealthStatusCss(selectedDeployment?.HealthStatus ?? AiModelHealthStatus.Unknown)">
                                    <span aria-hidden="true"></span>@GetHealthText(selectedDeployment?.HealthStatus ?? AiModelHealthStatus.Unknown)
                                </span>
                                <span class="rag-binding-hint @GetBindingHintCss(binding)">@GetBindingHint(binding)</span>
                            </div>

                            <details class="rag-binding-advanced" open>
                                <summary>高级参数</summary>
                                <div class="rag-binding-advanced-grid">
                                    @if (binding.Usage != AiModelUsage.KnowledgeEmbedding)
                                    {
                                        <div class="rag-field">
                                            <label for="binding-token-@binding.Usage">输出 token</label>
                                            <InputNumber id="@($"binding-token-{binding.Usage}")" class="kp-input" @bind-Value="binding.MaxOutputTokens" disabled="@(!CanSwitchDefaults)" />
                                        </div>
                                        <div class="rag-field">
                                            <label for="binding-temperature-@binding.Usage">Temperature</label>
                                            <InputNumber id="@($"binding-temperature-{binding.Usage}")" class="kp-input" @bind-Value="binding.Temperature" disabled="@(!CanSwitchDefaults)" />
                                        </div>
                                    }
                                    <div class="rag-field">
                                        <label for="binding-fallback-@binding.Usage">Fallback Alias</label>
                                        <InputText id="@($"binding-fallback-{binding.Usage}")" class="kp-input" @bind-Value="binding.FallbackAliasesText" disabled="@(!CanSwitchDefaults)" />
                                    </div>
                                </div>
                            </details>

                            <p class="rag-binding-notice">切换仅影响后续调用；历史记录保留当时的模型与业务版本。</p>

                            <div class="rag-binding-actions">
                                @if (CanTest && selectedDeployment != null)
                                {
                                    <button class="kp-button kp-button--sm kp-button--secondary" type="button" @onclick="() => TestModelAsync(selectedDeployment.Id)" disabled="@IsBusy">测试模型</button>
                                }
                                <button class="kp-button kp-button--sm kp-button--primary" type="button" @onclick="() => SaveBindingAsync(binding)" disabled="@(!CanSaveBinding(binding) || IsBusy)">
                                    @(isChanging ? "切换并生效" : "保存配置")
                                </button>
                            </div>
                        </article>
                    }
                </div>
            </section>
            <aside class="rag-model-surface">
                <div class="rag-model-section-heading"><h2>最近健康检查</h2></div>
                <div class="rag-model-health-summary">
                    @if (Overview.HealthSnapshots.Count == 0) { <p>尚未执行健康检查。检查模型后再切换默认配置。</p> }
                    @foreach (var health in Overview.HealthSnapshots.OrderByDescending(x => x.CheckedTime).GroupBy(x => x.DeploymentId).Select(x => x.First()))
                    {
                        <div class="rag-model-health-item"><strong>@health.DeploymentAlias</strong><span class="rag-model-status @GetHealthStatusCss(health.Status)">@GetHealthText(health.Status)</span><small>@health.CheckedTime.ToLocalTime().ToString("MM-dd HH:mm") · @(health.LatencyMs.HasValue ? $"{health.LatencyMs} ms" : "无延迟记录")</small>@if (!string.IsNullOrWhiteSpace(health.FailureReason)) { <p>@health.FailureReason</p> }</div>
                    }
                    @if (CanTest) { <button class="kp-button kp-button--secondary" @onclick="TestAllAsync" disabled="@IsBusy">重新检查全部</button> }
                </div>
            </aside>
            </div>
        }
        else if (ActiveSection == ModelWorkspaceSection.Catalog)
        {
            <section class="rag-model-surface">
                <div class="rag-model-section-heading">
                    <div>
                        <h2>模型目录</h2>
                        <p>@Overview.Deployments.Count 个模型 · @Overview.Deployments.Count(x => x.IsActive) 个启用。密钥只通过环境变量读取。</p>
                    </div>
                </div>

                @if (ShowModelEditor)
                {
                    <MudDrawer Anchor="Anchor.Right" Variant="DrawerVariant.Temporary" @bind-Open="ShowModelEditor" Width="880px" Overlay="true" OverlayAutoClose="false" Class="rag-model-drawer">
                    <div class="rag-model-editor">
                        <div class="rag-model-editor-heading">
                            <div>
                                <h3>@(ModelForm.IsEditing ? "编辑模型" : "接入新模型")</h3>
                                <p>保存的是业务 Alias 和连接信息，不保存任何密钥值。</p>
                            </div>
                            <button class="kp-button--close" type="button" aria-label="关闭模型编辑器" @onclick="CloseModelEditorAsync"></button>
                        </div>

                        <EditForm Model="@ModelForm" OnValidSubmit="@SaveModelAsync">
                            <DataAnnotationsValidator />
                            <div class="rag-model-form-grid">
                                <div class="rag-field">
                                    <label for="model-alias">Alias</label>
                                    <InputText id="model-alias" class="kp-input" @bind-Value="ModelForm.Alias" disabled="@(!CanManage)" />
                                    <ValidationMessage For="@(() => ModelForm.Alias)" />
                                </div>
                                <div class="rag-field">
                                    <label for="model-upstream">上游模型</label>
                                    <InputText id="model-upstream" class="kp-input" @bind-Value="ModelForm.UpstreamModelName" disabled="@(!CanManage)" />
                                    <ValidationMessage For="@(() => ModelForm.UpstreamModelName)" />
                                </div>
                                <div class="rag-field">
                                    <label for="model-capability">能力</label>
                                    <InputSelect id="model-capability" class="kp-select" @bind-Value="ModelForm.Capability" disabled="@(!CanManage)">
                                        @foreach (var value in Enum.GetValues<AiModelCapability>())
                                        {
                                            <option value="@value">@GetCapabilityText(value)</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="rag-field">
                                    <label for="model-provider">供应商</label>
                                    <InputSelect id="model-provider" class="kp-select" @bind-Value="ModelForm.ProviderType" disabled="@(!CanManage)">
                                        @foreach (var value in Enum.GetValues<AiModelProviderType>())
                                        {
                                            <option value="@value">@value</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="rag-field">
                                    <label for="model-version">业务版本</label>
                                    <InputText id="model-version" class="kp-input" @bind-Value="ModelForm.ModelVersion" disabled="@(!CanManage)" />
                                    <ValidationMessage For="@(() => ModelForm.ModelVersion)" />
                                </div>
                                <div class="rag-field">
                                    <label for="model-env">Key 环境变量</label>
                                    <InputText id="model-env" class="kp-input" @bind-Value="ModelForm.ApiKeyEnvironmentVariable" disabled="@(!CanManage)" />
                                </div>
                                <div class="rag-field rag-field--wide">
                                    <label for="model-base-url">Base URL</label>
                                    <InputText id="model-base-url" class="kp-input" @bind-Value="ModelForm.BaseUrl" disabled="@(!CanManage)" />
                                </div>
                                <div class="rag-field">
                                    <label for="model-context-window">上下文窗口 Token</label>
                                    <InputNumber id="model-context-window" class="kp-input" @bind-Value="ModelForm.ContextWindowTokens" min="1" step="1" disabled="@(!CanManage)" />
                                    <ValidationMessage For="@(() => ModelForm.ContextWindowTokens)" />
                                </div>
                                @if (ModelForm.Capability == AiModelCapability.Embedding)
                                {
                                    <div class="rag-field">
                                        <label for="model-dimension">向量维度</label>
                                        <InputNumber id="model-dimension" class="kp-input" @bind-Value="ModelForm.EmbeddingDimension" disabled="@(!CanManage)" />
                                        <small>切换为不同维度的 Embedding 模型需要重建知识索引。</small>
                                    </div>
                                }
                                else
                                {
                                    <div class="rag-field">
                                        <label for="model-output">最大输出 token</label>
                                        <InputNumber id="model-output" class="kp-input" @bind-Value="ModelForm.MaxOutputTokens" disabled="@(!CanManage)" />
                                    </div>
                                }
                                <div class="rag-field">
                                    <label for="model-input-price">输入 Token 单价（USD）</label>
                                    <InputNumber id="model-input-price" class="kp-input" @bind-Value="ModelForm.PromptTokenPriceUsd" min="0" step="any" disabled="@(!CanManage)" />
                                    <ValidationMessage For="@(() => ModelForm.PromptTokenPriceUsd)" />
                                </div>
                                <div class="rag-field">
                                    <label for="model-output-price">输出 Token 单价（USD）</label>
                                    <InputNumber id="model-output-price" class="kp-input" @bind-Value="ModelForm.CompletionTokenPriceUsd" min="0" step="any" disabled="@(!CanManage)" />
                                    <ValidationMessage For="@(() => ModelForm.CompletionTokenPriceUsd)" />
                                </div>
                                <div class="rag-field rag-field--wide">
                                    <label for="model-description">部署说明</label>
                                    <InputTextArea id="model-description" class="kp-input" @bind-Value="ModelForm.Description" rows="3" maxlength="@AiModelConsts.MaxDescriptionLength" disabled="@(!CanManage)" />
                                    <ValidationMessage For="@(() => ModelForm.Description)" />
                                </div>
                            </div>
                            <div class="rag-model-form-footer">
                                <div class="kp-check kp-switch">
                                    <InputCheckbox id="model-active" class="kp-check__input" @bind-Value="ModelForm.IsActive" disabled="@(!CanManage)" />
                                    <label class="kp-check__label" for="model-active">保存后启用</label>
                                </div>
                                <div>
                                    <button class="kp-button kp-button--secondary" type="button" @onclick="CloseModelEditorAsync" disabled="@IsBusy">取消</button>
                                    <button class="kp-button kp-button--primary" type="submit" disabled="@(!CanManage || IsBusy)">保存模型</button>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                    </MudDrawer>
                }

                <form class="rag-model-filter" @onsubmit="ApplyModelFilter" @onsubmit:preventDefault>
                    <div class="rag-field"><label for="model-keyword">搜索模型</label><input id="model-keyword" class="kp-input" @bind="ModelKeyword" placeholder="模型别名 / 供应商 / 上游模型" /></div>
                    <div class="rag-field"><label for="model-state">启用状态</label><select id="model-state" class="kp-select" @bind="ModelStateFilter"><option value="">全部状态</option><option value="true">已启用</option><option value="false">已停用</option></select></div>
                    <button class="kp-button kp-button--primary" type="submit">查询</button><button class="kp-button kp-button--secondary" type="button" @onclick="ResetModelFilter">重置</button>
                </form>

                <div class="kp-table-wrap rag-model-table-wrap">
                    <table class="kp-table kp-table-align-middle kp-mb-0 rag-model-table">
                        <thead>
                            <tr>
                                <th>业务 Alias</th>
                                <th>能力</th>
                                <th>凭据环境变量</th>
                                <th>健康状态</th>
                                <th>启用</th>
                                <th class="kp-text-end">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (FilteredModels.Count == 0) { <tr><td colspan="6"><div class="rag-model-empty">暂无符合条件的模型。请调整筛选，或新增模型部署。</div></td></tr> }
                            @foreach (var model in FilteredModels.Skip(ModelSkipCount).Take(10))
                            {
                                <tr>
                                    <td>
                                        <strong>@model.Alias</strong>
                                        <span>@model.ModelVersion</span>
                                    </td>
                                    <td>@GetCapabilityText(model.Capability)</td>
                                    <td>
                                        <strong>@(model.ApiKeyEnvironmentVariable ?? "未配置")</strong>
                                        <span>@model.ProviderType · @model.UpstreamModelName</span>
                                    </td>
                                    <td>
                                        <span class="rag-model-status @GetHealthStatusCss(model.HealthStatus)"><span aria-hidden="true"></span>@GetHealthText(model.HealthStatus)</span>
                                        <span>@GetModelUsageText(model.Id)</span>
                                    </td>
                                    <td>@(model.IsActive ? "已启用" : "已停用")</td>
                                    <td>
                                        <div class="rag-model-row-actions">
                                            @if (CanTest)
                                            {
                                                <button class="kp-button kp-button--sm kp-button--primary-outline" type="button" @onclick="() => TestModelAsync(model.Id)" disabled="@IsBusy">测试</button>
                                            }
                                            @if (CanManage)
                                            {
                                                <button class="kp-button kp-button--sm kp-button--secondary" type="button" @onclick="() => EditModelAsync(model)">编辑</button>
                                                <button class="kp-button kp-button--sm kp-button--secondary" type="button" @onclick="() => ToggleModelAsync(model)" disabled="@IsBusy">
                                                    @(model.IsActive ? "停用" : "启用")
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <MvpPager SkipCount="ModelSkipCount" PageSize="10" TotalCount="FilteredModels.Count" IsBusy="IsBusy" OnSkipCountChanged="ChangeModelPage" />
            </section>
        }
        else
        {
            <section class="rag-model-surface">
                <div class="rag-model-section-heading">
                    <div>
                        <h2>健康记录</h2>
                        <p>健康检查会真实调用 LiteLLM 的 Chat 或 Embedding 接口，并记录延迟与失败原因。</p>
                    </div>
                    @if (CanTest)
                    {
                        <button class="kp-button kp-button--sm kp-button--primary" type="button" @onclick="TestAllAsync" disabled="@IsBusy">
                            <i class="fa fa-play" aria-hidden="true"></i> 立即检查全部
                        </button>
                    }
                </div>

                <div class="kp-table-wrap rag-model-table-wrap">
                    <table class="kp-table kp-table-align-middle kp-mb-0 rag-model-table">
                        <thead>
                            <tr>
                                <th>模型</th>
                                <th>状态</th>
                                <th>延迟</th>
                                <th>检查时间</th>
                                <th>错误摘要</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Overview.HealthSnapshots.Count == 0)
                            {
                                <tr><td colspan="5"><div class="rag-model-empty">尚未执行健康检查。请先检查全部模型，再进行默认模型切换。</div></td></tr>
                            }
                            else
                            {
                                @foreach (var health in Overview.HealthSnapshots.OrderByDescending(x => x.CheckedTime))
                                {
                                    <tr>
                                        <td><strong>@health.DeploymentAlias</strong></td>
                                        <td><span class="rag-model-status @GetHealthStatusCss(health.Status)"><span aria-hidden="true"></span>@GetHealthText(health.Status)</span></td>
                                        <td>@(health.LatencyMs.HasValue ? $"{health.LatencyMs.Value} ms" : "-")</td>
                                        <td>@health.CheckedTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td>@(string.IsNullOrWhiteSpace(health.FailureReason) ? "-" : health.FailureReason)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</div>

@code {
    private AiModelCatalogOverviewDto? Overview { get; set; }
    private ModelFormModel ModelForm { get; set; } = new();
    private List<BindingFormModel> BindingForms { get; set; } = new();
    [SupplyParameterFromQuery(Name = "section")]
    public string? Section { get; set; }

    private ModelWorkspaceSection ActiveSection { get; set; } = ModelWorkspaceSection.Catalog;
    private AiModelUsage SelectedUsage { get; set; } = AiModelUsage.RagAnswerChat;
    private string? ModelKeyword { get; set; }
    private string? ModelStateFilter { get; set; }
    private int ModelSkipCount { get; set; }
    private IReadOnlyList<AiModelDeploymentDto> FilteredModels => Overview?.Deployments.Where(x =>
        (string.IsNullOrWhiteSpace(ModelKeyword) || x.Alias.Contains(ModelKeyword.Trim(), StringComparison.OrdinalIgnoreCase) || x.UpstreamModelName.Contains(ModelKeyword.Trim(), StringComparison.OrdinalIgnoreCase) || x.ProviderType.ToString().Contains(ModelKeyword.Trim(), StringComparison.OrdinalIgnoreCase)) &&
        (!bool.TryParse(ModelStateFilter, out var active) || x.IsActive == active)).ToList() ?? [];
    private bool ShowModelEditor { get; set; }
    private bool CanManage { get; set; }
    private bool CanTest { get; set; }
    private bool CanSwitchDefaults { get; set; }
    private bool IsBusy { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        CanManage = await PermissionChecker.IsGrantedAsync(KnowPulsePermissions.AiModels.Manage);
        CanTest = await PermissionChecker.IsGrantedAsync(KnowPulsePermissions.AiModels.Test);
        CanSwitchDefaults = await PermissionChecker.IsGrantedAsync(KnowPulsePermissions.AiModels.SwitchDefaults);
        await ReloadAsync();
    }

    protected override void OnParametersSet()
    {
        ActiveSection = Section switch { "bindings" => ModelWorkspaceSection.Bindings, "health" => ModelWorkspaceSection.Health, _ => ModelWorkspaceSection.Catalog };
    }

    private void ApplyModelFilter() => ModelSkipCount = 0;
    private void ResetModelFilter() { ModelKeyword = null; ModelStateFilter = null; ModelSkipCount = 0; }
    private void ChangeModelPage(int skipCount) => ModelSkipCount = skipCount;

    private async Task ReloadAsync()
    {
        await RunBusyAsync(async () =>
        {
            Overview = await AiModelCatalogAppService.GetOverviewAsync();
            BindingForms = CreateBindingForms(Overview);
        }, successMessage: null);
    }

    private Task NewModelAsync()
    {
        ActiveSection = ModelWorkspaceSection.Catalog;
        ModelForm = new ModelFormModel();
        ShowModelEditor = true;
        SuccessMessage = null;
        ErrorMessage = null;
        return Task.CompletedTask;
    }

    private Task EditModelAsync(AiModelDeploymentDto model)
    {
        ActiveSection = ModelWorkspaceSection.Catalog;
        ShowModelEditor = true;
        ModelForm = new ModelFormModel
        {
            Id = model.Id,
            IsEditing = true,
            Alias = model.Alias,
            ProviderType = model.ProviderType,
            Capability = model.Capability,
            UpstreamModelName = model.UpstreamModelName,
            ModelVersion = model.ModelVersion,
            ApiKeyEnvironmentVariable = model.ApiKeyEnvironmentVariable,
            BaseUrl = model.BaseUrl,
            ContextWindowTokens = model.ContextWindowTokens,
            MaxOutputTokens = model.MaxOutputTokens,
            EmbeddingDimension = model.EmbeddingDimension,
            PromptTokenPriceUsd = model.PromptTokenPriceUsd,
            CompletionTokenPriceUsd = model.CompletionTokenPriceUsd,
            IsActive = model.IsActive,
            Description = model.Description
        };
        return Task.CompletedTask;
    }

    private Task CloseModelEditorAsync()
    {
        ModelForm = new ModelFormModel();
        ShowModelEditor = false;
        ErrorMessage = null;
        return Task.CompletedTask;
    }

    private async Task SaveModelAsync()
    {
        await RunBusyAsync(async () =>
        {
            var input = ModelForm.ToDto();
            if (ModelForm.IsEditing && ModelForm.Id.HasValue)
            {
                await AiModelCatalogAppService.UpdateDeploymentAsync(ModelForm.Id.Value, input);
            }
            else
            {
                await AiModelCatalogAppService.CreateDeploymentAsync(input);
            }

            Overview = await AiModelCatalogAppService.GetOverviewAsync();
            BindingForms = CreateBindingForms(Overview);
            ModelForm = new ModelFormModel();
            ShowModelEditor = false;
        }, "模型已保存；切换业务用途前请先执行健康检查。");
    }

    private async Task ToggleModelAsync(AiModelDeploymentDto model)
    {
        await RunBusyAsync(async () =>
        {
            await AiModelCatalogAppService.SetDeploymentActiveAsync(model.Id, !model.IsActive);
            Overview = await AiModelCatalogAppService.GetOverviewAsync();
            BindingForms = CreateBindingForms(Overview);
        }, model.IsActive ? "模型已停用" : "模型已启用");
    }

    private async Task TestModelAsync(Guid modelId)
    {
        await RunBusyAsync(async () =>
        {
            await AiModelCatalogAppService.TestDeploymentAsync(modelId);
            Overview = await AiModelCatalogAppService.GetOverviewAsync();
        }, "健康检查已完成");
    }

    private async Task TestAllAsync()
    {
        await RunBusyAsync(async () =>
        {
            await AiModelCatalogAppService.TestAllAsync();
            Overview = await AiModelCatalogAppService.GetOverviewAsync();
        }, "批量健康检查已完成");
    }

    private async Task SaveBindingAsync(BindingFormModel binding)
    {
        if (!CanSaveBinding(binding))
        {
            ErrorMessage = GetBindingHint(binding);
            return;
        }

        await RunBusyAsync(async () =>
        {
            await AiModelCatalogAppService.SetUsageBindingAsync(new SetAiModelUsageBindingDto
            {
                Usage = binding.Usage,
                DeploymentId = binding.DeploymentId,
                BusinessModelVersion = binding.BusinessModelVersion,
                MaxOutputTokens = binding.MaxOutputTokens,
                Temperature = binding.Temperature,
                FallbackAliases = binding.FallbackAliasesText
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .ToList()
            });
            Overview = await AiModelCatalogAppService.GetOverviewAsync();
            BindingForms = CreateBindingForms(Overview);
        }, "用途配置已保存并生效");
    }

    private IReadOnlyList<AiModelDeploymentDto> GetDeploymentsForUsage(AiModelUsage usage)
    {
        if (Overview == null)
        {
            return Array.Empty<AiModelDeploymentDto>();
        }

        var capability = usage == AiModelUsage.KnowledgeEmbedding ? AiModelCapability.Embedding : AiModelCapability.Chat;
        return Overview.Deployments.Where(x => x.IsActive && x.Capability == capability).OrderBy(x => x.Alias).ToList();
    }

    private AiModelDeploymentDto? GetSelectedDeployment(BindingFormModel binding)
        => Overview?.Deployments.FirstOrDefault(x => x.Id == binding.DeploymentId);

    private bool HasEmbeddingDimensionChange(BindingFormModel binding)
    {
        if (Overview == null || binding.Usage != AiModelUsage.KnowledgeEmbedding || binding.OriginalDeploymentId == binding.DeploymentId)
        {
            return false;
        }

        var current = Overview.Deployments.FirstOrDefault(x => x.Id == binding.OriginalDeploymentId);
        var selected = GetSelectedDeployment(binding);
        return current?.EmbeddingDimension != selected?.EmbeddingDimension;
    }

    private bool CanSaveBinding(BindingFormModel binding)
    {
        if (!CanSwitchDefaults || binding.DeploymentId == Guid.Empty || HasEmbeddingDimensionChange(binding))
        {
            return false;
        }

        if (binding.OriginalDeploymentId == binding.DeploymentId)
        {
            return true;
        }

        return GetSelectedDeployment(binding)?.HealthStatus == AiModelHealthStatus.Healthy;
    }

    private string GetBindingHint(BindingFormModel binding)
    {
        if (HasEmbeddingDimensionChange(binding))
        {
            return "向量维度发生变化，需先重建知识索引，当前不能直接生效。";
        }

        if (binding.OriginalDeploymentId == binding.DeploymentId)
        {
            return "当前生效配置";
        }

        return GetSelectedDeployment(binding)?.HealthStatus == AiModelHealthStatus.Healthy
            ? "健康检查已通过，可以切换"
            : "切换默认模型前请先完成健康检查";
    }

    private string GetBindingHintCss(BindingFormModel binding)
        => CanSaveBinding(binding) ? "is-ready" : binding.OriginalDeploymentId == binding.DeploymentId ? "is-current" : "is-warning";

    private string GetModelUsageText(Guid deploymentId)
    {
        if (Overview == null)
        {
            return "未绑定";
        }

        var usages = Overview.Bindings.Where(x => x.DeploymentId == deploymentId).Select(x => GetUsageText(x.Usage)).ToList();
        return usages.Count == 0 ? "未绑定" : string.Join("、", usages);
    }

    private async Task RunBusyAsync(Func<Task> action, string? successMessage)
    {
        try
        {
            ErrorMessage = null;
            SuccessMessage = null;
            IsBusy = true;
            await action();
            SuccessMessage = successMessage;
        }
        catch (Exception ex)
        {
            ErrorMessage = GetUserFriendlyErrorMessage(ex);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private static List<BindingFormModel> CreateBindingForms(AiModelCatalogOverviewDto overview)
    {
        return Enum.GetValues<AiModelUsage>()
            .Where(x => x is not (AiModelUsage.SubjectiveScoring or AiModelUsage.TeachingPlanGeneration))
            .Select(usage =>
            {
                var existing = overview.Bindings.FirstOrDefault(x => x.Usage == usage);
                var firstDeployment = overview.Deployments.FirstOrDefault(x => x.IsActive && x.Capability == (usage == AiModelUsage.KnowledgeEmbedding ? AiModelCapability.Embedding : AiModelCapability.Chat));
                var deploymentId = existing?.DeploymentId ?? firstDeployment?.Id ?? Guid.Empty;
                return new BindingFormModel
                {
                    Usage = usage,
                    OriginalDeploymentId = deploymentId,
                    DeploymentId = deploymentId,
                    BusinessModelVersion = existing?.BusinessModelVersion ?? string.Empty,
                    MaxOutputTokens = existing?.MaxOutputTokens ?? (usage == AiModelUsage.KnowledgeEmbedding ? 0 : 800),
                    Temperature = existing?.Temperature ?? 0.2,
                    FallbackAliasesText = existing == null ? string.Empty : string.Join(", ", existing.FallbackAliases)
                };
            })
            .ToList();
    }

