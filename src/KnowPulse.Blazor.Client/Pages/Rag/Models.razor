@page "/rag/models"
@attribute [Authorize(KnowPulsePermissions.AiModels.View)]
@inherits KnowPulseComponentBase
@inject IAiModelCatalogAppService AiModelCatalogAppService
@inject IPermissionChecker PermissionChecker

<PageTitle>模型管理</PageTitle>

<div class="rag-model-console">
    <header class="rag-model-header">
        <div>
            <h1>RAG 运行控制台 · 模型管理</h1>
            <p>管理稳定 Alias、验证模型连通性，并控制不同业务用途的生效配置。</p>
        </div>
        <div class="rag-model-header-actions">
            @if (!string.IsNullOrWhiteSpace(Overview?.LiteLlmAdminUrl))
            {
                <a class="btn btn-outline-secondary" href="@Overview.LiteLlmAdminUrl" target="_blank" rel="noopener">
                    LiteLLM 控制台 <i class="fa fa-external-link-alt" aria-hidden="true"></i>
                </a>
            }
            <button class="btn btn-outline-primary" type="button" @onclick="ReloadAsync" disabled="@IsBusy">
                <i class="fa fa-sync-alt" aria-hidden="true"></i> 刷新
            </button>
        </div>
    </header>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">@ErrorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="alert alert-success" role="status">@SuccessMessage</div>
    }

    @if (Overview == null)
    {
        <div class="rag-model-loading" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            正在读取模型配置
        </div>
    }
    else
    {
        <section class="rag-usage-summary" aria-label="当前业务用途配置">
            @foreach (var binding in Overview.Bindings.Where(x => x.Usage != AiModelUsage.SubjectiveScoring).OrderBy(x => x.Usage))
            {
                var deployment = Overview.Deployments.FirstOrDefault(x => x.Id == binding.DeploymentId);
                <article class="rag-usage-card">
                    <span class="rag-usage-icon @GetUsageIconCss(binding.Usage)">
                        <i class="fa @GetUsageIcon(binding.Usage)" aria-hidden="true"></i>
                    </span>
                    <div class="rag-usage-copy">
                        <div class="rag-usage-heading">
                            <strong>@GetUsageText(binding.Usage)</strong>
                            <span class="rag-model-status @GetHealthStatusCss(deployment?.HealthStatus ?? AiModelHealthStatus.Unknown)">
                                <span aria-hidden="true"></span>@GetHealthText(deployment?.HealthStatus ?? AiModelHealthStatus.Unknown)
                            </span>
                        </div>
                        <div class="rag-usage-alias">@binding.DeploymentAlias</div>
                        <div class="rag-usage-version">业务版本 @binding.BusinessModelVersion</div>
                    </div>
                </article>
            }
        </section>

        <nav class="rag-model-tabs" aria-label="模型管理分区">
            <button type="button" class="@(ActiveSection == ModelWorkspaceSection.Bindings ? "is-active" : null)" @onclick="() => SelectSection(ModelWorkspaceSection.Bindings)">
                <i class="fa fa-route" aria-hidden="true"></i> 用途配置
            </button>
            <button type="button" class="@(ActiveSection == ModelWorkspaceSection.Catalog ? "is-active" : null)" @onclick="() => SelectSection(ModelWorkspaceSection.Catalog)">
                <i class="fa fa-cubes" aria-hidden="true"></i> 模型目录
            </button>
            <button type="button" class="@(ActiveSection == ModelWorkspaceSection.Health ? "is-active" : null)" @onclick="() => SelectSection(ModelWorkspaceSection.Health)">
                <i class="fa fa-heartbeat" aria-hidden="true"></i> 健康记录
            </button>
        </nav>

        @if (ActiveSection == ModelWorkspaceSection.Bindings)
        {
            <section class="rag-model-surface">
                <div class="rag-model-section-heading">
                    <div>
                        <h2>用途配置</h2>
                        <p>业务代码只依赖稳定用途；切换默认模型前必须先完成健康检查。</p>
                    </div>
                    @if (CanTest)
                    {
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="TestAllAsync" disabled="@IsBusy">
                            <i class="fa fa-stethoscope" aria-hidden="true"></i> 检查全部模型
                        </button>
                    }
                </div>

                <div class="rag-binding-list">
                    @foreach (var binding in BindingForms)
                    {
                        var selectedDeployment = GetSelectedDeployment(binding);
                        var isChanging = binding.OriginalDeploymentId != binding.DeploymentId;
                        <article class="rag-binding-row">
                            <div class="rag-binding-purpose">
                                <span class="rag-usage-icon @GetUsageIconCss(binding.Usage)">
                                    <i class="fa @GetUsageIcon(binding.Usage)" aria-hidden="true"></i>
                                </span>
                                <div>
                                    <h3>@GetUsageText(binding.Usage)</h3>
                                    <p>@GetUsageDescription(binding.Usage)</p>
                                </div>
                            </div>

                            <div class="rag-binding-controls">
                                <div class="rag-field">
                                    <label for="binding-model-@binding.Usage">默认模型</label>
                                    <InputSelect id="@($"binding-model-{binding.Usage}")" class="form-select" @bind-Value="binding.DeploymentId" disabled="@(!CanSwitchDefaults)">
                                        @foreach (var model in GetDeploymentsForUsage(binding.Usage))
                                        {
                                            <option value="@model.Id">@model.Alias</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="rag-field">
                                    <label for="binding-version-@binding.Usage">业务版本</label>
                                    <InputText id="@($"binding-version-{binding.Usage}")" class="form-control" @bind-Value="binding.BusinessModelVersion" disabled="@(!CanSwitchDefaults)" />
                                </div>
                            </div>

                            <div class="rag-binding-state">
                                <span class="rag-model-status @GetHealthStatusCss(selectedDeployment?.HealthStatus ?? AiModelHealthStatus.Unknown)">
                                    <span aria-hidden="true"></span>@GetHealthText(selectedDeployment?.HealthStatus ?? AiModelHealthStatus.Unknown)
                                </span>
                                <span class="rag-binding-hint @GetBindingHintCss(binding)">@GetBindingHint(binding)</span>
                            </div>

                            <details class="rag-binding-advanced">
                                <summary>高级参数</summary>
                                <div class="rag-binding-advanced-grid">
                                    @if (binding.Usage != AiModelUsage.KnowledgeEmbedding)
                                    {
                                        <div class="rag-field">
                                            <label for="binding-token-@binding.Usage">输出 token</label>
                                            <InputNumber id="@($"binding-token-{binding.Usage}")" class="form-control" @bind-Value="binding.MaxOutputTokens" disabled="@(!CanSwitchDefaults)" />
                                        </div>
                                        <div class="rag-field">
                                            <label for="binding-temperature-@binding.Usage">Temperature</label>
                                            <InputNumber id="@($"binding-temperature-{binding.Usage}")" class="form-control" @bind-Value="binding.Temperature" disabled="@(!CanSwitchDefaults)" />
                                        </div>
                                    }
                                    <div class="rag-field">
                                        <label for="binding-fallback-@binding.Usage">Fallback Alias</label>
                                        <InputText id="@($"binding-fallback-{binding.Usage}")" class="form-control" @bind-Value="binding.FallbackAliasesText" disabled="@(!CanSwitchDefaults)" />
                                    </div>
                                </div>
                            </details>

                            <div class="rag-binding-actions">
                                @if (CanTest && selectedDeployment != null)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => TestModelAsync(selectedDeployment.Id)" disabled="@IsBusy">测试模型</button>
                                }
                                <button class="btn btn-sm btn-primary" type="button" @onclick="() => SaveBindingAsync(binding)" disabled="@(!CanSaveBinding(binding) || IsBusy)">
                                    @(isChanging ? "切换并生效" : "保存配置")
                                </button>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
        else if (ActiveSection == ModelWorkspaceSection.Catalog)
        {
            <section class="rag-model-surface">
                <div class="rag-model-section-heading">
                    <div>
                        <h2>模型目录</h2>
                        <p>维护稳定 Alias 与上游模型映射；密钥只通过环境变量读取。</p>
                    </div>
                    @if (CanManage)
                    {
                        <button class="btn btn-sm btn-primary" type="button" @onclick="NewModelAsync">
                            <i class="fa fa-plus" aria-hidden="true"></i> 新增模型
                        </button>
                    }
                </div>

                @if (ShowModelEditor)
                {
                    <div class="rag-model-editor">
                        <div class="rag-model-editor-heading">
                            <div>
                                <h3>@(ModelForm.IsEditing ? "编辑模型" : "接入新模型")</h3>
                                <p>保存的是业务 Alias 和连接信息，不保存任何密钥值。</p>
                            </div>
                            <button class="btn-close" type="button" aria-label="关闭模型编辑器" @onclick="CloseModelEditorAsync"></button>
                        </div>

                        <EditForm Model="@ModelForm" OnValidSubmit="@SaveModelAsync">
                            <DataAnnotationsValidator />
                            <div class="rag-model-form-grid">
                                <div class="rag-field">
                                    <label for="model-alias">Alias</label>
                                    <InputText id="model-alias" class="form-control" @bind-Value="ModelForm.Alias" disabled="@(!CanManage)" />
                                    <ValidationMessage For="@(() => ModelForm.Alias)" />
                                </div>
                                <div class="rag-field">
                                    <label for="model-upstream">上游模型</label>
                                    <InputText id="model-upstream" class="form-control" @bind-Value="ModelForm.UpstreamModelName" disabled="@(!CanManage)" />
                                    <ValidationMessage For="@(() => ModelForm.UpstreamModelName)" />
                                </div>
                                <div class="rag-field">
                                    <label for="model-capability">能力</label>
                                    <InputSelect id="model-capability" class="form-select" @bind-Value="ModelForm.Capability" disabled="@(!CanManage)">
                                        @foreach (var value in Enum.GetValues<AiModelCapability>())
                                        {
                                            <option value="@value">@GetCapabilityText(value)</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="rag-field">
                                    <label for="model-provider">供应商</label>
                                    <InputSelect id="model-provider" class="form-select" @bind-Value="ModelForm.ProviderType" disabled="@(!CanManage)">
                                        @foreach (var value in Enum.GetValues<AiModelProviderType>())
                                        {
                                            <option value="@value">@value</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="rag-field">
                                    <label for="model-version">业务版本</label>
                                    <InputText id="model-version" class="form-control" @bind-Value="ModelForm.ModelVersion" disabled="@(!CanManage)" />
                                    <ValidationMessage For="@(() => ModelForm.ModelVersion)" />
                                </div>
                                <div class="rag-field">
                                    <label for="model-env">Key 环境变量</label>
                                    <InputText id="model-env" class="form-control" @bind-Value="ModelForm.ApiKeyEnvironmentVariable" disabled="@(!CanManage)" />
                                </div>
                                <div class="rag-field">
                                    <label for="model-base-url">Base URL</label>
                                    <InputText id="model-base-url" class="form-control" @bind-Value="ModelForm.BaseUrl" disabled="@(!CanManage)" />
                                </div>
                                @if (ModelForm.Capability == AiModelCapability.Embedding)
                                {
                                    <div class="rag-field">
                                        <label for="model-dimension">向量维度</label>
                                        <InputNumber id="model-dimension" class="form-control" @bind-Value="ModelForm.EmbeddingDimension" disabled="@(!CanManage)" />
                                        <small>切换为不同维度的 Embedding 模型需要重建知识索引。</small>
                                    </div>
                                }
                                else
                                {
                                    <div class="rag-field">
                                        <label for="model-output">最大输出 token</label>
                                        <InputNumber id="model-output" class="form-control" @bind-Value="ModelForm.MaxOutputTokens" disabled="@(!CanManage)" />
                                    </div>
                                }
                            </div>
                            <div class="rag-model-form-footer">
                                <div class="form-check form-switch">
                                    <InputCheckbox id="model-active" class="form-check-input" @bind-Value="ModelForm.IsActive" disabled="@(!CanManage)" />
                                    <label class="form-check-label" for="model-active">保存后启用</label>
                                </div>
                                <div>
                                    <button class="btn btn-outline-secondary" type="button" @onclick="CloseModelEditorAsync" disabled="@IsBusy">取消</button>
                                    <button class="btn btn-primary" type="submit" disabled="@(!CanManage || IsBusy)">保存模型</button>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                }

                <div class="table-responsive rag-model-table-wrap">
                    <table class="table align-middle mb-0 rag-model-table">
                        <thead>
                            <tr>
                                <th>业务 Alias</th>
                                <th>能力</th>
                                <th>上游模型</th>
                                <th>当前用途</th>
                                <th>运行状态</th>
                                <th class="text-end">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var model in Overview.Deployments)
                            {
                                <tr>
                                    <td>
                                        <strong>@model.Alias</strong>
                                        <span>@model.ModelVersion</span>
                                    </td>
                                    <td>@GetCapabilityText(model.Capability)</td>
                                    <td>
                                        <strong>@model.UpstreamModelName</strong>
                                        <span>@model.ProviderType · @model.ApiKeyEnvironmentVariable</span>
                                    </td>
                                    <td>@GetModelUsageText(model.Id)</td>
                                    <td>
                                        <span class="rag-model-status @GetHealthStatusCss(model.HealthStatus)"><span aria-hidden="true"></span>@GetHealthText(model.HealthStatus)</span>
                                        <span>@(model.IsActive ? "已启用" : "已停用")</span>
                                    </td>
                                    <td>
                                        <div class="rag-model-row-actions">
                                            @if (CanTest)
                                            {
                                                <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => TestModelAsync(model.Id)" disabled="@IsBusy">测试</button>
                                            }
                                            @if (CanManage)
                                            {
                                                <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => EditModelAsync(model)">编辑</button>
                                                <button class="btn btn-sm btn-outline-secondary" type="button" @onclick="() => ToggleModelAsync(model)" disabled="@IsBusy">
                                                    @(model.IsActive ? "停用" : "启用")
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
        else
        {
            <section class="rag-model-surface">
                <div class="rag-model-section-heading">
                    <div>
                        <h2>健康记录</h2>
                        <p>健康检查会真实调用 LiteLLM 的 Chat 或 Embedding 接口，并记录延迟与失败原因。</p>
                    </div>
                    @if (CanTest)
                    {
                        <button class="btn btn-sm btn-primary" type="button" @onclick="TestAllAsync" disabled="@IsBusy">
                            <i class="fa fa-play" aria-hidden="true"></i> 立即检查全部
                        </button>
                    }
                </div>

                <div class="table-responsive rag-model-table-wrap">
                    <table class="table align-middle mb-0 rag-model-table">
                        <thead>
                            <tr>
                                <th>模型</th>
                                <th>状态</th>
                                <th>延迟</th>
                                <th>检查时间</th>
                                <th>错误摘要</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Overview.HealthSnapshots.Count == 0)
                            {
                                <tr><td colspan="5"><div class="rag-model-empty">尚未执行健康检查。请先检查全部模型，再进行默认模型切换。</div></td></tr>
                            }
                            else
                            {
                                @foreach (var health in Overview.HealthSnapshots.OrderByDescending(x => x.CheckedTime))
                                {
                                    <tr>
                                        <td><strong>@health.DeploymentAlias</strong></td>
                                        <td><span class="rag-model-status @GetHealthStatusCss(health.Status)"><span aria-hidden="true"></span>@GetHealthText(health.Status)</span></td>
                                        <td>@(health.LatencyMs.HasValue ? $"{health.LatencyMs.Value} ms" : "-")</td>
                                        <td>@health.CheckedTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                                        <td>@(string.IsNullOrWhiteSpace(health.FailureReason) ? "-" : health.FailureReason)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        }
    }
</div>

@code {
    private AiModelCatalogOverviewDto? Overview { get; set; }
    private ModelFormModel ModelForm { get; set; } = new();
    private List<BindingFormModel> BindingForms { get; set; } = new();
    private ModelWorkspaceSection ActiveSection { get; set; } = ModelWorkspaceSection.Bindings;
    private bool ShowModelEditor { get; set; }
    private bool CanManage { get; set; }
    private bool CanTest { get; set; }
    private bool CanSwitchDefaults { get; set; }
    private bool IsBusy { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        CanManage = await PermissionChecker.IsGrantedAsync(KnowPulsePermissions.AiModels.Manage);
        CanTest = await PermissionChecker.IsGrantedAsync(KnowPulsePermissions.AiModels.Test);
        CanSwitchDefaults = await PermissionChecker.IsGrantedAsync(KnowPulsePermissions.AiModels.SwitchDefaults);
        await ReloadAsync();
    }

    private void SelectSection(ModelWorkspaceSection section)
    {
        ActiveSection = section;
        ErrorMessage = null;
        SuccessMessage = null;
    }

    private async Task ReloadAsync()
    {
        await RunBusyAsync(async () =>
        {
            Overview = await AiModelCatalogAppService.GetOverviewAsync();
            BindingForms = CreateBindingForms(Overview);
        }, successMessage: null);
    }

    private Task NewModelAsync()
    {
        ActiveSection = ModelWorkspaceSection.Catalog;
        ModelForm = new ModelFormModel();
        ShowModelEditor = true;
        SuccessMessage = null;
        ErrorMessage = null;
        return Task.CompletedTask;
    }

    private Task EditModelAsync(AiModelDeploymentDto model)
    {
        ActiveSection = ModelWorkspaceSection.Catalog;
        ShowModelEditor = true;
        ModelForm = new ModelFormModel
        {
            Id = model.Id,
            IsEditing = true,
            Alias = model.Alias,
            ProviderType = model.ProviderType,
            Capability = model.Capability,
            UpstreamModelName = model.UpstreamModelName,
            ModelVersion = model.ModelVersion,
            ApiKeyEnvironmentVariable = model.ApiKeyEnvironmentVariable,
            BaseUrl = model.BaseUrl,
            ContextWindowTokens = model.ContextWindowTokens,
            MaxOutputTokens = model.MaxOutputTokens,
            EmbeddingDimension = model.EmbeddingDimension,
            PromptTokenPriceUsd = model.PromptTokenPriceUsd,
            CompletionTokenPriceUsd = model.CompletionTokenPriceUsd,
            IsActive = model.IsActive,
            Description = model.Description
        };
        return Task.CompletedTask;
    }

    private Task CloseModelEditorAsync()
    {
        ModelForm = new ModelFormModel();
        ShowModelEditor = false;
        ErrorMessage = null;
        return Task.CompletedTask;
    }

    private async Task SaveModelAsync()
    {
        await RunBusyAsync(async () =>
        {
            var input = ModelForm.ToDto();
            if (ModelForm.IsEditing && ModelForm.Id.HasValue)
            {
                await AiModelCatalogAppService.UpdateDeploymentAsync(ModelForm.Id.Value, input);
            }
            else
            {
                await AiModelCatalogAppService.CreateDeploymentAsync(input);
            }

            Overview = await AiModelCatalogAppService.GetOverviewAsync();
            BindingForms = CreateBindingForms(Overview);
            ModelForm = new ModelFormModel();
            ShowModelEditor = false;
        }, "模型已保存；切换业务用途前请先执行健康检查。");
    }

    private async Task ToggleModelAsync(AiModelDeploymentDto model)
    {
        await RunBusyAsync(async () =>
        {
            await AiModelCatalogAppService.SetDeploymentActiveAsync(model.Id, !model.IsActive);
            Overview = await AiModelCatalogAppService.GetOverviewAsync();
            BindingForms = CreateBindingForms(Overview);
        }, model.IsActive ? "模型已停用" : "模型已启用");
    }

    private async Task TestModelAsync(Guid modelId)
    {
        await RunBusyAsync(async () =>
        {
            await AiModelCatalogAppService.TestDeploymentAsync(modelId);
            Overview = await AiModelCatalogAppService.GetOverviewAsync();
        }, "健康检查已完成");
    }

    private async Task TestAllAsync()
    {
        await RunBusyAsync(async () =>
        {
            await AiModelCatalogAppService.TestAllAsync();
            Overview = await AiModelCatalogAppService.GetOverviewAsync();
        }, "批量健康检查已完成");
    }

    private async Task SaveBindingAsync(BindingFormModel binding)
    {
        if (!CanSaveBinding(binding))
        {
            ErrorMessage = GetBindingHint(binding);
            return;
        }

        await RunBusyAsync(async () =>
        {
            await AiModelCatalogAppService.SetUsageBindingAsync(new SetAiModelUsageBindingDto
            {
                Usage = binding.Usage,
                DeploymentId = binding.DeploymentId,
                BusinessModelVersion = binding.BusinessModelVersion,
                MaxOutputTokens = binding.MaxOutputTokens,
                Temperature = binding.Temperature,
                FallbackAliases = binding.FallbackAliasesText
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .ToList()
            });
            Overview = await AiModelCatalogAppService.GetOverviewAsync();
            BindingForms = CreateBindingForms(Overview);
        }, "用途配置已保存并生效");
    }

    private IReadOnlyList<AiModelDeploymentDto> GetDeploymentsForUsage(AiModelUsage usage)
    {
        if (Overview == null)
        {
            return Array.Empty<AiModelDeploymentDto>();
        }

        var capability = usage == AiModelUsage.KnowledgeEmbedding ? AiModelCapability.Embedding : AiModelCapability.Chat;
        return Overview.Deployments.Where(x => x.IsActive && x.Capability == capability).OrderBy(x => x.Alias).ToList();
    }

    private AiModelDeploymentDto? GetSelectedDeployment(BindingFormModel binding)
        => Overview?.Deployments.FirstOrDefault(x => x.Id == binding.DeploymentId);

    private bool HasEmbeddingDimensionChange(BindingFormModel binding)
    {
        if (Overview == null || binding.Usage != AiModelUsage.KnowledgeEmbedding || binding.OriginalDeploymentId == binding.DeploymentId)
        {
            return false;
        }

        var current = Overview.Deployments.FirstOrDefault(x => x.Id == binding.OriginalDeploymentId);
        var selected = GetSelectedDeployment(binding);
        return current?.EmbeddingDimension != selected?.EmbeddingDimension;
    }

    private bool CanSaveBinding(BindingFormModel binding)
    {
        if (!CanSwitchDefaults || binding.DeploymentId == Guid.Empty || HasEmbeddingDimensionChange(binding))
        {
            return false;
        }

        if (binding.OriginalDeploymentId == binding.DeploymentId)
        {
            return true;
        }

        return GetSelectedDeployment(binding)?.HealthStatus == AiModelHealthStatus.Healthy;
    }

    private string GetBindingHint(BindingFormModel binding)
    {
        if (HasEmbeddingDimensionChange(binding))
        {
            return "向量维度发生变化，需先重建知识索引，当前不能直接生效。";
        }

        if (binding.OriginalDeploymentId == binding.DeploymentId)
        {
            return "当前生效配置";
        }

        return GetSelectedDeployment(binding)?.HealthStatus == AiModelHealthStatus.Healthy
            ? "健康检查已通过，可以切换"
            : "切换默认模型前请先完成健康检查";
    }

    private string GetBindingHintCss(BindingFormModel binding)
        => CanSaveBinding(binding) ? "is-ready" : binding.OriginalDeploymentId == binding.DeploymentId ? "is-current" : "is-warning";

    private string GetModelUsageText(Guid deploymentId)
    {
        if (Overview == null)
        {
            return "未绑定";
        }

        var usages = Overview.Bindings.Where(x => x.DeploymentId == deploymentId).Select(x => GetUsageText(x.Usage)).ToList();
        return usages.Count == 0 ? "未绑定" : string.Join("、", usages);
    }

    private async Task RunBusyAsync(Func<Task> action, string? successMessage)
    {
        try
        {
            ErrorMessage = null;
            SuccessMessage = null;
            IsBusy = true;
            await action();
            SuccessMessage = successMessage;
        }
        catch (Exception ex)
        {
            ErrorMessage = GetUserFriendlyErrorMessage(ex);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private static List<BindingFormModel> CreateBindingForms(AiModelCatalogOverviewDto overview)
    {
        return Enum.GetValues<AiModelUsage>()
            .Where(x => x != AiModelUsage.SubjectiveScoring)
            .Select(usage =>
            {
                var existing = overview.Bindings.FirstOrDefault(x => x.Usage == usage);
                var firstDeployment = overview.Deployments.FirstOrDefault(x => x.IsActive && x.Capability == (usage == AiModelUsage.KnowledgeEmbedding ? AiModelCapability.Embedding : AiModelCapability.Chat));
                var deploymentId = existing?.DeploymentId ?? firstDeployment?.Id ?? Guid.Empty;
                return new BindingFormModel
                {
                    Usage = usage,
                    OriginalDeploymentId = deploymentId,
                    DeploymentId = deploymentId,
                    BusinessModelVersion = existing?.BusinessModelVersion ?? (usage == AiModelUsage.TeachingPlanGeneration ? "2026-10-teaching-plan" : string.Empty),
                    MaxOutputTokens = existing?.MaxOutputTokens ?? (usage == AiModelUsage.KnowledgeEmbedding ? 0 : usage == AiModelUsage.TeachingPlanGeneration ? 4096 : 800),
                    Temperature = existing?.Temperature ?? 0.2,
                    FallbackAliasesText = existing == null ? string.Empty : string.Join(", ", existing.FallbackAliases)
                };
            })
            .ToList();
    }

