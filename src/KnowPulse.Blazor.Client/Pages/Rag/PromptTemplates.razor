@page "/rag/prompt-templates"
@attribute [Authorize(KnowPulsePermissions.QuestionBank.PromptTemplates)]
@inherits KnowPulseComponentBase
@inject IAiQuestionGenerationAppService AiQuestionGenerationAppService

<PageTitle>Prompt 模板版本库</PageTitle>

<div class="admin-page rag-admin-page">
    <header class="admin-page-header">
        <div><h1>Prompt 模板版本库</h1><p>查阅当前与历史模板，核对出题时使用的提示词版本。</p></div>
        <a class="kp-button kp-button--secondary" href="/rag/models">返回模型目录</a>
    </header>
    <RagAdminTabs Active="prompts" />

    @if (ErrorMessage is not null)
    {
        <div class="kp-alert kp-alert--error" role="alert">@ErrorMessage <button class="kp-button kp-button--sm kp-button--secondary" @onclick="LoadAsync" disabled="@IsLoading">重试</button></div>
    }

    <section class="admin-panel rag-admin-panel">
        <div class="rag-admin-panel-heading"><h2>模板版本</h2><span>只读查看 · 共 @TotalCount 条</span></div>
        <form class="admin-toolbar rag-admin-toolbar" @onsubmit="SearchAsync" @onsubmit:preventDefault>
            <div class="rag-admin-field rag-admin-search"><label for="prompt-keyword">模板 Key / 说明</label><input id="prompt-keyword" class="kp-input" @bind="Keyword" placeholder="搜索模板键、版本或说明" /></div>
            <div class="rag-admin-field"><label for="prompt-version">版本</label><input id="prompt-version" class="kp-input" @bind="Version" placeholder="全部版本" /></div>
            <div class="rag-admin-field"><label for="prompt-status">启用状态</label><select id="prompt-status" class="kp-select" @bind="ActiveFilter"><option value="">全部状态</option><option value="true">已启用</option><option value="false">已停用</option></select></div>
            <button class="kp-button kp-button--primary" type="submit" disabled="@IsLoading">查询</button>
            <button class="kp-button kp-button--secondary" type="button" @onclick="ResetAsync" disabled="@IsLoading">重置</button>
        </form>
        <div class="kp-table-wrap"><table class="kp-table rag-admin-table"><thead><tr><th>模板 / 版本</th><th>说明</th><th>状态</th><th>创建时间</th><th>操作</th></tr></thead><tbody>
            @if (IsLoading)
            {
                <tr><td colspan="5"><div class="rag-admin-empty" role="status"><span class="kp-spinner kp-spinner--sm" aria-hidden="true"></span> 正在加载模板版本</div></td></tr>
            }
            else if (Templates.Count == 0)
            {
                <tr><td colspan="5"><div class="rag-admin-empty"><strong>@(ErrorMessage is null ? "没有匹配的模板版本" : "暂时无法读取模板")</strong><p>@(ErrorMessage is null ? "调整关键词或清除筛选后再试。" : "筛选条件已保留，请重试。")</p></div></td></tr>
            }
            else
            {
                @foreach (var template in Templates)
                {
                    <tr class="@(SelectedTemplate?.Id == template.Id ? "is-selected" : null)"><td><strong>@template.TemplateKey</strong><small>@template.Version</small></td><td>@(template.Description ?? "—")</td><td><span class="rag-admin-badge @(template.IsActive ? "is-success" : "is-neutral")">@(template.IsActive ? "已启用" : "已停用")</span></td><td>@template.CreationTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td><td><button class="kp-button kp-button--link kp-button--sm" @onclick="() => SelectedTemplate = template">查看版本</button></td></tr>
                }
            }
        </tbody></table></div>
        <MvpPager SkipCount="SkipCount" PageSize="PageSize" TotalCount="TotalCount" IsBusy="IsLoading" OnSkipCountChanged="ChangePageAsync" />
        <p class="rag-admin-note">模板仅供版本审查与排障。本页不修改、发布或回滚模板。</p>
    </section>

    @if (SelectedTemplate is not null)
    {
        <section class="admin-panel rag-admin-panel">
            <div class="rag-admin-panel-heading"><h2>模板内容 · @SelectedTemplate.Version</h2><span>@SelectedTemplate.TemplateKey</span></div>
            <div class="rag-admin-content rag-admin-columns">
                <div><h3>System Prompt</h3><pre class="rag-admin-code">@SelectedTemplate.SystemPrompt</pre></div>
                <div><h3>User Prompt 模板</h3><pre class="rag-admin-code">@SelectedTemplate.UserPromptTemplate</pre></div>
            </div>
        </section>
    }
</div>

@code {
    private const int PageSize = 10;
    private IReadOnlyList<AiQuestionPromptTemplateDto> Templates { get; set; } = [];
    private AiQuestionPromptTemplateDto? SelectedTemplate { get; set; }
    private string? Keyword { get; set; }
    private string? Version { get; set; }
    private string? ActiveFilter { get; set; }
    private int SkipCount { get; set; }
    private long TotalCount { get; set; }
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task SearchAsync() { SkipCount = 0; return LoadAsync(); }
    private Task ChangePageAsync(int skipCount) { SkipCount = skipCount; return LoadAsync(); }
    private Task ResetAsync() { Keyword = null; Version = null; ActiveFilter = null; return SearchAsync(); }

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        SelectedTemplate = null;
        try
        {
            var result = await AiQuestionGenerationAppService.GetPromptTemplatesAsync(new GetAiQuestionPromptTemplateListInput
            {
                Keyword = Keyword?.Trim(),
                Version = Version?.Trim(),
                IsActive = bool.TryParse(ActiveFilter, out var active) ? active : null,
                SkipCount = SkipCount,
                MaxResultCount = PageSize
            });
            Templates = result.Items;
            TotalCount = result.TotalCount;
            SelectedTemplate = Templates.FirstOrDefault();
        }
        catch (Exception exception)
        {
            Templates = [];
            TotalCount = 0;
            ErrorMessage = GetUserFriendlyErrorMessage(exception);
        }
        finally { IsLoading = false; }
    }
}
