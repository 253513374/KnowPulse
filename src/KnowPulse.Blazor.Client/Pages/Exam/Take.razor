@page "/exam/take"
@attribute [Authorize(KnowPulsePermissions.Exam.Participate)]
@inherits KnowPulseComponentBase
@inject IExamAppService ExamAppService

<PageTitle>在线考试</PageTitle>

<div class="kp-flex kp-flex-wrap kp-align-center kp-justify-between kp-gap-2 kp-mb-3">
    <div>
        <h1 class="kp-heading-4 kp-mb-1">在线考试</h1>
        <div class="kp-text-muted kp-text-small">Exam / Take</div>
    </div>
    <button class="kp-button kp-button--secondary kp-button--sm" type="button" @onclick="LoadPlansAsync" disabled="@IsBusy">刷新</button>
</div>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="kp-alert kp-alert--error kp-flex kp-flex-wrap kp-align-center kp-justify-between kp-gap-2" role="alert">
        <span>@ErrorMessage</span>
        <button class="kp-button kp-button--sm kp-button--danger-outline" type="button" @onclick="RetrySaveAsync" disabled="@IsBusy">重试保存</button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(SaveStatus))
{
    <div class="kp-alert @SaveStatusCss" role="status">@SaveStatus</div>
}

<div class="kp-grid kp-grid-gap-3">
    <div class="kp-col-xl-4">
        <div class="kp-card">
            <div class="kp-table-wrap">
                <table class="kp-table kp-table--hover kp-table-align-middle kp-mb-0">
                    <thead>
                        <tr>
                            <th>可参加考试</th>
                            <th class="kp-text-end">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr>
                                <td colspan="2" class="kp-text-center kp-py-4 kp-text-muted">加载中</td>
                            </tr>
                        }
                        else if (PlanList.Count == 0)
                        {
                            <tr>
                                <td colspan="2" class="kp-text-center kp-py-4 kp-text-muted">暂无可参加考试</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var plan in PlanList)
                            {
                                <tr class="@(CurrentAttempt?.PlanId == plan.Id ? "kp-table-row--primary" : null)">
                                    <td>
                                        <div class="kp-text-semibold">@plan.Name</div>
                                        <div class="kp-text-small kp-text-muted">@plan.Paper?.QuestionCount 题 / @plan.DurationMinutes 分钟 / @plan.PassingScore 分及格</div>
                                    </td>
                                    <td class="kp-text-end">
                                        <button class="kp-button kp-button--primary kp-button--sm" type="button" @onclick="() => StartAsync(plan.Id)" disabled="@IsBusy">开始</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="kp-col-xl-8">
        @if (CurrentAttempt == null)
        {
            <div class="kp-card">
                <div class="kp-card__body kp-text-center kp-text-muted kp-py-5">请选择一场考试开始作答</div>
            </div>
        }
        else
        {
            <div class="kp-card kp-mb-3">
                <div class="kp-card__body">
                    <div class="kp-flex kp-flex-wrap kp-align-start kp-justify-between kp-gap-2">
                        <div>
                            <h2 class="kp-heading-5 kp-mb-1">@CurrentAttempt.Plan?.Name</h2>
                            <div class="kp-text-small kp-text-muted">
                                第 @CurrentAttempt.AttemptNumber 次 / @GetAttemptStatusText(CurrentAttempt.Status) / 剩余 @GetRemainingText()
                            </div>
                        </div>
                        @if (CurrentAttempt.Score != null)
                        {
                            <span class="kp-badge @(CurrentAttempt.Score.IsPassed ? "kp-bg-success" : "kp-bg-error")">
                                @CurrentAttempt.Score.ObtainedScore / @CurrentAttempt.Score.TotalScore
                            </span>
                        }
                    </div>
                </div>
            </div>

            <div class="kp-flex kp-flex-column kp-gap-3">
                @foreach (var question in CurrentAttempt.Paper?.Questions.OrderBy(x => x.DisplayOrder) ?? Enumerable.Empty<ExamPaperQuestionDto>())
                {
                    <div class="kp-card">
                        <div class="kp-card__body">
                            <div class="kp-flex kp-flex-wrap kp-align-start kp-justify-between kp-gap-2">
                                <div>
                                    <h3 class="kp-heading-6 kp-mb-1">@question.DisplayOrder. @question.Title</h3>
                                    <div class="kp-text-small kp-text-muted">@GetTypeText(question.Type) / @question.Score 分</div>
                                </div>
                                <span class="kp-badge @(IsAnswered(question.Id) ? "kp-bg-success" : "kp-bg-light kp-text-dark")">
                                    @(IsAnswered(question.Id) ? "已答" : "未答")
                                </span>
                            </div>

                            <p class="kp-mt-3">@question.Stem</p>

                            @if (question.Type == QuestionType.MultipleChoice)
                            {
                                <div class="kp-list kp-mb-2">
                                    @foreach (var option in question.Options.OrderBy(x => x.DisplayOrder))
                                    {
                                        <label class="kp-list__item">
                                            <input class="kp-check__input kp-me-2"
                                                   type="checkbox"
                                                   checked="@HasValue(question.Id, option.OptionKey)"
                                                   disabled="@IsSubmitted"
                                                   @onchange="async e => await ToggleMultiAnswerAsync(question, option.OptionKey, (bool?)e.Value == true)" />
                                            <span class="kp-text-semibold">@option.OptionKey.</span> @option.Content
                                        </label>
                                    }
                                </div>
                            }
                            else if (question.Type == QuestionType.SingleChoice)
                            {
                                <select class="kp-select" value="@GetFirstAnswer(question.Id)" disabled="@IsSubmitted" @onchange="async e => await SetSingleAnswerAsync(question, e.Value?.ToString())">
                                    <option value="">请选择</option>
                                    @foreach (var option in question.Options.OrderBy(x => x.DisplayOrder))
                                    {
                                        <option value="@option.OptionKey">@option.OptionKey. @option.Content</option>
                                    }
                                </select>
                            }
                            else if (question.Type == QuestionType.TrueFalse)
                            {
                                <select class="kp-select" value="@GetFirstAnswer(question.Id)" disabled="@IsSubmitted" @onchange="async e => await SetSingleAnswerAsync(question, e.Value?.ToString())">
                                    <option value="">请选择</option>
                                    <option value="true">对</option>
                                    <option value="false">错</option>
                                </select>
                            }
                            else
                            {
                                <input class="kp-input" value="@GetFirstAnswer(question.Id)" disabled="@IsSubmitted" @onchange="async e => await SetSingleAnswerAsync(question, e.Value?.ToString())" />
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="kp-flex kp-flex-wrap kp-gap-2 kp-mt-3">
                <button class="kp-button kp-button--primary-outline" type="button" @onclick="SaveAllAsync" disabled="@(IsBusy || IsSubmitted)">手动保存</button>
                <button class="kp-button kp-button--primary" type="button" @onclick="SubmitAsync" disabled="@(IsBusy || IsSubmitted)">提交试卷</button>
            </div>
        }
    </div>
</div>

@code {
    private const int PageSize = 20;
    private readonly List<ExamPlanDto> PlanList = new();
    private readonly Dictionary<Guid, List<string>> Answers = new();
    private readonly Dictionary<Guid, int> AnswerVersions = new();
    private ExamAttemptDto? CurrentAttempt { get; set; }
    private SaveExamAnswersDto? LastSaveInput { get; set; }
    private bool IsBusy { get; set; }
    private bool IsLoading { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SaveStatus { get; set; }
    private string SaveStatusCss { get; set; } = "kp-alert--info";
    private bool IsSubmitted => CurrentAttempt?.Status is ExamAttemptStatus.Submitted or ExamAttemptStatus.Scored or ExamAttemptStatus.Expired or ExamAttemptStatus.Cancelled;

    protected override async Task OnInitializedAsync()
    {
        await LoadPlansAsync();
    }

    private async Task LoadPlansAsync()
    {
        await RunBusyAsync(async () =>
        {
            IsLoading = true;
            var result = await ExamAppService.GetMyPlanListAsync(new GetExamPlanListInput { MaxResultCount = PageSize });
            PlanList.Clear();
            PlanList.AddRange(result.Items);
        });
    }

    private async Task StartAsync(Guid planId)
    {
        await RunBusyAsync(async () =>
        {
            CurrentAttempt = await ExamAppService.StartAttemptAsync(planId);
            LoadAnswersFromAttempt();
            SetSaveStatus("考试已开始，已恢复服务端保存的答案。", "kp-alert--info");
        });
    }

    private async Task SetSingleAnswerAsync(ExamPaperQuestionDto question, string? value)
    {
        Answers[question.Id] = string.IsNullOrWhiteSpace(value) ? new List<string>() : new List<string> { value.Trim() };
        await SaveQuestionAsync(question.Id);
    }

    private async Task ToggleMultiAnswerAsync(ExamPaperQuestionDto question, string value, bool isChecked)
    {
        if (!Answers.TryGetValue(question.Id, out var values))
        {
            values = new List<string>();
            Answers[question.Id] = values;
        }

        if (isChecked && !values.Contains(value, StringComparer.OrdinalIgnoreCase))
        {
            values.Add(value);
        }
        else if (!isChecked)
        {
            values.RemoveAll(x => x.Equals(value, StringComparison.OrdinalIgnoreCase));
        }

        await SaveQuestionAsync(question.Id);
    }

    private async Task SaveQuestionAsync(Guid paperQuestionId)
    {
        if (CurrentAttempt == null || IsSubmitted)
        {
            return;
        }

        await SaveAsync(new List<Guid> { paperQuestionId });
    }

    private async Task SaveAllAsync()
    {
        if (CurrentAttempt == null)
        {
            return;
        }

        await SaveAsync(CurrentAttempt.Paper?.Questions.Select(x => x.Id).ToList() ?? new List<Guid>());
    }

    private async Task RetrySaveAsync()
    {
        if (CurrentAttempt == null || LastSaveInput == null)
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            SetSaveStatus("保存中...", "kp-alert--info");
            CurrentAttempt = await ExamAppService.SaveAnswersAsync(CurrentAttempt.Id, LastSaveInput);
            LoadAnswersFromAttempt();
            SetSaveStatus("已保存", "kp-alert--success");
        });
    }

    private async Task SaveAsync(List<Guid> questionIds)
    {
        if (CurrentAttempt == null)
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            SetSaveStatus("保存中...", "kp-alert--info");
            await PersistAnswersAsync(BuildSaveInput(questionIds));
            SetSaveStatus("已保存", "kp-alert--success");
        });
    }

    private async Task SubmitAsync()
    {
        if (CurrentAttempt == null)
        {
            return;
        }

        var unanswered = CurrentAttempt.Paper?.Questions.Count(x => !IsAnswered(x.Id)) ?? 0;
        if (!await Message.Confirm($"还有 {unanswered} 题未答，确定提交吗？"))
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            SetSaveStatus("保存中...", "kp-alert--info");
            await PersistAnswersAsync(BuildSaveInput(CurrentAttempt.Paper?.Questions.Select(x => x.Id).ToList() ?? new List<Guid>()));
            CurrentAttempt = await ExamAppService.SubmitAttemptAsync(CurrentAttempt.Id, new SubmitExamAttemptDto
            {
                IdempotencyKey = Guid.NewGuid().ToString("N")
            });
            LoadAnswersFromAttempt();
            SetSaveStatus("试卷已提交并完成客观题评分。", "kp-alert--success");
        });
    }

    private SaveExamAnswersDto BuildSaveInput(List<Guid> questionIds)
    {
        return new SaveExamAnswersDto
        {
            IdempotencyKey = Guid.NewGuid().ToString("N"),
            Answers = questionIds.Select(id => new SaveExamAnswerItemDto
            {
                PaperQuestionId = id,
                Values = Answers.TryGetValue(id, out var values) ? values : new List<string>(),
                ClientVersion = AnswerVersions.TryGetValue(id, out var version) ? version + 1 : 1
            }).ToList()
        };
    }

    private async Task PersistAnswersAsync(SaveExamAnswersDto input)
    {
        if (CurrentAttempt == null)
        {
            return;
        }

        LastSaveInput = input;
        CurrentAttempt = await ExamAppService.SaveAnswersAsync(CurrentAttempt.Id, input);
        LoadAnswersFromAttempt();
    }

    private void LoadAnswersFromAttempt()
    {
        Answers.Clear();
        AnswerVersions.Clear();
        if (CurrentAttempt == null)
        {
            return;
        }

        foreach (var answer in CurrentAttempt.Answers)
        {
            Answers[answer.PaperQuestionId] = answer.Values.ToList();
            AnswerVersions[answer.PaperQuestionId] = answer.SaveVersion;
        }
    }

    private async Task RunBusyAsync(Func<Task> action)
    {
        try
        {
            ErrorMessage = null;
            IsBusy = true;
            await action();
        }
        catch (Exception ex)
        {
            ErrorMessage = GetUserFriendlyErrorMessage(ex);
            SetSaveStatus("保存失败，请重试。", "kp-alert--error");
        }
        finally
        {
            IsBusy = false;
            IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SetSaveStatus(string message, string css)
    {
        SaveStatus = message;
        SaveStatusCss = css;
    }

    private bool IsAnswered(Guid questionId)
    {
        return Answers.TryGetValue(questionId, out var values) && values.Any(x => !string.IsNullOrWhiteSpace(x));
    }

    private bool HasValue(Guid questionId, string value)
    {
        return Answers.TryGetValue(questionId, out var values) && values.Contains(value, StringComparer.OrdinalIgnoreCase);
    }

    private string GetFirstAnswer(Guid questionId)
    {
        return Answers.TryGetValue(questionId, out var values) ? values.FirstOrDefault() ?? string.Empty : string.Empty;
    }

    private string GetRemainingText()
    {
        if (CurrentAttempt == null)
        {
            return "-";
        }

        if (!CurrentAttempt.ExpiresTime.HasValue) return "不限时";
        var remaining = CurrentAttempt.ExpiresTime.Value - DateTime.UtcNow;
        if (remaining <= TimeSpan.Zero)
        {
            return "已到期";
        }

        return $"{(int)remaining.TotalMinutes:D2}:{remaining.Seconds:D2}";
    }

    private static string GetTypeText(QuestionType type) => type switch
    {
        QuestionType.SingleChoice => "单选",
        QuestionType.MultipleChoice => "多选",
        QuestionType.TrueFalse => "判断",
        QuestionType.FillBlank => "填空",
        _ => type.ToString()
    };

    private static string GetAttemptStatusText(ExamAttemptStatus status) => status switch
    {
        ExamAttemptStatus.NotStarted => "未开始",
        ExamAttemptStatus.InProgress => "进行中",
        ExamAttemptStatus.Submitted => "已提交",
        ExamAttemptStatus.Scored => "已评分",
        ExamAttemptStatus.Expired => "已过期",
        ExamAttemptStatus.Cancelled => "已取消",
        _ => status.ToString()
    };
}
