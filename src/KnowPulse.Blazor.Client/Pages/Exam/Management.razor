@page "/exam/management"
@attribute [Authorize(KnowPulsePermissions.Exam.Manage)]
@inherits KnowPulseComponentBase
@inject IExamAppService Exams
@using KnowPulse.Blazor.Client.Pages.Teaching

<PageTitle>考试任务管理 · 平台管理</PageTitle>

<div class="admin-page">
    <header class="admin-page-header">
        <div>
            <h1>考试任务管理</h1>
            <p class="kp-text-muted">查看本人创建及可维护的历史计划，跟踪学生作答与结果。</p>
        </div>
        <a class="kp-button kp-button--primary" href="/exam/management/new">创建考试计划</a>
    </header>

    @if (_error is not null)
    {
        <div class="kp-alert kp-alert--error" role="alert">
            <span>@_error</span>
            <button class="kp-button kp-button--secondary" type="button" @onclick="LoadAsync" disabled="_busy">重新加载</button>
        </div>
    }

    <section class="admin-panel">
        <div class="kp-flex kp-flex-wrap kp-align-center kp-justify-between kp-gap-2">
            <h2>考试计划</h2>
            <span class="kp-text-muted kp-text-small">发布时固定试题与接收名单</span>
        </div>
        <form class="admin-toolbar" @onsubmit="SearchAsync" @onsubmit:preventDefault>
            <div class="exam-search-field">
                <label class="kp-label" for="exam-keyword">搜索计划</label>
                <input id="exam-keyword" class="kp-input" placeholder="计划名称 / 说明" @bind="_keyword" @bind:event="oninput" disabled="_busy" />
            </div>
            <div class="exam-status-field">
                <label class="kp-label" for="exam-status">计划状态</label>
                <select id="exam-status" class="kp-select" @bind="_status" disabled="_busy">
                    <option value="">全部状态</option>
                    <option value="@ExamPlanStatus.Draft">草稿</option>
                    <option value="@ExamPlanStatus.Published">已发布</option>
                    <option value="@ExamPlanStatus.Cancelled">已取消</option>
                </select>
            </div>
            <button class="kp-button kp-button--primary" type="submit" disabled="_busy">查询</button>
            <button class="kp-button kp-button--secondary" type="button" @onclick="ResetAsync" disabled="_busy">重置</button>
        </form>

        <div class="kp-table-wrap">
            <table class="kp-table kp-table--hover kp-table-align-middle">
                <thead>
                    <tr><th>考试计划</th><th>试卷 / 题量</th><th>接收人数</th><th>可作答时间</th><th>状态</th><th>操作</th></tr>
                </thead>
                <tbody>
                    @if (_busy)
                    {
                        <tr><td colspan="6" class="kp-text-center kp-py-5" role="status">正在加载考试计划</td></tr>
                    }
                    else if (_error is not null)
                    {
                        <tr><td colspan="6" class="kp-text-center kp-py-5">考试计划暂时无法加载，请保留筛选条件重试。</td></tr>
                    }
                    else if (_plans.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="kp-text-center kp-py-5">
                                <strong>@(string.IsNullOrWhiteSpace(_keyword) && !_status.HasValue ? "还没有考试计划" : "没有符合条件的考试计划")</strong>
                                <p class="kp-text-muted">可以调整筛选条件，或选择已确认的题目创建一份计划。</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var plan in _plans)
                        {
                            <tr>
                                <td><strong>@plan.Name</strong><p class="kp-text-muted kp-text-small">@plan.Description</p></td>
                                <td>@plan.Paper?.Title<p class="kp-text-muted kp-text-small">@(plan.Paper?.QuestionCount ?? 0) 题 / @(plan.Paper?.TotalScore ?? 0) 分</p></td>
                                <td>@RecipientText(plan)</td>
                                <td class="kp-text-small">@(plan.StartTime.HasValue ? TeacherTime.FormatExamUtc(plan.StartTime.Value) : "发布即可参加")<p class="kp-text-muted">@(plan.EndTime.HasValue ? TeacherTime.FormatExamUtc(plan.EndTime.Value) : "无截止时间")</p></td>
                                <td><span class="kp-badge @StatusClass(plan.Status)">@StatusText(plan.Status)</span></td>
                                <td><a class="kp-button kp-button--link" href="@($"/exam/management/{plan.Id}/results")">查看结果</a></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <MvpPager SkipCount="_skip" PageSize="PageSize" TotalCount="_total" IsBusy="_busy" OnSkipCountChanged="ChangePageAsync" />
        <p class="kp-text-muted kp-text-small">仅展示当前账号可管理的计划；其他教师的任务与成绩不在此范围。</p>
    </section>
</div>

@code {
    private const int PageSize = 20;
    private IReadOnlyList<ExamPlanDto> _plans = [];
    private string? _keyword, _error;
    private ExamPlanStatus? _status;
    private int _skip;
    private long _total;
    private bool _busy;

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task SearchAsync()
    {
        _skip = 0;
        return LoadAsync();
    }

    private Task ResetAsync()
    {
        _keyword = null;
        _status = null;
        return SearchAsync();
    }

    private Task ChangePageAsync(int skip)
    {
        _skip = skip;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var result = await Exams.GetPlanListAsync(new GetExamPlanListInput
            {
                Keyword = _keyword,
                Status = _status,
                SkipCount = _skip,
                MaxResultCount = PageSize
            });
            _plans = result.Items;
            _total = result.TotalCount;
        }
        catch (Exception ex)
        {
            _error = GetUserFriendlyErrorMessage(ex);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string RecipientText(ExamPlanDto plan) => plan.Assignments.Any(x => x.IsActive && x.ScopeType != ExamAssignmentScopeType.User)
        ? "历史分配范围"
        : $"{plan.Assignments.Count(x => x.IsActive && x.ScopeType == ExamAssignmentScopeType.User)} 人";

    private static string StatusText(ExamPlanStatus status) => status switch
    {
        ExamPlanStatus.Draft => "草稿",
        ExamPlanStatus.Published => "已发布",
        ExamPlanStatus.Cancelled => "已取消",
        _ => status.ToString()
    };

    private static string StatusClass(ExamPlanStatus status) => status switch
    {
        ExamPlanStatus.Published => "kp-bg-success",
        ExamPlanStatus.Cancelled => "kp-bg-secondary",
        _ => "kp-bg-info"
    };
}
