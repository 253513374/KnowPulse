@page "/organization/positions"
@attribute [Authorize(KnowPulsePermissions.Organization.Positions)]
@inherits KnowPulseComponentBase
@inject IPositionAppService PositionAppService
@inject IDepartmentAppService DepartmentAppService

<PageTitle>岗位</PageTitle>

<div class="kp-flex kp-flex-wrap kp-align-center kp-justify-between kp-gap-2 kp-mb-3">
    <div>
        <h1 class="kp-heading-4 kp-mb-1">岗位</h1>
        <div class="kp-text-muted kp-text-small">Organization / Positions</div>
    </div>
    <button class="kp-button kp-button--secondary kp-button--sm" type="button" @onclick="LoadAsync" disabled="@IsBusy">刷新</button>
</div>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="kp-alert kp-alert--error kp-flex kp-flex-wrap kp-align-center kp-justify-between kp-gap-2" role="alert">
        <span>@ErrorMessage</span>
        <button class="kp-button kp-button--sm kp-button--danger-outline" type="button" @onclick="LoadAsync" disabled="@IsBusy">重试</button>
    </div>
}

<div class="kp-grid kp-grid-gap-3">
    <div class="kp-col-lg-4">
        <div class="kp-card">
            <div class="kp-card__body">
                <h2 class="kp-heading-6 kp-mb-3">@FormTitle</h2>
                <EditForm Model="@FormModel" OnValidSubmit="@SaveAsync">
                    <DataAnnotationsValidator />

                    <div class="kp-mb-3">
                        <label class="kp-label" for="position-code">编码</label>
                        <input id="position-code" class="kp-input" @bind="FormModel.Code" @bind:event="oninput" />
                    </div>

                    <div class="kp-mb-3">
                        <label class="kp-label" for="position-name">名称</label>
                        <input id="position-name" class="kp-input" @bind="FormModel.Name" @bind:event="oninput" />
                    </div>

                    <div class="kp-mb-3">
                        <label class="kp-label" for="position-department">所属部门</label>
                        <select id="position-department" class="kp-select" @bind="FormModel.DepartmentIdText">
                            <option value="">未指定</option>
                            @foreach (var department in DepartmentList)
                            {
                                <option value="@department.Id">@department.Name</option>
                            }
                        </select>
                    </div>

                    <div class="kp-mb-3">
                        <label class="kp-label" for="position-security">安全等级</label>
                        <InputNumber id="position-security" class="kp-input" @bind-Value="FormModel.SecurityLevel" />
                    </div>

                    <div class="kp-check kp-switch kp-mb-3">
                        <InputCheckbox id="position-active" class="kp-check__input" @bind-Value="FormModel.IsActive" />
                        <label class="kp-check__label" for="position-active">启用</label>
                    </div>

                    <div class="kp-flex kp-gap-2">
                        <button class="kp-button kp-button--primary" type="submit" disabled="@IsBusy">保存</button>
                        <button class="kp-button kp-button--secondary" type="button" @onclick="ResetForm" disabled="@IsBusy">取消</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>

    <div class="kp-col-lg-8">
        <div class="kp-card">
            <div class="kp-table-wrap">
                <table class="kp-table kp-table--hover kp-table-align-middle kp-mb-0">
                    <thead>
                        <tr>
                            <th>编码</th>
                            <th>名称</th>
                            <th>部门</th>
                            <th>安全等级</th>
                            <th>状态</th>
                            <th class="kp-text-end">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr>
                                <td colspan="6" class="kp-text-center kp-py-4 kp-text-muted">加载中</td>
                            </tr>
                        }
                        else if (PositionList.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="kp-text-center kp-py-4 kp-text-muted">暂无数据</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var position in PositionList)
                            {
                                <tr>
                                    <td class="kp-text-semibold">@position.Code</td>
                                    <td>@position.Name</td>
                                    <td>@GetDepartmentName(position.DepartmentId)</td>
                                    <td>@position.SecurityLevel</td>
                                    <td>
                                        <span class="kp-badge @(position.IsActive ? "kp-bg-success" : "kp-bg-secondary")">
                                            @(position.IsActive ? "启用" : "停用")
                                        </span>
                                    </td>
                                    <td class="kp-text-end">
                                        <button class="kp-button kp-button--link kp-button--sm" type="button" @onclick="() => Edit(position)">编辑</button>
                                        <button class="kp-button kp-button--link kp-button--sm kp-text-danger" type="button" @onclick="() => DeleteAsync(position.Id)">删除</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <MvpPager SkipCount="SkipCount" PageSize="PageSize" TotalCount="TotalCount" IsBusy="IsBusy" OnSkipCountChanged="ChangePageAsync" />
        </div>
    </div>
</div>

@code {
    private const int PageSize = 20;
    private readonly List<PositionDto> PositionList = new();
    private readonly List<DepartmentDto> DepartmentList = new();
    private PositionFormModel FormModel { get; set; } = new();
    private Guid? EditingId { get; set; }
    private int SkipCount { get; set; }
    private long TotalCount { get; set; }
    private bool IsLoading { get; set; }
    private bool IsBusy { get; set; }
    private string? ErrorMessage { get; set; }
    private string FormTitle => EditingId.HasValue ? "编辑岗位" : "新增岗位";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await RunBusyAsync(async () =>
        {
            IsLoading = true;
            var departments = await DepartmentAppService.GetListAsync(new PagedAndSortedResultRequestDto { MaxResultCount = 100 });
            var positions = await PositionAppService.GetListAsync(new PagedAndSortedResultRequestDto
            {
                SkipCount = SkipCount,
                MaxResultCount = PageSize
            });

            DepartmentList.Clear();
            DepartmentList.AddRange(departments.Items.OrderBy(x => x.Code));
            PositionList.Clear();
            PositionList.AddRange(positions.Items.OrderBy(x => x.Code));
            TotalCount = positions.TotalCount;
            IsLoading = false;
        });
    }

    private async Task ChangePageAsync(int skipCount)
    {
        SkipCount = skipCount;
        await LoadAsync();
    }

    private async Task SaveAsync()
    {
        await RunBusyAsync(async () =>
        {
            var input = new CreateUpdatePositionDto
            {
                DepartmentId = ParseNullableGuid(FormModel.DepartmentIdText),
                Code = FormModel.Code.Trim(),
                Name = FormModel.Name.Trim(),
                SecurityLevel = FormModel.SecurityLevel,
                IsActive = FormModel.IsActive
            };

            if (EditingId.HasValue)
            {
                await PositionAppService.UpdateAsync(EditingId.Value, input);
            }
            else
            {
                await PositionAppService.CreateAsync(input);
            }

            ResetForm();
            await LoadAsync();
        });
    }

    private void Edit(PositionDto position)
    {
        EditingId = position.Id;
        FormModel = new PositionFormModel
        {
            DepartmentIdText = position.DepartmentId?.ToString() ?? string.Empty,
            Code = position.Code,
            Name = position.Name,
            SecurityLevel = position.SecurityLevel,
            IsActive = position.IsActive
        };
    }

    private async Task DeleteAsync(Guid id)
    {
        await RunBusyAsync(async () =>
        {
            await PositionAppService.DeleteAsync(id);
            if (EditingId == id)
            {
                ResetForm();
            }
            await LoadAsync();
        });
    }

    private void ResetForm()
    {
        EditingId = null;
        FormModel = new PositionFormModel();
    }

    private string GetDepartmentName(Guid? id)
    {
        if (id == null)
        {
            return "-";
        }

        return DepartmentList.FirstOrDefault(x => x.Id == id.Value)?.Name ?? id.Value.ToString("N");
    }

    private static Guid? ParseNullableGuid(string? value)
    {
        return Guid.TryParse(value, out var id) ? id : null;
    }

    private async Task RunBusyAsync(Func<Task> action)
    {
        try
        {
            ErrorMessage = null;
            IsBusy = true;
            await action();
        }
        catch (Exception ex)
        {
            ErrorMessage = GetUserFriendlyErrorMessage(ex);
        }
        finally
        {
            IsBusy = false;
            IsLoading = false;
        }
    }

    private class PositionFormModel
    {
        public string? DepartmentIdText { get; set; }

        [Required]
        [StringLength(64)]
        public string Code { get; set; } = string.Empty;

        [Required]
        [StringLength(128)]
        public string Name { get; set; } = string.Empty;

        [Range(0, int.MaxValue)]
        public int SecurityLevel { get; set; }

        public bool IsActive { get; set; } = true;
    }
}
