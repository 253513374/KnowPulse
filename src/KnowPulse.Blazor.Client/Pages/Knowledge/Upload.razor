@page "/knowledge/upload"
@attribute [Authorize(KnowPulsePermissions.KnowledgeBase.Items)]
@inherits KnowPulseComponentBase
@using System.IO
@inject IKnowledgeItemAppService KnowledgeItemAppService
@inject IKnowledgeCategoryAppService CategoryAppService
@inject IKnowledgeIndexJobAppService IndexJobAppService
@inject IPermissionChecker PermissionChecker
@inject NavigationManager NavigationManager

@* 知识上传引导页：面向运营人员完成从内容选择、可见范围确认到发布索引的主流程。 *@
<PageTitle>上传知识</PageTitle>

<div class="admin-page knowledge-upload-page">
<header class="admin-page-header">
    <div>
        <h1>上传知识@(CurrentStep == UploadStep.Publish ? " · 发布确认" : string.Empty)</h1>
        <div class="kp-text-muted kp-text-small">确认内容、访问范围和版本。发布后会继续处理索引。</div>
    </div>
    <div class="kp-flex kp-flex-wrap kp-gap-2">
        <button class="kp-button kp-button--secondary kp-button--sm" type="button" @onclick="ViewAdvanced" disabled="@IsBusy">知识管理</button>
        <button class="kp-button kp-button--secondary kp-button--sm" type="button" @onclick="ResetWizard" disabled="@IsBusy">重新开始</button>
    </div>
</header>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="kp-alert kp-alert--error kp-flex kp-flex-wrap kp-align-center kp-justify-between kp-gap-2" role="alert">
        <span>@ErrorMessage</span>
        <button class="kp-button kp-button--sm kp-button--danger-outline" type="button" @onclick="ClearError" disabled="@IsBusy">知道了</button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(LookupWarningMessage))
{
    <div class="kp-alert kp-alert--warning" role="status">@LookupWarningMessage</div>
}

@if (!HasRequiredWritePermissions)
{
    <div class="kp-alert kp-alert--warning" role="status">
        当前账号缺少知识版本或访问策略权限，可以预览流程，无法保存草稿或发布知识。
    </div>
}

<div class="knowledge-upload-flow kp-mb-3" aria-label="知识上传流程">
    <div class="knowledge-flow-step @GetStepClass(UploadStep.Content)">
        <div class="knowledge-flow-index">1</div>
        <div>
            <div class="knowledge-flow-title">内容来源</div>
            <div class="knowledge-flow-meta">@ContentStepSummary</div>
        </div>
    </div>
    <div class="knowledge-flow-step @GetStepClass(UploadStep.Info)">
        <div class="knowledge-flow-index">2</div>
        <div>
            <div class="knowledge-flow-title">基础信息</div>
            <div class="knowledge-flow-meta">@InfoStepSummary</div>
        </div>
    </div>
    <div class="knowledge-flow-step @GetStepClass(UploadStep.Visibility)">
        <div class="knowledge-flow-index">3</div>
        <div>
            <div class="knowledge-flow-title">可见范围</div>
            <div class="knowledge-flow-meta">@VisibilityStepSummary</div>
        </div>
    </div>
    <div class="knowledge-flow-step @GetStepClass(UploadStep.Publish)">
        <div class="knowledge-flow-index">4</div>
        <div>
            <div class="knowledge-flow-title">发布确认</div>
            <div class="knowledge-flow-meta">@PublishStepSummary</div>
        </div>
    </div>
    <div class="knowledge-flow-step @GetStepClass(UploadStep.Result)">
        <div class="knowledge-flow-index">5</div>
        <div>
            <div class="knowledge-flow-title">结果处理</div>
            <div class="knowledge-flow-meta">@ResultStepSummary</div>
        </div>
    </div>
</div>

<div class="kp-grid kp-grid-gap-3 knowledge-upload-grid">
    <div class="kp-col-xl-8">
        <div class="admin-panel kp-card">
            <div class="kp-card__body">
                @if (IsLoading)
                {
                    <div class="kp-text-center kp-py-5 kp-text-muted">加载中</div>
                }
                else if (CurrentStep == UploadStep.Content)
                {
                    <div class="kp-flex kp-flex-wrap kp-align-start kp-justify-between kp-gap-2 kp-mb-3">
                        <div>
                            <h2 class="kp-heading-5 kp-mb-1">选择内容来源</h2>
                            <div class="kp-text-muted kp-text-small">正文、文本和可转换文档会进入 RAG；图片、音视频等高级解析文件先作为附件保存。</div>
                        </div>
                    </div>

                    <div class="kp-grid kp-grid-gap-3 kp-mb-3">
                        <div class="kp-col-md-3">
                            <label class="@GetChoiceCss(UploadSourceMode.BodyText)" for="source-body">
                                <div class="kp-check">
                                    <input id="source-body" class="kp-check__input" type="radio" name="source-mode" checked="@(SourceMode == UploadSourceMode.BodyText)" @onchange="() => SelectSourceMode(UploadSourceMode.BodyText)" />
                                    <span class="kp-check__label kp-text-semibold">正文输入</span>
                                </div>
                                <div class="kp-text-muted kp-text-small kp-mt-2">直接粘贴制度、流程、FAQ 或说明文本。</div>
                                <span class="kp-badge kp-bg-success kp-mt-3">可索引内容</span>
                            </label>
                        </div>
                        <div class="kp-col-md-3">
                            <label class="@GetChoiceCss(UploadSourceMode.IndexableFile)" for="source-indexable">
                                <div class="kp-check">
                                    <input id="source-indexable" class="kp-check__input" type="radio" name="source-mode" checked="@(SourceMode == UploadSourceMode.IndexableFile)" @onchange="() => SelectSourceMode(UploadSourceMode.IndexableFile)" />
                                    <span class="kp-check__label kp-text-semibold">文本或 Markdown</span>
                                </div>
                                <div class="kp-text-muted kp-text-small kp-mt-2">支持 .txt、.md、.markdown，由后端读取附件内容。</div>
                                <span class="kp-badge kp-bg-success kp-mt-3">直接索引</span>
                            </label>
                        </div>
                        <div class="kp-col-md-3">
                            <label class="@GetChoiceCss(UploadSourceMode.ConvertibleFile)" for="source-convertible">
                                <div class="kp-check">
                                    <input id="source-convertible" class="kp-check__input" type="radio" name="source-mode" checked="@(SourceMode == UploadSourceMode.ConvertibleFile)" @onchange="() => SelectSourceMode(UploadSourceMode.ConvertibleFile)" />
                                    <span class="kp-check__label kp-text-semibold">文档转换</span>
                                </div>
                                <div class="kp-text-muted kp-text-small kp-mt-2">支持 PDF、Word、PPT、Excel、HTML、CSV、JSON、XML。</div>
                                <span class="kp-badge kp-bg-info kp-text-dark kp-mt-3">转换后索引</span>
                            </label>
                        </div>
                        <div class="kp-col-md-3">
                            <label class="@GetChoiceCss(UploadSourceMode.AttachmentOnly)" for="source-attachment">
                                <div class="kp-check">
                                    <input id="source-attachment" class="kp-check__input" type="radio" name="source-mode" checked="@(SourceMode == UploadSourceMode.AttachmentOnly)" @onchange="() => SelectSourceMode(UploadSourceMode.AttachmentOnly)" />
                                    <span class="kp-check__label kp-text-semibold">附件留存</span>
                                </div>
                                <div class="kp-text-muted kp-text-small kp-mt-2">图片、音视频、压缩包和其他文件仅保存为附件。</div>
                                <span class="kp-badge kp-bg-warning kp-text-dark kp-mt-3">仅附件内容</span>
                            </label>
                        </div>
                    </div>

                    @if (SourceMode == UploadSourceMode.BodyText)
                    {
                        <div class="kp-mb-3">
                            <label class="kp-label" for="upload-body">正文内容</label>
                            <textarea id="upload-body" class="kp-input" rows="12" maxlength="@MaxContentTextLength" @bind="Form.ContentText" @bind:event="oninput" disabled="@IsBusy"></textarea>
                            <div class="kp-help">@GetTextLengthText(Form.ContentText, MaxContentTextLength)</div>
                        </div>
                    }
                    else
                    {
                        <div class="kp-mb-3">
                            <label class="kp-label" for="upload-file">选择文件</label>
                            <InputFile id="upload-file" class="kp-input" OnChange="@OnFileSelected" disabled="@IsBusy" />
                            <div class="kp-help">@FileHelpText</div>
                        </div>

                        @if (SourceMode == UploadSourceMode.IndexableFile)
                        {
                            <div class="kp-alert kp-alert--info kp-mb-0" role="status">
                                文本或 Markdown 文件会作为附件保存，并在索引阶段直接读取为 Markdown 内容。
                            </div>
                        }
                        else if (SourceMode == UploadSourceMode.ConvertibleFile)
                        {
                            <div class="kp-alert kp-alert--info kp-mb-0" role="status">
                                该文件会作为附件保存，并在索引阶段通过 MarkItDown 转换为 Markdown。若服务端未配置 markitdown，可在结果页看到 reader 阶段失败原因。
                            </div>
                        }
                        else
                        {
                            <div class="kp-alert kp-alert--warning kp-mb-0" role="status">
                                该模式不会把附件内容写入知识正文，也不会参与 RAG 检索。发布后用户只能在知识管理中查看附件。
                            </div>
                        }
                    }

                    <div class="kp-flex kp-flex-wrap kp-justify-end kp-gap-2 kp-mt-4">
                        <button class="kp-button kp-button--primary" type="button" @onclick="GoNext" disabled="@IsBusy">下一步</button>
                    </div>
                }
                else if (CurrentStep == UploadStep.Info)
                {
                    <div class="kp-mb-3">
                        <h2 class="kp-heading-5 kp-mb-1">填写基础信息</h2>
                        <div class="kp-text-muted kp-text-small">标题用于列表和问答引用，版本标题用于本次内容变更记录。</div>
                    </div>

                    <div class="kp-mb-3">
                        <label class="kp-label" for="upload-title">知识标题</label>
                        <input id="upload-title" class="kp-input" maxlength="@MaxTitleLength" @bind="Form.Title" @bind:event="oninput" disabled="@IsBusy" />
                        <div class="kp-help">@GetTextLengthText(Form.Title, MaxTitleLength)</div>
                    </div>

                    <div class="kp-mb-3">
                        <label class="kp-label" for="upload-category">分类</label>
                        <select id="upload-category" class="kp-select" @bind="Form.CategoryIdText" disabled="@(IsBusy || CategoryList.Count == 0)">
                            <option value="">未分类</option>
                            @foreach (var category in CategoryList)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                        @if (CategoryList.Count == 0)
                        {
                            <div class="kp-help">当前没有可选择分类，上传后会保存为未分类。</div>
                        }
                    </div>

                    <div class="kp-mb-3">
                        <label class="kp-label" for="upload-summary">摘要</label>
                        <textarea id="upload-summary" class="kp-input" rows="4" maxlength="@MaxSummaryLength" @bind="Form.Summary" @bind:event="oninput" disabled="@IsBusy"></textarea>
                        <div class="kp-help">@GetTextLengthText(Form.Summary, MaxSummaryLength)</div>
                    </div>

                    <div class="kp-mb-3">
                        <label class="kp-label" for="upload-version-title">版本标题</label>
                        <input id="upload-version-title" class="kp-input" maxlength="@MaxTitleLength" @bind="Form.VersionTitle" @bind:event="oninput" disabled="@IsBusy" />
                    </div>

                    <div class="kp-flex kp-flex-wrap kp-justify-between kp-gap-2 kp-mt-4">
                        <button class="kp-button kp-button--secondary" type="button" @onclick="GoBack" disabled="@IsBusy">上一步</button>
                        <button class="kp-button kp-button--primary" type="button" @onclick="GoNext" disabled="@IsBusy">下一步</button>
                    </div>
                }
                else if (CurrentStep == UploadStep.Visibility)
                {
                    <h2 class="kp-heading-5 kp-mb-1">确认可见范围</h2>
                    <p class="kp-text-muted">新资料默认仅自己可见。可以另外授予有效教师读取和出题使用权。</p>
                    <div class="knowledge-visibility-options">
                        <label class="knowledge-upload-choice @(!ShareWithTeachers ? "is-selected" : null)">
                            <input class="kp-check__input" type="radio" name="visibility-mode" checked="@(!ShareWithTeachers)" @onchange="() => ShareWithTeachers = false" disabled="@IsBusy" />
                            <strong>仅自己</strong><span>资料原件由当前账号维护。</span>
                        </label>
                        <label class="knowledge-upload-choice @(ShareWithTeachers ? "is-selected" : null)">
                            <input class="kp-check__input" type="radio" name="visibility-mode" checked="@ShareWithTeachers" @onchange="() => ShareWithTeachers = true" disabled="@(IsBusy || !CanUseRestrictedScopes)" />
                            <strong>指定教师可见</strong><span>共享对象可以读取当前发布版并用于出题。</span>
                        </label>
                    </div>
                    @if (ShareWithTeachers)
                    {
                        <div class="admin-toolbar kp-mt-3">
                            <div class="knowledge-teacher-search"><label class="kp-label" for="upload-teacher-filter">搜索有效教师</label><input id="upload-teacher-filter" class="kp-input" @bind="TeacherFilterText" @bind:event="oninput" disabled="@IsBusy" /></div>
                            <button class="kp-button kp-button--secondary" type="button" @onclick="SearchTeachersAsync" disabled="@IsBusy">查找</button>
                        </div>
                        <div class="knowledge-teacher-options">
                            @foreach (var teacher in TeacherList)
                            {
                                <label class="kp-check"><input class="kp-check__input" type="checkbox" checked="@SharedTeachers.ContainsKey(teacher.Id)" @onchange="args => SelectTeacher(teacher, args.Value is true)" disabled="@IsBusy" /><span>@teacher.DisplayName（@teacher.UserName）</span></label>
                            }
                            @if (TeacherList.Count == 0) { <p class="kp-text-muted">没有匹配的有效教师，请调整关键词。</p> }
                        </div>
                        <p class="kp-help">已选择 @SharedTeachers.Count 位教师；当前账号的访问权始终保留。</p>
                    }
                    <div class="kp-alert kp-alert--info kp-mt-3" role="status">共享不允许修改或删除你的原件。管理员权限不会改变资料归属。</div>
                    <div class="kp-flex kp-flex-wrap kp-justify-between kp-gap-2 kp-mt-4">
                        <button class="kp-button kp-button--secondary" type="button" @onclick="GoBack" disabled="@IsBusy">上一步</button>
                        <button class="kp-button kp-button--primary" type="button" @onclick="GoNext" disabled="@IsBusy">下一步</button>
                    </div>
                }
                else if (CurrentStep == UploadStep.Publish)
                {
                    <div class="kp-mb-3">
                        <h2 class="kp-heading-5 kp-mb-1">发布确认</h2>
                        <div class="kp-text-muted kp-text-small">保存草稿不会发布版本，发布会创建索引任务。</div>
                    </div>

                    <div class="knowledge-upload-summary kp-mb-4">
                        <div class="knowledge-upload-summary-item">
                            <span class="kp-text-muted">知识标题</span>
                            <span class="knowledge-upload-summary-value">@Form.Title</span>
                        </div>
                        <div class="knowledge-upload-summary-item">
                            <span class="kp-text-muted">内容来源</span>
                            <span class="knowledge-upload-summary-value">@ContentStepSummary</span>
                        </div>
                        <div class="knowledge-upload-summary-item">
                            <span class="kp-text-muted">RAG 状态</span>
                            <span class="knowledge-upload-summary-value">@RagCoverageText</span>
                        </div>
                        <div class="knowledge-upload-summary-item">
                            <span class="kp-text-muted">可见范围</span>
                            <span class="knowledge-upload-summary-value">@VisibilityStepSummary</span>
                        </div>
                        <div class="knowledge-upload-summary-item">
                            <span class="kp-text-muted">分类</span>
                            <span class="knowledge-upload-summary-value">@CategorySummaryText</span>
                        </div>
                    </div>

                    <div class="knowledge-content-preview kp-mb-3">
                        @if (!string.IsNullOrWhiteSpace(Form.ContentText))
                        {
                            <h3>正文预览</h3><div class="knowledge-preview-text">@Form.ContentText</div>
                        }
                        @if (SelectedFile is not null)
                        {
                            <table class="kp-table"><thead><tr><th>附件</th><th>大小</th><th>处理方式</th></tr></thead><tbody><tr><td>@SelectedFile.Name</td><td>@FormatFileSize(SelectedFile.Size)</td><td>@RagCoverageText</td></tr></tbody></table>
                        }
                    </div>
                    <div class="kp-alert kp-alert--info" role="status">@VisibilityStepSummary；资料所有者为当前账号。发布后索引仍需实际完成，才能用于问答。</div>

                    @if (SourceMode == UploadSourceMode.AttachmentOnly)
                    {
                        <div class="kp-alert kp-alert--warning" role="status">
                            当前文件仅作为附件保存，不会进入 RAG 问答。若希望被问答检索，请改用正文输入、文本/Markdown 文件或文档转换模式。
                        </div>
                    }

                    @if (SourceMode == UploadSourceMode.ConvertibleFile)
                    {
                        <div class="kp-alert kp-alert--info" role="status">
                            发布后索引任务会调用 MarkItDown 转换附件。若服务端没有安装或配置 markitdown，结果页会显示 reader 阶段失败。
                        </div>
                    }

                    <div class="kp-flex kp-flex-wrap kp-justify-between kp-gap-2 kp-mt-4">
                        <button class="kp-button kp-button--secondary" type="button" @onclick="GoBack" disabled="@IsBusy">上一步</button>
                        <div class="kp-flex kp-flex-wrap kp-gap-2">
                            <button class="kp-button kp-button--primary-outline" type="button" @onclick="SaveDraftAsync" disabled="@(IsBusy || !HasRequiredWritePermissions)">保存草稿</button>
                            <button class="kp-button kp-button--primary" type="button" @onclick="PublishAsync" disabled="@(IsBusy || !HasRequiredWritePermissions)">确认发布并开始索引</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="kp-mb-3">
                        <h2 class="kp-heading-5 kp-mb-1">@ResultTitle</h2>
                        <div class="kp-text-muted kp-text-small">@ResultDescription</div>
                    </div>

                    @if (ResultKind == UploadResultKind.Failed)
                    {
                        <div class="kp-alert kp-alert--error" role="alert">
                            <div class="kp-text-semibold">失败阶段：@FailureStageText</div>
                            <div class="kp-mt-1">@FailureReasonText</div>
                        </div>
                        @if (CreatedItemId.HasValue)
                        {
                            <div class="kp-alert kp-alert--info" role="status">
                                发布前已经保存的知识、版本和附件仍作为草稿保留；可以打开知识详情继续修复，不需要重新上传。
                            </div>
                        }
                    }
                    else if (HasIndexFailure)
                    {
                        <div class="kp-alert kp-alert--error" role="alert">
                            <div class="kp-text-semibold">索引失败：@LatestIndexJob?.FailureStage</div>
                            <div class="kp-mt-1">@LatestIndexJob?.FailureReason</div>
                        </div>
                    }
                    else if (ResultKind == UploadResultKind.DraftSaved)
                    {
                        <div class="kp-alert kp-alert--info" role="status">草稿已保存，可以稍后到知识管理中继续发布。</div>
                    }
                    else
                    {
                        <div class="kp-alert kp-alert--success" role="status">知识已发布。索引处理完成后即可在问答中验证。</div>
                    }

                    @if (LatestIndexJob != null)
                    {
                        <div class="knowledge-upload-summary kp-mb-4">
                            <div class="knowledge-upload-summary-item">
                                <span class="kp-text-muted">索引状态</span>
                                <span class="knowledge-upload-summary-value">
                                    <span class="kp-badge @GetIndexStatusBadge(LatestIndexJob.Status)">@GetIndexStatusText(LatestIndexJob.Status)</span>
                                </span>
                            </div>
                            <div class="knowledge-upload-summary-item">
                                <span class="kp-text-muted">索引时间</span>
                                <span class="knowledge-upload-summary-value">@GetIndexJobTimeText(LatestIndexJob)</span>
                            </div>
                        </div>
                    }

                    @if (ResultKind == UploadResultKind.Published && CanManageIndexJobs)
                    {
                        <button class="kp-button kp-button--secondary kp-mb-3" type="button" @onclick="RefreshIndexAsync" disabled="@IsBusy">刷新索引状态</button>
                    }
                    <div class="kp-flex kp-flex-wrap kp-gap-2">
                        @if (ResultKind == UploadResultKind.Failed || HasIndexFailure)
                        {
                            @if (HasIndexFailure && CanManageIndexJobs)
                            {
                                <button class="kp-button kp-button--primary" type="button" @onclick="RetryIndexAsync" disabled="@IsBusy">重试索引</button>
                            }
                            @if (ResultKind == UploadResultKind.Failed && CreatedItemId.HasValue)
                            {
                                <button class="kp-button kp-button--primary-outline" type="button" @onclick="ViewAdvanced" disabled="@IsBusy">打开保留的草稿</button>
                            }
                            else
                            {
                                <button class="kp-button kp-button--secondary" type="button" @onclick="ReturnToEdit" disabled="@IsBusy">返回修改内容</button>
                            }
                            @if (CanManageIndexJobs)
                            {
                                <button class="kp-button kp-button--secondary" type="button" @onclick="ViewIndexJobs" disabled="@IsBusy">查看索引任务</button>
                            }
                        }
                        else
                        {
                            <button class="kp-button kp-button--primary" type="button" @onclick="GoToRag" disabled="@(IsBusy || LatestIndexJob?.Status != KnowledgeIndexJobStatus.Indexed)">去问答验证</button>
                            <button class="kp-button kp-button--primary-outline" type="button" @onclick="ResetWizard" disabled="@IsBusy">继续上传下一份</button>
                            <button class="kp-button kp-button--secondary" type="button" @onclick="ViewAdvanced" disabled="@IsBusy">查看高级管理</button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="kp-col-xl-4">
        <div class="admin-panel kp-card kp-mb-3">
            <div class="kp-card__body">
                <h2 class="kp-heading-6 kp-mb-3">发布范围与版本</h2>
                <div class="knowledge-upload-summary">
                    <div class="knowledge-upload-summary-item">
                        <span class="kp-text-muted">步骤</span>
                        <span class="knowledge-upload-summary-value">@GetStepText(CurrentStep)</span>
                    </div>
                    <div class="knowledge-upload-summary-item">
                        <span class="kp-text-muted">内容</span>
                        <span class="knowledge-upload-summary-value">@ContentStepSummary</span>
                    </div>
                    <div class="knowledge-upload-summary-item">
                        <span class="kp-text-muted">RAG</span>
                        <span class="knowledge-upload-summary-value">@RagCoverageText</span>
                    </div>
                    <div class="knowledge-upload-summary-item">
                        <span class="kp-text-muted">可见范围</span>
                        <span class="knowledge-upload-summary-value">@VisibilityStepSummary</span>
                    </div>
                    <div class="knowledge-upload-summary-item">
                        <span class="kp-text-muted">资料所有者</span>
                        <span class="knowledge-upload-summary-value">当前账号</span>
                    </div>
                    <div class="knowledge-upload-summary-item">
                        <span class="kp-text-muted">附件权限</span>
                        <span class="knowledge-upload-summary-value">@(CanUploadAttachment ? "可上传" : "不可上传")</span>
                    </div>
                    <div class="knowledge-upload-summary-item">
                        <span class="kp-text-muted">索引任务</span>
                        <span class="knowledge-upload-summary-value">@IndexSummaryText</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="admin-panel kp-card">
            <div class="kp-card__body">
                <h2 class="kp-heading-6 kp-mb-3">文件规则</h2>
                <div class="kp-text-small kp-text-muted">
                    <div class="kp-mb-2">直接索引：正文、.txt、.md、.markdown。</div>
                    <div class="kp-mb-2">转换后索引：PDF、Word、PPT、Excel、HTML、CSV、JSON、XML。</div>
                    <div class="kp-mb-2">仅附件：图片、音频、视频、压缩包和其他二进制文件。</div>
                    <div>单个附件最大 @FormatFileSize(MaxAttachmentBytes)。</div>
                </div>
            </div>
        </div>
    </div>
</div>

</div>

@code {
    private const int MaxTitleLength = 256;
    private const int MaxSummaryLength = 1024;
    private const int MaxContentTextLength = 8192;
    private const long MaxAttachmentBytes = 20 * 1024 * 1024;
    private const long MaxIndexableTextBytes = 128 * 1024;

    private readonly List<KnowledgeCategoryDto> CategoryList = new();
    private readonly List<KnowledgeShareTeacherDto> TeacherList = new();
    private readonly Dictionary<Guid, KnowledgeShareTeacherDto> SharedTeachers = new();
    private bool ShareWithTeachers;

    private UploadFormModel Form { get; set; } = new();
    private UploadStep CurrentStep { get; set; } = UploadStep.Content;
    private UploadSourceMode SourceMode { get; set; } = UploadSourceMode.BodyText;
    private UploadResultKind? ResultKind { get; set; }
    private IBrowserFile? SelectedFile { get; set; }
    private KnowledgeIndexJobDto? LatestIndexJob { get; set; }
    private Guid? CreatedItemId { get; set; }
    private Guid? CreatedVersionId { get; set; }
    private bool IsLoading { get; set; }
    private bool IsBusy { get; set; }
    private bool CanManageCategories { get; set; }
    private bool CanCreateVersion { get; set; }
    private bool CanUploadAttachment { get; set; }
    private bool CanManagePermissionScopes { get; set; }
    private bool CanManageIndexJobs { get; set; }
    private bool ScopeTargetsLoadFailed { get; set; }
    private string? TeacherFilterText { get; set; }
    private string? ErrorMessage { get; set; }
    private string? LookupWarningMessage { get; set; }
    private string? FailureStageText { get; set; }
    private string? FailureReasonText { get; set; }

    private bool HasRequiredWritePermissions => CanCreateVersion && CanManagePermissionScopes;
    private bool CanUseRestrictedScopes => CanManagePermissionScopes && !ScopeTargetsLoadFailed;
    private bool HasIndexFailure => LatestIndexJob?.Status == KnowledgeIndexJobStatus.Failed;
    private string ContentStepSummary => SourceMode switch
    {
        UploadSourceMode.BodyText => string.IsNullOrWhiteSpace(Form.ContentText) ? "正文输入" : $"正文 {Form.ContentText.Length} 字",
        UploadSourceMode.IndexableFile => SelectedFile == null ? "文本或 Markdown" : SelectedFile.Name,
        UploadSourceMode.ConvertibleFile => SelectedFile == null ? "文档转换" : SelectedFile.Name,
        UploadSourceMode.AttachmentOnly => SelectedFile == null ? "附件留存" : SelectedFile.Name,
        _ => "未选择"
    };
    private string InfoStepSummary => string.IsNullOrWhiteSpace(Form.Title) ? "未填写标题" : Form.Title;
    private string VisibilityStepSummary => ShareWithTeachers
        ? $"本人及指定教师：{string.Join("、", SharedTeachers.Values.Select(x => x.DisplayName))}"
        : "仅自己";
    private string PublishStepSummary => ResultKind == null ? "等待确认" : ResultStepSummary;
    private string ResultStepSummary => ResultKind switch
    {
        UploadResultKind.DraftSaved => "草稿已保存",
        UploadResultKind.Published when HasIndexFailure => "索引失败",
        UploadResultKind.Published => "已发布",
        UploadResultKind.Failed when CreatedItemId.HasValue => "发布未完成，草稿已保留",
        UploadResultKind.Failed => "处理失败",
        _ => "未完成"
    };
    private string RagCoverageText => SourceMode switch
    {
        UploadSourceMode.AttachmentOnly => "不参与 RAG",
        UploadSourceMode.ConvertibleFile => "转换后参与 RAG",
        _ => "可参与 RAG"
    };
    private string FileHelpText => SelectedFile == null
        ? $"未选择文件，最大 {FormatFileSize(MaxAttachmentBytes)}"
        : $"{SelectedFile.Name} / {FormatFileSize(SelectedFile.Size)}";
    private string CategorySummaryText => ParseNullableGuid(Form.CategoryIdText) is { } categoryId
        ? CategoryList.FirstOrDefault(x => x.Id == categoryId)?.Name ?? categoryId.ToString("N")
        : "未分类";
    private string IndexSummaryText => LatestIndexJob == null
        ? (CanManageIndexJobs ? "未创建" : "无索引权限")
        : GetIndexStatusText(LatestIndexJob.Status);
    private string ResultTitle => ResultKind switch
    {
        UploadResultKind.DraftSaved => "草稿已保存",
        UploadResultKind.Published when HasIndexFailure => "发布成功，索引失败",
        UploadResultKind.Published => "上传完成",
        UploadResultKind.Failed => "处理失败",
        _ => "等待结果"
    };
    private string ResultDescription => ResultKind switch
    {
        UploadResultKind.DraftSaved => "草稿不会进入问答检索，发布后才会创建索引任务。",
        UploadResultKind.Published when LatestIndexJob?.Status == KnowledgeIndexJobStatus.Indexed => "索引已完成，可以直接去问答验证。",
        UploadResultKind.Published => "发布已经完成，索引任务会继续处理。",
        UploadResultKind.Failed when CreatedItemId.HasValue => "本次处理没有完成，但已经写入的草稿与附件可以继续修复。",
        UploadResultKind.Failed => "本次处理没有完成，请按失败阶段返回修正或重试。",
        _ => ""
    };

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        try
        {
            CanManageCategories = await PermissionChecker.IsGrantedAsync(KnowPulsePermissions.KnowledgeBase.Categories);
            CanCreateVersion = await PermissionChecker.IsGrantedAsync(KnowPulsePermissions.KnowledgeBase.Versions);
            CanUploadAttachment = await PermissionChecker.IsGrantedAsync(KnowPulsePermissions.KnowledgeBase.Attachments);
            CanManagePermissionScopes = await PermissionChecker.IsGrantedAsync(KnowPulsePermissions.KnowledgeBase.PermissionScopes);
            CanManageIndexJobs = await PermissionChecker.IsGrantedAsync(KnowPulsePermissions.KnowledgeIndexing.IndexJobs);

            await LoadCategoriesAsync();
            await LoadTeachersAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = GetUserFriendlyErrorMessage(ex);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadCategoriesAsync()
    {
        if (!CanManageCategories)
        {
            return;
        }

        try
        {
            var categories = await CategoryAppService.GetListAsync(new PagedAndSortedResultRequestDto { MaxResultCount = 100 });
            CategoryList.Clear();
            CategoryList.AddRange(categories.Items.Where(x => x.IsActive).OrderBy(x => x.Code));
        }
        catch (Exception ex)
        {
            AppendLookupWarning($"分类加载失败，上传时将使用未分类：{GetUserFriendlyErrorMessage(ex)}");
        }
    }

    private async Task LoadTeachersAsync()
    {
        if (!CanManagePermissionScopes) return;
        try
        {
            var teachers = await KnowledgeItemAppService.SearchShareTeachersAsync(TeacherFilterText);
            TeacherList.Clear();
            TeacherList.AddRange(teachers.Items);
            ScopeTargetsLoadFailed = false;
        }
        catch (Exception ex)
        {
            ScopeTargetsLoadFailed = true;
            AppendLookupWarning($"共享教师加载失败，可以按仅自己可见保存：{GetUserFriendlyErrorMessage(ex)}");
        }
    }

    private Task SearchTeachersAsync() => RunBusyAsync(LoadTeachersAsync);

    private void SelectTeacher(KnowledgeShareTeacherDto teacher, bool selected)
    {
        if (selected) SharedTeachers[teacher.Id] = teacher;
        else SharedTeachers.Remove(teacher.Id);
    }

    private void SelectSourceMode(UploadSourceMode sourceMode)
    {
        SourceMode = sourceMode;
        ErrorMessage = null;
        if (sourceMode == UploadSourceMode.BodyText)
        {
            SelectedFile = null;
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs args)
    {
        SelectedFile = args.File;
        if (SelectedFile == null)
        {
            return;
        }

        var fileTitle = Path.GetFileNameWithoutExtension(SelectedFile.Name);
        if (string.IsNullOrWhiteSpace(Form.Title))
        {
            Form.Title = fileTitle;
        }

        if (string.IsNullOrWhiteSpace(Form.VersionTitle))
        {
            Form.VersionTitle = "初始版本";
        }
    }

    private void GoNext()
    {
        ErrorMessage = null;
        if (CurrentStep == UploadStep.Content && !ValidateContentStep())
        {
            return;
        }

        if (CurrentStep == UploadStep.Info && !ValidateInfoStep())
        {
            return;
        }

        if (CurrentStep == UploadStep.Visibility && !ValidateVisibilityStep())
        {
            return;
        }

        if (CurrentStep < UploadStep.Result)
        {
            CurrentStep = (UploadStep)((int)CurrentStep + 1);
        }
    }

    private void GoBack()
    {
        ErrorMessage = null;
        if (CurrentStep > UploadStep.Content)
        {
            CurrentStep = (UploadStep)((int)CurrentStep - 1);
        }
    }

    private async Task SaveDraftAsync()
    {
        await ExecuteCreationAsync(publish: false);
    }

    private async Task PublishAsync()
    {
        await ExecuteCreationAsync(publish: true);
    }

    private async Task ExecuteCreationAsync(bool publish)
    {
        if (IsBusy) return;
        ErrorMessage = null;
        ResultKind = null;
        FailureStageText = null;
        FailureReasonText = null;
        LatestIndexJob = null;

        if (!ValidateAllSteps())
        {
            return;
        }

        string? contentText;
        try
        {
            FailureStageText = "读取可索引正文";
            contentText = await ResolveContentTextAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = GetUserFriendlyErrorMessage(ex);
            CurrentStep = UploadStep.Content;
            return;
        }

        IsBusy = true;
        try
        {
            var title = Form.Title?.Trim() ?? string.Empty;
            var versionTitle = Form.VersionTitle.Trim();

            FailureStageText = "创建知识文档";
            var item = await KnowledgeItemAppService.CreateAsync(new CreateKnowledgeItemDto
            {
                CategoryId = ParseNullableGuid(Form.CategoryIdText),
                Title = title,
                Summary = NormalizeOptionalText(Form.Summary)
            });

            CreatedItemId = item.Id;

            FailureStageText = "创建知识版本";
            var version = await KnowledgeItemAppService.CreateVersionAsync(item.Id, new CreateKnowledgeVersionDto
            {
                Title = versionTitle,
                ContentText = contentText
            });

            CreatedVersionId = version.Id;

            if (SourceMode != UploadSourceMode.BodyText)
            {
                FailureStageText = "上传附件";
                await UploadSelectedFileAsync(item.Id, version.Id);
            }

            var accessPolicies = new List<CreateKnowledgePermissionScopeDto>
            {
                new() { ScopeType = KnowledgePermissionScopeType.User, TargetId = item.OwnerTeacherId }
            };
            if (ShareWithTeachers)
            {
                accessPolicies.AddRange(SharedTeachers.Keys.Select(id => new CreateKnowledgePermissionScopeDto
                {
                    ScopeType = KnowledgePermissionScopeType.User,
                    TargetId = id
                }));
            }

            if (publish)
            {
                FailureStageText = "确认访问策略、发布并创建索引";
                var result = await KnowledgeItemAppService.PublishVersionWithAccessPolicyAsync(item.Id, new PublishKnowledgeVersionInput
                {
                    KnowledgeVersionId = version.Id,
                    PermissionScopes = accessPolicies
                });
                ResultKind = UploadResultKind.Published;
                LatestIndexJob = result.IndexJob;
            }
            else
            {
                FailureStageText = "保存访问策略";
                foreach (var policy in accessPolicies)
                    await KnowledgeItemAppService.CreatePermissionScopeAsync(item.Id, policy);
                ResultKind = UploadResultKind.DraftSaved;
            }

            CurrentStep = UploadStep.Result;
        }
        catch (Exception ex)
        {
            ResultKind = UploadResultKind.Failed;
            FailureReasonText = GetUserFriendlyErrorMessage(ex);
            CurrentStep = UploadStep.Result;
        }
        finally
        {
            IsBusy = false;
        }
    }

    private async Task<string?> ResolveContentTextAsync()
    {
        if (SourceMode == UploadSourceMode.BodyText)
        {
            return NormalizeOptionalText(Form.ContentText);
        }

        if (SourceMode is UploadSourceMode.IndexableFile or UploadSourceMode.ConvertibleFile or UploadSourceMode.AttachmentOnly)
        {
            return null;
        }

        await Task.CompletedTask;
        return null;
    }

    private async Task UploadSelectedFileAsync(Guid itemId, Guid versionId)
    {
        if (SelectedFile == null)
        {
            return;
        }

        var stream = SelectedFile.OpenReadStream(MaxAttachmentBytes);
        using var content = new RemoteStreamContent(
            stream,
            SelectedFile.Name,
            string.IsNullOrWhiteSpace(SelectedFile.ContentType) ? "application/octet-stream" : SelectedFile.ContentType,
            SelectedFile.Size,
            disposeStream: true);

        await KnowledgeItemAppService.UploadAttachmentAsync(itemId, versionId, content);
    }

    private async Task LoadLatestIndexJobAsync(Guid versionId)
    {
        if (!CanManageIndexJobs)
        {
            return;
        }

        var result = await IndexJobAppService.GetListAsync(new GetKnowledgeIndexJobListInput
        {
            KnowledgeVersionId = versionId,
            MaxResultCount = 20
        });

        LatestIndexJob = result.Items.OrderByDescending(x => x.CreationTime).FirstOrDefault();
    }

    private Task RefreshIndexAsync() => CreatedVersionId.HasValue
        ? RunBusyAsync(() => LoadLatestIndexJobAsync(CreatedVersionId.Value))
        : Task.CompletedTask;

    private async Task RetryIndexAsync()
    {
        if (LatestIndexJob == null || !CanManageIndexJobs)
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            LatestIndexJob = await IndexJobAppService.RetryAsync(LatestIndexJob.Id);
            await LoadLatestIndexJobAsync(LatestIndexJob.KnowledgeVersionId);
        });
    }

    private bool ValidateAllSteps()
    {
        if (!ValidateContentStep())
        {
            CurrentStep = UploadStep.Content;
            return false;
        }

        if (!ValidateInfoStep())
        {
            CurrentStep = UploadStep.Info;
            return false;
        }

        if (!ValidateVisibilityStep())
        {
            CurrentStep = UploadStep.Visibility;
            return false;
        }

        if (!HasRequiredWritePermissions)
        {
            ErrorMessage = "缺少知识版本或访问策略权限，无法保存或发布知识。";
            return false;
        }

        if (SourceMode != UploadSourceMode.BodyText && !CanUploadAttachment)
        {
            CurrentStep = UploadStep.Content;
            ErrorMessage = "缺少附件上传权限，无法上传文件。";
            return false;
        }

        return true;
    }

    private bool ValidateContentStep()
    {
        if (SourceMode == UploadSourceMode.BodyText)
        {
            if (string.IsNullOrWhiteSpace(Form.ContentText))
            {
                ErrorMessage = "请填写正文内容。";
                return false;
            }

            if (Form.ContentText.Length > MaxContentTextLength)
            {
                ErrorMessage = $"正文不能超过 {MaxContentTextLength} 个字符。";
                return false;
            }

            return true;
        }

        if (SelectedFile == null)
        {
            ErrorMessage = "请选择要上传的文件。";
            return false;
        }

        if (SelectedFile.Size > MaxAttachmentBytes)
        {
            ErrorMessage = $"文件不能超过 {FormatFileSize(MaxAttachmentBytes)}。";
            return false;
        }

        if (!CanUploadAttachment)
        {
            ErrorMessage = "缺少附件上传权限，无法上传文件。";
            return false;
        }

        if (SourceMode == UploadSourceMode.IndexableFile)
        {
            if (!IsSupportedIndexableFile(SelectedFile.Name))
            {
                ErrorMessage = "直接索引文件仅支持 .txt、.md、.markdown。";
                return false;
            }

            if (SelectedFile.Size > MaxIndexableTextBytes)
            {
                ErrorMessage = $"文本文件过大，当前可读取上限为 {FormatFileSize(MaxIndexableTextBytes)}。";
                return false;
            }
        }
        else if (SourceMode == UploadSourceMode.ConvertibleFile && !IsSupportedConvertibleFile(SelectedFile.Name))
        {
            ErrorMessage = "可转换文档仅支持 PDF、Word、PPT、Excel、HTML、CSV、JSON、XML。";
            return false;
        }

        return true;
    }

    private bool ValidateInfoStep()
    {
        if (string.IsNullOrWhiteSpace(Form.Title))
        {
            ErrorMessage = "请填写知识标题。";
            return false;
        }

        if (Form.Title.Length > MaxTitleLength)
        {
            ErrorMessage = $"知识标题不能超过 {MaxTitleLength} 个字符。";
            return false;
        }

        if (!string.IsNullOrWhiteSpace(Form.Summary) && Form.Summary.Length > MaxSummaryLength)
        {
            ErrorMessage = $"摘要不能超过 {MaxSummaryLength} 个字符。";
            return false;
        }

        if (string.IsNullOrWhiteSpace(Form.VersionTitle))
        {
            ErrorMessage = "请填写版本标题。";
            return false;
        }

        if (Form.VersionTitle.Length > MaxTitleLength)
        {
            ErrorMessage = $"版本标题不能超过 {MaxTitleLength} 个字符。";
            return false;
        }

        return true;
    }

    private bool ValidateVisibilityStep()
    {
        if (!ShareWithTeachers) return true;
        if (!CanUseRestrictedScopes || SharedTeachers.Count == 0)
        {
            ErrorMessage = "请选择至少一位有效教师，或改为仅自己可见。";
            return false;
        }
        return true;
    }

    private void ReturnToEdit()
    {
        ErrorMessage = null;
        ResultKind = null;
        LatestIndexJob = null;
        CurrentStep = UploadStep.Publish;
    }

    private void ResetWizard()
    {
        Form = new UploadFormModel();
        ShareWithTeachers = false;
        SharedTeachers.Clear();
        CurrentStep = UploadStep.Content;
        SourceMode = UploadSourceMode.BodyText;
        ResultKind = null;
        SelectedFile = null;
        LatestIndexJob = null;
        CreatedItemId = null;
        CreatedVersionId = null;
        ErrorMessage = null;
        FailureStageText = null;
        FailureReasonText = null;
    }

    private void ViewAdvanced()
    {
        if (CreatedItemId.HasValue && CreatedVersionId.HasValue)
        {
            NavigationManager.NavigateTo($"/knowledge/{CreatedItemId.Value:D}");
            return;
        }

        NavigationManager.NavigateTo("/knowledge");
    }

    private void GoToRag()
    {
        NavigationManager.NavigateTo("/rag/answer");
    }

    private void ViewIndexJobs()
    {
        if (!CreatedItemId.HasValue)
        {
            return;
        }

        NavigationManager.NavigateTo($"/knowledge/{CreatedItemId.Value:D}?tab=index");
    }

    private void ClearError()
    {
        ErrorMessage = null;
    }

    private async Task RunBusyAsync(Func<Task> action)
    {
        try
        {
            ErrorMessage = null;
            IsBusy = true;
            await action();
        }
        catch (Exception ex)
        {
            ErrorMessage = GetUserFriendlyErrorMessage(ex);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private void AppendLookupWarning(string message)
    {
        LookupWarningMessage = string.IsNullOrWhiteSpace(LookupWarningMessage)
            ? message
            : $"{LookupWarningMessage} {message}";
    }

    private string GetStepClass(UploadStep step)
    {
        if (step == CurrentStep)
        {
            return "is-current";
        }

        return step < CurrentStep ? "is-complete" : "";
    }

    private string GetChoiceCss(UploadSourceMode sourceMode)
    {
        return SourceMode == sourceMode ? "knowledge-upload-choice is-selected" : "knowledge-upload-choice";
    }

    private static string GetStepText(UploadStep step)
    {
        return step switch
        {
            UploadStep.Content => "1 / 内容来源",
            UploadStep.Info => "2 / 基础信息",
            UploadStep.Visibility => "3 / 可见范围",
            UploadStep.Publish => "4 / 发布确认",
            UploadStep.Result => "5 / 结果处理",
            _ => step.ToString()
        };
    }

    private static string GetIndexStatusText(KnowledgeIndexJobStatus status)
    {
        return status switch
        {
            KnowledgeIndexJobStatus.Pending => "待处理",
            KnowledgeIndexJobStatus.Processing => "处理中",
            KnowledgeIndexJobStatus.Indexed => "已索引",
            KnowledgeIndexJobStatus.Failed => "失败",
            KnowledgeIndexJobStatus.Outdated => "已过期",
            KnowledgeIndexJobStatus.Deleted => "已删除",
            _ => status.ToString()
        };
    }

    private static string GetIndexStatusBadge(KnowledgeIndexJobStatus status)
    {
        return status switch
        {
            KnowledgeIndexJobStatus.Pending => "kp-bg-warning kp-text-dark",
            KnowledgeIndexJobStatus.Processing => "kp-bg-info kp-text-dark",
            KnowledgeIndexJobStatus.Indexed => "kp-bg-success",
            KnowledgeIndexJobStatus.Failed => "kp-bg-error",
            KnowledgeIndexJobStatus.Outdated => "kp-bg-secondary",
            KnowledgeIndexJobStatus.Deleted => "kp-bg-dark",
            _ => "kp-bg-secondary"
        };
    }

    private static string GetIndexJobTimeText(KnowledgeIndexJobDto job)
    {
        if (job.CompletedTime.HasValue)
        {
            return $"完成于 {job.CompletedTime.Value:yyyy-MM-dd HH:mm}";
        }

        if (job.StartedTime.HasValue)
        {
            return $"开始于 {job.StartedTime.Value:yyyy-MM-dd HH:mm}";
        }

        return $"创建于 {job.CreationTime:yyyy-MM-dd HH:mm}";
    }

    private static string GetTextLengthText(string? value, int maxLength)
    {
        return $"{(value?.Length ?? 0)} / {maxLength}";
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
        {
            return $"{bytes / 1024d / 1024d:0.#} MB";
        }

        if (bytes >= 1024)
        {
            return $"{bytes / 1024d:0.#} KB";
        }

        return $"{bytes} B";
    }

    private static bool IsSupportedIndexableFile(string fileName)
    {
        var extension = Path.GetExtension(fileName).ToLowerInvariant();
        return extension is ".txt" or ".md" or ".markdown";
    }

    private static bool IsSupportedConvertibleFile(string fileName)
    {
        var extension = Path.GetExtension(fileName).ToLowerInvariant();
        return extension is ".pdf" or ".doc" or ".docx" or ".ppt" or ".pptx" or ".xls" or ".xlsx" or ".html" or ".htm" or ".csv" or ".json" or ".xml";
    }

    private static Guid? ParseNullableGuid(string? value)
    {
        return Guid.TryParse(value, out var id) ? id : null;
    }

    private static string? NormalizeOptionalText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    private enum UploadStep
    {
        Content = 1,
        Info = 2,
        Visibility = 3,
        Publish = 4,
        Result = 5
    }

    private enum UploadSourceMode
    {
        BodyText,
        IndexableFile,
        ConvertibleFile,
        AttachmentOnly
    }

    private enum UploadResultKind
    {
        DraftSaved,
        Published,
        Failed
    }

    private class UploadFormModel
    {
        public string? Title { get; set; }
        public string? CategoryIdText { get; set; }
        public string? Summary { get; set; }
        public string VersionTitle { get; set; } = "初始版本";
        public string? ContentText { get; set; }
    }
}
