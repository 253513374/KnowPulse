@page "/knowledge/feedback"
@attribute [Authorize(KnowPulsePermissions.KnowledgeBase.Feedback)]
@inherits KnowPulseComponentBase
@inject IKnowledgeFeedbackAppService FeedbackAppService
@inject IPermissionChecker PermissionChecker
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>反馈与修订</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">反馈与修订</h1>
        <div class="text-muted small">接手问题，创建修订，发布并验证检索结果后完成反馈。</div>
    </div>
    <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="LoadAsync" disabled="@IsBusy">刷新</button>
</div>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert @(IsPermissionError ? "alert-warning" : "alert-danger") d-flex flex-wrap align-items-center justify-content-between gap-2" role="alert">
        <span>@ErrorMessage</span>
        <button class="btn btn-sm @(IsPermissionError ? "btn-outline-warning" : "btn-outline-danger")" type="button" @onclick="LoadAsync" disabled="@IsBusy">重试</button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <div class="alert alert-success" role="status">@SuccessMessage</div>
}

@if (IsPermissionError)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <h2 class="h6 mb-2">无权限处理知识反馈</h2>
            <div class="text-muted">请确认账号已授予知识反馈处理权限。</div>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        <div class="col-xl-6">
            <div class="card">
                <div class="card-body border-bottom">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label" for="feedback-status">状态</label>
                            <select id="feedback-status" class="form-select" @bind="StatusFilterText">
                                <option value="">全部</option>
                                <option value="@KnowledgeFeedbackStatus.Submitted">待处理</option>
                                <option value="@KnowledgeFeedbackStatus.Processing">处理中</option>
                                <option value="@KnowledgeFeedbackStatus.Resolved">已完成</option>
                                <option value="@KnowledgeFeedbackStatus.Closed">已关闭</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label" for="feedback-type">类型</label>
                            <select id="feedback-type" class="form-select" @bind="TypeFilterText">
                                <option value="">全部</option>
                                <option value="@KnowledgeFeedbackType.Problem">问题</option>
                                <option value="@KnowledgeFeedbackType.Outdated">过期</option>
                                <option value="@KnowledgeFeedbackType.Error">错误</option>
                                <option value="@KnowledgeFeedbackType.Missing">缺失</option>
                                <option value="@KnowledgeFeedbackType.Suggestion">建议</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="feedback-keyword">关键词</label>
                            <input id="feedback-keyword" class="form-control" @bind="Keyword" @bind:event="oninput" />
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-primary w-100" type="button" @onclick="ApplyFilterAsync" disabled="@IsBusy">查询</button>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>反馈</th>
                                <th>知识</th>
                                <th>状态</th>
                                <th>提交时间</th>
                                <th class="text-end">操作</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (IsLoading)
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">加载中</td>
                                </tr>
                            }
                            else if (FeedbackList.Count == 0)
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-4 text-muted">暂无知识反馈</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var feedback in FeedbackList)
                                {
                                    <tr class="@(SelectedFeedback?.Id == feedback.Id ? "table-active" : null)">
                                        <td>
                                            <div class="fw-semibold">@feedback.Title</div>
                                            <div class="text-muted small">@GetTypeText(feedback.Type)</div>
                                        </td>
                                        <td>
                                            <div>@feedback.KnowledgeTitle</div>
                                            <div class="text-muted small">@GetVersionText(feedback)</div>
                                        </td>
                                        <td><span class="badge @GetStatusBadge(feedback.Status)">@GetStatusText(feedback.Status)</span></td>
                                        <td>@feedback.CreationTime.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="text-end">
                                            <button class="btn btn-link btn-sm" type="button" @onclick="() => SelectFeedbackAsync(feedback)" disabled="@IsBusy">查看</button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <MvpPager SkipCount="SkipCount" PageSize="PageSize" TotalCount="TotalCount" IsBusy="IsBusy" OnSkipCountChanged="ChangePageAsync" />
            </div>
        </div>

        <div class="col-xl-6">
            <div class="card">
                <div class="card-body border-bottom">
                    <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
                        <div>
                            <h2 class="h6 mb-1">处理闭环</h2>
                            <div class="text-muted small">@SelectedFeedbackTitle</div>
                        </div>
                        @if (SelectedFeedback != null)
                        {
                            <span class="badge @GetStatusBadge(SelectedFeedback.Status)">@GetStatusText(SelectedFeedback.Status)</span>
                        }
                    </div>
                </div>

                @if (SelectedFeedback == null)
                {
                    <div class="card-body text-center text-muted py-5">请选择一条反馈</div>
                }
                else
                {
                    <div class="card-body">
                        <div class="feedback-workflow mb-4" aria-label="反馈处理进度">
                            @foreach (var step in WorkflowSteps)
                            {
                                <div class="feedback-workflow-step @GetWorkflowStepClass(step.Number)">
                                    <span>@(IsWorkflowStepDone(step.Number) ? "✓" : step.Number)</span>
                                    <small>@step.Label</small>
                                </div>
                                @if (step.Number < WorkflowSteps.Count)
                                {
                                    <i class="feedback-workflow-line @GetWorkflowLineClass(step.Number)" aria-hidden="true"></i>
                                }
                            }
                        </div>

                        <dl class="row small mb-3">
                            <dt class="col-4">类型</dt>
                            <dd class="col-8">@GetTypeText(SelectedFeedback.Type)</dd>
                            <dt class="col-4">知识</dt>
                            <dd class="col-8">
                                <button class="btn btn-link btn-sm p-0" type="button" @onclick="OpenKnowledge" disabled="@IsBusy">@SelectedFeedback.KnowledgeTitle</button>
                                <div class="text-muted">@GetVersionText(SelectedFeedback)</div>
                            </dd>
                            <dt class="col-4">提交人</dt>
                            <dd class="col-8">用户 @SelectedFeedback.SubmitterUserId.ToString("N")[..8]</dd>
                            <dt class="col-4">提交时间</dt>
                            <dd class="col-8">@SelectedFeedback.CreationTime.ToString("yyyy-MM-dd HH:mm")</dd>
                            <dt class="col-4">关联版本</dt>
                            <dd class="col-8">@GetLinkedVersionText(SelectedFeedback)</dd>
                        </dl>

                        <div class="border rounded p-3 mb-3">
                            <div class="fw-semibold mb-1">@SelectedFeedback.Title</div>
                            <div class="small">@SelectedFeedback.Description</div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(SelectedFeedback.Resolution))
                        {
                            <div class="border rounded p-3 mb-3 bg-light">
                                <div class="fw-semibold mb-1">处理结论</div>
                                <div class="small">@SelectedFeedback.Resolution</div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(SelectedFeedback.CloseReason))
                        {
                            <div class="border rounded p-3 mb-3 bg-light">
                                <div class="fw-semibold mb-1">关闭原因</div>
                                <div class="small">@SelectedFeedback.CloseReason</div>
                            </div>
                        }

                        <div class="d-flex flex-column gap-3">
                            @if (SelectedFeedback.Status == KnowledgeFeedbackStatus.Submitted)
                            {
                            <EditForm Model="@ProcessForm" OnValidSubmit="@ProcessAsync">
                                <DataAnnotationsValidator />
                                <div class="feedback-action-card is-primary">
                                    <div><strong>第一步：接手反馈</strong><p>确认由你负责判断问题，并记录初步处理方向。</p></div>
                                    <label class="form-label" for="process-resolution">初步处理备注</label>
                                    <textarea id="process-resolution" class="form-control mb-3" rows="2" @bind="ProcessForm.Resolution" @bind:event="oninput"></textarea>
                                    <button class="btn btn-primary" type="submit" disabled="@IsBusy">接手反馈</button>
                                </div>
                            </EditForm>
                            }

                            @if (SelectedFeedback.Status == KnowledgeFeedbackStatus.Processing)
                            {
                                <div class="feedback-action-card @(SelectedFeedback.LinkedKnowledgeVersionId.HasValue ? "is-complete" : "is-primary")">
                                    <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
                                        <div><strong>第二步：创建修订</strong><p>系统从反馈来源版本复制正文并自动关联；附件需要在修订中重新上传。</p></div>
                                        @if (SelectedFeedback.LinkedKnowledgeVersionId.HasValue)
                                        {
                                            <span class="badge text-bg-success">已创建</span>
                                        }
                                    </div>
                                    @if (!SelectedFeedback.LinkedKnowledgeVersionId.HasValue)
                                    {
                                        <button class="btn btn-primary" type="button" @onclick="CreateRevisionAsync" disabled="@(IsBusy || !CanManageVersions)">
                                            <i class="fas fa-file-circle-plus me-2" aria-hidden="true"></i>创建修订草稿
                                        </button>
                                        @if (!CanManageVersions)
                                        {
                                            <small class="d-block text-warning mt-2">当前账号缺少知识版本管理权限，不能创建或发布修订。</small>
                                        }
                                    }
                                    else
                                    {
                                        <div class="feedback-revision-summary">
                                            <div><small>关联修订</small><strong>@GetLinkedVersionText(SelectedFeedback)</strong></div>
                                            <span class="badge @GetRevisionBadgeClass()">@GetRevisionStateText()</span>
                                        </div>
                                        <div class="d-flex flex-wrap gap-2 mt-3">
                                            <button class="btn btn-outline-primary" type="button" @onclick="OpenRevision" disabled="@IsBusy">编辑或发布修订</button>
                                            <button class="btn btn-outline-secondary" type="button" @onclick="RefreshSelectedAsync" disabled="@IsBusy">刷新验证状态</button>
                                        </div>
                                    }
                                </div>
                            }

                            @if (SelectedFeedback.Status == KnowledgeFeedbackStatus.Processing && SelectedFeedback.LinkedKnowledgeVersionId.HasValue)
                            {
                            <EditForm Model="@ResolveForm" OnValidSubmit="@ResolveAsync">
                                <DataAnnotationsValidator />
                                <div class="feedback-action-card @(CanCompleteRevision ? "is-primary" : null)">
                                    <div><strong>第三、四步：发布验证并完成</strong><p>@GetCompletionGuidance()</p></div>
                                    <label class="form-label" for="resolve-resolution">处理结论</label>
                                    <textarea id="resolve-resolution" class="form-control mb-3" rows="3" @bind="ResolveForm.Resolution" @bind:event="oninput"></textarea>
                                    <button class="btn btn-success" type="submit" disabled="@(IsBusy || !CanCompleteRevision)">
                                        <i class="fas fa-circle-check me-2" aria-hidden="true"></i>验证并完成反馈
                                    </button>
                                </div>
                            </EditForm>
                            }

                            @if (SelectedFeedback.Status == KnowledgeFeedbackStatus.Resolved)
                            {
                                <div class="alert alert-success mb-0">
                                    <strong class="d-block mb-1">反馈闭环已完成</strong>
                                    关联修订已成为当前发布版本，并且检索索引已成功建立。
                                </div>
                            }

                            @if (SelectedFeedback.Status is KnowledgeFeedbackStatus.Submitted or KnowledgeFeedbackStatus.Processing)
                            {
                            <EditForm Model="@CloseForm" OnValidSubmit="@CloseAsync">
                                <DataAnnotationsValidator />
                                <details class="feedback-close-panel">
                                    <summary>确认无需修订？关闭反馈</summary>
                                    <div class="pt-3">
                                        <label class="form-label" for="close-reason">关闭原因</label>
                                        <textarea id="close-reason" class="form-control mb-2" rows="2" @bind="CloseForm.CloseReason" @bind:event="oninput"></textarea>
                                        <button class="btn btn-outline-danger btn-sm" type="submit" disabled="@IsBusy">关闭反馈</button>
                                    </div>
                                </details>
                            </EditForm>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private const int PageSize = 20;

    [Parameter]
    [SupplyParameterFromQuery(Name = "itemId")]
    public Guid? QueryItemId { get; set; }

    private readonly List<KnowledgeFeedbackDto> FeedbackList = new();
    private int SkipCount { get; set; }
    private long TotalCount { get; set; }
    private string? StatusFilterText { get; set; }
    private string? TypeFilterText { get; set; }
    private string? Keyword { get; set; }
    private bool IsLoading { get; set; }
    private bool IsBusy { get; set; }
    private bool CanManageVersions { get; set; }
    private string? ErrorMessage { get; set; }
    private string? SuccessMessage { get; set; }
    private KnowledgeFeedbackDto? SelectedFeedback { get; set; }
    private ProcessFormModel ProcessForm { get; set; } = new();
    private ResolveFormModel ResolveForm { get; set; } = new();
    private CloseFormModel CloseForm { get; set; } = new();
    private static readonly IReadOnlyList<WorkflowStep> WorkflowSteps =
    [
        new(1, "接手"),
        new(2, "修订"),
        new(3, "发布验证"),
        new(4, "完成")
    ];

    private bool CanCompleteRevision => SelectedFeedback is
    {
        Status: KnowledgeFeedbackStatus.Processing,
        LinkedKnowledgeVersionStatus: KnowledgeVersionStatus.Published,
        LinkedKnowledgeVersionIsCurrentPublished: true,
        LinkedKnowledgeVersionIndexStatus: KnowledgeIndexJobStatus.Indexed
    };
    private bool IsPermissionError => ErrorMessage?.Contains("无权限", StringComparison.OrdinalIgnoreCase) == true ||
                                      ErrorMessage?.Contains("未登录", StringComparison.OrdinalIgnoreCase) == true ||
                                      ErrorMessage?.Contains("Unauthorized", StringComparison.OrdinalIgnoreCase) == true ||
                                      ErrorMessage?.Contains("Forbidden", StringComparison.OrdinalIgnoreCase) == true;
    private string SelectedFeedbackTitle => SelectedFeedback?.Title ?? "未选择反馈";

    protected override async Task OnInitializedAsync()
    {
        CanManageVersions = await PermissionChecker.IsGrantedAsync(KnowPulsePermissions.KnowledgeBase.Versions);
        await LoadAsync();
    }

    private async Task ApplyFilterAsync()
    {
        SkipCount = 0;
        await LoadAsync();
    }

    private async Task ChangePageAsync(int skipCount)
    {
        SkipCount = skipCount;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await RunBusyAsync(LoadListCoreAsync);
    }

    private async Task LoadListCoreAsync()
    {
        IsLoading = true;
        var result = await FeedbackAppService.GetListAsync(new GetKnowledgeFeedbackListInput
        {
            KnowledgeItemId = QueryItemId,
            Status = ParseStatus(StatusFilterText),
            Type = ParseType(TypeFilterText),
            Keyword = string.IsNullOrWhiteSpace(Keyword) ? null : Keyword.Trim(),
            SkipCount = SkipCount,
            MaxResultCount = PageSize
        });

        FeedbackList.Clear();
        FeedbackList.AddRange(result.Items);
        TotalCount = result.TotalCount;

        if (SelectedFeedback != null)
        {
            SelectedFeedback = FeedbackList.FirstOrDefault(x => x.Id == SelectedFeedback.Id) ?? SelectedFeedback;
        }
        else if (FeedbackList.Count > 0)
        {
            SelectedFeedback = FeedbackList[0];
            ResetActionForms(SelectedFeedback);
        }

        IsLoading = false;
    }

    private async Task SelectFeedbackAsync(KnowledgeFeedbackDto feedback)
    {
        await RunBusyAsync(async () =>
        {
            SelectedFeedback = await FeedbackAppService.GetAsync(feedback.Id);
            ResetActionForms(SelectedFeedback);
        });
    }

    private async Task ProcessAsync()
    {
        if (SelectedFeedback == null)
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            SelectedFeedback = await FeedbackAppService.ProcessAsync(SelectedFeedback.Id, new ProcessKnowledgeFeedbackDto
            {
                Resolution = NormalizeOptionalText(ProcessForm.Resolution)
            });
            ResetActionForms(SelectedFeedback);
            await LoadListCoreAsync();
            SuccessMessage = "已接手处理反馈。";
        });
    }

    private async Task CreateRevisionAsync()
    {
        if (SelectedFeedback == null)
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            SelectedFeedback = await FeedbackAppService.CreateRevisionAsync(SelectedFeedback.Id);
            ResetActionForms(SelectedFeedback);
            await LoadListCoreAsync();
            SuccessMessage = $"已创建并关联 v{SelectedFeedback.LinkedKnowledgeVersionNumber} 修订草稿。";
        });
    }

    private async Task ResolveAsync()
    {
        if (SelectedFeedback == null)
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            SelectedFeedback = await FeedbackAppService.ResolveAsync(SelectedFeedback.Id, new ResolveKnowledgeFeedbackDto
            {
                Resolution = ResolveForm.Resolution.Trim(),
                LinkedKnowledgeVersionId = SelectedFeedback.LinkedKnowledgeVersionId
            });
            ResetActionForms(SelectedFeedback);
            await LoadListCoreAsync();
            SuccessMessage = "修订已发布并完成索引，反馈闭环已完成。";
        });
    }

    private async Task RefreshSelectedAsync()
    {
        if (SelectedFeedback == null)
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            SelectedFeedback = await FeedbackAppService.GetAsync(SelectedFeedback.Id);
            ResetActionForms(SelectedFeedback);
            await LoadListCoreAsync();
        });
    }

    private async Task CloseAsync()
    {
        if (SelectedFeedback == null || !await ConfirmAsync("确定关闭该反馈吗？关闭后不能继续处理或关联版本。"))
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            SelectedFeedback = await FeedbackAppService.CloseAsync(SelectedFeedback.Id, new CloseKnowledgeFeedbackDto
            {
                CloseReason = NormalizeOptionalText(CloseForm.CloseReason)
            });
            ResetActionForms(SelectedFeedback);
            await LoadListCoreAsync();
            SuccessMessage = "反馈已关闭。";
        });
    }

    private void OpenKnowledge()
    {
        if (SelectedFeedback == null)
        {
            return;
        }

        NavigationManager.NavigateTo($"/knowledge/{SelectedFeedback.KnowledgeItemId:D}");
    }

    private void OpenRevision()
    {
        if (SelectedFeedback?.LinkedKnowledgeVersionId is not { } versionId)
        {
            return;
        }

        NavigationManager.NavigateTo($"/knowledge/items?itemId={SelectedFeedback.KnowledgeItemId:D}&versionId={versionId:D}");
    }

    private void ResetActionForms(KnowledgeFeedbackDto feedback)
    {
        ProcessForm = new ProcessFormModel { Resolution = feedback.Resolution };
        ResolveForm = new ResolveFormModel
        {
            Resolution = feedback.Resolution ?? string.Empty
        };
        CloseForm = new CloseFormModel { CloseReason = feedback.CloseReason };
    }

    private static KnowledgeFeedbackStatus? ParseStatus(string? value)
    {
        return Enum.TryParse<KnowledgeFeedbackStatus>(value, out var status) ? status : null;
    }

    private static KnowledgeFeedbackType? ParseType(string? value)
    {
        return Enum.TryParse<KnowledgeFeedbackType>(value, out var type) ? type : null;
    }

    private static string GetVersionText(KnowledgeFeedbackDto feedback)
    {
        return feedback.KnowledgeVersionId.HasValue
            ? $"v{feedback.KnowledgeVersionNumber?.ToString() ?? "-"} - {feedback.KnowledgeVersionTitle ?? feedback.KnowledgeVersionId.Value.ToString("N")}"
            : "未绑定来源版本";
    }

    private static string GetLinkedVersionText(KnowledgeFeedbackDto feedback)
    {
        return feedback.LinkedKnowledgeVersionId.HasValue
            ? $"v{feedback.LinkedKnowledgeVersionNumber?.ToString() ?? "-"} - {feedback.LinkedKnowledgeVersionTitle ?? feedback.LinkedKnowledgeVersionId.Value.ToString("N")}"
            : "未关联修订版本";
    }

    private static string GetTypeText(KnowledgeFeedbackType type)
    {
        return type switch
        {
            KnowledgeFeedbackType.Problem => "问题",
            KnowledgeFeedbackType.Outdated => "过期",
            KnowledgeFeedbackType.Error => "错误",
            KnowledgeFeedbackType.Missing => "缺失",
            KnowledgeFeedbackType.Suggestion => "建议",
            _ => type.ToString()
        };
    }

    private static string GetStatusText(KnowledgeFeedbackStatus status)
    {
        return status switch
        {
            KnowledgeFeedbackStatus.Submitted => "待处理",
            KnowledgeFeedbackStatus.Processing => "处理中",
            KnowledgeFeedbackStatus.Resolved => "已完成",
            KnowledgeFeedbackStatus.Closed => "已关闭",
            _ => status.ToString()
        };
    }

    private static string GetStatusBadge(KnowledgeFeedbackStatus status)
    {
        return status switch
        {
            KnowledgeFeedbackStatus.Submitted => "bg-warning text-dark",
            KnowledgeFeedbackStatus.Processing => "bg-info text-dark",
            KnowledgeFeedbackStatus.Resolved => "bg-success",
            KnowledgeFeedbackStatus.Closed => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    private static string? NormalizeOptionalText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    private int CurrentWorkflowStep => SelectedFeedback?.Status switch
    {
        KnowledgeFeedbackStatus.Submitted => 1,
        KnowledgeFeedbackStatus.Processing when SelectedFeedback.LinkedKnowledgeVersionId == null => 2,
        KnowledgeFeedbackStatus.Processing => 3,
        KnowledgeFeedbackStatus.Resolved => 4,
        _ => 0
    };

    private bool IsWorkflowStepDone(int step) =>
        SelectedFeedback?.Status == KnowledgeFeedbackStatus.Resolved || step < CurrentWorkflowStep;

    private string GetWorkflowStepClass(int step)
    {
        if (SelectedFeedback?.Status == KnowledgeFeedbackStatus.Closed)
        {
            return "is-closed";
        }

        if (IsWorkflowStepDone(step))
        {
            return "is-done";
        }

        return step == CurrentWorkflowStep ? "is-current" : string.Empty;
    }

    private string GetWorkflowLineClass(int step) =>
        SelectedFeedback?.Status == KnowledgeFeedbackStatus.Resolved || step < CurrentWorkflowStep
            ? "is-done"
            : string.Empty;

    private string GetRevisionStateText()
    {
        if (SelectedFeedback == null)
        {
            return "未创建";
        }

        if (CanCompleteRevision)
        {
            return "发布与索引已验证";
        }

        if (SelectedFeedback.LinkedKnowledgeVersionStatus != KnowledgeVersionStatus.Published ||
            !SelectedFeedback.LinkedKnowledgeVersionIsCurrentPublished)
        {
            return "草稿待发布";
        }

        return SelectedFeedback.LinkedKnowledgeVersionIndexStatus switch
        {
            KnowledgeIndexJobStatus.Failed => "索引失败",
            KnowledgeIndexJobStatus.Indexed => "索引已完成",
            _ => "等待索引完成"
        };
    }

    private string GetRevisionBadgeClass() => CanCompleteRevision
        ? "text-bg-success"
        : SelectedFeedback?.LinkedKnowledgeVersionIndexStatus == KnowledgeIndexJobStatus.Failed
            ? "text-bg-danger"
            : "text-bg-warning";

    private string GetCompletionGuidance()
    {
        if (CanCompleteRevision)
        {
            return "系统已确认关联修订是当前发布版本，且最新索引任务已完成。填写结论后即可完成反馈。";
        }

        if (SelectedFeedback?.LinkedKnowledgeVersionStatus != KnowledgeVersionStatus.Published ||
            SelectedFeedback.LinkedKnowledgeVersionIsCurrentPublished != true)
        {
            return "请先打开修订，完成内容编辑并发布为当前版本。";
        }

        return SelectedFeedback.LinkedKnowledgeVersionIndexStatus == KnowledgeIndexJobStatus.Failed
            ? "修订已经发布，但索引失败。请回到知识详情的“检索状态”定位原因并重试。"
            : "修订已经发布，正在等待索引完成；完成后刷新验证状态。";
    }

    private async Task<bool> ConfirmAsync(string message)
    {
        return await JSRuntime.InvokeAsync<bool>("confirm", message);
    }

    private async Task RunBusyAsync(Func<Task> action)
    {
        try
        {
            ErrorMessage = null;
            SuccessMessage = null;
            IsBusy = true;
            await action();
        }
        catch (Exception ex)
        {
            ErrorMessage = GetUserFriendlyErrorMessage(ex);
        }
        finally
        {
            IsBusy = false;
            IsLoading = false;
        }
    }

