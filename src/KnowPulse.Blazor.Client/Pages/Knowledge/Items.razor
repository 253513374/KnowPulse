    /// <summary>
    /// 打开指定知识版本的正文预览面板。
    /// </summary>
    /// <param name="version">需要预览正文的知识版本。</param>
    private void PreviewVersion(KnowledgeVersionDto version)
    {
        PreviewedVersion = version;
    }

    /// <summary>
    /// 关闭当前知识版本正文预览面板。
    /// </summary>
