@page "/knowledge/items"
@attribute [Authorize(KnowPulsePermissions.KnowledgeBase.Items)]
@inherits KnowPulseComponentBase
@inject IKnowledgeItemAppService KnowledgeItemAppService
@inject IKnowledgeCategoryAppService CategoryAppService
@inject IKnowledgeIndexJobAppService IndexJobAppService
@inject IKnowledgeFeedbackAppService FeedbackAppService
@inject IPermissionChecker PermissionChecker
@inject IJSRuntime JSRuntime

@* 知识文档管理页：同一页面承载文档元数据、版本生命周期和版本附件管理。 *@
<PageTitle>知识文档</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h4 mb-1">知识文档</h1>
        <div class="text-muted small">文档、版本、附件</div>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <button class="btn btn-primary btn-sm" type="button" @onclick="StartCreateItem" disabled="@IsBusy">新建文档</button>
        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="LoadAsync" disabled="@IsBusy">刷新</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger d-flex flex-wrap align-items-center justify-content-between gap-2" role="alert">
        <span>@ErrorMessage</span>
        <button class="btn btn-sm btn-outline-danger" type="button" @onclick="LoadAsync" disabled="@IsBusy">重试</button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(FeedbackSuccessMessage))
{
    <div class="alert alert-success" role="status">@FeedbackSuccessMessage</div>
}

<div class="knowledge-flow mb-3" aria-label="知识文档工作流">
    <div class="knowledge-flow-step @GetFlowStepClass(SelectedItemId.HasValue)">
        <div class="knowledge-flow-index">1</div>
        <div>
            <div class="knowledge-flow-title">文档</div>
            <div class="knowledge-flow-meta">@SelectedItemTitle</div>
        </div>
    </div>
    <div class="knowledge-flow-step @GetFlowStepClass(SelectedVersionId.HasValue)">
        <div class="knowledge-flow-index">2</div>
        <div>
            <div class="knowledge-flow-title">版本</div>
            <div class="knowledge-flow-meta">@SelectedVersionTitle</div>
        </div>
    </div>
    <div class="knowledge-flow-step @GetFlowStepClass(AttachmentList.Count > 0)">
        <div class="knowledge-flow-index">3</div>
        <div>
            <div class="knowledge-flow-title">附件</div>
            <div class="knowledge-flow-meta">@AttachmentStepText</div>
        </div>
    </div>
</div>

<div class="row g-3">
    @* 左侧负责编辑知识文档和为当前选中文档创建新版本。 *@
    <div class="col-xl-4">
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <div>
                        <h2 class="h6 mb-1">@ItemFormTitle</h2>
                        <div class="text-muted small">@ItemFormSubtitle</div>
                    </div>
                    @if (EditingItemId.HasValue)
                    {
                        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="StartCreateItem" disabled="@IsBusy">改为新建</button>
                    }
                </div>
                <EditForm Model="@ItemForm" OnValidSubmit="@SaveItemAsync">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label" for="knowledge-title">标题</label>
                        <input id="knowledge-title" class="form-control" @bind="ItemForm.Title" @bind:event="oninput" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="knowledge-category">分类</label>
                        <select id="knowledge-category" class="form-select" @bind="ItemForm.CategoryIdText">
                            <option value="">未分类</option>
                            @foreach (var category in CategoryList)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="knowledge-summary">摘要</label>
                        <textarea id="knowledge-summary" class="form-control" rows="4" @bind="ItemForm.Summary" @bind:event="oninput"></textarea>
                    </div>

                    @if (EditingItemId.HasValue)
                    {
                        <div class="form-check form-switch mb-3">
                            <InputCheckbox id="knowledge-active" class="form-check-input" @bind-Value="ItemForm.IsActive" />
                            <label class="form-check-label" for="knowledge-active">启用</label>
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2">
                        <button class="btn btn-primary" type="submit" disabled="@IsBusy">@ItemSubmitText</button>
                        <button class="btn btn-outline-secondary" type="button" @onclick="ResetItemForm" disabled="@IsBusy">取消</button>
                    </div>
                </EditForm>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <div>
                        <h2 class="h6 mb-1">版本内容</h2>
                        <div class="text-muted small">@SelectedItemTitle</div>
                    </div>
                </div>
                @if (SelectedItemId == null)
                {
                    <div class="knowledge-empty-compact mb-3">未选择文档</div>
                }
                <EditForm Model="@VersionForm" OnValidSubmit="@CreateVersionAsync">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label" for="version-title">标题</label>
                        <input id="version-title" class="form-control" @bind="VersionForm.Title" @bind:event="oninput" disabled="@(SelectedItemId == null || IsBusy)" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="version-content">正文</label>
                        <textarea id="version-content" class="form-control" rows="6" @bind="VersionForm.ContentText" @bind:event="oninput" disabled="@(SelectedItemId == null || IsBusy)"></textarea>
                    </div>

                    <button class="btn btn-primary" type="submit" disabled="@(IsBusy || SelectedItemId == null)">创建版本</button>
                </EditForm>
            </div>
        </div>
    </div>

    @* 右侧负责展示知识文档列表、版本列表和附件列表。 *@
    <div class="col-xl-8">
        <div class="card mb-3">
            <div class="card-body border-bottom">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div>
                        <h2 class="h6 mb-1">文档列表</h2>
                        <div class="text-muted small">@TotalCount 条文档</div>
                    </div>
                    @if (SelectedItemId.HasValue)
                    {
                        <span class="badge bg-primary-subtle text-primary-emphasis">已打开：@SelectedItemTitle</span>
                    }
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>标题</th>
                            <th>分类</th>
                            <th>发布</th>
                            <th>状态</th>
                            <th class="text-end">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">加载中</td>
                            </tr>
                        }
                        else if (KnowledgeItemList.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">暂无数据</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in KnowledgeItemList)
                            {
                                <tr class="@(SelectedItemId == item.Id ? "table-active" : null)">
                                    <td>
                                        <div class="fw-semibold">@item.Title</div>
                                        @if (!string.IsNullOrWhiteSpace(item.Summary))
                                        {
                                            <div class="text-muted small">@item.Summary</div>
                                        }
                                    </td>
                                    <td>@GetCategoryName(item.CategoryId)</td>
                                    <td>@(item.CurrentPublishedVersionId.HasValue ? "已发布" : "未发布")</td>
                                    <td>
                                        <span class="badge @(item.IsActive ? "bg-success" : "bg-secondary")">
                                            @(item.IsActive ? "启用" : "停用")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-link btn-sm" type="button" @onclick="() => SelectItemAsync(item)">打开</button>
                                        <button class="btn btn-link btn-sm" type="button" @onclick="() => EditItemAsync(item)">编辑</button>
                                        <button class="btn btn-link btn-sm text-danger" type="button" @onclick="() => DeleteItemAsync(item)" disabled="@IsBusy">删除</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <MvpPager SkipCount="SkipCount" PageSize="PageSize" TotalCount="TotalCount" IsBusy="IsBusy" OnSkipCountChanged="ChangePageAsync" />
        </div>

        <div class="card">
            <div class="card-body border-bottom">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div>
                        <h2 class="h6 mb-1">版本</h2>
                        <div class="text-muted small">@SelectedItemTitle</div>
                    </div>
                    @if (SelectedVersionId.HasValue)
                    {
                        <span class="badge bg-secondary">@SelectedVersionTitle</span>
                    }
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>版本</th>
                            <th>标题</th>
                            <th>状态</th>
                            @if (CanManageIndexJobs)
                            {
                                <th>索引</th>
                            }
                            <th>发布时间</th>
                            <th class="text-end">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (SelectedItemId == null)
                        {
                            <tr>
                                <td colspan="@VersionTableColumnCount" class="text-center py-4 text-muted">
                                    <div class="knowledge-empty-state">未打开文档</div>
                                </td>
                            </tr>
                        }
                        else if (VersionList.Count == 0)
                        {
                            <tr>
                                <td colspan="@VersionTableColumnCount" class="text-center py-4 text-muted">
                                    <div class="knowledge-empty-state">暂无版本</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var version in VersionList)
                            {
                                <tr>
                                    <td>v@(version.VersionNumber)</td>
                                    <td>@version.Title</td>
                                    <td>
                                        <span class="badge @(version.IsCurrentPublished ? "bg-success" : "bg-secondary")">
                                            @GetVersionStatusText(version)
                                        </span>
                                    </td>
                                    @if (CanManageIndexJobs)
                                    {
                                        var latestJob = GetLatestIndexJob(version.Id);
                                        <td>
                                            @if (latestJob == null)
                                            {
                                                <span class="text-muted small">未索引</span>
                                            }
                                            else
                                            {
                                                <div>
                                                    <span class="badge @GetIndexStatusBadge(latestJob.Status)">@GetIndexStatusText(latestJob.Status)</span>
                                                </div>
                                                <div class="text-muted small">@GetIndexJobTimeText(latestJob)</div>
                                                @if (!string.IsNullOrWhiteSpace(latestJob.FailureReason))
                                                {
                                                    <div class="text-danger small">@latestJob.FailureStage：@latestJob.FailureReason</div>
                                                }
                                            }
                                        </td>
                                    }
                                    <td>@(version.PublishedTime?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                                    <td class="text-end">
                                        <button class="btn btn-link btn-sm" type="button" @onclick="() => PreviewVersion(version)">预览</button>
                                        <button class="btn btn-link btn-sm" type="button" @onclick="() => PublishVersionAsync(version)" disabled="@IsBusy">发布</button>
                                        <button class="btn btn-link btn-sm" type="button" @onclick="() => WithdrawVersionAsync(version)" disabled="@IsBusy">下架</button>
                                        @if (CanManageIndexJobs)
                                        {
                                            <button class="btn btn-link btn-sm" type="button" @onclick="() => ReindexVersionAsync(version)" disabled="@IsBusy">重建索引</button>
                                        }
                                        <button class="btn btn-link btn-sm text-danger" type="button" @onclick="() => ArchiveVersionAsync(version)" disabled="@IsBusy">归档</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @if (PreviewedVersion != null)
        {
            <div class="card mt-3">
                <div class="card-body border-bottom">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                        <div>
                            <h2 class="h6 mb-1">版本预览</h2>
                            <div class="text-muted small">v@(PreviewedVersion.VersionNumber) - @PreviewedVersion.Title</div>
                        </div>
                        <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="CloseVersionPreview">关闭</button>
                    </div>
                </div>
                <div class="card-body">
                    @if (string.IsNullOrWhiteSpace(PreviewedVersion.ContentText))
                    {
                        <div class="text-muted">暂无正文</div>
                    }
                    else
                    {
                        <pre class="knowledge-version-preview mb-0">@PreviewedVersion.ContentText</pre>
                    }
                </div>
            </div>
        }

        <div class="card mt-3">
            <div class="card-body border-bottom">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div>
                        <h2 class="h6 mb-1">知识反馈</h2>
                        <div class="text-muted small">@FeedbackSourceText</div>
                    </div>
                </div>
            </div>
            <div class="card-body">
                @if (SelectedItemId == null)
                {
                    <div class="knowledge-empty-compact mb-3">未选择文档</div>
                }
                <EditForm Model="@FeedbackForm" OnValidSubmit="@SubmitFeedbackAsync">
                    <DataAnnotationsValidator />

                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label" for="feedback-type">类型</label>
                            <InputSelect id="feedback-type" class="form-select" @bind-Value="FeedbackForm.Type" disabled="@(SelectedItemId == null || IsBusy)">
                                <option value="@KnowledgeFeedbackType.Problem">问题</option>
                                <option value="@KnowledgeFeedbackType.Outdated">过期</option>
                                <option value="@KnowledgeFeedbackType.Error">错误</option>
                                <option value="@KnowledgeFeedbackType.Missing">缺失</option>
                                <option value="@KnowledgeFeedbackType.Suggestion">建议</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label" for="feedback-title">标题</label>
                            <input id="feedback-title" class="form-control" @bind="FeedbackForm.Title" @bind:event="oninput" disabled="@(SelectedItemId == null || IsBusy)" />
                        </div>
                    </div>

                    <div class="mt-2">
                        <label class="form-label" for="feedback-description">说明</label>
                        <textarea id="feedback-description" class="form-control" rows="3" @bind="FeedbackForm.Description" @bind:event="oninput" disabled="@(SelectedItemId == null || IsBusy)"></textarea>
                    </div>

                    <div class="mt-3">
                        <button class="btn btn-outline-primary btn-sm" type="submit" disabled="@(IsBusy || SelectedItemId == null)">提交反馈</button>
                    </div>
                </EditForm>
            </div>
        </div>

        @* 附件绑定到具体知识版本，文件内容走 BlobStoring/MinIO，页面只展示元数据和下载入口。 *@
        <div class="card mt-3">
            <div class="card-body border-bottom">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div>
                        <h2 class="h6 mb-1">版本附件</h2>
                        <div class="text-muted small">@SelectedVersionTitle</div>
                    </div>
                    <span class="badge bg-light text-dark">@AttachmentStepText</span>
                </div>
            </div>
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label" for="attachment-version">版本</label>
                        <select id="attachment-version" class="form-select" value="@SelectedVersionIdText" @onchange="OnSelectedVersionChangedAsync" disabled="@(SelectedItemId == null || VersionList.Count == 0)">
                            <option value="">选择版本</option>
                            @foreach (var version in VersionList)
                            {
                                <option value="@version.Id">v@(version.VersionNumber) - @version.Title</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label" for="attachment-file">文件</label>
                        <InputFile id="attachment-file" class="form-control" OnChange="@OnAttachmentFileChanged" disabled="@(SelectedVersionId == null)" />
                        <div class="form-text">最大 @FormatFileSize(MaxAttachmentBytes)</div>
                    </div>
                    <div class="col-md-2">
                        <button class="btn btn-primary w-100" type="button" @onclick="UploadAttachmentAsync" disabled="@(IsBusy || IsUploadingAttachment || SelectedItemId == null || SelectedVersionId == null || SelectedAttachmentFile == null)">
                            @(IsUploadingAttachment ? "上传中" : "上传")
                        </button>
                    </div>
                </div>

                @if (SelectedAttachmentFile != null)
                {
                    <div class="text-muted small mt-2">@SelectedAttachmentFile.Name (@FormatFileSize(SelectedAttachmentFile.Size))</div>
                }
                @if (IsUploadingAttachment)
                {
                    <div class="progress mt-3" role="progressbar" aria-label="附件上传中">
                        <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%">上传中</div>
                    </div>
                }
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>文件名</th>
                            <th>类型</th>
                            <th>大小</th>
                            <th class="text-end">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (SelectedVersionId == null)
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    <div class="knowledge-empty-state">未选择版本</div>
                                </td>
                            </tr>
                        }
                        else if (AttachmentList.Count == 0)
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    <div class="knowledge-empty-state">暂无附件</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var attachment in AttachmentList)
                            {
                                <tr>
                                    <td class="fw-semibold">@attachment.FileName</td>
                                    <td>@attachment.ContentType</td>
                                    <td>@FormatFileSize(attachment.Size)</td>
                                    <td class="text-end">
                                        <button class="btn btn-link btn-sm" type="button" @onclick="() => PreviewAttachmentAsync(attachment)" disabled="@(IsBusy || !CanPreviewAttachment(attachment))" title="@GetPreviewUnavailableText(attachment)">预览</button>
                                        <button class="btn btn-link btn-sm" type="button" @onclick="() => DownloadAttachmentAsync(attachment)" disabled="@IsBusy">下载</button>
                                        <button class="btn btn-link btn-sm text-danger" type="button" @onclick="() => DeleteAttachmentAsync(attachment)" disabled="@IsBusy">删除</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    // MVP-0 管理页面统一使用固定页大小，避免引入额外分页配置状态。
    private const int PageSize = 20;

    // 浏览器端上传限制，后端仍需继续依赖应用服务和对象存储的校验兜底。
    private const long MaxAttachmentBytes = 20 * 1024 * 1024;

    // 页面状态按业务区域拆分：知识文档、分类、版本、附件分别维护列表。
    private readonly List<KnowledgeItemDto> KnowledgeItemList = new();
    private readonly List<KnowledgeCategoryDto> CategoryList = new();
    private readonly List<KnowledgeVersionDto> VersionList = new();
    private readonly List<KnowledgeAttachmentDto> AttachmentList = new();
    private readonly Dictionary<Guid, KnowledgeIndexJobDto> LatestIndexJobsByVersion = new();
    private KnowledgeItemFormModel ItemForm { get; set; } = new();
    private KnowledgeVersionFormModel VersionForm { get; set; } = new();
    private KnowledgeFeedbackFormModel FeedbackForm { get; set; } = new();
    private KnowledgeItemDto? SelectedItem { get; set; }
    private KnowledgeVersionDto? PreviewedVersion { get; set; }
    private Guid? EditingItemId { get; set; }
    private Guid? SelectedItemId { get; set; }
    private Guid? SelectedVersionId { get; set; }
    private string? SelectedVersionIdText { get; set; }
    private IBrowserFile? SelectedAttachmentFile { get; set; }
    private int SkipCount { get; set; }
    private long TotalCount { get; set; }
    private bool IsUploadingAttachment { get; set; }
    private bool IsLoading { get; set; }
    private bool IsBusy { get; set; }
    // 索引状态和重建操作属于运维/管理员能力。没有 IndexJobs 权限时，
    // 页面仍可管理知识版本，但不会泄露索引任务信息或显示重建入口。
    private bool CanManageIndexJobs { get; set; }
    private string? ErrorMessage { get; set; }
    private string? FeedbackSuccessMessage { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "itemId")]
    public Guid? QueryItemId { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "versionId")]
    public Guid? QueryVersionId { get; set; }

    private string ItemFormTitle => EditingItemId.HasValue ? "编辑知识文档" : "新增知识文档";
    private string ItemFormSubtitle => EditingItemId.HasValue ? "文档元数据" : "新文档元数据";
    private string ItemSubmitText => EditingItemId.HasValue ? "保存修改" : "创建并打开";
    private KnowledgeVersionDto? SelectedVersion => SelectedVersionId.HasValue
        ? VersionList.FirstOrDefault(x => x.Id == SelectedVersionId.Value)
        : null;
    private string SelectedItemTitle => SelectedItem?.Title ?? "未打开文档";
    private string SelectedVersionTitle => SelectedVersion == null
        ? "未选择版本"
        : $"v{SelectedVersion.VersionNumber} - {SelectedVersion.Title}";
    private string AttachmentStepText => SelectedVersionId.HasValue ? $"{AttachmentList.Count} 个附件" : "未选择版本";
    private string FeedbackSourceText => SelectedItemId == null
        ? "未选择文档"
        : $"{SelectedItemTitle} / {SelectedVersionTitle}";
    private int VersionTableColumnCount => CanManageIndexJobs ? 6 : 5;

    /// <summary>
    /// 初始化知识管理页权限状态，并加载首屏知识文档、分类和默认版本附件数据。
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        CanManageIndexJobs = await PermissionChecker.IsGrantedAsync(KnowPulsePermissions.KnowledgeIndexing.IndexJobs);
        await LoadAsync();
        await ApplyQuerySelectionAsync();
    }

    /// <summary>
    /// 首次加载和刷新时同时拉取分类和知识文档；若已有选中文档，则同步刷新版本与附件。
    /// </summary>
    private async Task LoadAsync()
    {
        await RunBusyAsync(async () =>
        {
            IsLoading = true;
            var categories = await CategoryAppService.GetListAsync(new PagedAndSortedResultRequestDto { MaxResultCount = 100 });
            var items = await KnowledgeItemAppService.GetListAsync(new PagedAndSortedResultRequestDto
            {
                SkipCount = SkipCount,
                MaxResultCount = PageSize
            });

            CategoryList.Clear();
            CategoryList.AddRange(categories.Items.OrderBy(x => x.Code));
            KnowledgeItemList.Clear();
            KnowledgeItemList.AddRange(items.Items.OrderBy(x => x.Title));
            TotalCount = items.TotalCount;

            if (SelectedItemId.HasValue)
            {
                SelectedItem = KnowledgeItemList.FirstOrDefault(x => x.Id == SelectedItemId.Value) ?? SelectedItem;
                await LoadVersionsAsync(SelectedItemId.Value);
            }

            IsLoading = false;
        });
    }

    /// <summary>
    /// 支持从学习中心携带 itemId/versionId 跳转到指定知识版本。
    /// </summary>
    private async Task ApplyQuerySelectionAsync()
    {
        if (!QueryItemId.HasValue)
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            var item = await KnowledgeItemAppService.GetAsync(QueryItemId.Value);
            SelectedItem = item;
            SelectedItemId = item.Id;
            SelectedVersionId = QueryVersionId;
            SelectedVersionIdText = QueryVersionId?.ToString();
            SelectedAttachmentFile = null;
            PreviewedVersion = null;
            AttachmentList.Clear();

            await LoadVersionsAsync(item.Id);

            if (SelectedVersionId.HasValue)
            {
                var selectedVersion = VersionList.FirstOrDefault(x => x.Id == SelectedVersionId.Value);
                if (selectedVersion != null)
                {
                    PreviewVersion(selectedVersion);
                }
            }
        });
    }

    /// <summary>
    /// 切换知识文档列表分页位置，不重置当前编辑表单和版本选择。
    /// </summary>
    /// <param name="skipCount">新分页起始偏移量。</param>
    private async Task ChangePageAsync(int skipCount)
    {
        SkipCount = skipCount;
        await LoadAsync();
    }

    /// <summary>
    /// 进入新增知识文档模式，并清空左侧文档元数据表单。
    /// </summary>
    private void StartCreateItem()
    {
        EditingItemId = null;
        ItemForm = new KnowledgeItemFormModel();
    }

    /// <summary>
    /// 保存知识文档元数据。正文不在这里保存，而是通过版本创建单独维护。
    /// </summary>
    private async Task SaveItemAsync()
    {
        await RunBusyAsync(async () =>
        {
            var wasCreating = !EditingItemId.HasValue;
            KnowledgeItemDto savedItem;
            if (EditingItemId.HasValue)
            {
                savedItem = await KnowledgeItemAppService.UpdateAsync(EditingItemId.Value, new UpdateKnowledgeItemDto
                {
                    CategoryId = ParseNullableGuid(ItemForm.CategoryIdText),
                    Title = ItemForm.Title.Trim(),
                    Summary = NormalizeOptionalText(ItemForm.Summary),
                    IsActive = ItemForm.IsActive
                });
            }
            else
            {
                savedItem = await KnowledgeItemAppService.CreateAsync(new CreateKnowledgeItemDto
                {
                    CategoryId = ParseNullableGuid(ItemForm.CategoryIdText),
                    Title = ItemForm.Title.Trim(),
                    Summary = NormalizeOptionalText(ItemForm.Summary)
                });
            }

            SelectedItem = savedItem;
            SelectedItemId = savedItem.Id;
            if (wasCreating)
            {
                SelectedVersionId = null;
                SelectedVersionIdText = null;
                SelectedAttachmentFile = null;
                PreviewedVersion = null;
                VersionList.Clear();
                AttachmentList.Clear();
            }

            ResetItemForm();
            await LoadAsync();
        });
    }

    /// <summary>
    /// 选择知识文档后清空旧的版本附件状态，避免跨文档显示残留附件。
    /// </summary>
    /// <param name="item">被用户选中的知识文档。</param>
    private async Task SelectItemAsync(KnowledgeItemDto item)
    {
        FeedbackSuccessMessage = null;
        SelectedItem = item;
        SelectedItemId = item.Id;
        SelectedVersionId = null;
        SelectedVersionIdText = null;
        SelectedAttachmentFile = null;
        PreviewedVersion = null;
        AttachmentList.Clear();
        await RunBusyAsync(() => LoadVersionsAsync(item.Id));
    }

    /// <summary>
    /// 将列表行数据回填到左侧编辑表单，必要时同步切换版本和附件上下文。
    /// </summary>
    /// <param name="item">准备编辑的知识文档。</param>
    private async Task EditItemAsync(KnowledgeItemDto item)
    {
        FeedbackSuccessMessage = null;
        var itemChanged = SelectedItemId != item.Id;
        SelectedItem = item;
        EditingItemId = item.Id;
        SelectedItemId = item.Id;
        ItemForm = new KnowledgeItemFormModel
        {
            CategoryIdText = item.CategoryId?.ToString() ?? string.Empty,
            Title = item.Title,
            Summary = item.Summary,
            IsActive = item.IsActive
        };

        if (itemChanged)
        {
            SelectedVersionId = null;
            SelectedVersionIdText = null;
            SelectedAttachmentFile = null;
            PreviewedVersion = null;
            AttachmentList.Clear();
            await RunBusyAsync(() => LoadVersionsAsync(item.Id));
        }
    }

    /// <summary>
    /// 删除知识文档，并同步清理页面上依赖该文档的版本、附件和编辑状态。
    /// </summary>
    /// <param name="item">准备删除的知识文档。</param>
    private async Task DeleteItemAsync(KnowledgeItemDto item)
    {
        if (!await ConfirmAsync($"确定删除知识文档「{item.Title}」吗？"))
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            var id = item.Id;
            await KnowledgeItemAppService.DeleteAsync(id);
            if (EditingItemId == id)
            {
                ResetItemForm();
            }
            if (SelectedItemId == id)
            {
                SelectedItemId = null;
                SelectedVersionId = null;
                SelectedVersionIdText = null;
                SelectedAttachmentFile = null;
                SelectedItem = null;
                PreviewedVersion = null;
                VersionList.Clear();
                AttachmentList.Clear();
            }
            await LoadAsync();
        });
    }

    /// <summary>
    /// 创建知识版本后自动选中新版本，便于用户继续上传该版本附件。
    /// </summary>
    private async Task CreateVersionAsync()
    {
        if (SelectedItemId == null)
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            var version = await KnowledgeItemAppService.CreateVersionAsync(SelectedItemId.Value, new CreateKnowledgeVersionDto
            {
                Title = VersionForm.Title.Trim(),
                ContentText = NormalizeOptionalText(VersionForm.ContentText)
            });
            VersionForm = new KnowledgeVersionFormModel();
            SelectedVersionId = version.Id;
            SelectedVersionIdText = version.Id.ToString();
            await LoadVersionsAsync(SelectedItemId.Value);
            PreviewedVersion = VersionList.FirstOrDefault(x => x.Id == version.Id);
            await LoadAttachmentsAsync();
        });
    }

    /// <summary>
    /// 提交当前知识和版本的用户反馈。该操作只创建反馈记录，不修改知识版本。
    /// </summary>
    private async Task SubmitFeedbackAsync()
    {
