    {
        PreviewedVersion = null;
    }

    /// <summary>
    /// 发布指定知识版本，并让后端维护当前发布版本唯一性。
    /// </summary>
    /// <param name="version">准备发布的知识版本。</param>
    private async Task PublishVersionAsync(KnowledgeVersionDto version)
    {
        if (!await ConfirmAsync($"确定发布 v{version.VersionNumber}「{version.Title}」吗？发布后会成为当前版本。"))
        {
            return;
        }

        await RunVersionCommandAsync(version.Id, KnowledgeItemAppService.PublishVersionAsync);
    }

    /// <summary>
    /// 下架指定知识版本；如果它是当前发布版本，后端会同步清空当前发布版本引用。
    /// </summary>
    /// <param name="version">准备下架的知识版本。</param>
    private async Task WithdrawVersionAsync(KnowledgeVersionDto version)
    {
        if (!await ConfirmAsync($"确定下架 v{version.VersionNumber}「{version.Title}」吗？当前用户将不能再按已发布版本访问它。"))
        {
            return;
        }

        await RunVersionCommandAsync(version.Id, KnowledgeItemAppService.WithdrawVersionAsync);
    }

    /// <summary>
    /// 归档指定知识版本，用于保留历史事实且不再参与当前发布。
    /// </summary>
    /// <param name="version">准备归档的知识版本。</param>
    private async Task ArchiveVersionAsync(KnowledgeVersionDto version)
    {
        if (!await ConfirmAsync($"确定归档 v{version.VersionNumber}「{version.Title}」吗？归档版本不能再次发布。"))
        {
            return;
        }

        await RunVersionCommandAsync(version.Id, KnowledgeItemAppService.ArchiveVersionAsync);
    }

    /// <summary>
    /// 统一执行知识版本状态命令，减少发布、下架、归档之间的刷新逻辑重复。
    /// </summary>
    /// <param name="versionId">要操作的知识版本标识。</param>
    /// <param name="command">由应用服务提供的版本状态变更命令。</param>
    private async Task RunVersionCommandAsync(Guid versionId, Func<Guid, Guid, Task<KnowledgeVersionDto>> command)
    {
        if (SelectedItemId == null)
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            await command(SelectedItemId.Value, versionId);
            await LoadVersionsAsync(SelectedItemId.Value);
            await LoadAsync();
        });
    }

    /// <summary>
    /// 刷新指定知识文档的版本列表，并同步维护选中版本、预览版本和附件列表状态。
    /// </summary>
    /// <param name="itemId">需要加载版本列表的知识文档标识。</param>
    private async Task LoadVersionsAsync(Guid itemId)
    {
        var result = await KnowledgeItemAppService.GetVersionsAsync(itemId);
        VersionList.Clear();
        LatestIndexJobsByVersion.Clear();
        VersionList.AddRange(result.Items.OrderByDescending(x => x.VersionNumber));

        if (CanManageIndexJobs)
        {
            await LoadIndexJobsAsync(itemId);
        }

        if (SelectedVersionId.HasValue && VersionList.All(x => x.Id != SelectedVersionId.Value))
        {
            SelectedVersionId = null;
            SelectedVersionIdText = null;
            SelectedAttachmentFile = null;
            AttachmentList.Clear();
        }

        if (!SelectedVersionId.HasValue && VersionList.Count > 0)
        {
            var latestVersion = VersionList[0];
            SelectedVersionId = latestVersion.Id;
            SelectedVersionIdText = latestVersion.Id.ToString();
            SelectedAttachmentFile = null;
        }

        if (PreviewedVersion != null)
        {
            PreviewedVersion = VersionList.FirstOrDefault(x => x.Id == PreviewedVersion.Id);
        }

        if (SelectedVersionId.HasValue)
        {
            await LoadAttachmentsAsync();
        }
    }

    /// <summary>
    /// 加载指定知识文档下每个版本的最近一次索引任务，用于版本表格展示索引状态。
    /// </summary>
    /// <param name="itemId">需要加载索引任务的知识文档标识。</param>
    private async Task LoadIndexJobsAsync(Guid itemId)
    {
        // 版本列表只需要展示每个版本的最近一次索引任务。
        // 这里拉取当前知识文档下的任务后按版本分组，避免每行单独请求后端。
        var result = await IndexJobAppService.GetListAsync(new GetKnowledgeIndexJobListInput
        {
            KnowledgeItemId = itemId,
            MaxResultCount = 100
        });

        foreach (var job in result.Items
                     .OrderByDescending(x => x.CreationTime)
                     .GroupBy(x => x.KnowledgeVersionId)
                     .Select(x => x.First()))
        {
            LatestIndexJobsByVersion[job.KnowledgeVersionId] = job;
        }
    }

    /// <summary>
    /// 为指定知识版本创建手动重建索引任务，并刷新该版本所在文档的索引状态。
    /// </summary>
    /// <param name="version">需要重建索引的知识版本。</param>
    private async Task ReindexVersionAsync(KnowledgeVersionDto version)
    {
        // 手动重建不会改知识版本状态，只是创建新的索引任务；
        // 任务处理失败时会在索引任务页和本表格中展示失败阶段/原因。
        if (!await ConfirmAsync($"确定为 v{version.VersionNumber}「{version.Title}」创建重建索引任务吗？"))
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            await IndexJobAppService.ReindexVersionAsync(version.Id);
            if (SelectedItemId.HasValue)
            {
                await LoadVersionsAsync(SelectedItemId.Value);
            }
        });
    }

    /// <summary>
    /// 响应版本下拉选择变化，切换当前附件上下文并重新加载附件列表。
    /// </summary>
    /// <param name="args">包含用户选择版本标识的变更事件参数。</param>
    private async Task OnSelectedVersionChangedAsync(ChangeEventArgs args)
    {
        SelectedVersionIdText = args.Value?.ToString();
        SelectedVersionId = ParseNullableGuid(SelectedVersionIdText);
        SelectedAttachmentFile = null;
        await RunBusyAsync(LoadAttachmentsAsync);
    }

    /// <summary>
    /// 记录浏览器文件选择结果，真正上传发生在用户点击上传按钮时。
    /// </summary>
    /// <param name="args">浏览器文件选择事件参数。</param>
    private void OnAttachmentFileChanged(InputFileChangeEventArgs args)
    {
        SelectedAttachmentFile = args.File;
    }

    /// <summary>
    /// 通过 RemoteStreamContent 把浏览器文件流传给后端，后端负责文件名归一化和对象存储写入。
    /// </summary>
    private async Task UploadAttachmentAsync()
    {
        if (SelectedItemId == null || SelectedVersionId == null || SelectedAttachmentFile == null)
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            try
            {
                IsUploadingAttachment = true;
                var stream = SelectedAttachmentFile.OpenReadStream(MaxAttachmentBytes);
                using var content = new RemoteStreamContent(
                    stream,
                    SelectedAttachmentFile.Name,
                    string.IsNullOrWhiteSpace(SelectedAttachmentFile.ContentType)
                        ? "application/octet-stream"
                        : SelectedAttachmentFile.ContentType,
                    SelectedAttachmentFile.Size,
                    disposeStream: true);

                await KnowledgeItemAppService.UploadAttachmentAsync(SelectedItemId.Value, SelectedVersionId.Value, content);
                SelectedAttachmentFile = null;
                await LoadAttachmentsAsync();
            }
            finally
            {
                IsUploadingAttachment = false;
            }
        });
    }

    /// <summary>
    /// 下载指定附件流并交给浏览器侧预览工具打开临时 Blob URL。
    /// </summary>
    /// <param name="attachment">准备在线预览的知识附件。</param>
    private async Task PreviewAttachmentAsync(KnowledgeAttachmentDto attachment)
    {
        if (SelectedItemId == null || SelectedVersionId == null)
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            var content = await KnowledgeItemAppService.DownloadAttachmentAsync(
                SelectedItemId.Value,
                SelectedVersionId.Value,
                attachment.Id);

            await using var stream = content.GetStream();
            using var streamReference = new DotNetStreamReference(stream);
            await JSRuntime.InvokeVoidAsync(
                "knowPulse.previewFileFromStream",
                content.FileName ?? attachment.FileName,
                content.ContentType ?? attachment.ContentType,
                streamReference);

            if (content is IDisposable disposable)
            {
                disposable.Dispose();
            }
        });
    }

    /// <summary>
    /// 下载时把后端返回的远程流交给 JS helper，避免把文件内容先完整加载到页面状态里。
    /// </summary>
    /// <param name="attachment">准备下载的知识附件。</param>
    private async Task DownloadAttachmentAsync(KnowledgeAttachmentDto attachment)
    {
        if (SelectedItemId == null || SelectedVersionId == null)
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            var content = await KnowledgeItemAppService.DownloadAttachmentAsync(
                SelectedItemId.Value,
                SelectedVersionId.Value,
                attachment.Id);

            await using var stream = content.GetStream();
            using var streamReference = new DotNetStreamReference(stream);
            await JSRuntime.InvokeVoidAsync(
                "knowPulse.downloadFileFromStream",
                content.FileName ?? attachment.FileName,
                content.ContentType ?? attachment.ContentType,
                streamReference);

            if (content is IDisposable disposable)
            {
                disposable.Dispose();
            }
        });
    }

    /// <summary>
    /// 删除指定知识附件，后端会同时删除 Blob 对象和附件元数据。
    /// </summary>
    /// <param name="attachment">准备删除的知识附件。</param>
    private async Task DeleteAttachmentAsync(KnowledgeAttachmentDto attachment)
    {
        if (SelectedItemId == null || SelectedVersionId == null)
        {
            return;
        }

        if (!await ConfirmAsync($"确定删除附件「{attachment.FileName}」吗？"))
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            await KnowledgeItemAppService.DeleteAttachmentAsync(SelectedItemId.Value, SelectedVersionId.Value, attachment.Id);
            await LoadAttachmentsAsync();
        });
    }

    /// <summary>
    /// 加载当前选中知识版本的附件列表；未选中文档或版本时清空附件状态。
    /// </summary>
    private async Task LoadAttachmentsAsync()
    {
        AttachmentList.Clear();
