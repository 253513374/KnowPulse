    }

    /// <summary>
    /// 判断附件是否属于浏览器侧允许在线预览的安全类型。
    /// </summary>
    /// <param name="attachment">需要判断的知识附件。</param>
    /// <returns>允许在线预览时返回 true。</returns>
    private static bool CanPreviewAttachment(KnowledgeAttachmentDto attachment)
    {
        var contentType = NormalizePreviewContentType(attachment.ContentType);
        var fileName = attachment.FileName ?? string.Empty;

        return IsPreviewablePdf(fileName, contentType)
               || IsSafeTextPreview(fileName, contentType)
               || IsPreviewableMedia(contentType);
    }

    /// <summary>
    /// 获取附件无法在线预览时的提示文本。
    /// </summary>
    /// <param name="attachment">需要判断预览能力的知识附件。</param>
    /// <returns>不支持预览时的提示文本；支持预览时返回 null。</returns>
    private static string? GetPreviewUnavailableText(KnowledgeAttachmentDto attachment)
    {
        return CanPreviewAttachment(attachment) ? null : "该类型暂不支持在线预览，请下载后查看";
    }

    /// <summary>
    /// 判断附件是否为可由浏览器安全预览的 PDF 文件。
    /// </summary>
    /// <param name="fileName">附件文件名。</param>
    /// <param name="contentType">归一化后的内容类型。</param>
    /// <returns>附件为 PDF 时返回 true。</returns>
    private static bool IsPreviewablePdf(string fileName, string contentType)
    {
        return contentType == "application/pdf" || HasExtension(fileName, ".pdf");
    }

    /// <summary>
    /// 判断附件是否为安全文本预览类型，并排除 HTML、XML 和 SVG 等主动内容。
    /// </summary>
    /// <param name="fileName">附件文件名。</param>
    /// <param name="contentType">归一化后的内容类型。</param>
    /// <returns>附件可按文本安全预览时返回 true。</returns>
    private static bool IsSafeTextPreview(string fileName, string contentType)
    {
        if (contentType == "application/json")
        {
            return true;
        }

        if (HasExtension(fileName, ".txt", ".md", ".markdown", ".json", ".csv", ".log", ".yaml", ".yml"))
        {
            return true;
        }

        return contentType.StartsWith("text/", StringComparison.OrdinalIgnoreCase)
               && contentType != "text/html"
               && contentType != "text/xml"
               && contentType != "image/svg+xml";
    }

    /// <summary>
    /// 判断附件是否为浏览器可直接预览的图片、音频或视频媒体类型。
    /// </summary>
    /// <param name="contentType">归一化后的内容类型。</param>
    /// <returns>附件为可预览媒体类型时返回 true。</returns>
    private static bool IsPreviewableMedia(string contentType)
    {
        if (contentType == "image/svg+xml")
        {
            return false;
        }

        return contentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)
               || contentType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase)
               || contentType.StartsWith("video/", StringComparison.OrdinalIgnoreCase);
    }

    /// <summary>
    /// 归一化内容类型，仅保留主类型并转为小写以便预览规则匹配。
    /// </summary>
    /// <param name="contentType">原始 Content-Type。</param>
    /// <returns>归一化后的内容类型字符串。</returns>
    private static string NormalizePreviewContentType(string? contentType)
    {
        return (contentType ?? string.Empty).Split(';', StringSplitOptions.TrimEntries)[0].ToLowerInvariant();
    }

    /// <summary>
    /// 判断文件名是否匹配任意指定扩展名，比较时忽略大小写。
    /// </summary>
    /// <param name="fileName">需要判断的文件名。</param>
    /// <param name="extensions">允许匹配的扩展名集合。</param>
    /// <returns>文件名匹配任意扩展名时返回 true。</returns>
    private static bool HasExtension(string fileName, params string[] extensions)
    {
        return extensions.Any(extension => fileName.EndsWith(extension, StringComparison.OrdinalIgnoreCase));
    }

    /// <summary>
    /// 将空白文本按 null 传给后端，减少数据库中的无意义空字符串。
    /// </summary>
    /// <param name="value">表单中的可选文本。</param>
    /// <returns>去除首尾空白后的文本；空白输入返回 null。</returns>
    private static string? NormalizeOptionalText(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    /// <summary>
    /// 将附件字节数格式化为页面展示的人类可读大小，不参与后端大小校验。
    /// </summary>
    /// <param name="size">附件大小，单位为字节。</param>
    /// <returns>格式化后的文件大小文本。</returns>
    private static string FormatFileSize(long size)
    {
        if (size < 1024)
        {
            return $"{size} B";
        }

        if (size < 1024 * 1024)
        {
            return $"{size / 1024d:0.##} KB";
        }

        return $"{size / 1024d / 1024d:0.##} MB";
    }

    /// <summary>
    /// 将表单下拉保存的字符串值转换为可空 Guid。
    /// </summary>
    /// <param name="value">下拉框中的字符串标识。</param>
    /// <returns>解析成功的 Guid；空值或非法值返回 null。</returns>
    private static Guid? ParseNullableGuid(string? value)
    {
        return Guid.TryParse(value, out var id) ? id : null;
    }

    /// <summary>
    /// 使用浏览器原生确认框请求用户确认危险操作。
    /// </summary>
    /// <param name="message">确认框提示文本。</param>
    /// <returns>用户确认时返回 true。</returns>
    private async Task<bool> ConfirmAsync(string message)
    {
        return await JSRuntime.InvokeAsync<bool>("confirm", message);
    }

    /// <summary>
    /// 统一页面忙碌态和错误处理，保证操作失败后可以通过错误条重试。
    /// </summary>
    /// <param name="action">需要在忙碌态下执行的异步页面操作。</param>
    private async Task RunBusyAsync(Func<Task> action)
    {
        try
        {
            ErrorMessage = null;
            IsBusy = true;
            await action();
        }
        catch (Exception ex)
        {
            ErrorMessage = GetUserFriendlyErrorMessage(ex);
        }
        finally
        {
            IsBusy = false;
            IsLoading = false;
        }
    }

