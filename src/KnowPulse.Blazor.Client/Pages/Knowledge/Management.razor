@page "/knowledge"
@attribute [Authorize(KnowPulsePermissions.KnowledgeBase.Items)]
@inherits KnowPulseComponentBase
@inject IKnowledgeManagementAppService KnowledgeManagementAppService
@inject NavigationManager NavigationManager
@inject Volo.Abp.Users.ICurrentUser CurrentAccount

<PageTitle>知识管理</PageTitle>

<div class="admin-page knowledge-management-page">
    <header class="admin-page-header">
        <div>
            <h1>知识管理</h1>
            <p class="kp-text-muted kp-mb-0">查看当前授权范围内的知识、发布版本与可检索状态。</p>
        </div>
        <button class="kp-button kp-button--primary" type="button" @onclick="CreateKnowledge">
            上传知识
        </button>
    </header>

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="kp-alert kp-alert--error kp-flex kp-flex-wrap kp-align-center kp-justify-between kp-gap-2" role="alert">
            <span>@ErrorMessage</span>
            <button class="kp-button kp-button--sm kp-button--danger-outline" type="button" @onclick="LoadAsync" disabled="@IsLoading">重试</button>
        </div>
    }

    <section class="admin-panel kp-card knowledge-list-card">
        <div class="knowledge-panel-heading"><h2>知识列表</h2><span>内容发布与索引状态分别显示</span></div>
        <div class="kp-card__body kp-border-bottom">
            <div class="knowledge-list-tools">
                <div class="knowledge-status-tabs" role="group" aria-label="知识状态筛选">
                    <button class="@GetStatusTabClass(null)" aria-pressed="@(StatusFilter == null)" type="button" @onclick="() => SetStatusAsync(null)">全部知识 @Overview.TotalCount</button>
                    <button class="@GetStatusTabClass(KnowledgeManagementStatus.Ready)" aria-pressed="@(StatusFilter == KnowledgeManagementStatus.Ready)" type="button"
                            @onclick="() => SetStatusAsync(KnowledgeManagementStatus.Ready)">可用于问答 @Overview.ReadyCount</button>
                    <button class="@GetStatusTabClass(KnowledgeManagementStatus.Publishing)" aria-pressed="@(StatusFilter == KnowledgeManagementStatus.Publishing)" type="button"
                            @onclick="() => SetStatusAsync(KnowledgeManagementStatus.Publishing)">发布处理中</button>
                    <button class="@GetStatusTabClass(KnowledgeManagementStatus.NeedsAttention)" aria-pressed="@(StatusFilter == KnowledgeManagementStatus.NeedsAttention)" type="button"
                            @onclick="() => SetStatusAsync(KnowledgeManagementStatus.NeedsAttention)">需处理 @Overview.NeedsAttentionCount</button>
                    <button class="@GetStatusTabClass(KnowledgeManagementStatus.Draft)" aria-pressed="@(StatusFilter == KnowledgeManagementStatus.Draft)" type="button"
                            @onclick="() => SetStatusAsync(KnowledgeManagementStatus.Draft)">草稿 @Overview.DraftCount</button>
                </div>

                <form class="admin-toolbar knowledge-search" @onsubmit="SearchAsync" @onsubmit:preventDefault>
                    <div class="knowledge-search-field">
                        <label class="kp-label" for="knowledge-keyword">搜索知识</label>
                        <input id="knowledge-keyword" class="kp-input" placeholder="标题 / 摘要 / 分类" @bind="Keyword" @bind:event="oninput" />
                    </div>
                    <div class="knowledge-state-field">
                        <label class="kp-label" for="knowledge-status">知识状态</label>
                        <select id="knowledge-status" class="kp-select" @bind="StatusFilter">
                            <option value="">全部状态</option>
                            @foreach (var status in Enum.GetValues<KnowledgeManagementStatus>())
                            {
                                <option value="@status">@GetStatusText(status)</option>
                            }
                        </select>
                    </div>
                    <button class="kp-button kp-button--primary" type="submit" disabled="@IsLoading">查询</button>
                    <button class="kp-button kp-button--secondary" type="button" @onclick="ResetFiltersAsync" disabled="@IsLoading">重置</button>
                </form>
            </div>
        </div>

        <div class="knowledge-filter-summary">
            <span>当前筛选：<strong>@CurrentFilterText</strong></span>
            <span>共 @TotalCount 条</span>
        </div>

        <div class="kp-table-wrap">
            <table class="kp-table kp-table--hover kp-table-align-middle kp-mb-0 knowledge-management-table">
                <thead>
                    <tr>
                        <th>知识名称 / 分类</th>
                        <th>归属与范围</th>
                        <th>发布状态</th>
                        <th>检索状态</th>
                        <th>更新时间</th>
                        <th class="kp-text-end">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (IsLoading)
                    {
                        <tr>
                            <td colspan="6" class="kp-text-center kp-py-5 kp-text-muted">
                                <span class="kp-spinner kp-spinner--sm kp-me-2" aria-hidden="true"></span>正在加载知识状态
                            </td>
                        </tr>
                    }
                    else if (Items.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="kp-text-center kp-py-5">
                                <div class="knowledge-empty">
                                    <span><i class="fas fa-book-open" aria-hidden="true"></i></span>
                                    <strong>@EmptyTitle</strong>
                                    <p>@EmptyDescription</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Items)
                        {
                            <tr class="@(item.Status == KnowledgeManagementStatus.NeedsAttention ? "knowledge-row-attention" : null)"
                                @onclick="() => OpenDetail(item.Id)">
                                <td>
                                    <div class="knowledge-title-cell">
                                        <span class="knowledge-file-icon @GetFileIconClass(item)">
                                            <i class="@GetFileIcon(item)" aria-hidden="true"></i>
                                        </span>
                                        <span>
                                            <strong>@item.Title</strong>
                                            <small>@GetKnowledgeMeta(item)</small>
                                            @if (item.PendingFeedbackCount > 0)
                                            {
                                                <small class="knowledge-feedback-count">@item.PendingFeedbackCount 条待处理反馈</small>
                                            }
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <span class="knowledge-scope">@GetOwnershipText(item)</span>
                                    <small>@item.AccessScopeText</small>
                                </td>
                                <td><span class="knowledge-status @GetPublicationClass(item)">@GetPublicationText(item)</span></td>
                                <td>
                                    <span class="knowledge-status @GetStatusClass(item.Status)">@GetRetrievalText(item)</span>
                                    <small class="knowledge-status-reason">@item.StatusReason</small>
                                </td>
                                <td>
                                    <strong class="knowledge-update-time">@FormatDate(item.UpdatedTime)</strong>
                                    <small>@GetUpdateText(item)</small>
                                </td>
                                <td class="kp-text-end">
                                    <button class="kp-button kp-button--link kp-button--sm" type="button"
                                            @onclick:stopPropagation="true" @onclick="() => OpenDetail(item.Id)">查看详情</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <MvpPager SkipCount="SkipCount" PageSize="PageSize" TotalCount="TotalCount"
                  IsBusy="IsLoading" OnSkipCountChanged="ChangePageAsync" />
    </section>
</div>

@code {
    private const int PageSize = 20;
    private readonly List<KnowledgeManagementListItemDto> Items = new();
    private KnowledgeManagementOverviewDto Overview { get; set; } = new();
    private KnowledgeManagementStatus? StatusFilter { get; set; }
    private string? Keyword { get; set; }
    private string? ErrorMessage { get; set; }
    private bool IsLoading { get; set; }
    private int SkipCount { get; set; }
    private long TotalCount { get; set; }

    private string CurrentFilterText => StatusFilter.HasValue ? GetStatusText(StatusFilter.Value) : "全部知识";
    private string EmptyTitle => string.IsNullOrWhiteSpace(Keyword) ? "当前筛选下暂无知识" : "没有找到匹配的知识";
    private string EmptyDescription => string.IsNullOrWhiteSpace(Keyword)
        ? "可以新建知识，或切换其他状态查看。"
        : "尝试缩短关键词或清空筛选条件。";

    protected override Task OnInitializedAsync()
    {
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            var result = await KnowledgeManagementAppService.GetListAsync(new GetKnowledgeManagementListInput
            {
                Keyword = string.IsNullOrWhiteSpace(Keyword) ? null : Keyword.Trim(),
                Status = StatusFilter,
                SkipCount = SkipCount,
                MaxResultCount = PageSize,
                Sorting = "UpdatedTime desc"
            });

            Items.Clear();
            Items.AddRange(result.Items);
            Overview = result.Overview;
            TotalCount = result.TotalCount;
        }
        catch (Exception exception)
        {
            ErrorMessage = GetUserFriendlyErrorMessage(exception);
            Items.Clear();
            TotalCount = 0;
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task SetStatusAsync(KnowledgeManagementStatus? status)
    {
        StatusFilter = status;
        SkipCount = 0;
        await LoadAsync();
    }

    private async Task SearchAsync()
    {
        SkipCount = 0;
        await LoadAsync();
    }

    private async Task ResetFiltersAsync()
    {
        Keyword = null;
        StatusFilter = null;
        SkipCount = 0;
        await LoadAsync();
    }

    private async Task ChangePageAsync(int skipCount)
    {
        SkipCount = skipCount;
        await LoadAsync();
    }

    private void CreateKnowledge()
    {
        NavigationManager.NavigateTo("/knowledge/upload");
    }

    private void OpenDetail(Guid id)
    {
        NavigationManager.NavigateTo($"/knowledge/{id:D}");
    }

    private string GetOwnershipText(KnowledgeManagementListItemDto item) => item.OwnerTeacherId == CurrentAccount.Id
        ? "本人资料"
        : item.OwnerTeacherId.HasValue ? "共享教师资料" : "受控历史资料";

    private static string GetPublicationText(KnowledgeManagementListItemDto item) => !item.IsActive ? "已停用" : item.CurrentVersionStatus switch
    {
        KnowledgeVersionStatus.Published => "已发布",
        KnowledgeVersionStatus.Withdrawn => "已下架",
        KnowledgeVersionStatus.Archived => "已归档",
        _ => GetStatusText(item.Status)
    };

    private static string GetPublicationClass(KnowledgeManagementListItemDto item) => item.IsActive && item.CurrentVersionStatus == KnowledgeVersionStatus.Published
        ? "status-ready" : "status-draft";

    private static string GetRetrievalText(KnowledgeManagementListItemDto item) => item.LatestIndexStatus switch
    {
        KnowledgeIndexJobStatus.Pending => "等待索引",
        KnowledgeIndexJobStatus.Processing => "索引处理中",
        KnowledgeIndexJobStatus.Indexed when item.Status == KnowledgeManagementStatus.Ready => "可用于问答",
        KnowledgeIndexJobStatus.Failed => "索引失败",
        KnowledgeIndexJobStatus.Outdated => "索引已过期",
        KnowledgeIndexJobStatus.Deleted => "索引已删除",
        _ => "尚不可检索"
    };

    private string GetStatusTabClass(KnowledgeManagementStatus? status)
    {
        return StatusFilter == status ? "is-active" : string.Empty;
    }

    private static string GetStatusText(KnowledgeManagementStatus status)
    {
        return status switch
        {
            KnowledgeManagementStatus.Draft => "草稿",
            KnowledgeManagementStatus.Publishing => "发布处理中",
            KnowledgeManagementStatus.Ready => "可用于问答",
            KnowledgeManagementStatus.NeedsAttention => "需要处理",
            KnowledgeManagementStatus.Withdrawn => "已下架",
            KnowledgeManagementStatus.Archived => "已归档",
            KnowledgeManagementStatus.Disabled => "已停用",
            _ => status.ToString()
        };
    }

    private static string GetStatusClass(KnowledgeManagementStatus status)
    {
        return status switch
        {
            KnowledgeManagementStatus.Ready => "status-ready",
            KnowledgeManagementStatus.Publishing => "status-publishing",
            KnowledgeManagementStatus.NeedsAttention => "status-attention",
            KnowledgeManagementStatus.Withdrawn or KnowledgeManagementStatus.Archived or KnowledgeManagementStatus.Disabled => "status-inactive",
            _ => "status-draft"
        };
    }

    private static string GetFileIcon(KnowledgeManagementListItemDto item)
    {
        return item.CurrentVersionId.HasValue ? "fas fa-file-lines" : "far fa-file";
    }

    private static string GetFileIconClass(KnowledgeManagementListItemDto item)
    {
        return item.Status switch
        {
            KnowledgeManagementStatus.Ready => "file-ready",
            KnowledgeManagementStatus.NeedsAttention => "file-attention",
            KnowledgeManagementStatus.Publishing => "file-publishing",
            _ => "file-draft"
        };
    }

    private static string GetKnowledgeMeta(KnowledgeManagementListItemDto item)
    {
        var version = item.CurrentVersionNumber.HasValue ? $"v{item.CurrentVersionNumber}" : "未发布";
        return $"{item.CategoryName} · {version} · 共 {item.VersionCount} 个版本";
    }

    private static string GetUpdateText(KnowledgeManagementListItemDto item)
    {
        return item.CurrentVersionNumber.HasValue
            ? $"当前版本 v{item.CurrentVersionNumber}"
            : "最近保存草稿";
    }

    private static string FormatDate(DateTime value)
    {
        var local = value.ToLocalTime();
        var now = DateTime.Now;
        return local.Date == now.Date
            ? $"今天 {local:HH:mm}"
            : local.Year == now.Year
                ? local.ToString("MM 月 dd 日")
                : local.ToString("yyyy-MM-dd");
    }
}
