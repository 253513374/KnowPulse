@page "/knowledge/index-jobs"
@attribute [Authorize(KnowPulsePermissions.KnowledgeIndexing.IndexJobs)]
@inherits KnowPulseComponentBase
@inject IKnowledgeIndexJobAppService IndexJobAppService

<PageTitle>索引运行中心</PageTitle>

<div class="admin-page index-page">
<header class="admin-page-header">
    <div>
        <h1>索引运行中心</h1>
        <p>跟踪真实处理进度，定位失败阶段，并恢复可重试的任务。</p>
    </div>
    <button class="kp-button kp-button--secondary" type="button" @onclick="LoadAsync" disabled="@IsBusy">刷新状态</button>
</header>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="kp-alert kp-alert--error kp-flex kp-flex-wrap kp-align-center kp-justify-between kp-gap-2" role="alert">
        <span>@ErrorMessage</span>
        <button class="kp-button kp-button--sm kp-button--danger-outline" type="button" @onclick="LoadAsync" disabled="@IsBusy">重新加载</button>
    </div>
}

<section class="admin-metrics metric-grid" aria-label="索引任务摘要">
    <article class="admin-metric metric-card queue">
        <span>等待处理</span>
        <strong>@Summary.PendingCount</strong>
        <small>Worker 将自动领取</small>
    </article>
    <article class="admin-metric metric-card running">
        <span>正在运行</span>
        <strong>@Summary.ProcessingCount</strong>
        <small>@Summary.StaleCount 条心跳超时</small>
    </article>
    <article class="admin-metric metric-card failed">
        <span>执行失败</span>
        <strong>@Summary.FailedCount</strong>
        <small>@Summary.RetryDueCount 条已到重试时间</small>
    </article>
    <article class="admin-metric metric-card exhausted">
        <span>运行卡住</span>
        <strong>@Summary.StaleCount</strong>
        <small>另有 @Summary.ExhaustedCount 条重试耗尽</small>
    </article>
</section>

@if (Summary.StaleCount > 0 || Summary.ExhaustedCount > 0)
{
    <div class="attention-strip" role="status">
        <div>
            <strong>队列需要人工处理</strong>
            <span>卡住 @Summary.StaleCount 条，重试耗尽 @Summary.ExhaustedCount 条。请先查看失败阶段，再执行恢复或重新排队。</span>
        </div>
        <button class="kp-button kp-button--sm kp-button--danger-outline" type="button" @onclick="ShowActionableAsync" disabled="@IsBusy">只看失败</button>
    </div>
}

<section class="admin-panel jobs-panel">
    <div class="jobs-toolbar admin-toolbar">
        <div>
            <h2>索引任务</h2>
            <span>最近完成：@FormatTime(Summary.LastIndexedTime, "尚无成功记录")</span>
        </div>
        <div class="filter-group">
            <label for="index-status">状态</label>
            <select id="index-status" class="kp-select kp-select--sm" @bind="StatusFilterText">
                <option value="">全部</option>
                <option value="@KnowledgeIndexJobStatus.Pending">待处理</option>
                <option value="@KnowledgeIndexJobStatus.Processing">处理中</option>
                <option value="@KnowledgeIndexJobStatus.Indexed">已索引</option>
                <option value="@KnowledgeIndexJobStatus.Failed">失败</option>
                <option value="@KnowledgeIndexJobStatus.Outdated">已过期</option>
                <option value="@KnowledgeIndexJobStatus.Deleted">已删除</option>
            </select>
            <button class="kp-button kp-button--primary" type="button" @onclick="ApplyFilterAsync" disabled="@IsBusy">查询</button>
            <button class="kp-button kp-button--secondary" type="button" @onclick="ResetFilterAsync" disabled="@IsBusy">重置</button>
        </div>
    </div>

    <div class="kp-table-wrap">
        <table class="kp-table kp-table-align-middle kp-mb-0 jobs-table">
            <thead>
                <tr>
                    <th>知识与任务</th>
                    <th>状态</th>
                    <th>阶段 / 进度</th>
                    <th>最近心跳</th>
                    <th>重试计划</th>
                    <th class="kp-text-end">操作</th>
                </tr>
            </thead>
            <tbody>
                @if (IsLoading)
                {
                    <tr><td colspan="6" class="empty-cell">正在读取任务队列…</td></tr>
                }
                else if (JobList.Count == 0)
                {
                    <tr><td colspan="6" class="empty-cell">当前筛选条件下没有索引任务</td></tr>
                }
                else
                {
                    @foreach (var job in JobList)
                    {
                        <tr class="@(job.IsStale ? "stale-row" : null)">
                            <td>
                                <a class="knowledge-link" href="@($"/knowledge/{job.KnowledgeItemId}")">知识 @ShortId(job.KnowledgeItemId)</a>
                                <div class="cell-muted">版本 @ShortId(job.KnowledgeVersionId) · 任务 @ShortId(job.Id)</div>
                                <div class="cell-muted">@GetTriggerText(job.TriggerType) · @job.CreationTime.ToLocalTime().ToString("MM-dd HH:mm")</div>
                            </td>
                            <td><span class="index-status @GetIndexStatusClass(job.Status)">@(job.IsStale ? "运行卡住" : GetIndexStatusText(job.Status))</span></td>
                            <td class="progress-cell">
                                <div class="progress-meta">
                                    <span>@GetStageText(job.ProcessingStage)</span>
                                    <strong>@job.ProgressPercent%</strong>
                                </div>
                                <div class="kp-progress" role="progressbar" aria-valuenow="@job.ProgressPercent" aria-valuemin="0" aria-valuemax="100">
                                    <div class="kp-progress__bar @GetProgressClass(job.Status)" style="width: @(job.ProgressPercent)%"></div>
                                </div>
                            </td>
                            <td>@FormatTime(job.LastHeartbeatTime, "尚未启动")</td>
                            <td>
                                <strong>@job.RetryCount / @job.MaxRetryCount</strong>
                                <div class="cell-muted">@FormatRetryPlan(job)</div>
                            </td>
                            <td class="kp-text-end action-cell">
                                <button class="kp-button kp-button--sm kp-button--link" type="button" @onclick="() => SelectJobAsync(job.Id)" disabled="@IsBusy">查看详情</button>
                                @if (job.Status == KnowledgeIndexJobStatus.Pending)
                                {
                                    <button class="kp-button kp-button--sm kp-button--primary" type="button" @onclick="() => ExecuteAsync(job)" disabled="@IsBusy">立即执行</button>
                                }
                                else if (job.Status == KnowledgeIndexJobStatus.Failed)
                                {
                                    <button class="kp-button kp-button--sm kp-button--primary-outline" type="button" @onclick="() => RetryAsync(job)" disabled="@IsBusy">重新排队</button>
                                }
                                else if (job.Status == KnowledgeIndexJobStatus.Processing && job.IsStale)
                                {
                                    <button class="kp-button kp-button--sm kp-button--danger-outline" type="button" @onclick="() => RecoverAsync(job)" disabled="@IsBusy">恢复任务</button>
                                }
                                else
                                {
                                    <a class="kp-button kp-button--sm kp-button--link" href="@($"/knowledge/{job.KnowledgeItemId}")">查看知识</a>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <MvpPager SkipCount="SkipCount" PageSize="PageSize" TotalCount="TotalCount" IsBusy="IsBusy" OnSkipCountChanged="ChangePageAsync" />
</section>

@if (SelectedJob is { } selected)
{
    <section class="index-job-detail" aria-label="索引任务详情">
        <div class="admin-panel index-pipeline-panel">
            <div class="jobs-detail-heading"><h2>处理链路</h2><span>任务 @ShortId(selected.Id) · 进度 @selected.ProgressPercent%</span><button class="kp-button kp-button--secondary kp-button--sm" type="button" @onclick="() => SelectedJob = null">收起</button></div>
            @foreach (var stage in new[] { "reader", "processor", "chunker", "persistence", "embedding", "vector-store" })
            {
                <div class="index-stage @(selected.ProcessingStage == stage ? "is-current" : null)">
                    <strong>@GetStageText(stage)</strong><code>@stage</code>
                    @if (selected.ProcessingStage == stage) { <span class="index-status @GetIndexStatusClass(selected.Status)">@(selected.IsStale ? "心跳超时" : "最近执行阶段")</span> }
                </div>
            }
            <p class="cell-muted">仅展示任务实际记录的阶段与进度；索引完成要求分块、Embedding 和向量写入全部成功。</p>
        </div>
        <aside class="admin-panel index-recovery-panel">
            <h2>异常与恢复</h2>
            <span class="index-status @GetIndexStatusClass(selected.Status)">@(selected.IsStale ? "运行卡住" : GetIndexStatusText(selected.Status))</span>
            <dl><dt>任务编号</dt><dd>@selected.Id</dd><dt>最近心跳</dt><dd>@FormatTime(selected.LastHeartbeatTime, "尚未启动")</dd><dt>已重试</dt><dd>@selected.RetryCount / @selected.MaxRetryCount</dd><dt>失败阶段</dt><dd>@GetStageText(selected.FailureStage)</dd><dt>失败摘要</dt><dd>@(selected.FailureReason ?? "未记录失败")</dd><dt>来源任务</dt><dd>@(selected.RetryOfJobId?.ToString() ?? "无")</dd></dl>
            @if (selected.Status == KnowledgeIndexJobStatus.Failed) { <button class="kp-button kp-button--primary" type="button" @onclick="() => RetryAsync(selected)" disabled="@IsBusy">重新排队</button> }
            else if (selected.IsStale) { <button class="kp-button kp-button--primary" type="button" @onclick="() => RecoverAsync(selected)" disabled="@IsBusy">恢复并创建新任务</button> }
            else if (selected.Status == KnowledgeIndexJobStatus.Pending) { <button class="kp-button kp-button--primary" type="button" @onclick="() => ExecuteAsync(selected)" disabled="@IsBusy">立即执行</button> }
            <p class="kp-help">原任务与失败记录保留。重试或恢复会创建有关联的新任务。</p>
        </aside>
    </section>
}
</div>

@code {
    private const int PageSize = 20;

    private readonly List<KnowledgeIndexJobDto> JobList = new();
    private KnowledgeIndexJobOperationalSummaryDto Summary { get; set; } = new();
    private KnowledgeIndexJobDto? SelectedJob { get; set; }
    private string? StatusFilterText { get; set; }
    private int SkipCount { get; set; }
    private long TotalCount { get; set; }
    private bool IsLoading { get; set; }
    private bool IsBusy { get; set; }
    private string? ErrorMessage { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private Task SelectJobAsync(Guid id) => RunBusyAsync(async () => SelectedJob = await IndexJobAppService.GetAsync(id));

    private async Task ResetFilterAsync()
    {
        StatusFilterText = null;
        await ApplyFilterAsync();
    }

    private async Task ApplyFilterAsync()
    {
        SkipCount = 0;
        await LoadAsync();
    }

    private async Task ShowActionableAsync()
    {
        StatusFilterText = KnowledgeIndexJobStatus.Failed.ToString();
        await ApplyFilterAsync();
    }

    private async Task ChangePageAsync(int skipCount)
    {
        SkipCount = skipCount;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await RunBusyAsync(async () =>
        {
            IsLoading = true;
            Summary = await IndexJobAppService.GetOperationalSummaryAsync();
            var result = await IndexJobAppService.GetListAsync(new GetKnowledgeIndexJobListInput
            {
                Status = ParseStatus(StatusFilterText),
                SkipCount = SkipCount,
                MaxResultCount = PageSize
            });

            JobList.Clear();
            JobList.AddRange(result.Items.OrderByDescending(x => x.CreationTime));
            TotalCount = result.TotalCount;
            if (SelectedJob is not null) SelectedJob = await IndexJobAppService.GetAsync(SelectedJob.Id);
            IsLoading = false;
        });
    }

    private async Task ExecuteAsync(KnowledgeIndexJobDto job)
    {
        if (!await ConfirmAsync("立即执行会运行读取、分块、Embedding 和向量写入。是否继续？"))
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            await IndexJobAppService.ExecuteAsync(job.Id);
            await LoadAsync();
        });
    }

    private async Task RetryAsync(KnowledgeIndexJobDto job)
    {
        var message = job.CanRetry
            ? "将失败任务重新放回队列，并保留原失败记录。是否继续？"
            : "该任务已耗尽自动重试。确认已修复失败原因并创建新的恢复任务吗？";
        if (!await ConfirmAsync(message))
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            await IndexJobAppService.RetryAsync(job.Id);
            await LoadAsync();
        });
    }

    private async Task RecoverAsync(KnowledgeIndexJobDto job)
    {
        if (!await ConfirmAsync("恢复会终止当前卡住任务，并创建一条新的待处理任务。是否继续？"))
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            await IndexJobAppService.RecoverAsync(job.Id);
            await LoadAsync();
        });
    }

    private static KnowledgeIndexJobStatus? ParseStatus(string? value) =>
        Enum.TryParse<KnowledgeIndexJobStatus>(value, out var status) ? status : null;

    private static string GetIndexStatusText(KnowledgeIndexJobStatus status) => status switch
    {
        KnowledgeIndexJobStatus.Pending => "待处理",
        KnowledgeIndexJobStatus.Processing => "处理中",
        KnowledgeIndexJobStatus.Indexed => "已索引",
        KnowledgeIndexJobStatus.Failed => "失败",
        KnowledgeIndexJobStatus.Outdated => "已过期",
        KnowledgeIndexJobStatus.Deleted => "已删除",
        _ => status.ToString()
    };

    private static string GetIndexStatusClass(KnowledgeIndexJobStatus status) => status switch
    {
        KnowledgeIndexJobStatus.Pending => "pending",
        KnowledgeIndexJobStatus.Processing => "processing",
        KnowledgeIndexJobStatus.Indexed => "indexed",
        KnowledgeIndexJobStatus.Failed => "failed",
        _ => "muted"
    };

    private static string GetProgressClass(KnowledgeIndexJobStatus status) => status switch
    {
        KnowledgeIndexJobStatus.Indexed => "kp-bg-success",
        KnowledgeIndexJobStatus.Failed => "kp-bg-error",
        KnowledgeIndexJobStatus.Processing => "kp-progress__bar--striped kp-progress__bar--animated",
        _ => "kp-bg-secondary"
    };

    private static string GetTriggerText(KnowledgeIndexJobTriggerType triggerType) => triggerType switch
    {
        KnowledgeIndexJobTriggerType.Publish => "发布",
        KnowledgeIndexJobTriggerType.ManualRebuild => "手动重建",
        KnowledgeIndexJobTriggerType.PermissionChanged => "权限变更",
        KnowledgeIndexJobTriggerType.ModelChanged => "模型变更",
        KnowledgeIndexJobTriggerType.Delete => "删除",
        _ => triggerType.ToString()
    };

    private static string GetStageText(string? stage) => stage switch
    {
        "queued" => "等待 Worker",
        "starting" => "正在启动",
        "reader" => "读取内容",
        "processor" => "清洗内容",
        "chunker" => "生成分块",
        "persistence" => "保存分块",
        "embedding" => "生成 Embedding",
        "vector-store" => "写入向量库",
        "completed" => "索引完成",
        "recovery" => "人工恢复",
        "worker" => "后台执行器",
        "outdated" => "结果已过期",
        "deleted" => "结果已删除",
        null or "" => "尚未开始",
        _ => stage
    };

    private static string FormatRetryPlan(KnowledgeIndexJobDto job)
    {
        if (job.Status != KnowledgeIndexJobStatus.Failed)
        {
            return "-";
        }

        if (!job.CanRetry)
        {
            return "自动重试已停止";
        }

        return job.NextRetryTime.HasValue
            ? $"下次 {job.NextRetryTime.Value.ToLocalTime():MM-dd HH:mm:ss}"
            : "可立即重试";
    }

    private static string FormatTime(DateTime? value, string emptyText = "-") =>
        value.HasValue ? value.Value.ToLocalTime().ToString("MM-dd HH:mm:ss") : emptyText;

    private static string ShortId(Guid value) => value.ToString("N")[..8];

    private async Task<bool> ConfirmAsync(string message) =>
        await Message.Confirm(message);

    private async Task RunBusyAsync(Func<Task> action)
    {
        try
        {
            ErrorMessage = null;
            IsBusy = true;
            await action();
        }
        catch (Exception ex)
        {
            ErrorMessage = GetUserFriendlyErrorMessage(ex);
        }
        finally
        {
            IsBusy = false;
            IsLoading = false;
        }
    }
}
