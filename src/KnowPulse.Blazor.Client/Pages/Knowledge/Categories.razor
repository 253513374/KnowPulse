@page "/knowledge/categories"
@attribute [Authorize(KnowPulsePermissions.KnowledgeBase.Categories)]
@inherits KnowPulseComponentBase
@inject IKnowledgeCategoryAppService CategoryAppService

<PageTitle>知识分类</PageTitle>

<div class="kp-flex kp-flex-wrap kp-align-center kp-justify-between kp-gap-2 kp-mb-3">
    <div>
        <h1 class="kp-heading-4 kp-mb-1">知识分类</h1>
        <div class="kp-text-muted kp-text-small">KnowledgeBase / Categories</div>
    </div>
    <button class="kp-button kp-button--secondary kp-button--sm" type="button" @onclick="LoadAsync" disabled="@IsBusy">刷新</button>
</div>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="kp-alert kp-alert--error kp-flex kp-flex-wrap kp-align-center kp-justify-between kp-gap-2" role="alert">
        <span>@ErrorMessage</span>
        <button class="kp-button kp-button--sm kp-button--danger-outline" type="button" @onclick="LoadAsync" disabled="@IsBusy">重试</button>
    </div>
}

<div class="kp-grid kp-grid-gap-3">
    <div class="kp-col-lg-4">
        <div class="kp-card">
            <div class="kp-card__body">
                <h2 class="kp-heading-6 kp-mb-3">@FormTitle</h2>
                <EditForm Model="@FormModel" OnValidSubmit="@SaveAsync">
                    <DataAnnotationsValidator />

                    <div class="kp-mb-3">
                        <label class="kp-label" for="category-code">编码</label>
                        <input id="category-code" class="kp-input" @bind="FormModel.Code" @bind:event="oninput" />
                    </div>

                    <div class="kp-mb-3">
                        <label class="kp-label" for="category-name">名称</label>
                        <input id="category-name" class="kp-input" @bind="FormModel.Name" @bind:event="oninput" />
                    </div>

                    <div class="kp-mb-3">
                        <label class="kp-label" for="category-parent">上级分类</label>
                        <select id="category-parent" class="kp-select" @bind="FormModel.ParentIdText">
                            <option value="">无</option>
                            @foreach (var category in CategoryOptionList.Where(x => EditingId == null || x.Id != EditingId.Value))
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                    </div>

                    <div class="kp-check kp-switch kp-mb-3">
                        <InputCheckbox id="category-active" class="kp-check__input" @bind-Value="FormModel.IsActive" />
                        <label class="kp-check__label" for="category-active">启用</label>
                    </div>

                    <div class="kp-flex kp-gap-2">
                        <button class="kp-button kp-button--primary" type="submit" disabled="@IsBusy">保存</button>
                        <button class="kp-button kp-button--secondary" type="button" @onclick="ResetForm" disabled="@IsBusy">取消</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>

    <div class="kp-col-lg-8">
        <div class="kp-card">
            <div class="kp-table-wrap">
                <table class="kp-table kp-table--hover kp-table-align-middle kp-mb-0">
                    <thead>
                        <tr>
                            <th>编码</th>
                            <th>名称</th>
                            <th>上级分类</th>
                            <th>状态</th>
                            <th class="kp-text-end">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr>
                                <td colspan="5" class="kp-text-center kp-py-4 kp-text-muted">加载中</td>
                            </tr>
                        }
                        else if (CategoryList.Count == 0)
                        {
                            <tr>
                                <td colspan="5" class="kp-text-center kp-py-4 kp-text-muted">暂无数据</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var category in CategoryList)
                            {
                                <tr>
                                    <td class="kp-text-semibold">@category.Code</td>
                                    <td>@category.Name</td>
                                    <td>@GetCategoryName(category.ParentId)</td>
                                    <td>
                                        <span class="kp-badge @(category.IsActive ? "kp-bg-success" : "kp-bg-secondary")">
                                            @(category.IsActive ? "启用" : "停用")
                                        </span>
                                    </td>
                                    <td class="kp-text-end">
                                        <button class="kp-button kp-button--link kp-button--sm" type="button" @onclick="() => Edit(category)">编辑</button>
                                        <button class="kp-button kp-button--link kp-button--sm kp-text-danger" type="button" @onclick="() => DeleteAsync(category.Id)">删除</button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
            <MvpPager SkipCount="SkipCount" PageSize="PageSize" TotalCount="TotalCount" IsBusy="IsBusy" OnSkipCountChanged="ChangePageAsync" />
        </div>
    </div>
</div>

@code {
    private const int PageSize = 20;
    private readonly List<KnowledgeCategoryDto> CategoryList = new();
    private readonly List<KnowledgeCategoryDto> CategoryOptionList = new();
    private CategoryFormModel FormModel { get; set; } = new();
    private Guid? EditingId { get; set; }
    private int SkipCount { get; set; }
    private long TotalCount { get; set; }
    private bool IsLoading { get; set; }
    private bool IsBusy { get; set; }
    private string? ErrorMessage { get; set; }
    private string FormTitle => EditingId.HasValue ? "编辑分类" : "新增分类";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await RunBusyAsync(async () =>
        {
            IsLoading = true;
            var categoryOptions = await CategoryAppService.GetListAsync(new PagedAndSortedResultRequestDto { MaxResultCount = 100 });
            var result = await CategoryAppService.GetListAsync(new PagedAndSortedResultRequestDto
            {
                SkipCount = SkipCount,
                MaxResultCount = PageSize
            });
            CategoryOptionList.Clear();
            CategoryOptionList.AddRange(categoryOptions.Items.OrderBy(x => x.Code));
            CategoryList.Clear();
            CategoryList.AddRange(result.Items.OrderBy(x => x.Code));
            TotalCount = result.TotalCount;
            IsLoading = false;
        });
    }

    private async Task ChangePageAsync(int skipCount)
    {
        SkipCount = skipCount;
        await LoadAsync();
    }

    private async Task SaveAsync()
    {
        await RunBusyAsync(async () =>
        {
            var input = new CreateUpdateKnowledgeCategoryDto
            {
                ParentId = ParseNullableGuid(FormModel.ParentIdText),
                Code = FormModel.Code.Trim(),
                Name = FormModel.Name.Trim(),
                IsActive = FormModel.IsActive
            };

            if (EditingId.HasValue)
            {
                await CategoryAppService.UpdateAsync(EditingId.Value, input);
            }
            else
            {
                await CategoryAppService.CreateAsync(input);
            }

            ResetForm();
            await LoadAsync();
        });
    }

    private void Edit(KnowledgeCategoryDto category)
    {
        EditingId = category.Id;
        FormModel = new CategoryFormModel
        {
            ParentIdText = category.ParentId?.ToString() ?? string.Empty,
            Code = category.Code,
            Name = category.Name,
            IsActive = category.IsActive
        };
    }

    private async Task DeleteAsync(Guid id)
    {
        await RunBusyAsync(async () =>
        {
            await CategoryAppService.DeleteAsync(id);
            if (EditingId == id)
            {
                ResetForm();
            }
            await LoadAsync();
        });
    }

    private void ResetForm()
    {
        EditingId = null;
        FormModel = new CategoryFormModel();
    }

    private string GetCategoryName(Guid? id)
    {
        if (id == null)
        {
            return "-";
        }

        return CategoryOptionList.FirstOrDefault(x => x.Id == id.Value)?.Name ?? id.Value.ToString("N");
    }

    private static Guid? ParseNullableGuid(string? value)
    {
        return Guid.TryParse(value, out var id) ? id : null;
    }

    private async Task RunBusyAsync(Func<Task> action)
    {
        try
        {
            ErrorMessage = null;
            IsBusy = true;
            await action();
        }
        catch (Exception ex)
        {
            ErrorMessage = GetUserFriendlyErrorMessage(ex);
        }
        finally
        {
            IsBusy = false;
            IsLoading = false;
        }
    }

    private class CategoryFormModel
    {
        public string? ParentIdText { get; set; }

        [Required]
        [StringLength(64)]
        public string Code { get; set; } = string.Empty;

        [Required]
        [StringLength(128)]
        public string Name { get; set; } = string.Empty;

        public bool IsActive { get; set; } = true;
    }
}
