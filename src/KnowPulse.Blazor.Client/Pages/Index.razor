@page "/"
@inherits KnowPulseComponentBase

<PageTitle>KnowPulse</PageTitle>

<MudStack Class="kp-page" Spacing="3">
    <KpPageHeader Title="KnowPulse"
                  Description="企业知识与学习运营工作台"
                  Eyebrow="KNOWLEDGE OPERATIONS">
        <Actions>
            <KpStatusChip Label="MVP" Tone="KpStatusTone.Info" />
        </Actions>
    </KpPageHeader>

    <MudGrid Spacing="3">
        @foreach (var area in WorkAreas)
        {
            <MudItem xs="12" md="6" xl="3">
                <MudPaper Class="kp-feature-card" Elevation="0">
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                        <MudIcon Icon="@area.Icon" />
                    </MudAvatar>
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.overline" Color="Color.Secondary">@area.Title</MudText>
                        <MudText Typo="Typo.h6">@area.Description</MudText>
                    </MudStack>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
</MudStack>

@code {
    private static readonly (string Title, string Description, string Icon)[] WorkAreas =
    [
        ("组织管理", "部门 / 岗位 / 职级", Icons.Material.Filled.AccountTree),
        ("知识库", "上传 / 发布 / 索引", Icons.Material.Filled.MenuBook),
        ("题库与考试", "草稿 / 审核 / 作答", Icons.Material.Filled.FactCheck),
        ("RAG / AI", "模型 / 检索 / 评测", Icons.Material.Filled.AutoAwesome)
    ];
}
