@page "/"
@attribute [Authorize]
@inherits KnowPulseComponentBase
@inject IPermissionChecker PermissionChecker
@inject NavigationManager Navigation

<PageTitle>正在进入工作区 · 知脉空间</PageTitle>
<section class="kp-page" aria-busy="@_busy.ToString().ToLowerInvariant()">
    @if (_error is null)
    {
        <div role="status"><KpStatePanel Kind="KpStateKind.Loading" Title="正在进入工作区" Description="正在读取当前账号的可用功能。" /></div>
    }
    else
    {
        <div role="alert">
            <KpStatePanel Kind="KpStateKind.Error" Title="暂时无法进入工作区" Description="@_error">
                <Actions><MudButton OnClick="OpenWorkspaceAsync" Disabled="_busy" Color="Color.Primary" Variant="Variant.Filled">重试</MudButton></Actions>
            </KpStatePanel>
        </div>
    }
</section>

@code {
    private bool _busy = true;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await OpenWorkspaceAsync();
    }

    private async Task OpenWorkspaceAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var destination = await TeacherNavigation.GetHomeUrlAsync(PermissionChecker);
            Navigation.NavigateTo(destination, replace: true);
        }
        catch (Exception)
        {
            _error = "未能读取当前账号的可用功能，请重试。";
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }
}
