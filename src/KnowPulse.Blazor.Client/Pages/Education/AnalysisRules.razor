@page "/education/analysis-rules"
@attribute [Authorize(EducationPermissions.SchoolManage)]
@inherits KnowPulseComponentBase
@using KnowPulse.Education
@using System.Text.Json
@inject IEducationSchoolAppService Schools
@inject IEducationMasteryRuleAppService Rules
@inject IJSRuntime JS
@inject Volo.Abp.Users.ICurrentUser Account
@inject Volo.Abp.MultiTenancy.ICurrentTenant Tenant

<PageTitle>@L["EducationReport:RulesTitle"]</PageTitle>
<NavigationLock ConfirmExternalNavigation="@(Pending != null)" OnBeforeInternalNavigation="LeaveAsync" />
<h1 class="h4">@L["EducationReport:RulesTitle"]</h1>
<p class="text-muted">@L["EducationReport:RulesHint"]</p>
@if (Error != null) { <div class="alert alert-danger" role="alert">@Error</div> }
@if (Pending != null) { <div class="alert alert-info" role="status">@L["EducationReport:Pending"] <button class="btn btn-sm btn-outline-primary" disabled="@Busy" @onclick="RecoverAsync">@L["EducationGrading:Recover"]</button> <button class="btn btn-sm btn-outline-primary" disabled="@Busy" @onclick="(() => RunAsync(SendAsync))">@L["EducationReport:RetryCommand"]</button> <button class="btn btn-sm btn-outline-secondary" disabled="@Busy" @onclick="AbandonAsync">@L["EducationReport:Abandon"]</button></div> }
<fieldset disabled="@(Busy || Pending != null || !StorageReady)">
    <label for="rule-school" class="form-label">@L["Menu:EducationSchools"]</label><select id="rule-school" class="form-select mb-3" @bind="SchoolText" @bind:after="SchoolChangedAsync"><option value="">@L["EducationCurriculum:Choose"]</option>@foreach (var school in MySchools) { <option value="@school.Id">@school.Name</option> }</select>
    <label for="rule-subject" class="form-label">@L["EducationReport:Subject"]</label><select id="rule-subject" class="form-select mb-3" @bind="SubjectText" @bind:after="SubjectChangedAsync"><option value="">@L["EducationCurriculum:Choose"]</option>@foreach (var subject in Subjects) { <option value="@subject.Id">@subject.Name</option> }</select>
</fieldset>
@if (Current != null)
{
    <p>@(Current.Current == null ? L["EducationReport:NoRule"] : L["EducationReport:RuleVersion", Current.Current.RevisionNumber, Current.Current.RecordedAtUtc.ToLocalTime()])</p>
    <EditForm Model="Input" OnValidSubmit="SaveAsync"><DataAnnotationsValidator /><Microsoft.AspNetCore.Components.Forms.ValidationSummary />
        <fieldset disabled="@(Busy || Pending != null || !StorageReady)" class="card card-body">
            <label class="mb-3"><InputCheckbox class="form-check-input" @bind-Value="Input.IsEnabled" /> @L["EducationReport:RuleEnabled"]</label>
            <div class="row g-3"><label class="col-md-4">@L["EducationReport:WindowDays"]<InputNumber class="form-control" @bind-Value="Input.WindowDays" /></label><label class="col-md-4">@L["EducationReport:MinimumQuestions"]<InputNumber class="form-control" @bind-Value="Input.MinimumIndependentQuestionCount" /></label><label class="col-md-4">@L["EducationReport:MinimumAssessments"]<InputNumber class="form-control" @bind-Value="Input.MinimumAssessmentCount" /></label><label class="col-md-4">@L["EducationReport:MaximumAge"]<InputNumber class="form-control" @bind-Value="Input.MaximumLatestEvidenceAgeDays" /></label><label class="col-md-4">@L["EducationReport:Target"]<InputNumber class="form-control" step="0.0001" @bind-Value="Input.TargetRatio" /></label></div>
            <label class="mt-3">@L["EducationReport:Reason"]<InputTextArea class="form-control" @bind-Value="Input.Reason" /></label>
            <label class="my-3"><InputCheckbox class="form-check-input" @bind-Value="Input.ConfirmSchoolPolicy" /> @L["EducationReport:ConfirmPolicy"]</label>
            <button class="btn btn-primary align-self-start" type="submit">@L["EducationReport:SaveRule"]</button>
        </fieldset>
    </EditForm>
}
@code {
    private bool Busy, StorageAttempted, StorageReady; private string? Error; private string SchoolText = "", SubjectText = ""; private List<MySchoolDto> MySchools = []; private List<EducationSubjectDto> Subjects = [];
    private EducationMasteryRuleDto? Current; private SaveEducationMasteryRuleDto Input = new(); private Command? Pending;
    private string StorageKey => $"knowpulse-mastery-rule-v1:{Tenant.Id}:{Account.Id}";
    protected override Task OnInitializedAsync() => RunAsync(async () => MySchools = (await Schools.GetMySchoolsAsync()).Items.Where(x => x.Roles.Contains(SchoolMemberRole.Manager)).ToList());
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (StorageAttempted || Busy) return; StorageAttempted = true; await RunAsync(async () => { var json = await JS.InvokeAsync<string?>("sessionStorage.getItem", StorageKey); if (json != null) { Pending = JsonSerializer.Deserialize<Command>(json); Validate(); } StorageReady = true; }); StateHasChanged(); }
    private Task SchoolChangedAsync() => RunAsync(async () => { Current = null; SubjectText = ""; Subjects.Clear(); if (Guid.TryParse(SchoolText, out var school)) Subjects = (await Schools.GetSchoolConfigurationAsync(school)).Subjects; });
    private Task SubjectChangedAsync() => RunAsync(LoadAsync);
    private async Task LoadAsync() {
        Current = null; if (!Guid.TryParse(SchoolText, out var school) || !Guid.TryParse(SubjectText, out var subject)) return;
        Current = await Rules.GetAsync(school, subject); var r = Current.Current;
        Input = r == null ? new() : new() { ExpectedRevisionId = r.Id, ConcurrencyStamp = Current.ConcurrencyStamp, IsEnabled = r.IsEnabled, WindowDays = r.WindowDays, MinimumIndependentQuestionCount = r.MinimumIndependentQuestionCount, MinimumAssessmentCount = r.MinimumAssessmentCount, MaximumLatestEvidenceAgeDays = r.MaximumLatestEvidenceAgeDays, TargetRatio = r.TargetRatio };
    }
    private Task SaveAsync() => RunAsync(async () => { if (Pending != null || !StorageReady) return; Input.OperationId = Guid.NewGuid(); Input.ExpectedRevisionId = Current!.Current?.Id; Input.ConcurrencyStamp = Current.ConcurrencyStamp;
        var command = new Command { TenantId = Tenant.Id, AccountId = Account.Id, SchoolId = Current.SchoolId, SubjectId = Current.EducationSubjectId, Input = Input };
        await JS.InvokeVoidAsync("sessionStorage.setItem", StorageKey, JsonSerializer.Serialize(command)); Pending = command; await SendAsync();
    });
    private void Validate() { if (Pending == null || Pending.TenantId != Tenant.Id || Pending.AccountId != Account.Id || Pending.SchoolId == Guid.Empty || Pending.SubjectId == Guid.Empty || Pending.Input == null || Pending.Input.OperationId == Guid.Empty) throw new InvalidOperationException(L["EducationGrading:NoReceipt"]); }
    private async Task SendAsync() { Validate(); var op = Pending!; await CompleteAsync(await Rules.SaveAsync(op.SchoolId, op.SubjectId, op.Input)); }
    private Task RecoverAsync() => RunAsync(async () => { Validate(); var op = Pending!; var result = await Rules.GetOperationAsync(op.SchoolId, op.SubjectId, op.Input.OperationId); if (result == null) Error = L["EducationReport:NoReceipt"]; else await CompleteAsync(result); });
    private async Task CompleteAsync(EducationMasteryRuleRevisionDto result) { Validate(); if (result.Id != Pending!.Input.OperationId) throw new InvalidOperationException(L["EducationGrading:NoReceipt"]); SchoolText = Pending.SchoolId.ToString(); SubjectText = Pending.SubjectId.ToString(); await JS.InvokeVoidAsync("sessionStorage.removeItem", StorageKey); Pending = null; Subjects = (await Schools.GetSchoolConfigurationAsync(Guid.Parse(SchoolText))).Subjects; await LoadAsync(); }
    private Task AbandonAsync() => RunAsync(async () => { if (await JS.InvokeAsync<bool>("confirm", L["EducationReport:AbandonHint"].Value)) { await JS.InvokeVoidAsync("sessionStorage.removeItem", StorageKey); Pending = null; StorageReady = true; await LoadAsync(); } });
    private async Task RunAsync(Func<Task> action) { if (Busy) return; Busy = true; Error = null; try { await action(); } catch (Exception ex) { Error = GetUserFriendlyErrorMessage(ex); } finally { Busy = false; } }
    private async Task LeaveAsync(Microsoft.AspNetCore.Components.Routing.LocationChangingContext context) { if (Pending != null && !await JS.InvokeAsync<bool>("confirm", L["EducationGrading:Discard"].Value)) context.PreventNavigation(); }
    private sealed class Command { public Guid? TenantId { get; set; } public Guid? AccountId { get; set; } public Guid SchoolId { get; set; } public Guid SubjectId { get; set; } public SaveEducationMasteryRuleDto Input { get; set; } = new(); }
}
