@page "/education/inbox/{SchoolId:guid}"
@attribute [Authorize]
@inherits KnowPulseComponentBase
@implements IDisposable
@using KnowPulse.Education
@inject IEducationStudentInboxAppService Inbox
@inject NavigationManager Navigation
@inject Volo.Abp.Users.ICurrentUser Account
@inject Volo.Abp.MultiTenancy.ICurrentTenant Tenant

<PageTitle>@L["EducationInbox:Title"]</PageTitle>
<h1>@L["EducationInbox:Title"]</h1><p class="text-muted">@L["EducationInbox:Hint"]</p>
@if (Error != null) { <div class="alert alert-danger" role="alert">@Error</div> }
@if (Notice != null) { <div class="alert alert-info" role="status">@Notice</div> }
<fieldset class="mb-3"><legend class="h6">@L["EducationInbox:Sources"]</legend><div class="d-flex gap-2 flex-wrap">
@foreach (var source in Sources) { <button class="btn @(source == Source ? "btn-primary" : "btn-outline-primary")" aria-pressed="@((source == Source).ToString().ToLowerInvariant())" disabled="@Busy" @onclick="() => SelectAsync(source)">@L["EducationInbox:Source" + source]</button> }
</div></fieldset>
<div class="list-group mb-3">@foreach (var row in Items) { <section class="list-group-item" @key="row.Id"><h2 class="h6">@L["EducationInbox:Message" + row.Kind]</h2><p>@LocalTime(row.AvailableAtUtc) · @(row.ReadAtUtc.HasValue ? LocalTime(row.ReadAtUtc) : L["EducationInbox:Unread"])</p>
    @if (!row.CanOpen) { <p class="text-muted">@L["EducationInbox:SourceUnavailable"]</p> }
    <button class="btn btn-sm btn-outline-primary" disabled="@Busy" @onclick="() => OpenAsync(row)">@L[row.CanOpen ? "EducationInbox:Open" : "EducationInbox:ReadOnly"]</button>
</section> }</div>
@if (!Busy && Items.Count == 0) { <p>@L["EducationInbox:Empty"]</p> }
<div class="d-flex gap-2 align-items-center flex-wrap"><button class="btn btn-outline-secondary" @onclick="() => PageAsync(-1)" disabled="@(Busy || Offset == 0)">@L["EducationPaper:Previous"]</button><span>@L["EducationInbox:SourceCount", Total]</span><button class="btn btn-outline-secondary" @onclick="() => PageAsync(1)" disabled="@(Busy || Offset + 20 >= Total)">@L["EducationPaper:Next"]</button><button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@Busy">@L["EducationInbox:Refresh"]</button><button class="btn btn-outline-secondary" @onclick="ResetAsync" disabled="@Busy">@L["EducationInbox:Reset"]</button></div>

@code {
    [Parameter] public Guid SchoolId { get; set; }
    private EducationInboxSource? Source;
    private List<EducationInboxSource> Sources = [];
    private List<EducationInboxMessageDto> Items = [];
    private long Total;
    private int Offset, Epoch;
    private bool Busy, Disposed;
    private string? Error, Notice;
    private (Guid? User, Guid? Tenant, Guid School, EducationInboxSource? Source, int Epoch) Ticket() => (Account.Id, Tenant.Id, SchoolId, Source, Epoch);
    private bool Current((Guid? User, Guid? Tenant, Guid School, EducationInboxSource? Source, int Epoch) t) => !Disposed && Account.IsAuthenticated && Account.Id == t.User && Tenant.Id == t.Tenant && SchoolId == t.School && Source == t.Source && Epoch == t.Epoch;
    private static string LocalTime(DateTime? value) => value?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—";
    protected override async Task OnParametersSetAsync() { Epoch++; Busy = false; Source = null; Sources = []; Offset = 0; Items = []; Total = 0; await LoadAsync(); }
    private async Task LoadAsync()
    {
        if (Busy || Disposed) return; Epoch++; var t = Ticket(); Busy = true; Error = null; Items = []; Sources = []; Total = 0;
        try {
            var sources = await Inbox.GetSourcesAsync(new() { SchoolId = t.School }); if (!Current(t)) return; Sources = sources;
            if (!Source.HasValue && sources.Count > 0) { Source = sources[0]; t = Ticket(); }
            if (!Source.HasValue || !sources.Contains(Source.Value)) { Notice = L["EducationInbox:NoSource"]; return; }
            var page = await Inbox.GetMyListAsync(new() { SchoolId = t.School, Source = Source.Value, SkipCount = Offset, MaxResultCount = 20 });
            if (Current(t)) { Items = page.Items.ToList(); Total = page.TotalCount; }
        } catch { if (Current(t)) Error = L["EducationInbox:Failed"]; }
        finally { if (Current(t)) Busy = false; }
    }
    private async Task SelectAsync(EducationInboxSource source) { if (Busy || !Sources.Contains(source)) return; Source = source; Offset = 0; Notice = null; await LoadAsync(); }
    private async Task ResetAsync() { if (Busy) return; Source = null; Offset = 0; Notice = null; await LoadAsync(); }
    private async Task PageAsync(int direction) { if (Busy || Offset + direction * 20 < 0 || direction > 0 && Offset + 20 >= Total) return; Offset += direction * 20; await LoadAsync(); }
    private async Task OpenAsync(EducationInboxMessageDto row)
    {
        if (Busy || Source != row.Source) return; var t = Ticket(); Busy = true; Error = null; Notice = null;
        try {
            var current = await Inbox.ReadMyAsync(new() { SchoolId = t.School, Source = row.Source, MessageId = row.Id });
            if (!Current(t)) return;
            if (current.Id != row.Id || current.Source != row.Source || current.Kind != row.Kind || current.SchoolId != t.School || current.ReferenceId != row.ReferenceId || current.PublicationId != row.PublicationId || current.ResultReleaseId != row.ResultReleaseId || current.StepId != row.StepId || !current.ReadAtUtc.HasValue) throw new InvalidOperationException();
            if (!current.CanOpen) { Busy = false; await LoadAsync(); if (!Disposed && Account.Id == t.User && Tenant.Id == t.Tenant && SchoolId == t.School && Source == t.Source) Notice = L["EducationInbox:SourceUnavailable"]; return; }
            var destination = current.Source == EducationInboxSource.TeachingPlan
                ? $"/education/teaching-plans/{current.ReferenceId}/activities?versionId={current.PublicationId}&schoolId={current.SchoolId}" + (current.StepId.HasValue ? $"&stepId={current.StepId}" : "")
                : current.Source == EducationInboxSource.Feedback
                ? $"/education/feedback/my?feedbackId={current.ReferenceId}&versionId={current.PublicationId}&schoolId={current.SchoolId}"
                : current.Kind == EducationInboxMessageKind.ResultReleased
                    ? $"/education/assessment-results?recipientId={current.ReferenceId}&schoolId={current.SchoolId}&taskRevisionId={current.PublicationId}&releaseId={current.ResultReleaseId}"
                    : $"/education/assessments/{current.ReferenceId}";
            Navigation.NavigateTo(destination);
        } catch { if (Current(t)) Error = L["EducationInbox:Failed"]; }
        finally { if (Current(t)) Busy = false; }
    }
    public void Dispose() { Disposed = true; Epoch++; Items.Clear(); Sources.Clear(); }
}
