@page "/education/schools/{SchoolId:guid}/relation-requests"
@attribute [Authorize]
@inherits KnowPulseComponentBase
@implements IDisposable
@using KnowPulse.Education
@using System.Text.Json
@using System.Globalization
@inject IEducationSchoolAppService Schools
@inject IJSRuntime JS
@inject Volo.Abp.Users.ICurrentUser Account
@inject Volo.Abp.MultiTenancy.ICurrentTenant Tenant
@inject AuthenticationStateProvider Authentication

<PageTitle>@L["RelationRequests:Title"]</PageTitle><h1 class="kp-heading-4">@L["RelationRequests:Title"]</h1><p>@L[Manage ? "RelationRequests:ManageHint" : "RelationRequests:TeacherHint"]</p>
<p><strong>@SchoolLabel</strong></p>
<NavigationLock ConfirmExternalNavigation="@(Busy || Pending != null || Text.Length > 0 || ResolutionText.Length > 0)" OnBeforeInternalNavigation="LeaveAsync" />
<a href="/education/workspace">@L["EducationWorkspace:Title"]</a>
@if (Error != null) { <p class="kp-alert kp-alert--error" role="alert">@Error</p> }
@if (Notice != null) { <p class="kp-alert kp-alert--info" role="status">@Notice</p> }
@if (Pending != null) { <section class="kp-alert kp-alert--warning"><h2 class="kp-heading-6">@L["SchoolInvites:Pending"]</h2><p>@L["RelationRequests:Uncertain"]</p><button class="kp-button kp-button--primary-outline kp-me-2" disabled="@Busy" @onclick="RecoverAsync">@L["SchoolInvites:Recover"]</button><button class="kp-button kp-button--primary-outline kp-me-2" disabled="@(Busy || SubmitInput == null && WithdrawInput == null && ResolveInput == null)" @onclick="RetryAsync">@L["SchoolInvites:Retry"]</button><button class="kp-button kp-button--secondary" disabled="@Busy" @onclick="AbandonAsync">@L["SchoolInvites:Clear"]</button></section> }
@if (!Manage) { <fieldset disabled="@(Busy || Pending != null || !StorageReady)"><legend class="kp-heading-5">@L["RelationRequests:Submit"]</legend><form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
<label for="relation-original" class="kp-label">@L["RelationRequests:Original"]</label><select id="relation-original" class="kp-select kp-mb-2" @bind="Original"><option value="">—</option><option value="missing">@L["RelationRequests:Missing"]</option>@foreach (var item in Relations) { <option value="@item.Id">@Summary(item)</option> }</select>
<div class="kp-flex kp-gap-2 my-2"><button type="button" class="kp-button kp-button--secondary kp-button--sm" disabled="@(RelationOffset == 0)" @onclick="() => RelationPageAsync(-1)">@L["EducationPaper:Previous"]</button><span>@L["RelationRequests:RelationCount", RelationTotal]</span><button type="button" class="kp-button kp-button--secondary kp-button--sm" disabled="@(RelationOffset + 20 >= RelationTotal)" @onclick="() => RelationPageAsync(1)">@L["EducationPaper:Next"]</button></div>
<label for="relation-text" class="kp-label">@L["RelationRequests:Text"]</label><textarea id="relation-text" class="kp-input" @bind="Text" required maxlength="2000"></textarea><label class="kp-check my-2"><input class="kp-check__input" type="checkbox" @bind="Shared" />@L["RelationRequests:Sharing"]</label><button class="kp-button kp-button--primary" disabled="@(!Shared || Original.Length == 0 || string.IsNullOrWhiteSpace(Text))" type="submit">@L["RelationRequests:Submit"]</button></form></fieldset> }
<section class="my-3"><h2 class="kp-heading-5">@L["RelationRequests:History"]</h2>@foreach (var item in Items) { <article class="kp-border kp-rounded kp-p-3 my-2" @key="item.Id"><p>@item.TeacherDisplayName · @item.SchoolName（@item.SchoolCode） · @State(item.Status)</p><p>@Local(item.RecordedAtUtc)</p><button class="kp-button kp-button--primary-outline" disabled="@(Busy || Pending != null || !StorageReady)" @onclick="() => OpenAsync(item.Id)">@L["RelationRequests:Review"]</button></article> }
<div class="kp-flex kp-gap-2 kp-align-center"><button class="kp-button kp-button--secondary" disabled="@(Busy || Pending != null || Offset == 0)" @onclick="() => PageAsync(-1)">@L["EducationPaper:Previous"]</button><span>@L["RelationRequests:Count", Total]</span><button class="kp-button kp-button--secondary" disabled="@(Busy || Pending != null || Offset + 20 >= Total)" @onclick="() => PageAsync(1)">@L["EducationPaper:Next"]</button><button class="kp-button kp-button--secondary" disabled="@Busy" @onclick="RefreshAsync">@L["EducationSchools:Refresh"]</button></div></section>
@if (Selected != null) { <section class="kp-card"><div class="kp-card__body"><h2 class="kp-heading-5">@Selected.TeacherDisplayName · @State(Selected.Status)</h2><p>@Selected.SchoolName（@Selected.SchoolCode）</p><p class="text-break" style="white-space:pre-wrap">@Selected.Text</p>
@if (Selected.Original != null) { <p>@Summary(Selected.Original)</p><p>@L["RelationRequests:OriginalEnd", Local(Selected.OriginalEndsAtRequestUtc)]</p> }
@if (Selected.Status == TeachingRelationRequestStatus.Pending && Selected.OriginalAssignmentId.HasValue && !ResolutionChoices.Contains(TeachingRelationResolution.End)) { <p class="kp-alert kp-alert--warning">@L["RelationRequests:Changed"]</p> }
@if (Selected.Resolution.HasValue) { <p>@Decision(Selected.Resolution.Value)</p><p class="text-break" style="white-space:pre-wrap">@Selected.ResolutionText</p> }
@if (Selected.Resulting != null) { <p>@Summary(Selected.Resulting)</p> }<p class="kp-text-muted">@L["RelationRequests:ResultHint"]</p>
@if (!Manage && Selected.CanWithdraw) { <button class="kp-button kp-button--secondary" disabled="@(Busy || Pending != null)" @onclick="WithdrawAsync">@L["RelationRequests:Withdraw"]</button> }
@if (Manage && Selected.Status == TeachingRelationRequestStatus.Pending && Configuration != null) { <fieldset disabled="@(Busy || Pending != null || !StorageReady)"><legend class="kp-heading-6">@L["RelationRequests:Resolve"]</legend><label for="relation-decision" class="kp-label">@L["RelationRequests:Decision"]</label><select id="relation-decision" class="kp-select kp-mb-2" @bind="Resolution">@foreach (var value in ResolutionChoices) { <option value="@value">@Decision(value)</option> }</select>
@if (Resolution is TeachingRelationResolution.Add or TeachingRelationResolution.Replace) {
<label for="relation-term">@L["EducationSchools:Term"]</label><select id="relation-term" class="kp-select kp-mb-2" @bind="Term" @bind:after="TermChanged"><option value="">—</option>@foreach (var term in Configuration.AcademicTerms.Where(x => x.EndsAtUtc > DateTime.UtcNow)) { <option value="@term.Id">@term.Name · @Local(term.StartsAtUtc) → @Local(term.EndsAtUtc)</option> }</select>
<label for="relation-class">@L["EducationSchools:Class"]</label><select id="relation-class" class="kp-select kp-mb-2" @bind="Class"><option value="">—</option>@foreach (var item in Configuration.Classes.Where(x => x.AcademicTermId.ToString() == Term)) { <option value="@item.Id">@item.Name</option> }</select>
<label for="relation-subject">@L["EducationSchools:Subject"]</label><select id="relation-subject" class="kp-select kp-mb-2" @bind="Subject"><option value="">—</option>@foreach (var item in Configuration.Subjects) { <option value="@item.Id">@item.Name</option> }</select> }
@if (Resolution != TeachingRelationResolution.Reject) { <label for="relation-start">@L["RelationRequests:Effective"]</label><input id="relation-start" type="datetime-local" class="kp-input kp-mb-2" value="@From" @onchange='e => From = e.Value?.ToString() ?? ""' /> }
@if (Resolution is TeachingRelationResolution.Add or TeachingRelationResolution.Replace) { <label for="relation-end">@L["SchoolInvites:To"]</label><input id="relation-end" type="datetime-local" class="kp-input kp-mb-2" value="@To" @onchange='e => To = e.Value?.ToString() ?? ""' /> }
<label for="relation-resolution">@L["RelationRequests:ResolutionText"]</label><textarea id="relation-resolution" class="kp-input kp-mb-2" @bind="ResolutionText" maxlength="2000"></textarea><label class="kp-check my-2"><input class="kp-check__input" type="checkbox" @bind="Reviewed" />@L["RelationRequests:Reviewed"]</label><button class="kp-button kp-button--primary" disabled="@(!Reviewed || string.IsNullOrWhiteSpace(ResolutionText))" @onclick="ResolveAsync">@L["RelationRequests:Resolve"]</button></fieldset> }
</div></section> }

@code {
    [Parameter] public Guid SchoolId { get; set; }
    [SupplyParameterFromQuery(Name = "manage")] public bool Manage { get; set; }
    private List<TeachingRelationRequestDto> Items = []; private List<MyTeachingRelationDto> Relations = []; private TeachingRelationRequestDto? Selected; private SchoolConfigurationDto? Configuration;
    private string Text = "", Original = "", ResolutionText = "", Term = "", Class = "", Subject = "", From = DateTime.Now.ToString("yyyy-MM-ddTHH:mm"), To = "";
    private string? Error, Notice; private string SchoolLabel = ""; private bool Shared, Reviewed, Busy, Disposed, StorageReady, StorageAttempted; private int Offset, RelationOffset, Epoch; private long Total, RelationTotal;
    private TeachingRelationResolution Resolution; private PendingCommand? Pending; private SubmitTeachingRelationRequestDto? SubmitInput; private WithdrawTeachingRelationRequestDto? WithdrawInput; private ResolveTeachingRelationRequestDto? ResolveInput;
    private string StorageKey => $"education-relation-request:{Tenant.Id}:{Account.Id}:{SchoolId}:{Manage}";
    private (Guid? User, Guid? Tenant, Guid School, bool Manage, int Epoch) Ticket() => (Account.Id, Tenant.Id, SchoolId, Manage, Epoch);
    private bool Current((Guid? User, Guid? Tenant, Guid School, bool Manage, int Epoch) t) => !Disposed && Account.IsAuthenticated && Account.Id == t.User && Tenant.Id == t.Tenant && SchoolId == t.School && Manage == t.Manage && Epoch == t.Epoch;
    protected override void OnInitialized() => Authentication.AuthenticationStateChanged += AuthChanged;
    private void Clear() { Items.Clear(); Relations.Clear(); Selected = null; Configuration = null; Pending = null; SubmitInput = null; WithdrawInput = null; ResolveInput = null; Text = ResolutionText = Original = SchoolLabel = Term = Class = Subject = To = ""; Shared = Reviewed = false; }
    private void AuthChanged(Task<AuthenticationState> state) => _ = InvokeAsync(() => { Epoch++; Busy = StorageReady = StorageAttempted = false; Clear(); StateHasChanged(); });
    protected override async Task OnParametersSetAsync() { Epoch++; Busy = StorageReady = StorageAttempted = false; Clear(); Offset = RelationOffset = 0; await RefreshAsync(); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (StorageAttempted || Busy) return; StorageAttempted = true; await RunAsync(async t => { var raw = await JS.InvokeAsync<string?>("sessionStorage.getItem", StorageKey); if (!Current(t)) return;
        if (raw != null) { var value = JsonSerializer.Deserialize<PendingCommand>(raw); if (value == null || value.User != t.User || value.Tenant != t.Tenant || value.School != t.School || value.Manage != t.Manage || value.Operation == Guid.Empty || value.Request == Guid.Empty || value.Kind is < 0 or > 2 || t.Manage != (value.Kind == 2)) throw new InvalidOperationException(L["SchoolInvites:InvalidLocal"]); Pending = value; } StorageReady = true; }); StateHasChanged(); }
    private Task RefreshAsync() => RunAsync(async t => { Items = []; Total = 0; var page = t.Manage ? await Schools.GetRelationRequestsAsync(t.School, new() { SkipCount = Offset, MaxResultCount = 20 }) : await Schools.GetMyRelationRequestsAsync(t.School, new() { SkipCount = Offset, MaxResultCount = 20 }); if (!Current(t)) return; Items = page.Items.ToList(); Total = page.TotalCount;
        if (t.Manage) { var config = await Schools.GetSchoolConfigurationAsync(t.School); if (Current(t)) { Configuration = config; SchoolLabel = $"{config.School.Name} ({config.School.Code})"; } }
        else { var schools = await Schools.GetMySchoolsAsync(); var school = schools.Items.Single(x => x.Id == t.School && x.Roles.Contains(SchoolMemberRole.Teacher)); var relations = await Schools.GetMyTeachingRelationsAsync(t.School, new() { SkipCount = RelationOffset, MaxResultCount = 20 }); if (Current(t)) { SchoolLabel = $"{school.Name} ({school.Code})"; Relations = relations.Items.ToList(); RelationTotal = relations.TotalCount; } }
    });
    private Task PageAsync(int n) { Offset += n * 20; return RefreshAsync(); }
    private Task RelationPageAsync(int n) { RelationOffset += n * 20; Original = ""; return RefreshAsync(); }
    private Task OpenAsync(Guid id) => RunAsync(async t => { if (Pending != null) return; Selected = null; var row = t.Manage ? await Schools.GetRelationRequestAsync(t.School, id) : await Schools.GetMyRelationRequestAsync(id); if (!Current(t)) return; if (row.SchoolId != t.School || !t.Manage && row.TeacherUserId != t.User) throw new InvalidOperationException(); Selected = row; Resolution = TeachingRelationResolution.Reject; ResolutionText = Term = Class = Subject = To = ""; From = DateTime.Now.ToString("yyyy-MM-ddTHH:mm"); Reviewed = false; });
    private async Task PersistAsync(int kind, Guid request, Guid operation, (Guid? User, Guid? Tenant, Guid School, bool Manage, int Epoch) t) { var value = new PendingCommand { User = t.User, Tenant = t.Tenant, School = t.School, Manage = t.Manage, Kind = kind, Request = request, Operation = operation }; await JS.InvokeVoidAsync("sessionStorage.setItem", StorageKey, JsonSerializer.Serialize(value)); if (!Current(t)) throw new InvalidOperationException(); Pending = value; }
    private Task SubmitAsync() => RunAsync(async t => { if (t.Manage || !StorageReady || Pending != null || !Shared || Original.Length == 0) return; var input = new SubmitTeachingRelationRequestDto { OperationId = Guid.NewGuid(), OriginalAssignmentId = Original == "missing" ? null : Guid.Parse(Original), Text = Text, ConfirmSharingWithSchool = Shared };
        if (!await JS.InvokeAsync<bool>("confirm", L["RelationRequests:SubmitConfirm"].Value) || !Current(t)) return; SubmitInput = input; await PersistAsync(0, input.OperationId, input.OperationId, t); await FinishAsync(await Schools.SubmitRelationRequestAsync(t.School, input), t); });
    private Task WithdrawAsync() => RunAsync(async t => { if (t.Manage || Pending != null || Selected?.CanWithdraw != true) return; var row = Selected; if (!await JS.InvokeAsync<bool>("confirm", L["RelationRequests:WithdrawConfirm"].Value) || !Current(t)) return;
        var input = new WithdrawTeachingRelationRequestDto { OperationId = Guid.NewGuid(), ConcurrencyStamp = row.ConcurrencyStamp }; WithdrawInput = input; await PersistAsync(1, row.Id, input.OperationId, t); await FinishAsync(await Schools.WithdrawMyRelationRequestAsync(row.Id, input), t); });
    private Task ResolveAsync() => RunAsync(async t => { if (!t.Manage || !StorageReady || Pending != null || Selected == null || !Reviewed) return; var row = Selected; var adding = Resolution is TeachingRelationResolution.Add or TeachingRelationResolution.Replace;
        var input = new ResolveTeachingRelationRequestDto { OperationId = Guid.NewGuid(), ConcurrencyStamp = row.ConcurrencyStamp, SchoolConfigurationRevision = row.SchoolConfigurationRevision, Resolution = Resolution, OriginalAssignmentStamp = row.OriginalAssignmentStamp,
            AcademicTermId = adding ? Guid.Parse(Term) : null, SchoolClassId = adding ? Guid.Parse(Class) : null, EducationSubjectId = adding ? Guid.Parse(Subject) : null, EffectiveFromUtc = Resolution == TeachingRelationResolution.Reject ? null : Utc(From), EffectiveToUtc = adding && To.Length > 0 ? Utc(To) : null, Text = ResolutionText, ConfirmReviewedAccountAndChange = Reviewed };
        if (!await JS.InvokeAsync<bool>("confirm", L["RelationRequests:ResolveConfirm", row.TeacherDisplayName, Decision(Resolution)].Value) || !Current(t)) return; ResolveInput = input; await PersistAsync(2, row.Id, input.OperationId, t); await FinishAsync(await Schools.ResolveRelationRequestAsync(t.School, row.Id, input), t); });
    private Task RecoverAsync() => RunAsync(async t => { if (Pending == null) return; var row = t.Manage ? await Schools.GetRelationRequestAsync(t.School, Pending.Request) : await Schools.GetMyRelationRequestAsync(Pending.Request); await FinishAsync(row, t); });
    private Task RetryAsync() => RunAsync(async t => { if (Pending == null) return; TeachingRelationRequestDto? row = Pending.Kind switch { 0 when SubmitInput != null => await Schools.SubmitRelationRequestAsync(t.School, SubmitInput), 1 when WithdrawInput != null => await Schools.WithdrawMyRelationRequestAsync(Pending.Request, WithdrawInput), 2 when ResolveInput != null => await Schools.ResolveRelationRequestAsync(t.School, Pending.Request, ResolveInput), _ => null }; if (row != null) await FinishAsync(row, t); });
    private async Task FinishAsync(TeachingRelationRequestDto row, (Guid? User, Guid? Tenant, Guid School, bool Manage, int Epoch) t) { if (!Current(t)) return;
        if (Pending == null || row.Id != Pending.Request || row.SchoolId != t.School || (Pending.Kind == 0 ? row.Id != Pending.Operation || row.TeacherUserId != t.User : row.CompletionOperationId != Pending.Operation || row.CompletedByUserId != t.User || row.Status != (Pending.Kind == 1 ? TeachingRelationRequestStatus.Withdrawn : TeachingRelationRequestStatus.Processed))) throw new InvalidOperationException(L["RelationRequests:NoReceipt"]);
        await JS.InvokeVoidAsync("sessionStorage.removeItem", StorageKey); if (!Current(t)) return; Pending = null; SubmitInput = null; WithdrawInput = null; ResolveInput = null; Selected = row; Shared = Reviewed = false; Text = ResolutionText = ""; Notice = L["RelationRequests:Recorded"]; }
    private Task AbandonAsync() => RunAsync(async t => { if (!await JS.InvokeAsync<bool>("confirm", L["SchoolInvites:ClearConfirm"].Value) || !Current(t)) return; await JS.InvokeVoidAsync("sessionStorage.removeItem", StorageKey); if (Current(t)) { Pending = null; SubmitInput = null; WithdrawInput = null; ResolveInput = null; } });
    private async Task RunAsync(Func<(Guid? User, Guid? Tenant, Guid School, bool Manage, int Epoch), Task> action) { if (Busy || Disposed) return; var t = Ticket(); Busy = true; Error = null; try { await action(t); } catch (Exception ex) { if (Current(t)) Error = GetUserFriendlyErrorMessage(ex); } finally { if (Current(t)) Busy = false; } }
    private static DateTime Utc(string value) => DateTime.Parse(value, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal).ToUniversalTime();
    private static string Local(DateTime? value) => value?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—";
    private static string Summary(MyTeachingRelationDto row) => $"{row.AcademicTermName} · {row.ClassName} · {row.SubjectName} · {Local(row.EffectiveFromUtc)} → {Local(row.EffectiveToUtc)}";
    private string State(TeachingRelationRequestStatus state) => L["RelationRequests:Status" + state]; private string Decision(TeachingRelationResolution value) => L["RelationRequests:Decision" + value];
    private IEnumerable<TeachingRelationResolution> ResolutionChoices {
        get { if (Selected == null) return []; if (!Selected.OriginalAssignmentId.HasValue) return [TeachingRelationResolution.Reject, TeachingRelationResolution.Add];
            if (Selected.OriginalChanged || Selected.Original == null || Selected.Original.EffectiveToUtc <= DateTime.UtcNow) return [TeachingRelationResolution.Reject];
            return [TeachingRelationResolution.Reject, TeachingRelationResolution.End, TeachingRelationResolution.Replace]; }
    }
    private void TermChanged() { Class = ""; Reviewed = false; }
    private async Task LeaveAsync(Microsoft.AspNetCore.Components.Routing.LocationChangingContext context) { if ((Busy || Pending != null || Text.Length > 0 || ResolutionText.Length > 0) && !await JS.InvokeAsync<bool>("confirm", L["RelationRequests:Leave"].Value)) context.PreventNavigation(); }
    public void Dispose() { Disposed = true; Epoch++; Authentication.AuthenticationStateChanged -= AuthChanged; Clear(); }
    private sealed class PendingCommand { public Guid? User { get; set; } public Guid? Tenant { get; set; } public Guid School { get; set; } public bool Manage { get; set; } public int Kind { get; set; } public Guid Request { get; set; } public Guid Operation { get; set; } }
}
