@page "/education/teaching-plans/{PlanId:guid}/execution"
@attribute [Authorize(EducationPermissions.TeachingPlanManage)]
@attribute [Authorize(EducationPermissions.AnalysisManage)]
@inherits KnowPulseComponentBase
@using KnowPulse.Education
@using System.Text.Json
@inject IEducationTeachingPlanExecutionAppService Execution
@inject IJSRuntime JS
@inject Volo.Abp.Users.ICurrentUser Account
@inject Volo.Abp.MultiTenancy.ICurrentTenant Tenant

<PageTitle>@L["EducationPlanExecution:Title"]</PageTitle>
<NavigationLock ConfirmExternalNavigation="@(Busy || Dirty || Pending != null)" OnBeforeInternalNavigation="LeaveAsync" />
<h1 class="kp-heading-4">@L["EducationPlanExecution:Title"]</h1>
<p>@L["EducationPlanExecution:Description"]</p>
<p><a href="@($"/education/teaching-plans/{PlanId}/progress")">@L["EducationActivity:TeacherTitle"]</a> · <a href="/education/learning-reports">@L["EducationReport:Title"]</a> · <a href="/education/teaching-plans">@L["EducationPlan:Title"]</a></p>
@if (Error != null) { <div class="kp-alert kp-alert--error" role="alert">@Error</div> }
@if (Receipt != null) { <p role="status">@L["EducationGrading:Receipt", Receipt]</p> }
@if (Pending != null) {
    <div class="kp-alert kp-alert--info" role="status">@L["EducationGrading:Unknown"]
        <button class="kp-button kp-button--sm kp-button--primary-outline" disabled="@Busy" @onclick="RecoverAsync">@L["EducationGrading:Recover"]</button>
        <button class="kp-button kp-button--sm kp-button--secondary" disabled="@Busy" @onclick="(() => RunAsync(SendAsync))">@L["EducationReport:RetryCommand"]</button>
        <button class="kp-button kp-button--sm kp-button--secondary" disabled="@Busy" @onclick="AbandonAsync">@L["EducationReport:Abandon"]</button>
    </div>
}
<button class="kp-button kp-button--secondary kp-mb-3" disabled="@(Busy || Pending != null)" @onclick="RefreshAsync">@L["EducationReport:Reload"]</button>
@if (View is { } view) {
    <h2 class="kp-heading-5">@view.StudentName · @view.SubjectName · @view.Title</h2>
    <p role="status">@L[$"EducationPlanExecution:State:{(int)view.State}"]</p>
    @if (!view.IsCurrentPublication) { <p class="kp-alert kp-alert--info" role="status">@L["EducationPlan:Availability:4"]</p> }
    @if (!view.Evidence.SourceIsCurrent) { <p class="kp-alert kp-alert--warning">@L["EducationPlan:SourceChanged"]</p> }
    @if (view.Evidence.RequiresAssessmentPermission) { <p>@L["EducationFormal:Permission"]</p> }
    <p>@L["EducationPlanExecution:EvidenceNotice"]</p>
    <div class="kp-table-wrap"><table class="kp-table"><thead><tr><th>@L["EducationPlanExecution:Step"]</th><th>@L["EducationPlanExecution:StudentRecord"]</th><th>@L["EducationPlanExecution:FormalRecord"]</th></tr></thead><tbody>
    @foreach (var row in view.Evidence.Activities) {
        <tr><td>@L[$"EducationPlan:StepKind:{(int)row.Kind}"]</td><td>@(row.StudentAction.HasValue ? L[$"EducationActivity:Action:{row.StudentAction}"].Value : L["EducationPlanExecution:None"].Value)</td>
            <td>@(row.SealedAtUtc?.ToLocalTime().ToString("g") ?? L["EducationPlanExecution:NotSealed"].Value) · @L["EducationPlanExecution:ConfirmedQuestions", row.ConfirmedQuestionCount?.ToString() ?? "—"]
                @if (row.AssessmentTaskId is Guid taskId) { <a href="@($"/education/assessment-grading/{taskId}")">@L["EducationPlanExecution:ReviewGrading"]</a> }
            </td></tr>
    }
    </tbody></table></div>
    <fieldset class="kp-card kp-card__body kp-mb-3" disabled="@(Busy || Pending != null || !StorageReady || !view.IsCurrentPublication || view.State is EducationPlanExecutionState.Ended or EducationPlanExecutionState.Terminated)" @oninput="Changed" @onchange="Changed">
        <label class="kp-label">@L["EducationPlanExecution:Decision"]<select class="kp-select" @bind="Decision">@foreach (var option in Options) { <option value="@option">@L[$"EducationPlanExecution:Decision:{(int)option}"]</option> }</select></label>
        <p class="kp-text-small">@L["EducationPlanExecution:Adjustment"]</p>
        <label class="kp-label" for="execution-reason">@L["EducationPlanExecution:PrivateReason"]</label><textarea id="execution-reason" class="kp-input kp-mb-2" maxlength="2000" @bind="Reason" @bind:event="oninput"></textarea>
        <label class="kp-block kp-mb-2"><input type="checkbox" @bind="Confirm" /> @L["EducationPlanExecution:Confirmation"]</label>
        <button class="kp-button kp-button--primary kp-align-self-start" disabled="@(!Confirm || string.IsNullOrWhiteSpace(Reason))" @onclick="SaveAsync">@L["EducationPlanExecution:Save"]</button>
    </fieldset>
    <h2 class="kp-heading-5">@L["EducationPlanExecution:History"]</h2>
    @foreach (var row in History) { <div class="kp-card kp-card__body kp-mb-2"><p>@row.RecordedAtUtc.ToLocalTime().ToString("g") · @L[$"EducationPlanExecution:Decision:{(int)row.Decision}"] · @L[$"EducationPlanExecution:State:{(int)row.After}"]</p><p style="white-space:pre-wrap">@row.Reason</p></div> }
    <div class="kp-flex kp-gap-2"><button class="kp-button kp-button--secondary" disabled="@(Busy || Pending != null || Offset == 0)" @onclick="(() => PageAsync(-1))">@L["EducationPaper:Previous"]</button><button class="kp-button kp-button--secondary" disabled="@(Busy || Pending != null || Offset + 20 >= Total)" @onclick="(() => PageAsync(1))">@L["EducationPaper:Next"]</button></div>
}
@code {
    [Parameter] public Guid PlanId { get; set; }
    private Guid? LoadedId, Receipt; private bool Busy, Dirty, Confirm, StorageReady, StorageAttempted;
    private string Reason = ""; private string? Error; private EducationPlanDecision Decision; private EducationPlanExecutionReviewDto? View;
    private List<EducationPlanDecisionDto> History = []; private int Offset; private long Total; private Command? Pending;
    private string Key => $"education-plan-execution-v1:{Tenant.Id}:{Account.Id}:{PlanId}";
    private IEnumerable<EducationPlanDecision> Options => View?.State switch {
        EducationPlanExecutionState.Running => [EducationPlanDecision.Continue, EducationPlanDecision.Adjust, EducationPlanDecision.End, EducationPlanDecision.Pause, EducationPlanDecision.Terminate],
        EducationPlanExecutionState.Paused => View.AdjustmentNeedsPublication ? [EducationPlanDecision.Adjust, EducationPlanDecision.End, EducationPlanDecision.Terminate] : [EducationPlanDecision.Resume, EducationPlanDecision.Adjust, EducationPlanDecision.End, EducationPlanDecision.Terminate], _ => [] };
    protected override Task OnParametersSetAsync() => RunAsync(async () => { if (LoadedId == PlanId) return; LoadedId = PlanId; Pending = null; StorageReady = StorageAttempted = false; await LoadAsync(); });
    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (StorageAttempted || Busy) return; StorageAttempted = true;
        await RunAsync(async () => { var raw = await JS.InvokeAsync<string?>("sessionStorage.getItem", Key); if (raw != null) { var c = JsonSerializer.Deserialize<Command>(raw); if (c == null || !Matches(c)) throw new InvalidOperationException(L["EducationGrading:NoReceipt"]); Pending = c; } StorageReady = true; }); StateHasChanged();
    }
    private bool Matches(Command c) => c.PlanId == PlanId && c.AccountId == Account.Id && c.TenantId == Tenant.Id && c.Input?.OperationId != null && c.Input.OperationId != Guid.Empty;
    private async Task LoadAsync() { View = null; History.Clear(); Offset = 0; Dirty = Confirm = false; Reason = ""; View = await Execution.GetExecutionReviewAsync(PlanId); Decision = Options.FirstOrDefault(); await HistoryAsync(); }
    private async Task HistoryAsync() { if (View == null) return; var page = await Execution.GetExecutionHistoryAsync(PlanId, View.CurrentDecisionId, new() { SkipCount = Offset, MaxResultCount = 20 }); History = page.Items.ToList(); Total = page.TotalCount; }
    private void Changed() => Dirty = true;
    private Task RefreshAsync() => RunAsync(async () => { if (!Dirty || await JS.InvokeAsync<bool>("confirm", L["EducationGrading:Discard"].Value)) await LoadAsync(); });
    private Task PageAsync(int direction) => RunAsync(async () => { Offset += direction * 20; await HistoryAsync(); });
    private Task SaveAsync() => RunAsync(async () => { if (View == null || Pending != null || !StorageReady || !Confirm) return;
        Pending = new() { PlanId = PlanId, AccountId = Account.Id, TenantId = Tenant.Id, Input = new() { OperationId = Guid.NewGuid(), ExpectedPublishedRevisionId = View.Evidence.PublishedRevisionId,
            ExpectedDecisionId = View.CurrentDecisionId, ConcurrencyStamp = View.ConcurrencyStamp, EvidenceFingerprint = View.EvidenceFingerprint, Decision = Decision, Reason = Reason, ConfirmReviewedEvidenceAndUncertainty = Confirm } };
        await JS.InvokeVoidAsync("sessionStorage.setItem", Key, JsonSerializer.Serialize(Pending)); await SendAsync(); });
    private async Task SendAsync() { if (Pending is not { } c || !Matches(c)) throw new InvalidOperationException(L["EducationGrading:NoReceipt"]); var result = await Execution.DecideExecutionAsync(PlanId, c.Input); await CompleteAsync(result); }
    private Task RecoverAsync() => RunAsync(async () => { if (Pending is not { } c || !Matches(c)) return; var result = await Execution.GetExecutionOperationAsync(PlanId, c.Input.OperationId); if (result == null) Error = L["EducationGrading:NoReceipt"]; else await CompleteAsync(result); });
    private async Task CompleteAsync(EducationPlanDecisionDto result) { if (Pending is not { } c || !Matches(c) || result.Id != c.Input.OperationId || result.PlanId != PlanId) throw new InvalidOperationException(L["EducationGrading:NoReceipt"]); await JS.InvokeVoidAsync("sessionStorage.removeItem", Key); Pending = null; Receipt = result.Id; await LoadAsync(); }
    private Task AbandonAsync() => RunAsync(async () => { if (!await JS.InvokeAsync<bool>("confirm", L["EducationReport:AbandonHint"].Value)) return; await JS.InvokeVoidAsync("sessionStorage.removeItem", Key); Pending = null; StorageReady = true; await LoadAsync(); });
    private async Task LeaveAsync(LocationChangingContext c) { if (Busy || Pending != null) c.PreventNavigation(); else if (Dirty && !await JS.InvokeAsync<bool>("confirm", L["EducationGrading:Discard"].Value)) c.PreventNavigation(); }
    private async Task RunAsync(Func<Task> action) { if (Busy) return; Busy = true; Error = null; try { await action(); } catch (Exception e) { View = null; History.Clear(); Error = e.Message; } finally { Busy = false; } }
    public sealed class Command { public Guid PlanId { get; set; } public Guid? AccountId { get; set; } public Guid? TenantId { get; set; } public DecideEducationPlanExecutionDto Input { get; set; } = new(); }
}
