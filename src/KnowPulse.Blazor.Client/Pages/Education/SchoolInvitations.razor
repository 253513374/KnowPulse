@page "/education/schools/{SchoolId:guid}/invitations"
@attribute [Authorize(EducationPermissions.SchoolManage)]
@inherits KnowPulseComponentBase
@implements IDisposable
@using KnowPulse.Education
@using System.Text.Json
@using System.Globalization
@inject IEducationSchoolAppService Schools
@inject IJSRuntime JS
@inject Volo.Abp.Users.ICurrentUser Account
@inject Volo.Abp.MultiTenancy.ICurrentTenant Tenant
@inject AuthenticationStateProvider Authentication

<PageTitle>@L["SchoolInvites:Manage"]</PageTitle>
<h1 class="h4">@L["SchoolInvites:Manage"] · @SchoolName</h1><p>@L["SchoolInvites:ManagerHint"]</p>
<a href="/education/schools">@L["EducationSchools:Title"]</a>
@if (Error != null) { <p class="alert alert-danger" role="alert">@Error</p> }
@if (Notice != null) { <p class="alert alert-info" role="status">@Notice</p> }
@if (Pending != null) { <section class="alert alert-warning"><h2 class="h6">@L["SchoolInvites:Pending"]</h2><p>@L["SchoolInvites:Uncertain"]</p><button class="btn btn-outline-primary me-2" disabled="@Busy" @onclick="RecoverAsync">@L["SchoolInvites:Recover"]</button><button class="btn btn-outline-primary me-2" disabled="@(Busy || CreateInput == null && RevokeInput == null)" @onclick="RetryAsync">@L["SchoolInvites:Retry"]</button><button class="btn btn-outline-secondary" disabled="@Busy" @onclick="AbandonAsync">@L["SchoolInvites:Clear"]</button></section> }
<fieldset disabled="@(Busy || !StorageReady || Pending != null)"><legend class="h5">@L["SchoolInvites:Create"]</legend>
<form class="d-flex gap-2 mb-2" @onsubmit="SearchAsync" @onsubmit:preventDefault="true"><label for="invite-search" class="visually-hidden">@L["EducationSchools:AccountKeyword"]</label><input id="invite-search" class="form-control" @bind="Keyword" required minlength="2" maxlength="64" /><button type="submit" class="btn btn-outline-primary">@L["EducationSchools:Search"]</button></form>
<p class="text-muted">@L["EducationSchools:AccountSearchHint"]</p>
@foreach (var account in Accounts) { <button class="btn btn-sm btn-outline-secondary me-2 mb-2" @onclick="() => Target = account">@account.DisplayName · @account.UserName</button> }
@if (Target != null) { <p><strong>@Target.DisplayName</strong> · @Target.UserName</p> }
<form @onsubmit="CreateAsync" @onsubmit:preventDefault="true"><div class="row g-2">
<div class="col-md-3"><label for="invite-role" class="form-label">@L["EducationSchools:Role"]</label><select id="invite-role" class="form-select" @bind="Role"><option value="@SchoolMemberRole.Teacher">@RoleName(SchoolMemberRole.Teacher)</option><option value="@SchoolMemberRole.Student">@RoleName(SchoolMemberRole.Student)</option></select></div>
<div class="col-md-3"><label for="invite-from" class="form-label">@L["SchoolInvites:From"]</label><input id="invite-from" type="datetime-local" class="form-control" value="@From" @onchange='e => From = e.Value?.ToString() ?? ""' required /></div>
<div class="col-md-3"><label for="invite-to" class="form-label">@L["SchoolInvites:To"]</label><input id="invite-to" type="datetime-local" class="form-control" value="@To" @onchange='e => To = e.Value?.ToString() ?? ""' /></div>
<div class="col-md-3"><label for="invite-expires" class="form-label">@L["SchoolInvites:Expires"]</label><input id="invite-expires" type="datetime-local" class="form-control" value="@Expires" @onchange='e => Expires = e.Value?.ToString() ?? ""' required /></div>
</div><label class="form-check my-3"><input type="checkbox" class="form-check-input" @bind="Verified" />@L["SchoolInvites:Verified"]</label><button type="submit" class="btn btn-primary" disabled="@(Target == null || !Verified)">@L["SchoolInvites:Create"]</button></form></fieldset>
<section class="mt-4"><h2 class="h5">@L["SchoolInvites:History"]</h2>
@foreach (var row in Items) { <article class="border rounded p-3 my-2" @key="row.Id"><p>@row.TargetDisplayName · @RoleName(row.Role) · @StatusName(row.Status)</p><p>@Local(row.EffectiveFromUtc) → @Local(row.EffectiveToUtc) · @L["SchoolInvites:Expires"] @Local(row.ExpiresAtUtc)</p>
@if (row.DeclineReason.HasValue) { <p>@DeclineName(row.DeclineReason.Value)</p> }
@if (row.RevocationReason != null) { <p class="text-break">@row.RevocationReason</p> }
@if (row.CanRevoke) { <button class="btn btn-outline-danger btn-sm" disabled="@(Busy || Pending != null)" @onclick="() => RevokeTarget = row">@L["SchoolInvites:PrepareRevoke"]</button> }</article> }
<div class="d-flex gap-2 align-items-center"><button class="btn btn-outline-secondary" disabled="@(Busy || Offset == 0)" @onclick="() => PageAsync(-1)">@L["EducationPaper:Previous"]</button><span>@L["SchoolInvites:Count", Total]</span><button class="btn btn-outline-secondary" disabled="@(Busy || Offset + 20 >= Total)" @onclick="() => PageAsync(1)">@L["EducationPaper:Next"]</button><button class="btn btn-outline-secondary" disabled="@Busy" @onclick="RefreshAsync">@L["EducationSchools:Refresh"]</button></div></section>
@if (RevokeTarget != null) { <fieldset class="mt-3" disabled="@(Busy || Pending != null)"><legend class="h6">@L["SchoolInvites:PrepareRevoke"] · @RevokeTarget.TargetDisplayName</legend><label for="invite-revoke-reason">@L["SchoolInvites:RevokeReason"]</label><textarea id="invite-revoke-reason" class="form-control mb-2" @bind="Reason" maxlength="1000"></textarea><button class="btn btn-danger" disabled="@string.IsNullOrWhiteSpace(Reason)" @onclick="RevokeAsync">@L["SchoolInvites:ConfirmRevoke"]</button></fieldset> }

@code {
    [Parameter] public Guid SchoolId { get; set; }
    private string? Error, Notice; private string SchoolName = "", Keyword = "", Reason = "";
    private string From = LocalInput(DateTime.Now), To = "", Expires = LocalInput(DateTime.Now.AddDays(3));
    private SchoolMemberRole Role = SchoolMemberRole.Teacher; private bool Verified, Busy, StorageReady, StorageAttempted, Disposed;
    private int Offset, Epoch; private long Total; private SchoolAccountDto? Target; private SchoolInvitationDto? RevokeTarget;
    private List<SchoolAccountDto> Accounts = []; private List<SchoolInvitationDto> Items = [];
    private PendingCommand? Pending; private CreateSchoolInvitationDto? CreateInput; private RevokeSchoolInvitationDto? RevokeInput;
    private string StorageKey => $"education-school-invite:{Tenant.Id}:{Account.Id}:{SchoolId}";
    private (Guid? User, Guid? Tenant, Guid School, int Epoch) Ticket() => (Account.Id, Tenant.Id, SchoolId, Epoch);
    private bool Current((Guid? User, Guid? Tenant, Guid School, int Epoch) t) => !Disposed && Account.IsAuthenticated && Account.Id == t.User && Tenant.Id == t.Tenant && SchoolId == t.School && Epoch == t.Epoch;
    protected override void OnInitialized() => Authentication.AuthenticationStateChanged += AuthChanged;
    private void AuthChanged(Task<AuthenticationState> state) => _ = InvokeAsync(() => { Epoch++; Busy = StorageReady = StorageAttempted = false; Items.Clear(); Accounts.Clear(); Target = null; RevokeTarget = null; Pending = null; CreateInput = null; RevokeInput = null; Reason = ""; Verified = false; StateHasChanged(); });
    protected override async Task OnParametersSetAsync() { Epoch++; Busy = StorageReady = StorageAttempted = Verified = false; Pending = null; CreateInput = null; RevokeInput = null; Target = null; RevokeTarget = null; Items.Clear(); Accounts.Clear(); SchoolName = Reason = ""; Offset = 0; await RefreshAsync(); }
    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (StorageAttempted || Busy) return; StorageAttempted = true;
        await RunAsync(async t => { var raw = await JS.InvokeAsync<string?>("sessionStorage.getItem", StorageKey); if (!Current(t)) return;
            if (raw != null) { var value = JsonSerializer.Deserialize<PendingCommand>(raw); if (value == null || value.School != SchoolId || value.User != Account.Id || value.Tenant != Tenant.Id || value.Invitation == Guid.Empty || value.Operation == Guid.Empty || value.Kind is not (0 or 1)) throw new InvalidOperationException(L["SchoolInvites:InvalidLocal"]); Pending = value; }
            StorageReady = true; }); StateHasChanged();
    }
    private Task RefreshAsync() => RunAsync(async t => { Items = []; Accounts = []; SchoolName = ""; Total = 0; var school = await Schools.GetSchoolConfigurationAsync(t.School); var page = await Schools.GetInvitationsAsync(t.School, new() { SkipCount = Offset, MaxResultCount = 20 }); if (Current(t)) { SchoolName = school.School.Name; Items = page.Items.ToList(); Total = page.TotalCount; } });
    private Task PageAsync(int n) { Offset += n * 20; return RefreshAsync(); }
    private Task SearchAsync() => RunAsync(async t => { Accounts = []; Target = null; var page = await Schools.GetAccountsAsync(t.School, new() { Keyword = Keyword, MaxResultCount = 20 }); if (Current(t)) Accounts = page.Items.ToList(); });
    private async Task SavePendingAsync(int kind, Guid id, Guid operation) { var t = Ticket(); var value = new PendingCommand { School = SchoolId, User = Account.Id, Tenant = Tenant.Id, Kind = kind, Invitation = id, Operation = operation }; await JS.InvokeVoidAsync("sessionStorage.setItem", StorageKey, JsonSerializer.Serialize(value)); if (!Current(t)) throw new InvalidOperationException(); Pending = value; }
    private Task CreateAsync() => RunAsync(async t => { if (!StorageReady || Pending != null || Target == null || !Verified) return;
        var input = new CreateSchoolInvitationDto { OperationId = Guid.NewGuid(), TargetUserId = Target.Id, Role = Role, EffectiveFromUtc = Utc(From), EffectiveToUtc = To.Length == 0 ? null : Utc(To), ExpiresAtUtc = Utc(Expires), ConfirmVerifiedAccount = true };
        if (!await JS.InvokeAsync<bool>("confirm", L["SchoolInvites:ConfirmCreate", Target.DisplayName, SchoolName, RoleName(Role)].Value) || !Current(t)) return;
        CreateInput = input; await SavePendingAsync(0, input.OperationId, input.OperationId); if (Current(t)) await FinishAsync(await Schools.CreateInvitationAsync(t.School, input), t);
    });
    private Task RevokeAsync() => RunAsync(async t => { if (!StorageReady || Pending != null || RevokeTarget == null) return; var row = RevokeTarget;
        var input = new RevokeSchoolInvitationDto { OperationId = Guid.NewGuid(), ConcurrencyStamp = row.ConcurrencyStamp, Reason = Reason };
        if (!await JS.InvokeAsync<bool>("confirm", L["SchoolInvites:RevokeConfirm"].Value) || !Current(t)) return;
        RevokeInput = input; await SavePendingAsync(1, row.Id, input.OperationId); if (Current(t)) await FinishAsync(await Schools.RevokeInvitationAsync(t.School, row.Id, input), t);
    });
    private Task RecoverAsync() => RunAsync(async t => { if (Pending == null) return; await FinishAsync(await Schools.GetInvitationAsync(t.School, Pending.Invitation), t); });
    private Task RetryAsync() => RunAsync(async t => { if (Pending == null) return;
        if (Pending.Kind == 0 && CreateInput != null) await FinishAsync(await Schools.CreateInvitationAsync(t.School, CreateInput), t);
        else if (Pending.Kind == 1 && RevokeInput != null) await FinishAsync(await Schools.RevokeInvitationAsync(t.School, Pending.Invitation, RevokeInput), t);
    });
    private async Task FinishAsync(SchoolInvitationDto row, (Guid? User, Guid? Tenant, Guid School, int Epoch) t) {
        if (!Current(t)) return; if (Pending == null || row.Id != Pending.Invitation || row.SchoolId != t.School || (Pending.Kind == 0 ? row.Id != Pending.Operation || row.InvitedByUserId != t.User : row.RevocationOperationId != Pending.Operation || row.RevokedByUserId != t.User)) throw new InvalidOperationException(L["SchoolInvites:NoReceipt"]);
        await JS.InvokeVoidAsync("sessionStorage.removeItem", StorageKey); if (!Current(t)) return; Pending = null; CreateInput = null; RevokeInput = null; Target = null; Verified = false; Reason = ""; RevokeTarget = null; Notice = L["SchoolInvites:Recorded"];
        var page = await Schools.GetInvitationsAsync(t.School, new() { SkipCount = Offset, MaxResultCount = 20 }); if (Current(t)) { Items = page.Items.ToList(); Total = page.TotalCount; }
    }
    private Task AbandonAsync() => RunAsync(async t => { if (!await JS.InvokeAsync<bool>("confirm", L["SchoolInvites:ClearConfirm"].Value) || !Current(t)) return; await JS.InvokeVoidAsync("sessionStorage.removeItem", StorageKey); if (Current(t)) { Pending = null; CreateInput = null; RevokeInput = null; } });
    private async Task RunAsync(Func<(Guid? User, Guid? Tenant, Guid School, int Epoch), Task> action) { if (Busy || Disposed) return; var t = Ticket(); Busy = true; Error = null; try { await action(t); } catch (Exception ex) { if (Current(t)) Error = GetUserFriendlyErrorMessage(ex); } finally { if (Current(t)) Busy = false; } }
    private static string LocalInput(DateTime value) => value.ToString("yyyy-MM-ddTHH:mm", CultureInfo.InvariantCulture);
    private static DateTime Utc(string value) => DateTime.Parse(value, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal).ToUniversalTime();
    private static string Local(DateTime? value) => value?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—";
    private string RoleName(SchoolMemberRole value) => L["EducationSchools:Role:" + value]; private string StatusName(SchoolInvitationStatus value) => L["SchoolInvites:Status" + value]; private string DeclineName(SchoolInvitationDeclineReason value) => L["SchoolInvites:Reason" + value];
    public void Dispose() { Disposed = true; Epoch++; Authentication.AuthenticationStateChanged -= AuthChanged; Pending = null; CreateInput = null; RevokeInput = null; Reason = ""; }
    private sealed class PendingCommand { public Guid School { get; set; } public Guid? User { get; set; } public Guid? Tenant { get; set; } public int Kind { get; set; } public Guid Invitation { get; set; } public Guid Operation { get; set; } }
}
