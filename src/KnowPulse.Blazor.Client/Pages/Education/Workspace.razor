@page "/education/workspace"
@attribute [Authorize]
@inherits KnowPulseComponentBase
@implements IDisposable
@using KnowPulse.Education
@using System.Security.Claims
@using Volo.Abp.Security.Claims
@inject IEducationSchoolAppService Schools
@inject AuthenticationStateProvider Authentication

<PageTitle>@L["EducationWorkspace:Title"]</PageTitle>
<p><a href="/account/assistance">@L["AccountHelp:Title"]</a></p>
<p><a href="/education/invitations">@L["SchoolInvites:Mine"]</a></p>
<section class="education-workspace" aria-busy="@Busy.ToString().ToLowerInvariant()">
    <div class="kp-flex kp-flex-wrap kp-justify-between kp-align-start kp-gap-2 kp-mb-3">
        <div><h1 class="kp-heading-4">@L["EducationWorkspace:Title"]</h1><p class="kp-text-muted">@L["EducationWorkspace:Introduction"]</p></div>
        <button class="kp-button kp-button--primary-outline" disabled="@Busy" @onclick="ReloadAsync">@L["EducationWorkspace:Refresh"]</button>
    </div>
    @if (Busy) { <p role="status">@L["EducationWorkspace:Loading"]</p> }
    @if (Error != null) { <p class="kp-alert kp-alert--error" role="alert">@Error</p> }
    @if (Snapshot != null)
    {
        @if (HasPermission(KnowPulsePermissions.KnowledgeBase.PersonalLibrary))
        {
            <div class="kp-card kp-mb-3"><div class="kp-card__body">
                <h2 class="kp-heading-5">@L["EducationWorkspace:PersonalLibrary"]</h2><p>@L["EducationWorkspace:PersonalLibraryHint"]</p>
                <a class="kp-button kp-button--primary-outline" href="/my-knowledge">@L["EducationWorkspace:OpenPersonalLibrary"]</a>
            </div></div>
        }
        @if (Snapshot.ManagedSchoolIds.Count > 0 && HasPermission(EducationPermissions.SchoolManage))
        {
            <p><a href="/education/schools">@L["EducationWorkspace:ManageSchools"]</a></p>
        }
        @if (Snapshot.Workspaces.Count == 0)
        {
            <p class="kp-alert kp-alert--info" role="status">@L["EducationWorkspace:NoIdentity"]</p>
        }
        else
        {
            <fieldset class="kp-mb-3">
                <legend class="kp-heading-5">@L["EducationWorkspace:ChooseRole"]</legend>
                <div class="kp-flex kp-flex-wrap kp-gap-2">
                    @foreach (var role in Snapshot.Workspaces.Select(x => x.Role).Distinct().Order())
                    {
                        <button type="button" class="kp-button @(SelectedRole == role ? "btn-primary" : "btn-outline-primary")" disabled="@Busy"
                                aria-pressed="@((SelectedRole == role).ToString().ToLowerInvariant())" @onclick="(() => LoadAsync(role))">@RoleName(role)</button>
                    }
                </div>
            </fieldset>
            @if (SelectedRole.HasValue)
            {
                <h2 class="kp-heading-5">@RoleName(SelectedRole.Value)</h2>
                <div class="workspace-schools kp-mb-3">
                    @foreach (var workspace in Snapshot.Workspaces.Where(x => x.Role == SelectedRole))
                    {
                        @if (workspace.Role == SchoolMemberRole.Teacher) { <p><a href="@($"/education/schools/{workspace.SchoolId}/relation-requests")">@L["RelationRequests:Title"]</a></p> }
                        <section class="kp-card" aria-labelledby="@($"workspace-{workspace.SchoolId:N}")"><div class="kp-card__body">
                            <h3 id="@($"workspace-{workspace.SchoolId:N}")" class="kp-heading-6">@workspace.SchoolName</h3>
                            @if (SelectedRole == SchoolMemberRole.Student && (HasPermission(EducationPermissions.AssessmentParticipate) || HasPermission(EducationPermissions.FeedbackView) || HasPermission(EducationPermissions.TeachingPlanView))) { <a class="kp-button kp-button--sm kp-button--primary-outline" href="@($"/education/inbox/{workspace.SchoolId}")">@L["EducationInbox:Title"]</a> }
                            @if (workspace.Classes.Count == 0) { <p class="kp-mb-0">@L[SelectedRole == SchoolMemberRole.Teacher ? "EducationWorkspace:NoTeaching" : "EducationWorkspace:NoEnrollment"]</p> }
                            else
                            {
                                <ul class="workspace-classes">
                                    @foreach (var schoolClass in workspace.Classes)
                                    {
                                        <li><strong>@schoolClass.ClassName</strong><span>@schoolClass.AcademicTermName</span>
                                            @if (schoolClass.SubjectName != null) { <span>@schoolClass.SubjectName</span> }
                                        </li>
                                    }
                                </ul>
                            }
                        </div></section>
                    }
                </div>
                @if (ActiveClasses)
                {
                    <nav class="workspace-actions" aria-label="@L["EducationWorkspace:Actions"]">
                        @if (SelectedRole == SchoolMemberRole.Teacher)
                        {
                            @if (HasPermission(EducationPermissions.AssessmentManage)) { <a class="kp-button kp-button--primary-outline" href="/education/assessment-tasks">@L["EducationWorkspace:Assessments"]</a> }
                            @if (HasPermission(EducationPermissions.LearningManage)) { <a class="kp-button kp-button--primary-outline" href="/education/study-tasks">@L["EducationWorkspace:StudyTasks"]</a> }
                            @if (HasPermission(EducationPermissions.FeedbackManage)) { <a class="kp-button kp-button--primary-outline" href="/education/feedback">@L["EducationWorkspace:Feedback"]</a> }
                            @if (HasPermission(EducationPermissions.AnalysisManage)) { <a class="kp-button kp-button--primary-outline" href="/education/learning-reports">@L["EducationWorkspace:Reports"]</a> }
                            @if (HasPermission(EducationPermissions.TeachingPlanManage, EducationPermissions.AnalysisManage)) { <a class="kp-button kp-button--primary-outline" href="/education/teaching-plans">@L["EducationWorkspace:Plans"]</a> }
                            @if (HasPermission(EducationPermissions.AssessmentManage, EducationPermissions.LearningManage)) { <a class="kp-button kp-button--primary-outline" href="/education/corrections">@L["EducationWorkspace:Corrections"]</a> }
                        }
                        else
                        {
                            @if (HasPermission(EducationPermissions.AssessmentParticipate)) { <a class="kp-button kp-button--primary-outline" href="/education/assessment-results">@L["EducationWorkspace:MyAssessments"]</a> <a class="kp-button kp-button--primary-outline" href="/education/growth">@L["EducationWorkspace:MyGrowth"]</a> }
                            @if (HasPermission(EducationPermissions.LearningParticipate)) { <a class="kp-button kp-button--primary-outline" href="/education/workload">@L["EducationWorkspace:MySchedule"]</a> <a class="kp-button kp-button--primary-outline" href="/education/study-tasks/my">@L["EducationWorkspace:MyStudyTasks"]</a> }
                            @if (HasPermission(EducationPermissions.FeedbackView)) { <a class="kp-button kp-button--primary-outline" href="/education/feedback/my">@L["EducationWorkspace:MyFeedback"]</a> }
                            @if (HasPermission(EducationPermissions.TeachingPlanView)) { <a class="kp-button kp-button--primary-outline" href="/education/teaching-plans/my">@L["EducationWorkspace:MyPlans"]</a> }
                            @if (HasPermission(EducationPermissions.AssessmentParticipate, EducationPermissions.LearningParticipate)) { <a class="kp-button kp-button--primary-outline" href="/education/corrections/my">@L["EducationWorkspace:MyCorrections"]</a> <a class="kp-button kp-button--primary-outline" href="/education/practice">@L["EducationWorkspace:MyPractice"]</a> }
                            @if (HasPermission(EducationPermissions.AssessmentParticipate, EducationPermissions.LearningParticipate)) { <a class="kp-button kp-button--primary-outline" href="/education/question-collections">@L["EducationCollection:Title"]</a> }
                        }
                    </nav>
                    @if (!HasRoleActions) { <p class="kp-alert kp-alert--info">@L["EducationWorkspace:NoPermissions"]</p> }
                }
                @if (SelectedRole == SchoolMemberRole.Student && HasPermission(KnowPulsePermissions.KnowledgeBase.PersonalLibrary))
                {
                    <p class="kp-mt-3"><a href="/education/notebook">@L["EducationWorkspace:MyNotebook"]</a></p>
                }
            }
        }
        <p class="kp-text-small kp-text-muted kp-mt-3">@L["EducationWorkspace:ObservedAt", Snapshot.ObservedAtUtc.ToString("yyyy-MM-dd HH:mm:ss")]</p>
    }
</section>

@code {
    private EducationWorkspaceDto? Snapshot;
    private SchoolMemberRole? SelectedRole;
    private bool Busy, Disposed;
    private string? Error;
    private int Generation;
    private bool ActiveClasses => Snapshot?.Workspaces.Any(x => x.Role == SelectedRole && x.Classes.Count > 0) == true;
    private bool HasRoleActions => SelectedRole == SchoolMemberRole.Teacher
        ? HasPermission(EducationPermissions.AssessmentManage) || HasPermission(EducationPermissions.LearningManage) || HasPermission(EducationPermissions.FeedbackManage) || HasPermission(EducationPermissions.AnalysisManage)
        : HasPermission(EducationPermissions.AssessmentParticipate) || HasPermission(EducationPermissions.LearningParticipate) || HasPermission(EducationPermissions.FeedbackView) || HasPermission(EducationPermissions.TeachingPlanView);
    private bool HasPermission(params string[] permissions) => Snapshot != null && permissions.All(Snapshot.GrantedPermissions.Contains);
    private string RoleName(SchoolMemberRole role) => L[role == SchoolMemberRole.Teacher ? "EducationWorkspace:Teacher" : "EducationWorkspace:Student"];
    protected override async Task OnInitializedAsync()
    {
        Authentication.AuthenticationStateChanged += AccountChanged;
        await LoadAsync(null);
    }
    private Task ReloadAsync() => LoadAsync(SelectedRole);
    private async Task LoadAsync(SchoolMemberRole? preferredRole)
    {
        var generation = ++Generation;
        Busy = true; Error = null; Snapshot = null; SelectedRole = null;
        try
        {
            var principal = (await Authentication.GetAuthenticationStateAsync()).User;
            var identity = IdentityKey(principal);
            if (identity == null) return;
            var result = await Schools.GetMyWorkspaceAsync();
            var current = (await Authentication.GetAuthenticationStateAsync()).User;
            if (Disposed || generation != Generation) return;
            if (identity != IdentityKey(current) || identity != $"{result.TenantId?.ToString("N") ?? "host"}:{result.AccountUserId:N}")
            {
                Error = L["EducationWorkspace:AccountChanged"]; return;
            }
            Snapshot = result;
            var roles = result.Workspaces.Select(x => x.Role).Distinct().ToList();
            SelectedRole = preferredRole.HasValue && roles.Contains(preferredRole.Value) ? preferredRole : roles.Count == 1 ? roles[0] : null;
        }
        catch (Exception ex)
        {
            if (!Disposed && generation == Generation) Error = GetUserFriendlyErrorMessage(ex);
        }
        finally { if (!Disposed && generation == Generation) Busy = false; }
    }
    private static string? IdentityKey(ClaimsPrincipal principal)
    {
        if (principal.Identity?.IsAuthenticated != true || !Guid.TryParse(principal.FindFirst(AbpClaimTypes.UserId)?.Value, out var userId)) return null;
        var tenant = principal.FindFirst(AbpClaimTypes.TenantId)?.Value;
        if (tenant != null && !Guid.TryParse(tenant, out _)) return null;
        return $"{(tenant == null ? "host" : Guid.Parse(tenant).ToString("N"))}:{userId:N}";
    }
    private void AccountChanged(Task<AuthenticationState> state)
    {
        if (!Disposed) _ = InvokeAsync(async () =>
        {
            if (Disposed) return;
            var load = LoadAsync(null);
            StateHasChanged();
            await load;
            if (!Disposed) StateHasChanged();
        });
    }
    public void Dispose()
    {
        Disposed = true; Generation++; Snapshot = null;
        Authentication.AuthenticationStateChanged -= AccountChanged;
    }
}
