@page "/education/practice-submissions"
@attribute [Authorize(EducationPermissions.AssessmentManage)]
@attribute [Authorize(EducationPermissions.LearningManage)]
@inherits KnowPulseComponentBase
@using KnowPulse.Education
@inject IEducationQuestionPracticeAppService Practices
@inject Volo.Abp.Users.ICurrentUser Account
@inject Volo.Abp.MultiTenancy.ICurrentTenant Tenant
<PageTitle>@L["EducationPractice:TeacherTitle"]</PageTitle>
<h1 class="kp-heading-4">@L["EducationPractice:TeacherTitle"]</h1>
<p>@L["EducationPractice:TeacherHint"]</p>
@if (Error != null) { <p class="kp-alert kp-alert--error" role="alert">@Error</p> }
<button class="kp-button kp-button--secondary kp-mb-3" disabled="@Busy" @onclick="ReloadAsync">@L["EducationReport:Reload"]</button>
@if (SubmissionId == null) { <p>@L["EducationPractice:ChooseOriginalSubmission"]</p> }
<div class="kp-grid kp-grid-gap-3"><aside class="kp-col-12 kp-col-lg-4"><div class="kp-list">
    @foreach (var row in Items) { <button class="kp-list__item list-group-item-action" disabled="@Busy" @onclick="(() => OpenAsync(row.Id))">@row.SubmittedAtUtc?.ToLocalTime().ToString("g")<br />@L["EducationPractice:SubmittedCopy"]</button> }
</div><p class="kp-text-small kp-mt-2">@L["EducationPractice:RecordCount", Total]</p>
<button class="kp-button kp-button--sm kp-button--secondary" disabled="@(Busy || Offset == 0)" @onclick="(() => PageAsync(-1))">@L["EducationPaper:Previous"]</button>
<button class="kp-button kp-button--sm kp-button--secondary" disabled="@(Busy || Offset + 20 >= Total)" @onclick="(() => PageAsync(1))">@L["EducationPaper:Next"]</button></aside>
<main class="kp-col-12 kp-col-lg-8"><EducationPracticeReview @key="LoadedContext" Model="Selected" ReadImage="ReadImageAsync" /></main></div>
@code {
    [SupplyParameterFromQuery(Name = "submissionId")] public Guid? SubmissionId { get; set; }
    [SupplyParameterFromQuery(Name = "questionId")] public Guid? QuestionId { get; set; }
    private string? LoadedContext, Error; private bool Busy; private int Offset; private long Total;
    private List<EducationPracticeListDto> Items = []; private EducationPracticeDto? Selected;
    private string Context => $"{Tenant.Id}:{Account.Id}:{SubmissionId}:{QuestionId}";
    protected override async Task OnParametersSetAsync() { var context = Context; if (context != LoadedContext) { LoadedContext = context; Offset = 0; Selected = null; Items = []; await ReloadAsync(); } }
    private async Task LoadAsync() {
        Items = []; Total = 0; if (SubmissionId is not Guid id) return;
        var context = Context; var page = await Practices.GetPracticeSubmissionsAsync(id, QuestionId, new() { SkipCount = Offset, MaxResultCount = 20 }); if (context != Context) return; Items = page.Items.ToList(); Total = page.TotalCount;
    }
    private Task ReloadAsync() => RunAsync(async () => { Selected = null; await LoadAsync(); });
    private Task OpenAsync(Guid id) => RunAsync(async () => { Selected = null; var context = Context; var row = await Practices.GetPracticeSubmissionAsync(id); if (context == Context) Selected = row; });
    private Task PageAsync(int direction) => RunAsync(async () => { Offset = Math.Max(0, Offset + 20 * direction); await LoadAsync(); });
    private Task<Volo.Abp.Content.IRemoteStreamContent> ReadImageAsync(Guid id) => Practices.DownloadPracticeImageAsync(Selected!.Id, id);
    private async Task RunAsync(Func<Task> action) { if (Busy) return; Busy = true; Error = null; try { await action(); } catch (Exception ex) { Selected = null; Error = GetUserFriendlyErrorMessage(ex); } finally { Busy = false; } }
}
