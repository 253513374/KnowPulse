@page "/education/corrections"
@attribute [Authorize(EducationPermissions.AssessmentManage)]
@attribute [Authorize(EducationPermissions.LearningManage)]
@inherits KnowPulseComponentBase
@using KnowPulse.Education
@using System.Text.Json
@inject IEducationCorrectionAppService CorrectionsApi
@inject IJSRuntime JS
@inject Volo.Abp.Users.ICurrentUser Account
@inject Volo.Abp.MultiTenancy.ICurrentTenant Tenant
<PageTitle>@L["EducationCorrection:Title"]</PageTitle>
<NavigationLock ConfirmExternalNavigation="@(Busy || Dirty || Pending != null)" OnBeforeInternalNavigation="LeaveAsync" />
<h1 class="h4">@L["EducationCorrection:Title"]</h1><p>@L["EducationCorrection:Separate"]</p>
@if (Dirty) { <p class="alert alert-info" role="status">@L["EducationCorrection:FinishEditing"]</p> }
@if (Error != null) { <p class="alert alert-danger" role="alert">@Error</p> }
@if (Receipt != null) { <p class="alert alert-success" role="status">@L["EducationGrading:Receipt", Receipt]</p> }
@if (StorageBroken) { <p class="alert alert-warning">@L["EducationCorrection:StorageBroken"]<button class="btn btn-outline-danger" disabled="@Busy" @onclick="AbandonAsync">@L["EducationReport:Abandon"]</button></p> }
@if (Pending != null) { <p class="alert alert-warning" role="status">@L["EducationGrading:Unknown"] <button class="btn btn-outline-primary" disabled="@Busy" @onclick="RecoverAsync">@L["EducationGrading:Recover"]</button><button class="btn btn-outline-primary" disabled="@Busy" @onclick="(() => RunAsync(SendAsync))">@L["EducationReport:RetryCommand"]</button><button class="btn btn-outline-secondary" disabled="@Busy" @onclick="AbandonAsync">@L["EducationReport:Abandon"]</button></p> }
<button class="btn btn-outline-secondary mb-3" disabled="@Locked" @onclick="RefreshAsync">@L["EducationGrading:Refresh"]</button>
<div class="row g-3"><aside class="col-lg-4"><div class="list-group">@foreach (var item in Items) { <button class="list-group-item list-group-item-action" disabled="@Locked" @onclick="(() => OpenAsync(item.Id))">@item.Current.StudentName · @item.Current.ClassName · @item.Current.SubjectName<br />@(item.Current.Content?.Title ?? L["EducationCorrection:Availability:Withdrawn"].Value)</button> }</div>
<button class="btn btn-sm btn-outline-secondary" disabled="@(Locked || Offset == 0)" @onclick="(() => PageAsync(-1))">@L["EducationPaper:Previous"]</button><button class="btn btn-sm btn-outline-secondary" disabled="@(Locked || Offset + 20 >= Total)" @onclick="(() => PageAsync(1))">@L["EducationPaper:Next"]</button>
<p class="small text-muted">@L["EducationCorrection:CreateFromGrade"]</p></aside><main class="col-lg-8">
@if (TaskId != Guid.Empty) {
    @if (Target is { } target) { <p>@target.StudentName · @target.ClassName · @target.SubjectName</p><details><summary>@L["EducationCorrection:Original"]</summary><p>@target.QuestionTitle (@target.ObtainedScore / @target.MaxScore)</p><p style="white-space:pre-wrap">@target.QuestionStem</p><a href="@($"/education/assessment-grading/{target.SourceTaskId}")">@L["EducationGrading:SubmittedAnswer"]</a></details> }
    <fieldset disabled="@(Locked || ReviewDirty)"><label class="form-label w-100">@L["EducationCorrection:TaskTitle"]<input class="form-control" maxlength="256" @bind="Title" @bind:after="Changed" /></label>
    <label class="form-label w-100">@L["EducationCorrection:Instructions"]<textarea class="form-control" maxlength="4000" rows="4" @bind="Instructions" @bind:after="Changed"></textarea></label>
    <div class="d-flex flex-wrap gap-2"><label class="form-label">@L["EducationCorrection:Start"]<input class="form-control" type="datetime-local" @bind="Starts" @bind:after="Changed" /></label><label class="form-label">@L["EducationCorrection:Due"]<input class="form-control" type="datetime-local" @bind="Due" @bind:after="Changed" /></label><label class="form-label">@L["EducationCorrection:Minutes"]<input class="form-control" type="number" min="1" max="1440" @bind="Minutes" @bind:after="Changed" /></label></div>
    <button class="btn btn-outline-primary" disabled="@(!StorageReady)" @onclick="SaveAsync">@L["EducationCorrection:SaveDraft"]</button>
    <button class="btn btn-outline-primary" disabled="@(Dirty || Root?.Current.Kind != EducationCorrectionRevisionKind.Draft)" @onclick="PreviewAsync">@L["EducationCorrection:PublishPreview"]</button>
    <label class="form-label w-100 mt-2">@L["EducationCorrection:PublicReason"]<textarea class="form-control" maxlength="2000" @bind="Reason" @bind:after="(() => ConfirmPublish = ConfirmWithdraw = false)"></textarea></label>
    @if (Preview is { } preview) { <section class="alert alert-info"><p>@preview.Target.StudentName · @preview.Target.ClassName · @preview.Target.SubjectName</p><p>@Title · @Due.ToString("g")</p><label><input type="checkbox" @bind="ConfirmPublish" /> @L["EducationCorrection:PublishConfirm"]</label><button class="btn btn-primary" disabled="@(!ConfirmPublish || Dirty)" @onclick="PublishAsync">@L["EducationCorrection:Publish"]</button></section> }
    @if (Root?.PublishedRevisionId != null) { <label><input type="checkbox" @bind="ConfirmWithdraw" /> @L["EducationCorrection:WithdrawConfirm"]</label><button class="btn btn-outline-danger" disabled="@(!ConfirmWithdraw || string.IsNullOrWhiteSpace(Reason))" @onclick="WithdrawAsync">@L["EducationCorrection:Withdraw"]</button> }
    </fieldset>
    @if (Progress is { } progress) { <section class="mt-4"><h2 class="h5">@L["EducationCorrection:Review"]</h2><label class="form-label">@L["EducationCorrection:PublishedVersion"]<select class="form-select" value="@progress.PublicationId" disabled="@Locked" @onchange="VersionAsync">@foreach (var version in progress.Publications) { <option value="@version.Id">r@version.RevisionNumber · @version.RecordedAtUtc.ToLocalTime().ToString("g")</option> }</select></label>
        <p>@progress.StudentName · @L[$"EducationCorrection:Availability:{progress.Delivery.Availability}"]</p><p style="white-space:pre-wrap">@progress.Delivery.Instructions</p>
        @foreach (var history in History) { <article class="card my-2"><div class="card-body"><h3 class="h6">@L["EducationCorrection:SubmissionVersion", history.Submission.SubmissionNumber] · @history.Submission.SubmittedAtUtc.ToLocalTime().ToString("g")</h3><p style="white-space:pre-wrap">@history.Submission.Content.OriginalThinking</p><p style="white-space:pre-wrap">@history.Submission.Content.CurrentSolution</p><p style="white-space:pre-wrap">@history.Submission.Content.CheckingStrategy</p>
            @foreach (var image in history.Submission.Content.Images) { <button class="btn btn-sm btn-outline-secondary" disabled="@Busy" @onclick="(() => ShowImageAsync(history.Submission.Id, image))">@L["EducationGrading:SubmittedImage"]</button> }
            @foreach (var review in history.Reviews) { <p>@L[$"EducationCorrection:Decision:{review.Decision}"] · @review.PublishedAtUtc.ToLocalTime().ToString("g")</p><p style="white-space:pre-wrap">@review.StudentFeedback</p> }</div></article> }
        <button class="btn btn-sm btn-outline-secondary" disabled="@(Locked || HistoryOffset == 0)" @onclick="(() => HistoryPageAsync(-1))">@L["EducationPaper:Previous"]</button><button class="btn btn-sm btn-outline-secondary" disabled="@(Locked || HistoryOffset + 20 >= HistoryTotal)" @onclick="(() => HistoryPageAsync(1))">@L["EducationPaper:Next"]</button>
        @if (progress.Delivery.CurrentSubmission is { } submitted) { <fieldset disabled="@(Locked || DraftDirty)"><p>@L["EducationCorrection:ReviewTarget", submitted.SubmissionNumber]</p>
            <label class="form-label">@L["EducationCorrection:ReviewDecision"]<select class="form-select" @bind="Decision" @bind:after="ReviewChanged">@foreach (var decision in Enum.GetValues<EducationCorrectionReviewDecision>()) { <option value="@decision">@L[$"EducationCorrection:Decision:{decision}"]</option> }</select></label>
            <label class="form-label w-100">@L["EducationCorrection:Feedback"]<textarea class="form-control" rows="3" maxlength="2000" @bind="Feedback" @bind:after="ReviewChanged"></textarea></label>
            <label><input type="checkbox" @bind="ConfirmReview" /> @L["EducationCorrection:ReviewConfirm"]</label><button class="btn btn-primary" disabled="@(!ConfirmReview || string.IsNullOrWhiteSpace(Feedback) || !StorageReady)" @onclick="ReviewAsync">@L["EducationCorrection:ReviewPublish"]</button></fieldset> }
    </section> }
    <EducationAssessmentImagePreview ImageData="@ImageData" Rotation="@Rotation" Alt="@L["EducationGrading:SubmittedImage"]" Closed="@(() => ImageData = null)" />
}
</main></div>
@code {
    [SupplyParameterFromQuery(Name = "gradeId")] public Guid? GradeId { get; set; }
    private bool Busy, DraftDirty, ReviewDirty, StorageReady, StorageAttempted, StorageBroken, ConfirmPublish, ConfirmWithdraw, ConfirmReview; private string? Error, ImageData; private Guid? Receipt;
    private Guid TaskId, QuestionGradeId; private EducationCorrectionTaskDto? Root; private EducationCorrectionTargetDto? Target; private EducationCorrectionProgressDto? Progress; private EducationCorrectionPublishPreviewDto? Preview;
    private string Title = "", Instructions = "", Reason = "", Feedback = ""; private int Minutes = 15, Offset, HistoryOffset, Rotation; private long Total, HistoryTotal;
    private DateTime Starts = DateTime.Now, Due = DateTime.Now.AddDays(1); private EducationCorrectionReviewDecision Decision;
    private List<EducationCorrectionTaskDto> Items = []; private List<EducationCorrectionHistoryDto> History = []; private Command? Pending;
    private bool Dirty => DraftDirty || ReviewDirty; private bool Locked => Busy || Pending != null || StorageBroken; private string Key => $"education-correction-teacher-v1:{Tenant.Id}:{Account.Id}";
    protected override Task OnInitializedAsync() => RunAsync(async () => { await ListAsync(); if (GradeId is Guid grade) { Target = await CorrectionsApi.GetCorrectionTargetAsync(grade); QuestionGradeId = grade; TaskId = Guid.NewGuid(); DraftDirty = true; } });
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (StorageAttempted || Busy) return; StorageAttempted = true;
        await RunAsync(async () => { try { var raw = await JS.InvokeAsync<string?>("sessionStorage.getItem", Key); if (raw != null) { Pending = JsonSerializer.Deserialize<Command>(raw); ValidatePending(); } StorageReady = true; } catch { StorageBroken = true; throw; } }); StateHasChanged(); }
    private void Changed() { DraftDirty = true; Preview = null; ConfirmPublish = ConfirmWithdraw = false; }
    private void ReviewChanged() { ReviewDirty = true; ConfirmReview = false; }
    private async Task ListAsync() { var page = await CorrectionsApi.GetCorrectionListAsync(new() { SkipCount = Offset, MaxResultCount = 20 }); Items = page.Items.ToList(); Total = page.TotalCount; }
    private async Task LoadAsync(Guid id) { Root = await CorrectionsApi.GetCorrectionAsync(id); TaskId = id; QuestionGradeId = Root.QuestionGradeId; Target = null; Preview = null; ImageData = null; Progress = null; History.Clear();
        var content = Root.Current.Content; Title = content?.Title ?? ""; Instructions = content?.Instructions ?? ""; Starts = content?.StartsAtUtc.ToLocalTime() ?? DateTime.Now; Due = content?.DueAtUtc.ToLocalTime() ?? DateTime.Now.AddDays(1); Minutes = content?.EstimatedMinutes ?? 15;
        Feedback = Reason = ""; DraftDirty = ReviewDirty = ConfirmPublish = ConfirmWithdraw = ConfirmReview = false; HistoryOffset = 0;
        if (Root.LastPublishedRevisionId != null) await ProgressAsync(null);
        try { Target = await CorrectionsApi.GetCorrectionTargetAsync(QuestionGradeId); } catch (Exception ex) { Error = GetUserFriendlyErrorMessage(ex); } }
    private async Task ProgressAsync(Guid? version) { ImageData = null; Feedback = ""; ReviewDirty = ConfirmReview = false; Progress = await CorrectionsApi.GetCorrectionProgressAsync(TaskId, version); await HistoryAsync(); }
    private async Task HistoryAsync() { if (Progress == null) return; var page = await CorrectionsApi.GetCorrectionSubmissionsAsync(Progress.Delivery.Id, new() { SkipCount = HistoryOffset, MaxResultCount = 20 }); History = page.Items.ToList(); HistoryTotal = page.TotalCount; }
    private Task OpenAsync(Guid id) => RunAsync(async () => { if (await DiscardAsync()) await LoadAsync(id); });
    private Task RefreshAsync() => RunAsync(async () => { if (!await DiscardAsync()) return; await ListAsync(); if (Root != null) await LoadAsync(Root.Id); });
    private Task PageAsync(int d) => RunAsync(async () => { if (!await DiscardAsync()) return; Offset += d * 20; await ListAsync(); });
    private Task VersionAsync(ChangeEventArgs e) => RunAsync(async () => { if (!Guid.TryParse(e.Value?.ToString(), out var id) || !await DiscardAsync()) return; HistoryOffset = 0; await ProgressAsync(id); });
    private Task HistoryPageAsync(int d) => RunAsync(async () => { HistoryOffset += d * 20; await HistoryAsync(); });
    private Task SaveAsync() => RunAsync(async () => { await StartAsync(new() { TaskId = TaskId, Kind = "draft", Draft = new() { OperationId = Guid.NewGuid(), QuestionGradeId = QuestionGradeId,
        ExpectedRevisionId = Root?.Current.Id, ConcurrencyStamp = Root?.ConcurrencyStamp, Content = new() { Title = Title, Instructions = Instructions, StartsAtUtc = Starts.ToUniversalTime(), DueAtUtc = Due.ToUniversalTime(), EstimatedMinutes = Minutes } } }); });
    private Task PreviewAsync() => RunAsync(async () => { Preview = null; ConfirmPublish = false; Preview = await CorrectionsApi.PreviewCorrectionPublishAsync(TaskId); });
    private Task PublishAsync() => RunAsync(async () => { if (Root == null || Preview == null || Dirty || !ConfirmPublish) return; await StartAsync(new() { TaskId = TaskId, Kind = "publish", Publish = new() { OperationId = Guid.NewGuid(), ExpectedRevisionId = Preview.DraftRevisionId, ConcurrencyStamp = Preview.ConcurrencyStamp, PreviewFingerprint = Preview.Fingerprint, ConfirmRecipientSourceAndSafeText = true, PublicReason = Reason } }); });
    private Task WithdrawAsync() => RunAsync(async () => { if (Root == null || !ConfirmWithdraw) return; await StartAsync(new() { TaskId = TaskId, Kind = "withdraw", Withdraw = new() { OperationId = Guid.NewGuid(), ExpectedRevisionId = Root.Current.Id, ConcurrencyStamp = Root.ConcurrencyStamp, PublicReason = Reason, ConfirmStudentVisibleWithdrawal = true } }); });
    private Task ReviewAsync() => RunAsync(async () => { if (Progress?.Delivery.CurrentSubmissionId is not Guid sub || !ConfirmReview) return; await StartAsync(new() { TaskId = TaskId, DeliveryId = Progress.Delivery.Id, Kind = "review", Review = new() { OperationId = Guid.NewGuid(), ExpectedSubmissionId = sub, ExpectedReviewId = Progress.ReviewHeadId, ConcurrencyStamp = Progress.ConcurrencyStamp, Decision = Decision, StudentFeedback = Feedback, ConfirmStudentVisibleFeedback = true } }); });
    private async Task StartAsync(Command c) { if (!StorageReady || Pending != null) return; c.AccountId = Account.Id; c.TenantId = Tenant.Id; c.Fingerprint = Fingerprint(c); Pending = c; ValidatePending(); await JS.InvokeVoidAsync("sessionStorage.setItem", Key, JsonSerializer.Serialize(c)); await SendAsync(); }
    private static string Fingerprint(Command c) => c.Kind switch { "draft" when c.Draft != null => EducationCorrectionFingerprint.Draft(c.TaskId, c.Draft), "publish" when c.Publish != null => EducationCorrectionFingerprint.Publish(c.TaskId, c.Publish), "withdraw" when c.Withdraw != null => EducationCorrectionFingerprint.Withdraw(c.TaskId, c.Withdraw), "review" when c.Review != null => EducationCorrectionFingerprint.Review(c.DeliveryId, c.Review), _ => throw new InvalidOperationException() };
    private static Guid Operation(Command c) => c.Draft?.OperationId ?? c.Publish?.OperationId ?? c.Withdraw?.OperationId ?? c.Review?.OperationId ?? Guid.Empty;
    private void ValidatePending() { var c = Pending ?? throw new InvalidOperationException(); if (c.AccountId == null || c.AccountId != Account.Id || c.TenantId != Tenant.Id || c.TaskId == Guid.Empty || Operation(c) == Guid.Empty || new object?[] { c.Draft, c.Publish, c.Withdraw, c.Review }.Count(x => x != null) != 1 || c.Fingerprint != Fingerprint(c) || c.Kind == "review" && c.DeliveryId == Guid.Empty) throw new InvalidOperationException(); }
    private async Task SendAsync() { if (Pending == null || StorageBroken) return; ValidatePending(); var c = Pending; await JS.InvokeVoidAsync("sessionStorage.setItem", Key, JsonSerializer.Serialize(c));
        if (c.Kind == "review") { var r = await CorrectionsApi.PublishCorrectionReviewAsync(c.DeliveryId, c.Review!); await AcceptAsync(c, r.Id, r.RequestFingerprint); }
        else { var r = c.Kind switch { "draft" => await CorrectionsApi.SaveCorrectionDraftAsync(c.TaskId, c.Draft!), "publish" => await CorrectionsApi.PublishCorrectionAsync(c.TaskId, c.Publish!), "withdraw" => await CorrectionsApi.WithdrawCorrectionAsync(c.TaskId, c.Withdraw!), _ => throw new InvalidOperationException() }; await AcceptAsync(c, r.Id, r.RequestFingerprint); } }
    private Task RecoverAsync() => RunAsync(async () => { if (Pending == null) return; ValidatePending(); var c = Pending; if (c.Kind == "review") { var r = await CorrectionsApi.GetCorrectionReviewOperationAsync(c.DeliveryId, Operation(c)); if (r != null) await AcceptAsync(c, r.Id, r.RequestFingerprint); }
        else { var r = await CorrectionsApi.GetCorrectionOperationAsync(c.TaskId, Operation(c)); if (r != null) await AcceptAsync(c, r.Id, r.RequestFingerprint); } });
    private async Task AcceptAsync(Command c, Guid id, string fp) { if (id != Operation(c) || fp != c.Fingerprint) throw new InvalidOperationException(L["EducationGrading:NoReceipt"]); await JS.InvokeVoidAsync("sessionStorage.removeItem", Key); Pending = null; Receipt = id; DraftDirty = ReviewDirty = false; await LoadAsync(c.TaskId); await ListAsync(); }
    private Task AbandonAsync() => RunAsync(async () => { if (!await JS.InvokeAsync<bool>("confirm", L["EducationReport:AbandonHint"].Value)) return; await JS.InvokeVoidAsync("sessionStorage.removeItem", Key); Pending = null; StorageReady = true; StorageBroken = false; DraftDirty = ReviewDirty = false; Root = null; TaskId = Guid.Empty; Progress = null; Preview = null; ImageData = null; await ListAsync(); });
    private Task ShowImageAsync(Guid sub, EducationCorrectionImageReference image) => RunAsync(async () => { ImageData = null; using var file = await CorrectionsApi.DownloadCorrectionImageAsync(sub, image.AttachmentId); using var bytes = new System.IO.MemoryStream(); await file.GetStream().CopyToAsync(bytes); Rotation = image.RotationDegrees; ImageData = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes.ToArray())}"; });
    private async Task<bool> DiscardAsync() => !Dirty || await JS.InvokeAsync<bool>("confirm", L["EducationGrading:Discard"].Value);
    private async Task LeaveAsync(Microsoft.AspNetCore.Components.Routing.LocationChangingContext context) { if (Busy || (Dirty || Pending != null) && !await JS.InvokeAsync<bool>("confirm", L["EducationGrading:Discard"].Value)) context.PreventNavigation(); }
    private async Task RunAsync(Func<Task> action) { if (Busy) return; Busy = true; Error = null; try { await action(); } catch (Exception ex) { Error = GetUserFriendlyErrorMessage(ex); } finally { Busy = false; } }
    private sealed class Command { public string Kind { get; set; } = ""; public Guid? AccountId { get; set; } public Guid? TenantId { get; set; } public Guid TaskId { get; set; } public Guid DeliveryId { get; set; } public string Fingerprint { get; set; } = ""; public SaveEducationCorrectionDraftDto? Draft { get; set; } public PublishEducationCorrectionDto? Publish { get; set; } public WithdrawEducationCorrectionDto? Withdraw { get; set; } public PublishEducationCorrectionReviewDto? Review { get; set; } }
}
