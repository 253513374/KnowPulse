@page "/education/notebook"
@attribute [Authorize(KnowPulsePermissions.KnowledgeBase.PersonalLibrary)]
@using KnowPulse.Blazor.Client.Pages.Knowledge

<PersonalLibrary NotebookMode="true" NotebookSourceKind="@SourceKind" NotebookRecipientId="RecipientId" NotebookComponentId="ComponentId" />

@code {
    [SupplyParameterFromQuery(Name = "sourceKind")] public string? SourceKind { get; set; }
    [SupplyParameterFromQuery(Name = "recipientId")] public Guid? RecipientId { get; set; }
    [SupplyParameterFromQuery(Name = "componentId")] public Guid? ComponentId { get; set; }
}
