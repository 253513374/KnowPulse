@page "/education/study-tasks/{TaskId:guid}/progress"
@attribute [Authorize(EducationPermissions.LearningManage)]
@inherits KnowPulseComponentBase
@using KnowPulse.Education
@using System.Text.Json
@inject IEducationStudyTaskAppService Study
@inject IPermissionChecker PermissionChecker
@inject IJSRuntime JS
@inject Volo.Abp.Users.ICurrentUser Account
@inject Volo.Abp.MultiTenancy.ICurrentTenant Tenant
<PageTitle>@L["EducationStudy:Progress"]</PageTitle>
<NavigationLock ConfirmExternalNavigation="@(Busy || Dirty || Pending != null)" OnBeforeInternalNavigation="LeaveAsync" />
<h1 class="h4">@L["EducationStudy:Progress"]</h1><p>@L["EducationActivity:ActivityOnly"]</p><a href="/education/study-tasks">@L["EducationStudy:Title"]</a>
@if (Error != null) { <p class="alert alert-danger" role="alert">@Error</p> }
@if (Receipt != null) { <p class="alert alert-success" role="status">@L["EducationGrading:Receipt", Receipt]</p> }
@if (StorageAttempted && !StorageReady && Pending == null) { <p class="alert alert-warning" role="alert">@L["EducationGrading:NoReceipt"] <button class="btn btn-sm btn-outline-secondary" disabled="@Busy" @onclick="AbandonAsync">@L["EducationReport:Abandon"]</button></p> }
@if (Pending != null) { <div class="alert alert-info" role="status">@L["EducationGrading:Unknown"]
    <button class="btn btn-sm btn-outline-primary" disabled="@Busy" @onclick="RecoverAsync">@L["EducationGrading:Recover"]</button>
    <button class="btn btn-sm btn-outline-primary" disabled="@Busy" @onclick="(() => RunAsync(SendAsync))">@L["EducationReport:RetryCommand"]</button>
    <button class="btn btn-sm btn-outline-secondary" disabled="@Busy" @onclick="AbandonAsync">@L["EducationReport:Abandon"]</button></div> }
<p class="small text-muted">@L["EducationStudy:LocalReceiptHint"]</p>
@if (Progress is { } progress) {
    <fieldset disabled="@Locked"><label class="d-block my-3">@L["EducationStudy:Publication"]<select class="form-select" @bind="PublicationId" @bind:after="PublicationChangedAsync">@foreach (var version in progress.Publications) { <option value="@version.Id">@L["EducationPlan:Version", version.RevisionNumber] · @version.RecordedAtUtc.ToLocalTime().ToString("g")</option> }</select></label>
        <button class="btn btn-outline-secondary" @onclick="RefreshAsync">@L["EducationReport:Reload"]</button></fieldset>
    <p class="my-3">@L["EducationStudy:ProgressCounts", progress.AssignedCount, progress.VisibleCount] · @L[progress.IsCurrent ? "EducationStudy:CurrentPublication" : "EducationStudy:OldPublication"]</p>
    <div class="table-responsive"><table class="table"><thead><tr><th>@L["EducationStudy:Student"]</th><th>@L["EducationStudy:State"]</th><th>@L["EducationStudy:SharedText"]</th><th>@L["EducationStudy:FollowUp"]</th></tr></thead><tbody>
    @foreach (var row in progress.Students) { <tr><td>@row.StudentName</td><td>@L[$"EducationActivity:State:{row.State}"]<br /><small>@L[$"EducationStudy:Availability:{row.Availability}"]</small></td>
        <td class="text-break" style="white-space:pre-wrap">@row.CurrentStudent?.SharedText<br /><small>@row.CurrentStudent?.RecordedAtUtc.ToLocalTime().ToString("g")</small></td>
        <td><button class="btn btn-sm btn-outline-primary" disabled="@Locked" @onclick="(() => SelectAsync(row))">@L["EducationStudy:FollowUp"]</button>
            @if (CanHintReview && row.FirstProvidedAtUtc != null) { <a class="btn btn-sm btn-outline-secondary mt-1" href="@($"/education/study-tasks/recipients/{row.Id}/hints")">@L["EducationStudyHint:Title"]</a> }</td></tr> }
    </tbody></table></div>
    <button class="btn btn-sm btn-outline-secondary" disabled="@(Locked || Offset == 0)" @onclick="(() => PageAsync(-1))">@L["EducationPaper:Previous"]</button><button class="btn btn-sm btn-outline-secondary ms-2" disabled="@(Locked || Offset + 20 >= progress.VisibleCount)" @onclick="(() => PageAsync(1))">@L["EducationPaper:Next"]</button>
}
@if (Selected is { } selected) {
    <section class="card card-body my-3"><h2 class="h6">@selected.StudentName · @L["EducationStudy:FollowUp"]</h2>
        <p>@selected.CurrentStudent?.SharedText</p>
        @if (selected.CurrentFollowUp is { } follow) { <p class="text-break" style="white-space:pre-wrap">@follow.RecordedAtUtc.ToLocalTime().ToString("g") · @follow.InternalTeacherNote</p> }
        <fieldset disabled="@(Locked || !StorageReady || selected.CurrentStudent?.Action != EducationTeachingActivityAction.Difficulty)" @oninput="Changed" @onchange="Changed">
            <label class="d-block mb-2">@L["EducationStudy:PrivateNote"]<textarea class="form-control" maxlength="2000" rows="4" @bind="Note"></textarea></label>
            <label class="d-block mb-2"><input type="checkbox" @bind="ConfirmPrivate" /> @L["EducationStudy:ConfirmPrivate"]</label>
            <button class="btn btn-primary" disabled="@(!ConfirmPrivate || string.IsNullOrWhiteSpace(Note))" @onclick="SaveAsync">@L["EducationStudy:SaveFollowUp"]</button>
        </fieldset>
    </section>
}
@code {
    [Parameter] public Guid TaskId { get; set; }
    private bool Busy, Dirty, StorageReady, StorageAttempted, ConfirmPrivate, CanHintReview; private string? Error, LoadedKey; private Guid? Receipt, PublicationId;
    private int Offset; private string Note = ""; private EducationStudyProgressDto? Progress; private EducationTeacherStudyRecipientDto? Selected; private Command? Pending;
    private bool Locked => Busy || Pending != null; private string StorageKey => $"education-study-follow-up-v1:{Tenant.Id}:{Account.Id}:{TaskId}";
    protected override Task OnParametersSetAsync() => RunAsync(async () => { if (LoadedKey == TaskId.ToString()) return; LoadedKey = TaskId.ToString(); Pending = null; StorageReady = StorageAttempted = false; PublicationId = null; Offset = 0;
        CanHintReview = await PermissionChecker.IsGrantedAsync(EducationPermissions.AssessmentManage) && await PermissionChecker.IsGrantedAsync(KnowPulsePermissions.KnowledgeBase.PersonalLibrary); await LoadAsync(); });
    protected override async Task OnAfterRenderAsync(bool firstRender) { if (StorageAttempted || Busy) return; StorageAttempted = true;
        await RunAsync(async () => { var raw = await JS.InvokeAsync<string?>("sessionStorage.getItem", StorageKey); if (raw != null) { Pending = JsonSerializer.Deserialize<Command>(raw); ValidatePending(); } StorageReady = true; }); StateHasChanged(); }
    private void Changed() => Dirty = true;
    private async Task LoadAsync() { Selected = null; Progress = null; Dirty = ConfirmPrivate = false; Note = ""; Progress = await Study.GetProgressAsync(TaskId, PublicationId, new() { SkipCount = Offset, MaxResultCount = 20 }); PublicationId = Progress.PublicationId; }
    private async Task<bool> DiscardAsync() => !Dirty || await JS.InvokeAsync<bool>("confirm", L["EducationGrading:Discard"].Value);
    private Task RefreshAsync() => RunAsync(async () => { if (await DiscardAsync()) await LoadAsync(); });
    private Task PublicationChangedAsync() => RunAsync(async () => { if (!await DiscardAsync()) { PublicationId = Progress?.PublicationId; return; } Offset = 0; await LoadAsync(); });
    private Task PageAsync(int direction) => RunAsync(async () => { if (!await DiscardAsync()) return; Offset += direction * 20; await LoadAsync(); });
    private Task SelectAsync(EducationTeacherStudyRecipientDto row) => RunAsync(async () => { if (!await DiscardAsync()) return; Selected = row; Note = ""; ConfirmPrivate = Dirty = false; });
    private Task SaveAsync() => RunAsync(async () => { if (Selected?.CurrentStudentRevisionId is not Guid studentHead || Pending != null || !StorageReady) return;
        var command = new Command { TaskId = TaskId, RecipientId = Selected.Id, AccountId = Account.Id, TenantId = Tenant.Id, Input = new() { OperationId = Guid.NewGuid(), ExpectedRevisionId = Selected.CurrentRevisionId,
            ExpectedStudentRevisionId = studentHead, ConcurrencyStamp = Selected.ConcurrencyStamp, InternalTeacherNote = Note, ConfirmPrivateHandling = ConfirmPrivate } };
        await JS.InvokeVoidAsync("sessionStorage.setItem", StorageKey, JsonSerializer.Serialize(command)); Pending = command; await SendAsync(); });
    private void ValidatePending() { if (Pending is not { } p || p.TaskId != TaskId || p.RecipientId == Guid.Empty || p.AccountId != Account.Id || p.TenantId != Tenant.Id || p.Input == null || p.Input.OperationId == Guid.Empty) throw new InvalidOperationException(L["EducationGrading:NoReceipt"]); }
    private async Task SendAsync() { ValidatePending(); await FinishAsync(await Study.SaveFollowUpAsync(Pending!.RecipientId, Pending.Input)); }
    private Task RecoverAsync() => RunAsync(async () => { ValidatePending(); await FinishAsync(await Study.GetFollowUpOperationAsync(Pending!.RecipientId, Pending.Input.OperationId) ?? throw new InvalidOperationException(L["EducationGrading:NoReceipt"])); });
    private async Task FinishAsync(EducationTeacherStudyEventDto result) { ValidatePending(); var p = Pending!;
        if (result.Id != p.Input.OperationId || result.RecipientId != p.RecipientId || result.RequestFingerprint != EducationStudyTaskFingerprint.FollowUp(p.RecipientId, p.Input)) throw new InvalidOperationException(L["EducationGrading:NoReceipt"]);
        await JS.InvokeVoidAsync("sessionStorage.removeItem", StorageKey); Pending = null; Receipt = result.Id; await LoadAsync(); }
    private Task AbandonAsync() => RunAsync(async () => { if (!await JS.InvokeAsync<bool>("confirm", L["EducationReport:AbandonHint"].Value)) return; await JS.InvokeVoidAsync("sessionStorage.removeItem", StorageKey); Pending = null; StorageReady = true; await LoadAsync(); });
    private async Task LeaveAsync(Microsoft.AspNetCore.Components.Routing.LocationChangingContext context) { if (Busy || (Dirty || Pending != null) && !await JS.InvokeAsync<bool>("confirm", L["EducationGrading:Discard"].Value)) context.PreventNavigation(); }
    private async Task RunAsync(Func<Task> action) { if (Busy) return; Busy = true; Error = null; try { await action(); } catch (Exception ex) { Selected = null; Error = GetUserFriendlyErrorMessage(ex); } finally { Busy = false; } }
    private sealed class Command { public Guid TaskId { get; set; } public Guid RecipientId { get; set; } public Guid? AccountId { get; set; } public Guid? TenantId { get; set; } public SaveEducationStudyFollowUpDto Input { get; set; } = new(); }
}
