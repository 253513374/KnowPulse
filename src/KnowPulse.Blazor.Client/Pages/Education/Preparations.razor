    private Task ConfirmBindingAsync() => RunAsync(async () =>
    {
        var body = JsonSerializer.Serialize(new { BindingVersionId, BindingChunkId, BindingMappingId, ConfirmWhole });
        if (body != BindingOperationBody) { BindingOperation = Guid.NewGuid(); BindingOperationBody = body; }
        await PreparationService.ConfirmBindingAsync(new ConfirmKnowledgeMaterialCurriculumBindingDto { IdempotencyKey = BindingOperation,
            KnowledgeVersionId = GuidValue(BindingVersionId) ?? Guid.Empty, KnowledgeChunkId = GuidValue(BindingChunkId),
            TextbookKnowledgePointMappingId = GuidValue(BindingMappingId) ?? Guid.Empty, ConfirmWholeMaterialForThisMapping = ConfirmWhole });
        BindingDirty = false; await LoadBindingsAsync(); Success = L["EducationPreparation:BindingSaved"].Value;
    });
    private async Task EndBindingAsync(KnowledgeMaterialCurriculumBindingDto binding)
    {
        if (!await JS.InvokeAsync<bool>("confirm", L["EducationPreparation:EndConfirmation"].Value)) return;
        await RunAsync(async () => { await PreparationService.EndBindingAsync(binding.Id, new EndMaterialBindingDto { ConcurrencyStamp = binding.ConcurrencyStamp }); await LoadBindingsAsync(); Success = L["EducationPreparation:BindingEnded"].Value; });
    }
