    private async Task LoadRevisionsAsync()
    { if (Current == null) return; var page = await PreparationService.GetRevisionsAsync(Current.Id, new PagedResultRequestDto { SkipCount = RevisionSkip, MaxResultCount = PageSize }); Revisions = page.Items.ToList(); RevisionCount = page.TotalCount; }
    private Task ViewRevisionAsync(Guid id) => RunAsync(async () => { ViewingRevision = await PreparationService.GetRevisionAsync(Current!.Id, id); ReflectionTitle = ViewingRevision.Title; ReflectionOperationBody = null; });
