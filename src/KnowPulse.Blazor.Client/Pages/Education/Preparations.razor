@page "/education/preparations"
@page "/education/material-bindings"
@attribute [Authorize(KnowPulsePermissions.KnowledgeBase.PersonalLibrary)]
@inherits KnowPulseComponentBase
@using KnowPulse.Education
@using System.Text.Json
@inject IEducationPreparationAppService PreparationService
@inject IEducationCurriculumAppService CurriculumService
@inject IEducationSchoolAppService SchoolService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IPermissionChecker PermissionChecker

<PageTitle>@L["EducationPreparation:Title"]</PageTitle>
<NavigationLock OnBeforeInternalNavigation="BeforeNavigationAsync" ConfirmExternalNavigation="@HasChanges" />
<div class="d-flex justify-content-between flex-wrap gap-3 mb-3">
    <div><h1>@L["EducationPreparation:Title"]</h1><p class="text-muted">@L["EducationPreparation:Description"]</p></div>
    <a class="btn btn-outline-secondary align-self-start" href="/education/curriculum">@L["EducationPreparation:ChooseTextbook"]</a>
</div>
@if (Error != null) { <div class="alert alert-danger" role="alert">@Error<div class="small">@L["EducationPreparation:FailureHint"]</div></div> }
@if (Success != null) { <div class="alert alert-success" role="status">@Success</div> }
<nav class="nav nav-pills gap-2 mb-3" aria-label="@L["EducationPreparation:Sections"]">
    @foreach (var tab in new[] { "Preparations", "Bindings", "History" })
    { <button type="button" class="nav-link @(Tab == tab ? "active" : "")" disabled="@Busy" @onclick="() => Tab = tab" aria-current="@(Tab == tab ? "page" : null)">@L[$"EducationPreparation:{tab}"]</button> }
</nav>
@if (Tab == "Preparations")
{
    <div class="row g-3">
        <aside class="col-lg-4"><div class="card"><div class="card-body">
            <h2 class="h5">@L["EducationPreparation:MyPreparations"]</h2>
            <form @onsubmit="SearchPreparationsAsync" @onsubmit:preventDefault="true"><fieldset disabled="@Busy" class="mb-2">
                <label for="prep-keyword" class="form-label">@L["EducationPreparation:Search"]</label><input id="prep-keyword" class="form-control mb-2" @bind="Keyword" maxlength="128" />
                <label for="prep-search-book" class="form-label">@L["EducationPreparation:SearchBook"]</label><select id="prep-search-book" class="form-select mb-2" @bind="SearchBookId" @bind:after="SearchBookChangedAsync"><option value="">@L["EducationPreparation:All"]</option>@foreach (var b in CatalogBooks) { <option value="@b.Id">@BookLabel(b)</option> }</select>
                <label for="prep-search-chapter" class="form-label">@L["EducationPreparation:SearchChapter"]</label><select id="prep-search-chapter" class="form-select mb-2" @bind="SearchChapterId"><option value="">@L["EducationPreparation:All"]</option>@foreach (var ch in SearchBook?.Chapters ?? []) { <option value="@ch.Id">@ch.Code · @ch.Title</option> }</select>
                <button type="submit" class="btn btn-outline-primary">@L["EducationPreparation:Search"]</button>
                <button type="button" class="btn btn-primary ms-1" @onclick="NewPreparationAsync">@L["EducationPreparation:New"]</button>
                @if (SourceVersionFilter.HasValue) { <div class="small mt-2">@L["EducationPreparation:SourceFilter", SourceFilterTitle] <button type="button" class="btn btn-link btn-sm" @onclick="ClearSourceFilterAsync">@L["EducationPreparation:ClearFilter"]</button></div> }
            </fieldset></form>
            @if (PreparationItems.Count == 0) { <p class="text-muted">@L["EducationPreparation:NoPreparations"]</p> }
            <div class="list-group mb-2">@foreach (var preparation in PreparationItems)
            { <button type="button" class="list-group-item list-group-item-action @(Current?.Id == preparation.Id ? "active" : "")" disabled="@Busy" @onclick="() => OpenPreparationAsync(preparation.Id)"><strong>@preparation.Title</strong><br /><small>@preparation.TextbookTitle · v@(preparation.CurrentRevisionNumber) · @preparation.UpdatedAtUtc.ToLocalTime().ToString("g")</small></button> }</div>
            <div class="d-flex gap-2 align-items-center"><button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(Busy || PreparationSkip == 0)" @onclick="() => PagePreparationsAsync(-1)">@L["EducationPreparation:Previous"]</button><span class="small">@L["EducationPreparation:Count", PreparationCount]</span><button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(Busy || PreparationSkip + PageSize >= PreparationCount)" @onclick="() => PagePreparationsAsync(1)">@L["EducationPreparation:Next"]</button></div>
        </div></div></aside>
        <main class="col-lg-8"><div class="card"><div class="card-body">
            <h2 class="h5">@L[CopyFrom != null ? "EducationPreparation:Copy" : Current == null ? "EducationPreparation:New" : "EducationPreparation:Edit"]</h2>
            @if (Current?.CurrentRevision.NeedsCurriculumConfirmation == true || CopyFrom != null) { <p class="alert alert-warning">@L["EducationPreparation:ReconfirmHint"]</p> }
            <form @onsubmit="SavePreparationAsync" @onsubmit:preventDefault="true" @oninput="MarkDirty"><fieldset disabled="@Busy">
                <div class="row g-2 mb-3">
                    <div class="col-md-6"><label for="prep-school" class="form-label">@L["EducationPreparation:School"]</label><select id="prep-school" class="form-select" @bind="PreparationSchoolId" @bind:after="PreparationSchoolChangedAsync"><option value="">@L["EducationPreparation:Choose"]</option>@foreach (var school in Schools.Where(x => x.Roles.Contains(SchoolMemberRole.Teacher))) { <option value="@school.Id">@school.Name</option> }</select></div>
                    <div class="col-md-6"><label for="prep-selection" class="form-label">@L["EducationPreparation:TeachingTextbook"]</label><select id="prep-selection" class="form-select" @bind="PreparationSelectionId" @bind:after="PreparationSelectionChangedAsync" required><option value="">@L["EducationPreparation:Choose"]</option>@foreach (var selection in Selections.Where(x => !x.EndedAtUtc.HasValue && x.TextbookStatus == TextbookVersionStatus.Published)) { <option value="@selection.Id">@SelectionLabel(selection)</option> }</select></div>
                </div>
                @if (PreparationBook != null)
                {
                    <p class="small text-muted">@BookLabel(PreparationBook)</p>
                    <fieldset class="border rounded p-2 mb-3"><legend class="float-none w-auto fs-6">@L["EducationPreparation:Mappings"]</legend>
                        @foreach (var mapping in PreparationBook.Mappings)
                        { <div class="form-check"><input id="@($"prep-map-{mapping.Id}")" type="checkbox" class="form-check-input" checked="@Form.Scope.TextbookKnowledgePointMappingIds.Contains(mapping.Id)" @onchange="e => ToggleMapping(mapping.Id, e)" /><label class="form-check-label" for="@($"prep-map-{mapping.Id}")">@MappingLabel(PreparationBook, mapping)</label></div> }
                    </fieldset>
                }
                @if (Selections.Count == 0) { <p class="small text-muted">@L["EducationPreparation:NoSelections"]</p> }
                <label for="prep-title" class="form-label">@L["EducationPreparation:LessonTitle"]</label><input id="prep-title" class="form-control mb-3" @bind="Form.Title" maxlength="256" required />
                <label for="prep-objectives" class="form-label">@L["EducationPreparation:Objectives"]</label><textarea id="prep-objectives" class="form-control mb-3" @bind="Form.Objectives" maxlength="8192" rows="4" required readonly="@(CopyFrom != null)"></textarea>
                <div class="d-flex flex-wrap gap-2 mb-2"><button type="button" class="btn btn-outline-primary" @onclick="LoadReferenceOptionsAsync" disabled="@(Form.Scope.TextbookKnowledgePointMappingIds.Count == 0)">@L["EducationPreparation:LoadReferences"]</button><div class="form-check align-self-center"><input id="prep-shared" type="checkbox" class="form-check-input" @bind="IncludeSchoolShared" /><label for="prep-shared" class="form-check-label">@L["EducationPreparation:IncludeSchoolShared"]</label></div></div>
                <p class="small text-muted">@L["EducationPreparation:ReferencesHint"]</p>
                @foreach (var kind in Enum.GetValues<LessonPreparationReferenceKind>())
                {
                    <fieldset class="border rounded p-2 mb-2"><legend class="float-none w-auto fs-6">@L[$"EducationPreparation:Kind:{kind}"]</legend>
                        @foreach (var option in Options[kind])
                        { <div class="form-check"><input id="@($"prep-ref-{option.Id}-{kind}")" type="checkbox" class="form-check-input" checked="@ReferenceIds(kind).Contains(option.Id)" @onchange="e => ToggleReference(kind, option.Id, e)" /><label for="@($"prep-ref-{option.Id}-{kind}")" class="form-check-label">@option.Title <small class="text-muted">@option.Detail</small></label></div> }
                        @if (Options[kind].Count == 0) { <p class="small text-muted mb-1">@L["EducationPreparation:NoReferences"]</p> }
                        <div class="d-flex gap-2 align-items-center"><button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(OptionSkips[kind] == 0)" @onclick="() => PageOptionsAsync(kind, -1)">@L["EducationPreparation:Previous"]</button><span class="small">@L["EducationPreparation:Count", OptionCounts[kind]]</span><button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(OptionSkips[kind] + PageSize >= OptionCounts[kind])" @onclick="() => PageOptionsAsync(kind, 1)">@L["EducationPreparation:Next"]</button></div>
                    </fieldset>
                }
                @if (SelectedLabels.Count > 0)
                { <ul class="small list-unstyled">@foreach (var selected in SelectedLabels.Where(x => ReferenceIds(x.Key.Kind).Contains(x.Key.Id))) { <li>@L[$"EducationPreparation:Kind:{selected.Key.Kind}"] · @selected.Value <button type="button" class="btn btn-link btn-sm" @onclick="() => RemoveReference(selected.Key.Kind, selected.Key.Id)">@L["EducationPreparation:Remove"]</button></li> }</ul> }
                <label for="prep-reflection" class="form-label">@L["EducationPreparation:Reflection"]</label><textarea id="prep-reflection" class="form-control mb-2" @bind="Form.Reflection" maxlength="8192" rows="4" readonly="@(CopyFrom != null)"></textarea>
                <p class="small text-muted">@L["EducationPreparation:PrivateReflectionHint"]</p>
                <button type="submit" class="btn btn-primary" disabled="@(Form.Scope.TeacherTextbookSelectionId == Guid.Empty || Form.Scope.TextbookKnowledgePointMappingIds.Count == 0 || (!Dirty && Current != null && CopyFrom == null))">@L[CopyFrom != null ? "EducationPreparation:SaveCopy" : "EducationPreparation:SaveRevision"]</button>
                @if (Current != null && !Current.CurrentRevision.NeedsCurriculumConfirmation && !Dirty && CopyFrom == null)
                { <a class="btn btn-outline-primary ms-2" href="@GenerationLink(Current.Id, Current.CurrentRevision.Id)">@L["EducationPreparation:GenerateQuestions"]</a> }
                @if (Dirty) { <span class="small text-muted ms-2">@L["EducationPreparation:Unsaved"]</span> }
            </fieldset></form>
        </div></div></main>
    </div>
}
@if (Tab == "Bindings")
{
    <div class="row g-3"><div class="col-lg-6"><div class="card"><div class="card-body">
        <h2 class="h5">@L["EducationPreparation:ConfirmBinding"]</h2><p class="small text-muted">@L["EducationPreparation:BindingHint"]</p>
        <form @onsubmit="ConfirmBindingAsync" @onsubmit:preventDefault="true" @oninput="MarkBindingDirty"><fieldset disabled="@Busy">
            <label for="binding-school" class="form-label">@L["EducationPreparation:School"]</label><select id="binding-school" class="form-select mb-2" @bind="BindingSchoolId" @bind:after="BindingSchoolChangedAsync"><option value="">@L["EducationPreparation:Choose"]</option>@foreach (var school in Schools) { <option value="@school.Id">@school.Name</option> }</select>
            <label for="binding-book" class="form-label">@L["EducationPreparation:Textbook"]</label><select id="binding-book" class="form-select mb-2" @bind="BindingBookId" @bind:after="BindingBookChangedAsync"><option value="">@L["EducationPreparation:Choose"]</option>@if (BindingBook != null && !BindingBooks.Any(x => x.Id == BindingBook.Id)) { <option value="@BindingBook.Id">@BookLabel(BindingBook)</option> }@foreach (var book in BindingBooks) { <option value="@book.Id">@BookLabel(book)</option> }</select>
            <div class="d-flex gap-2 mb-2"><button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(BindingBookSkip == 0)" @onclick="() => PageBindingBooksAsync(-1)">@L["EducationPreparation:Previous"]</button><button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(BindingBookSkip + PageSize >= BindingBookCount)" @onclick="() => PageBindingBooksAsync(1)">@L["EducationPreparation:Next"]</button></div>
            <label for="binding-mapping" class="form-label">@L["EducationPreparation:Mapping"]</label><select id="binding-mapping" class="form-select mb-3" @bind="BindingMappingId"><option value="">@L["EducationPreparation:Choose"]</option>@foreach (var mapping in BindingBook?.Mappings ?? []) { <option value="@mapping.Id">@MappingLabel(BindingBook!, mapping)</option> }</select>
            <label for="material-keyword" class="form-label">@L["EducationPreparation:MaterialSearch"]</label><input id="material-keyword" class="form-control mb-2" @bind="MaterialKeyword" maxlength="128" /><button type="button" class="btn btn-sm btn-outline-secondary mb-2" @onclick="SearchMaterialsAsync">@L["EducationPreparation:Search"]</button>
            <label for="binding-version" class="form-label">@L["EducationPreparation:MaterialVersion"]</label><select id="binding-version" class="form-select mb-2" @bind="BindingVersionId" @bind:after="BindingVersionChangedAsync"><option value="">@L["EducationPreparation:Choose"]</option>@if (SelectedMaterial != null && !Materials.Any(x => x.Id == SelectedMaterial.Id)) { <option value="@SelectedMaterial.Id">@SelectedMaterial.Title · v@(SelectedMaterial.VersionNumber)</option> }@foreach (var version in Materials) { <option value="@version.Id">@version.Title · v@(version.VersionNumber)</option> }</select>
            <div class="d-flex gap-2 mb-2"><button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(MaterialSkip == 0)" @onclick="() => PageMaterialsAsync(-1)">@L["EducationPreparation:Previous"]</button><span class="small">@L["EducationPreparation:Count", MaterialCount]</span><button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(MaterialSkip + PageSize >= MaterialCount)" @onclick="() => PageMaterialsAsync(1)">@L["EducationPreparation:Next"]</button></div>
            <label for="binding-chunk" class="form-label">@L["EducationPreparation:Chunk"]</label><select id="binding-chunk" class="form-select mb-2" @bind="BindingChunkId" @bind:after="BindingChunkChanged"><option value="">@L["EducationPreparation:WholeMaterial"]</option>@if (SelectedChunk != null && !Chunks.Any(x => x.Id == SelectedChunk.Id)) { <option value="@SelectedChunk.Id">@(SelectedChunk.Sequence + 1) · @SelectedChunk.SourceTitle · @SelectedChunk.SourcePage · @SelectedChunk.Preview</option> }@foreach (var chunk in Chunks) { <option value="@chunk.Id">@(chunk.Sequence + 1) · @chunk.SourceTitle · @chunk.SourcePage · @chunk.Preview</option> }</select>
            <div class="d-flex gap-2 mb-2"><button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(ChunkSkip == 0)" @onclick="() => PageChunksAsync(-1)">@L["EducationPreparation:Previous"]</button><span class="small">@L["EducationPreparation:Count", ChunkCount]</span><button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(ChunkSkip + PageSize >= ChunkCount)" @onclick="() => PageChunksAsync(1)">@L["EducationPreparation:Next"]</button></div>
            @if (string.IsNullOrEmpty(BindingChunkId)) { <div class="form-check mb-3"><input id="binding-whole-confirm" type="checkbox" class="form-check-input" @bind="ConfirmWhole" /><label for="binding-whole-confirm" class="form-check-label">@L["EducationPreparation:WholeConfirmation"]</label></div> }
            <p class="small text-muted">@L["EducationPreparation:PrecisePrecedenceHint"]</p>
            <button type="submit" class="btn btn-primary" disabled="@(string.IsNullOrEmpty(BindingVersionId) || string.IsNullOrEmpty(BindingMappingId) || (string.IsNullOrEmpty(BindingChunkId) && !ConfirmWhole))">@L["EducationPreparation:ConfirmBinding"]</button>
        </fieldset></form>
    </div></div></div><div class="col-lg-6"><div class="card"><div class="card-body">
        <h2 class="h5">@L["EducationPreparation:MyBindings"]</h2>
        <div class="form-check mb-2"><input id="binding-include-ended" type="checkbox" class="form-check-input" @bind="IncludeEnded" @bind:after="SearchBindingsAsync" disabled="@Busy" /><label for="binding-include-ended" class="form-check-label">@L["EducationPreparation:IncludeEnded"]</label></div>
        @foreach (var binding in Bindings)
        { <article class="border rounded p-2 mb-2"><strong>@binding.MaterialTitle</strong> · @L[binding.WholeMaterialAppliesToMapping ? "EducationPreparation:WholeMaterial" : "EducationPreparation:Chunk"]<div class="small">@binding.Curriculum.TextbookTitle · @binding.Curriculum.Edition · @binding.Curriculum.Volume · @binding.Curriculum.Mappings.FirstOrDefault()?.ChapterTitle · @binding.Curriculum.Mappings.FirstOrDefault()?.KnowledgePointName</div><div class="small text-muted">@L[binding.EndedAtUtc.HasValue ? "EducationPreparation:Ended" : binding.CanUseNow ? "EducationPreparation:Available" : "EducationPreparation:Unavailable"] · @binding.ConfirmedAtUtc.ToLocalTime().ToString("g")</div><button type="button" class="btn btn-link btn-sm" disabled="@Busy" @onclick="() => FindUsingSourceAsync(binding.KnowledgeVersionId, binding.MaterialTitle)">@L["EducationPreparation:FindUsingMaterial"]</button>@if (!binding.EndedAtUtc.HasValue) { <button type="button" class="btn btn-sm btn-outline-danger mt-1" disabled="@Busy" @onclick="() => EndBindingAsync(binding)">@L["EducationPreparation:End"]</button> }</article> }
        @if (Bindings.Count == 0) { <p class="text-muted">@L["EducationPreparation:NoBindings"]</p> }
        <div class="d-flex gap-2 align-items-center"><button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(Busy || BindingSkip == 0)" @onclick="() => PageBindingsAsync(-1)">@L["EducationPreparation:Previous"]</button><span class="small">@L["EducationPreparation:Count", BindingCount]</span><button type="button" class="btn btn-sm btn-outline-secondary" disabled="@(Busy || BindingSkip + PageSize >= BindingCount)" @onclick="() => PageBindingsAsync(1)">@L["EducationPreparation:Next"]</button></div>
    </div></div></div></div>
}
@if (Tab == "History")
{
    <h2 class="h5">@L["EducationPreparation:History"]</h2>
    @if (Current == null) { <p class="text-muted">@L["EducationPreparation:SelectPreparation"]</p> }
    else
    {
        <div class="row g-3"><aside class="col-lg-3"><div class="list-group">@foreach (var revision in Revisions) { <button type="button" class="list-group-item list-group-item-action @(ViewingRevision?.Id == revision.Id ? "active" : "")" disabled="@Busy" @onclick="() => ViewRevisionAsync(revision.Id)">v@(revision.RevisionNumber) · @revision.Title<br /><small>@revision.RecordedAtUtc.ToLocalTime().ToString("g")</small></button> }</div><div class="d-flex gap-2 mt-2"><button class="btn btn-sm btn-outline-secondary" disabled="@(Busy || RevisionSkip == 0)" @onclick="() => PageRevisionsAsync(-1)">@L["EducationPreparation:Previous"]</button><button class="btn btn-sm btn-outline-secondary" disabled="@(Busy || RevisionSkip + PageSize >= RevisionCount)" @onclick="() => PageRevisionsAsync(1)">@L["EducationPreparation:Next"]</button></div></aside>
        @if (ViewingRevision != null)
        { <article class="col-lg-9"><div class="card"><div class="card-body"><h3 class="h5">@ViewingRevision.Title · v@(ViewingRevision.RevisionNumber)</h3><p>@ViewingRevision.Curriculum.SubjectName · @ViewingRevision.Curriculum.TextbookTitle · @ViewingRevision.Curriculum.Publisher · @ViewingRevision.Curriculum.Edition · @ViewingRevision.Curriculum.Volume · @ViewingRevision.Curriculum.CatalogRevision</p><ul>@foreach (var mapping in ViewingRevision.Curriculum.Mappings) { <li>@mapping.ChapterCode · @mapping.ChapterTitle → @mapping.KnowledgePointCode · @mapping.KnowledgePointName · v@(mapping.RevisionNumber)</li> }</ul><h4 class="h6">@L["EducationPreparation:Objectives"]</h4><p class="preparation-text">@ViewingRevision.Objectives</p><h4 class="h6">@L["EducationPreparation:References"]</h4><ul>@foreach (var reference in ViewingRevision.References) { <li>@L[$"EducationPreparation:Kind:{reference.Kind}"] · @reference.Title · @L[reference.CanUseNow ? "EducationPreparation:Available" : "EducationPreparation:Unavailable"]</li> }</ul><h4 class="h6">@L["EducationPreparation:Reflection"]</h4><p class="preparation-text">@ViewingRevision.Reflection</p>@if (ViewingRevision.NeedsCurriculumConfirmation) { <p class="alert alert-warning">@L["EducationPreparation:ReconfirmHint"]</p> }
            <button type="button" class="btn btn-outline-primary" disabled="@Busy" @onclick="StartCopyAsync">@L["EducationPreparation:Copy"]</button>
            @if (!ViewingRevision.NeedsCurriculumConfirmation) { <a class="btn btn-outline-primary ms-1" href="@GenerationLink(Current.Id, ViewingRevision.Id)">@L["EducationPreparation:GenerateQuestions"]</a> }
            <form class="mt-3" @onsubmit="CopyReflectionAsync" @onsubmit:preventDefault="true"><fieldset disabled="@(Busy || string.IsNullOrWhiteSpace(ViewingRevision.Reflection))"><label for="reflection-private-title" class="form-label">@L["EducationPreparation:ReflectionDraftTitle"]</label><input id="reflection-private-title" class="form-control mb-2" @bind="ReflectionTitle" maxlength="256" required /><button type="submit" class="btn btn-outline-secondary">@L["EducationPreparation:CopyReflection"]</button><p class="small text-muted mt-1">@L["EducationPreparation:ReflectionDraftHint"]</p></fieldset></form>
        </div></div></article> }
        </div>
    }
}

@code {
    private const int PageSize = 20;
    private bool Busy, Dirty, BindingDirty, IncludeEnded, ConfirmWhole, IncludeSchoolShared, CanReferenceQuestions, CanReferencePapers;
    private string Tab = "Preparations", Keyword = "", MaterialKeyword = "", ReflectionTitle = "";
    private string PreparationSchoolId = "", PreparationSelectionId = "", BindingSchoolId = "", BindingBookId = "", BindingMappingId = "", BindingVersionId = "", BindingChunkId = "", SearchBookId = "", SearchChapterId = "";
    private string? Error, Success, PreparationOperationBody, BindingOperationBody, ReflectionOperationBody;
    private Guid? SourceVersionFilter;
    private string SourceFilterTitle = "";
    private Guid PreparationOperation = Guid.NewGuid(), BindingOperation = Guid.NewGuid(), ReflectionOperation = Guid.NewGuid();
    private int PreparationSkip, BindingSkip, MaterialSkip, ChunkSkip, BindingBookSkip, RevisionSkip;
    private long PreparationCount, BindingCount, MaterialCount, ChunkCount, BindingBookCount, RevisionCount;
    private List<MySchoolDto> Schools = [];
    private List<TextbookVersionDto> CatalogBooks = [], BindingBooks = [];
    private List<TeacherTextbookSelectionDto> Selections = [];
    private CurriculumContextDto? TeachingContext;
    private TextbookVersionDto? PreparationBook, BindingBook, SearchBook;
    private LessonPreparationContentDto Form = new();
    private LessonPreparationDto? Current;
    private LessonPreparationRevisionDto? ViewingRevision, CopyFrom;
    private List<LessonPreparationListDto> PreparationItems = [];
    private List<LessonPreparationRevisionDto> Revisions = [];
    private List<KnowledgeMaterialCurriculumBindingDto> Bindings = [];
    private List<EducationMaterialVersionOptionDto> Materials = [];
    private List<EducationMaterialChunkOptionDto> Chunks = [];
    private EducationMaterialVersionOptionDto? SelectedMaterial;
    private EducationMaterialChunkOptionDto? SelectedChunk;
    private readonly Dictionary<LessonPreparationReferenceKind, List<EducationPreparationReferenceOptionDto>> Options = Enum.GetValues<LessonPreparationReferenceKind>().ToDictionary(x => x, _ => new List<EducationPreparationReferenceOptionDto>());
    private readonly Dictionary<LessonPreparationReferenceKind, int> OptionSkips = Enum.GetValues<LessonPreparationReferenceKind>().ToDictionary(x => x, _ => 0);
    private readonly Dictionary<LessonPreparationReferenceKind, long> OptionCounts = Enum.GetValues<LessonPreparationReferenceKind>().ToDictionary(x => x, _ => 0L);
    private readonly Dictionary<(LessonPreparationReferenceKind Kind, Guid Id), string> SelectedLabels = [];
    private bool HasChanges => Dirty || BindingDirty;
    protected override async Task OnInitializedAsync()
    {
        Tab = Navigation.Uri.Contains("/material-bindings", StringComparison.OrdinalIgnoreCase) ? "Bindings" : "Preparations";
        await RunAsync(async () =>
        {
            CanReferenceQuestions = await PermissionChecker.IsGrantedAsync(KnowPulsePermissions.QuestionBank.Questions);
            CanReferencePapers = await PermissionChecker.IsGrantedAsync(KnowPulsePermissions.Exam.Manage);
            Schools = (await SchoolService.GetMySchoolsAsync()).Items.Where(x => x.Roles.Contains(SchoolMemberRole.Teacher) || x.Roles.Contains(SchoolMemberRole.Manager)).ToList();
            foreach (var school in Schools)
            {
                var books = await CurriculumService.GetTextbooksAsync(school.Id, new GetTextbookListInput { MaxResultCount = 100 });
                CatalogBooks.AddRange(books.Items);
            }
            await LoadPreparationsAsync(); await LoadBindingsAsync(); await LoadMaterialsAsync();
        });
    }
    private async Task RunAsync(Func<Task> action)
    {
        if (Busy) return;
        Busy = true; Error = null; Success = null;
        try { await action(); }
        catch (Exception ex) { Error = GetUserFriendlyErrorMessage(ex); }
        finally { Busy = false; }
    }
    private async Task<bool> DiscardAsync(bool dirty) => !dirty || await JS.InvokeAsync<bool>("confirm", L["EducationPreparation:DiscardChanges"].Value);
    private async Task BeforeNavigationAsync(LocationChangingContext context) { if (!await DiscardAsync(HasChanges)) context.PreventNavigation(); }
    private void MarkDirty() => Dirty = true;
    private void MarkBindingDirty() => BindingDirty = true;
    private static Guid? GuidValue(string value) => Guid.TryParse(value, out var id) ? id : null;
    private static string GenerationLink(Guid preparation, Guid revision) => $"/question-bank/ai-candidates?preparationId={preparation}&revisionId={revision}";
    private static string BookLabel(TextbookVersionDto book) => $"{book.Title} · {book.Grade} · {book.Publisher} · {book.Edition} · {book.Volume} · r{book.CatalogRevision}";
    private static string MappingLabel(TextbookVersionDto book, TextbookKnowledgePointMappingDto mapping) => $"{book.Chapters.FirstOrDefault(x => x.Id == mapping.ChapterId)?.Title} → {mapping.KnowledgePointCode} · {mapping.KnowledgePointName} · v{mapping.RevisionNumber}";
    private string SelectionLabel(TeacherTextbookSelectionDto selection)
    {
        var context = TeachingContext?.TeachingContexts.FirstOrDefault(x => x.Id == selection.TeachingAssignmentId);
        return $"{context?.TermName} · {context?.ClassName} · {context?.SubjectName} · {selection.TextbookTitle} · r{selection.CatalogRevision}";
    }
