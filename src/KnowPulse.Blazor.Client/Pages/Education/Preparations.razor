    {
        var body = JsonSerializer.Serialize(new { PreparationId = Current!.Id, RevisionId = ViewingRevision!.Id, ReflectionTitle });
        if (body != ReflectionOperationBody) { ReflectionOperation = Guid.NewGuid(); ReflectionOperationBody = body; }
