    private async Task NewPreparationAsync()
    {
        if (!await DiscardAsync(Dirty)) return;
        Current = null; CopyFrom = null; ViewingRevision = null; Form = new(); PreparationSchoolId = ""; PreparationSelectionId = "";
        PreparationBook = null; Selections = []; Revisions = []; Dirty = false; ClearOptions(); SelectedLabels.Clear(); PreparationOperationBody = null;
    }
    private async Task OpenPreparationAsync(Guid id)
    {
        if (!await DiscardAsync(Dirty)) return;
        await RunAsync(async () => { var preparation = await PreparationService.GetPreparationAsync(id); await SetPreparationAsync(preparation); });
    }
    private async Task SetPreparationAsync(LessonPreparationDto preparation)
    {
        Current = preparation; CopyFrom = null; ViewingRevision = preparation.CurrentRevision;
        var revision = preparation.CurrentRevision;
        Form = new LessonPreparationContentDto { Title = revision.Title, Objectives = revision.Objectives, Reflection = revision.Reflection,
            Scope = new EducationCurriculumScopeDto { TeacherTextbookSelectionId = revision.Curriculum.TeacherTextbookSelectionId, TextbookKnowledgePointMappingIds = revision.Curriculum.Mappings.Select(x => x.MappingId).ToList() },
            BindingIds = revision.References.Where(x => x.MaterialBindingId.HasValue).Select(x => x.MaterialBindingId!.Value).ToList(),
            QuestionIds = revision.References.Where(x => x.QuestionId.HasValue).Select(x => x.QuestionId!.Value).ToList(), ExamPaperIds = revision.References.Where(x => x.ExamPaperId.HasValue).Select(x => x.ExamPaperId!.Value).ToList() };
        SelectedLabels.Clear(); foreach (var reference in revision.References) SelectedLabels[(reference.Kind, reference.MaterialBindingId ?? reference.QuestionId ?? reference.ExamPaperId!.Value)] = reference.Title;
        PreparationSchoolId = revision.Curriculum.SchoolId.ToString(); PreparationSelectionId = revision.Curriculum.TeacherTextbookSelectionId.ToString();
        Selections = []; PreparationBook = null; TeachingContext = null; ClearOptions();
        if (Schools.Any(x => x.Id == revision.Curriculum.SchoolId && x.Roles.Contains(SchoolMemberRole.Teacher)))
        {
            TeachingContext = await CurriculumService.GetContextAsync(revision.Curriculum.SchoolId);
            Selections = (await CurriculumService.GetMySelectionsAsync(revision.Curriculum.SchoolId)).Items.ToList();
            if (!revision.NeedsCurriculumConfirmation) PreparationBook = await CurriculumService.GetTextbookAsync(revision.Curriculum.TextbookVersionId);
        }
        Dirty = false; PreparationOperationBody = null; RevisionSkip = 0; await LoadRevisionsAsync();
    }
    private Task PreparationSchoolChangedAsync() => RunAsync(async () =>
    {
        PreparationSelectionId = ""; PreparationBook = null; Selections = []; TeachingContext = null; ResetCourse();
        if (GuidValue(PreparationSchoolId) is { } id)
        { TeachingContext = await CurriculumService.GetContextAsync(id); Selections = (await CurriculumService.GetMySelectionsAsync(id)).Items.ToList(); }
    });
    private Task PreparationSelectionChangedAsync() => RunAsync(async () =>
    {
        PreparationBook = null; ResetCourse();
        if (GuidValue(PreparationSelectionId) is { } id && Selections.FirstOrDefault(x => x.Id == id && !x.EndedAtUtc.HasValue) is { } selection)
        { Form.Scope.TeacherTextbookSelectionId = id; PreparationBook = await CurriculumService.GetTextbookAsync(selection.TextbookVersionId); }
    });
    private void ResetCourse() { Form.Scope = new(); Form.BindingIds.Clear(); Form.QuestionIds.Clear(); Form.ExamPaperIds.Clear(); SelectedLabels.Clear(); ClearOptions(); Dirty = true; }
    private void ToggleMapping(Guid id, ChangeEventArgs args)
    {
        if (args.Value is true) { if (!Form.Scope.TextbookKnowledgePointMappingIds.Contains(id)) Form.Scope.TextbookKnowledgePointMappingIds.Add(id); }
        else Form.Scope.TextbookKnowledgePointMappingIds.Remove(id);
        Form.BindingIds.Clear(); Form.QuestionIds.Clear(); Form.ExamPaperIds.Clear(); SelectedLabels.Clear(); ClearOptions(); Dirty = true;
    }
    private List<Guid> ReferenceIds(LessonPreparationReferenceKind kind) => kind switch { LessonPreparationReferenceKind.Material => Form.BindingIds, LessonPreparationReferenceKind.Question => Form.QuestionIds, _ => Form.ExamPaperIds };
    private void ToggleReference(LessonPreparationReferenceKind kind, Guid id, ChangeEventArgs args)
    {
        var ids = ReferenceIds(kind);
        if (args.Value is true) { if (!ids.Contains(id)) ids.Add(id); SelectedLabels[(kind, id)] = Options[kind].First(x => x.Id == id).Title; }
        else ids.Remove(id);
        Dirty = true;
    }
    private void RemoveReference(LessonPreparationReferenceKind kind, Guid id) { ReferenceIds(kind).Remove(id); Dirty = true; }
    private void ClearOptions() { foreach (var kind in Options.Keys) { Options[kind] = []; OptionSkips[kind] = 0; OptionCounts[kind] = 0; } }
    private bool CanReference(LessonPreparationReferenceKind kind) => kind == LessonPreparationReferenceKind.Material || (kind == LessonPreparationReferenceKind.Question ? CanReferenceQuestions : CanReferencePapers);
    private Task LoadReferenceOptionsAsync() => RunAsync(async () => { foreach (var kind in Options.Keys.Where(CanReference)) { OptionSkips[kind] = 0; await LoadOptionsAsync(kind); } });
    private Task PageOptionsAsync(LessonPreparationReferenceKind kind, int direction) => RunAsync(async () => { OptionSkips[kind] = Math.Max(0, OptionSkips[kind] + direction * PageSize); await LoadOptionsAsync(kind); });
    private async Task LoadOptionsAsync(LessonPreparationReferenceKind kind)
    {
        var page = await PreparationService.GetReferenceOptionsAsync(new GetPreparationReferenceOptionsInput { Scope = Form.Scope, Kind = kind,
            IncludeSchoolShared = IncludeSchoolShared, SkipCount = OptionSkips[kind], MaxResultCount = PageSize });
        Options[kind] = page.Items.ToList(); OptionCounts[kind] = page.TotalCount;
    }
    private Task SavePreparationAsync() => RunAsync(async () =>
    {
        var body = JsonSerializer.Serialize(new { Form, CurrentId = Current?.Id, SourceId = CopyFrom?.Id });
        if (body != PreparationOperationBody) { PreparationOperation = Guid.NewGuid(); PreparationOperationBody = body; }
        LessonPreparationDto result;
        if (CopyFrom != null) result = await PreparationService.CopyPreparationAsync(CopyFrom.Id, new CopyLessonPreparationDto
        { IdempotencyKey = PreparationOperation, Title = Form.Title, Scope = Form.Scope, BindingIds = Form.BindingIds, QuestionIds = Form.QuestionIds, ExamPaperIds = Form.ExamPaperIds });
        else if (Current == null) result = await PreparationService.CreatePreparationAsync(new CreateLessonPreparationDto
        { IdempotencyKey = PreparationOperation, Title = Form.Title, Scope = Form.Scope, Objectives = Form.Objectives, Reflection = Form.Reflection, BindingIds = Form.BindingIds, QuestionIds = Form.QuestionIds, ExamPaperIds = Form.ExamPaperIds });
        else result = await PreparationService.SavePreparationAsync(Current.Id, new SaveLessonPreparationDto
        { IdempotencyKey = PreparationOperation, ConcurrencyStamp = Current.ConcurrencyStamp, Title = Form.Title, Scope = Form.Scope, Objectives = Form.Objectives, Reflection = Form.Reflection, BindingIds = Form.BindingIds, QuestionIds = Form.QuestionIds, ExamPaperIds = Form.ExamPaperIds });
        Current = result; CopyFrom = null; ViewingRevision = result.CurrentRevision; Dirty = false;
        try { await SetPreparationAsync(result); await LoadPreparationsAsync(); }
        catch (Exception ex) { Error = GetUserFriendlyErrorMessage(ex); }
        Success = L["EducationPreparation:Saved"].Value;
    });
