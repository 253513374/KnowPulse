@page "/question-bank/reviews/{Id:guid}"
@attribute [Authorize(KnowPulsePermissions.QuestionBank.Reviews)]
@inherits KnowPulseComponentBase
@inject IQuestionAppService QuestionAppService
@inject NavigationManager Navigation

<PageTitle>题目复核 · 平台管理</PageTitle>

<div class="admin-page qb-review-page">
<header class="admin-page-header">
    <div>
        <h1>题目复核</h1>
        <p class="kp-text-muted">核对内容、答案与来源依据，保留明确的审核结论。</p>
    </div>
    <a class="kp-button kp-button--secondary kp-button--sm" href="/question-bank/reviews">返回审核队列</a>
</header>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="kp-alert kp-alert--error" role="alert">
        @ErrorMessage
        <button class="kp-button kp-button--secondary kp-button--sm" type="button" @onclick="LoadAsync" disabled="@(IsLoading || IsBusy)">重新加载</button>
    </div>
}

@if (IsLoading)
{
    <div class="kp-card"><div class="kp-card__body kp-text-center kp-text-muted kp-py-5">加载中</div></div>
}
else if (Question == null)
{
    <div class="kp-card"><div class="kp-card__body kp-text-center kp-text-muted kp-py-5">题目不存在或无法访问</div></div>
}
else
{
    <div class="kp-grid kp-grid-gap-3">
        <div class="kp-col-xl-8">
            <div class="kp-card kp-mb-3 qb-review-checklist">
                <div class="kp-card__body">
                    <div class="kp-flex kp-flex-wrap kp-align-center kp-justify-between kp-gap-2 kp-mb-3">
                        <h2 class="kp-heading-6 kp-mb-0">审核清单</h2>
                        <span class="kp-text-small kp-text-muted">三项都确认后再通过</span>
                    </div>
                    <div class="qb-review-checks">
                        <div class="@(HasCompleteDefinition ? "is-ready" : null)"><i class="fa-solid @(HasCompleteDefinition ? "fa-check" : "fa-exclamation")"></i><span><strong>题目完整</strong><small>题干、选项和答案一致</small></span></div>
                        <div class="@(HasAnalysis ? "is-ready" : null)"><i class="fa-solid @(HasAnalysis ? "fa-check" : "fa-exclamation")"></i><span><strong>解析清楚</strong><small>能解释答案为什么正确</small></span></div>
                        <div class="@(HasEvidence ? "is-ready" : null)"><i class="fa-solid @(HasEvidence ? "fa-check" : "fa-exclamation")"></i><span><strong>依据可追溯</strong><small>能回看制度或知识来源</small></span></div>
                    </div>
                </div>
            </div>

            <div class="kp-card kp-mb-3">
                <div class="kp-card__body">
                    <div class="kp-flex kp-flex-wrap kp-justify-between kp-gap-2">
                        <div>
                            <h2 class="kp-heading-5 kp-mb-1">@Question.Title</h2>
                            <div class="kp-text-muted kp-text-small">@GetTypeText(Question.Type) / @GetDifficultyText(Question.Difficulty) / @GetSourceText(Question.CreationSource)</div>
                        </div>
                        <span class="kp-badge kp-bg-info kp-align-self-start">@(Question.Status == QuestionStatus.PendingReview ? "待审核" : "已处理")</span>
                    </div>

                    <div class="kp-mt-4">
                        <div class="kp-text-muted kp-text-small kp-mb-1">题干</div>
                        <div>@Question.Stem</div>
                    </div>

                    @if (Question.Options.Count > 0)
                    {
                        <div class="kp-list kp-list--flush kp-mt-3 qb-question-options">
                            @foreach (var option in Question.Options.OrderBy(x => x.DisplayOrder))
                            {
                                <div class="kp-list__item kp-px-0"><span class="kp-text-semibold">@option.OptionKey.</span> @option.Content</div>
                            }
                        </div>
                    }

                    <div class="kp-grid kp-grid-gap-3 kp-mt-1">
                        <div class="kp-col-md-6">
                            <div class="qb-reference-answer">
                                <span>参考答案：</span>
                                <strong>@string.Join(", ", Question.Answers.OrderBy(x => x.DisplayOrder).Select(x => x.Value))</strong>
                            </div>
                        </div>
                        <div class="kp-col-md-6">
                            <div class="kp-text-muted kp-text-small">知识点</div>
                            <div>@(Question.KnowledgePoints.Count == 0 ? "-" : string.Join(", ", Question.KnowledgePoints.Select(x => x.Name)))</div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Question.Analysis))
                    {
                        <div class="kp-mt-3">
                            <div class="kp-text-muted kp-text-small">解析</div>
                            <div>@Question.Analysis</div>
                        </div>
                    }
                </div>
            </div>

            <div class="kp-card">
                <div class="kp-card__body">
                    <h2 class="kp-heading-6">来源依据</h2>
                    @if (Question.Sources.Count == 0)
                    {
                        <div class="kp-alert kp-alert--warning kp-mb-0">该题没有可展示的来源依据。</div>
                    }
                    else
                    {
                        @foreach (var source in Question.Sources)
                        {
                            <div class="kp-border kp-rounded kp-p-3 kp-mt-2 qb-source-excerpt">
                                <div class="kp-text-semibold">@(source.SourceTitle ?? source.ManualSourceDescription ?? "题目来源")</div>
                                @if (!string.IsNullOrWhiteSpace(source.SourceExcerpt))
                                {
                                    <div class="kp-text-muted kp-text-small kp-mt-1">@source.SourceExcerpt</div>
                                }
                                <div class="kp-text-small kp-text-success kp-mt-2"><i class="fa-solid fa-link kp-me-1"></i>@(source.KnowledgeVersionId.HasValue ? "知识库依据已保留" : "人工来源说明")</div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="kp-col-xl-4">
            <div class="kp-card kp-mb-3 qb-decision-card">
                <div class="kp-card__body">
                    <h2 class="kp-heading-6">审核结论</h2>
                    <label class="kp-label kp-mt-2" for="review-comment">审核意见</label>
                    <textarea id="review-comment" class="kp-input" rows="4" @bind="ReviewComment" @bind:event="oninput" placeholder="请填写审核意见、退回或驳回原因"></textarea>
                    <div class="kp-help">退回或不采用时必须填写原因，出题人会据此处理。</div>

                    <div class="kp-grid-display kp-gap-2 kp-mt-3">
                        <button class="kp-button kp-button--primary" type="button" @onclick="ApproveAsync" disabled="@(IsBusy || Question.Status != QuestionStatus.PendingReview)">通过审核</button>
                        <button class="kp-button kp-button--secondary" type="button" @onclick="ReturnAsync" disabled="@(IsBusy || Question.Status != QuestionStatus.PendingReview)">退回修改</button>
                        <button class="kp-button kp-button--danger-outline qb-reject" type="button" @onclick="RejectAsync" disabled="@(IsBusy || Question.Status != QuestionStatus.PendingReview)">驳回题目</button>
                    </div>
                </div>
            </div>

            <div class="kp-card">
                <div class="kp-card__body">
                    <h2 class="kp-heading-6">操作记录</h2>
                    @if (Question.Reviews.Count == 0)
                    {
                        <p class="kp-text-muted kp-text-small">暂无审核记录。</p>
                    }
                    @foreach (var review in Question.Reviews.OrderByDescending(x => x.ReviewTime))
                    {
                        <div class="kp-border-start kp-ps-3 kp-mb-3">
                            <div class="kp-text-semibold kp-text-small">@GetReviewActionText(review.Action)</div>
                            <div class="kp-text-muted kp-text-small">@review.ReviewTime.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                            @if (!string.IsNullOrWhiteSpace(review.Comment))
                            {
                                <div class="kp-text-small kp-mt-1">@GetReviewCommentText(review.Comment)</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private QuestionDto? Question { get; set; }
    private string? ReviewComment { get; set; }
    private bool IsLoading { get; set; }
    private bool IsBusy { get; set; }
    private string? ErrorMessage { get; set; }
    private bool HasCompleteDefinition => Question != null && !string.IsNullOrWhiteSpace(Question.Stem) && Question.Answers.Count > 0 && (Question.Type is not (QuestionType.SingleChoice or QuestionType.MultipleChoice) || Question.Options.Count >= 2);
    private bool HasAnalysis => !string.IsNullOrWhiteSpace(Question?.Analysis);
    private bool HasEvidence => Question?.Sources.Count > 0;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        IsLoading = true;
        ErrorMessage = null;
        Question = null;
        try
        {
            Question = await QuestionAppService.GetAsync(Id);
            if (Question.Status != QuestionStatus.PendingReview)
            {
                ErrorMessage = "该题已经不在待审核状态，请返回审核队列刷新。";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = GetUserFriendlyErrorMessage(ex);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private Task ApproveAsync() => DecideAsync(QuestionReviewDecision.Approve);
    private Task ReturnAsync() => DecideAsync(QuestionReviewDecision.ReturnForRevision);
    private Task RejectAsync() => DecideAsync(QuestionReviewDecision.Reject);

    private async Task DecideAsync(QuestionReviewDecision decision)
    {
        if (decision is QuestionReviewDecision.ReturnForRevision or QuestionReviewDecision.Reject && string.IsNullOrWhiteSpace(ReviewComment))
        {
            ErrorMessage = "退回或驳回时必须填写审核原因。";
            return;
        }

        var decisionText = decision switch
        {
            QuestionReviewDecision.Approve => "审核通过",
            QuestionReviewDecision.ReturnForRevision => "退回修改",
            QuestionReviewDecision.Reject => "驳回",
            _ => "处理"
        };

        if (!await Message.Confirm($"确定{decisionText}该题目吗？"))
        {
            return;
        }

        try
        {
            ErrorMessage = null;
            IsBusy = true;
            var input = new ReviewQuestionDto { Comment = ReviewComment };
            if (decision == QuestionReviewDecision.Approve)
            {
                await QuestionAppService.ApproveAsync(Id, input);
            }
            else if (decision == QuestionReviewDecision.ReturnForRevision)
            {
                await QuestionAppService.ReturnForRevisionAsync(Id, input);
            }
            else
            {
                await QuestionAppService.RejectAsync(Id, input);
            }

            Navigation.NavigateTo("/question-bank/reviews");
        }
        catch (Exception ex)
        {
            ErrorMessage = GetUserFriendlyErrorMessage(ex);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private static string GetTypeText(QuestionType type) => type switch
    {
        QuestionType.SingleChoice => "单选",
        QuestionType.MultipleChoice => "多选",
        QuestionType.TrueFalse => "判断",
        QuestionType.FillBlank => "填空",
        _ => type.ToString()
    };

    private static string GetDifficultyText(QuestionDifficulty difficulty) => difficulty switch
    {
        QuestionDifficulty.Easy => "简单",
        QuestionDifficulty.Normal => "普通",
        QuestionDifficulty.Hard => "困难",
        _ => difficulty.ToString()
    };

    private static string GetSourceText(QuestionCreationSource source)
        => source == QuestionCreationSource.AiGenerated ? "AI 采纳" : "人工创建";

    private static string GetReviewActionText(QuestionReviewAction action) => action switch
    {
        QuestionReviewAction.Submitted => "提交审核",
        QuestionReviewAction.Approved => "审核通过",
        QuestionReviewAction.Rejected => "驳回",
        QuestionReviewAction.ReturnedForRevision => "退回修改",
        QuestionReviewAction.Disabled => "停用",
        QuestionReviewAction.Archived => "归档",
        _ => action.ToString()
    };

    private static string GetReviewCommentText(string comment) => comment switch
    {
        "Submitted for review." => "题目已提交，等待审核。",
        "Question disabled." => "题目已停用，不再进入新试卷。",
        "Question archived." => "题目已归档。",
        _ => comment
    };
}
