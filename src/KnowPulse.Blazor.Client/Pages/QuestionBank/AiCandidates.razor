    // 创建任务表单模型。使用字符串保存岗位 ID，便于和 select 的空值选项绑定。
    private class GenerationFormModel
    {
        [Range(typeof(decimal), "0.01", "1000")] public decimal Score { get; set; } = 1;
        [Required, StringLength(64)] public string Purpose { get; set; } = "Practice";
        [EnumDataType(typeof(KnowledgeSearchScope))]
        public KnowledgeSearchScope Scope { get; set; } = KnowledgeSearchScope.PersonalLibrary;
        public string? SchoolIdText { get; set; }

        // 本次生成希望得到的题型。
        public QuestionType Type { get; set; } = QuestionType.SingleChoice;

        // 本次生成希望得到的难度。
        public QuestionDifficulty Difficulty { get; set; } = QuestionDifficulty.Normal;

        // 期望候选题数量，后端仍会根据配置上限做二次截断。
        [Range(1, 10)]
        public int RequestedCount { get; set; } = 3;

        // RAG 上下文数量上限，候选题 citation 必须来自这些上下文。
        [Range(1, 10)]
        public int TopK { get; set; } = 5;

        // 管理员输入的知识范围，用于构造检索 query。
        [Required]
        [StringLength(512)]
        public string KnowledgeScope { get; set; } = string.Empty;

        // 可选知识点文本，用于增强检索 query。
        [StringLength(512)]
        public string? KnowledgePointText { get; set; }

        // 岗位下拉绑定值，空字符串表示不限岗位。
        public string? ApplicablePositionIdText { get; set; }

        // 候选题安全等级，会随候选题提交到题库草稿。
        [Range(0, 10)]
        public int SecurityLevel { get; set; }

        // 候选题标签文本。
        [StringLength(512)]
        public string? Tags { get; set; }
    }
