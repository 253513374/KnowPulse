@page "/question-bank/ai-candidates"
@attribute [Authorize(KnowPulsePermissions.QuestionBank.AiGeneration)]
@inherits KnowPulseComponentBase
@inject IAiQuestionGenerationAppService AiQuestionGenerationAppService
@inject IQuestionAppService QuestionAppService
@inject IPositionAppService PositionAppService
@inject IPermissionChecker PermissionChecker

<PageTitle>AI 候选题</PageTitle>

<QuestionBankFlowNav ActiveStage="create" />

@* 页面只负责生成和采纳候选题；审核动作统一在题库审核队列处理。 *@
<div class="kp-flex kp-flex-wrap kp-align-center kp-justify-between kp-gap-2 kp-mb-3">
    <div>
        <h1 class="kp-heading-4 kp-mb-1">AI 候选题</h1>
        <div class="kp-text-muted kp-text-small">从知识库生成备选题，先人工确认并采纳为草稿，再进入审核。</div>
    </div>
    <button class="kp-button kp-button--secondary kp-button--sm" type="button" @onclick="LoadTasksAsync" disabled="@IsBusy">刷新</button>
</div>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="kp-alert kp-alert--error kp-flex kp-flex-wrap kp-align-center kp-justify-between kp-gap-2" role="alert">
        <span>@ErrorMessage</span>
        <button class="kp-button kp-button--sm kp-button--danger-outline" type="button" @onclick="LoadTasksAsync" disabled="@IsBusy">重试</button>
    </div>
}

@if (!string.IsNullOrWhiteSpace(SuccessMessage))
{
    <div class="kp-alert kp-alert--success" role="alert">@SuccessMessage</div>
}

<div class="kp-grid kp-grid-gap-3">
    <div class="kp-col-xl-4">
        <div class="kp-alert kp-alert--primary qb-ai-guardrail" role="note">
            <i class="fa-solid fa-shield-halved"></i>
            <div><strong>AI 结果不会直接入库</strong><span>采纳后仍可编辑，并且必须经过人工审核。</span></div>
        </div>
        @* 左侧表单负责创建 AI 出题任务，用户输入的是生成约束，真正依据仍由服务端 RAG 检索决定。 *@
        <div class="kp-card kp-mb-3">
            <div class="kp-card__body">
                <h2 class="kp-heading-6 kp-mb-1">从知识库生成候选题</h2>
                <div class="kp-text-small kp-text-muted kp-mb-3">描述要覆盖的内容，系统会检索可引用的知识。</div>
                <EditForm Model="@FormModel" OnValidSubmit="@GenerateAsync">
                    <DataAnnotationsValidator />

                    <div class="kp-mb-3">
                        <label class="kp-label" for="ai-scope">想考察什么</label>
                        <textarea id="ai-scope" class="kp-input" rows="3" @bind="FormModel.KnowledgeScope" @bind:event="oninput" placeholder="例如：新员工信息安全制度中的账号与密码要求"></textarea>
                        <ValidationMessage For="@(() => FormModel.KnowledgeScope)" />
                    </div>

                    <div class="kp-mb-3">
                        <label class="kp-label" for="ai-points">知识点标签</label>
                        <input id="ai-points" class="kp-input" @bind="FormModel.KnowledgePointText" @bind:event="oninput" placeholder="例如：账号安全、密码规范" />
                    </div>

                    <div class="kp-grid kp-grid-gap-2">
                        <div class="kp-col-md-6">
                            <label class="kp-label" for="ai-type">题型</label>
                            <select id="ai-type" class="kp-select" @bind="FormModel.Type">
                                <option value="@QuestionType.SingleChoice">单选</option>
                                <option value="@QuestionType.MultipleChoice">多选</option>
                                <option value="@QuestionType.TrueFalse">判断</option>
                                <option value="@QuestionType.FillBlank">填空</option>
                            </select>
                        </div>
                        <div class="kp-col-md-6">
                            <label class="kp-label" for="ai-difficulty">难度</label>
                            <select id="ai-difficulty" class="kp-select" @bind="FormModel.Difficulty">
                                <option value="@QuestionDifficulty.Easy">简单</option>
                                <option value="@QuestionDifficulty.Normal">普通</option>
                                <option value="@QuestionDifficulty.Hard">困难</option>
                            </select>
                        </div>
                    </div>

                    <div class="kp-mt-3">
                        <label class="kp-label" for="ai-count">生成数量</label>
                        <InputNumber id="ai-count" class="kp-input" @bind-Value="FormModel.RequestedCount" />
                    </div>

                    <div class="kp-mt-3">
                        <label class="kp-label" for="ai-position">适用岗位</label>
                        <select id="ai-position" class="kp-select" @bind="FormModel.ApplicablePositionIdText">
                            <option value="">不限</option>
                            @foreach (var position in PositionList)
                            {
                                <option value="@position.Id">@position.Name</option>
                            }
                        </select>
                    </div>

                    <details class="kp-mt-3 qb-ai-advanced">
                        <summary>高级设置</summary>
                        <div class="kp-grid kp-grid-gap-2 kp-mt-1">
                            <div class="kp-col-md-6">
                                <label class="kp-label" for="ai-topk">检索依据数量</label>
                                <InputNumber id="ai-topk" class="kp-input" @bind-Value="FormModel.TopK" />
                            </div>
                            <div class="kp-col-md-6">
                                <label class="kp-label" for="ai-security">安全等级</label>
                                <InputNumber id="ai-security" class="kp-input" @bind-Value="FormModel.SecurityLevel" />
                            </div>
                        </div>
                        <div class="kp-mt-2">
                            <label class="kp-label" for="ai-tags">标签</label>
                            <input id="ai-tags" class="kp-input" @bind="FormModel.Tags" @bind:event="oninput" />
                        </div>
                    </details>

                    <button class="kp-button kp-button--primary kp-full-width kp-mt-3" type="submit" disabled="@IsBusy">@(IsBusy ? "正在生成…" : "开始生成候选题")</button>
                </EditForm>
            </div>
        </div>

        @* 左侧任务列表展示最近生成任务，失败任务允许重试，点击任务后右侧展示候选题和引用。 *@
        <div class="kp-card qb-task-card">
            <div class="kp-card__header kp-bg-transparent kp-border-0 kp-text-semibold kp-pt-3">最近生成</div>
            <div class="kp-table-wrap">
                <table class="kp-table kp-table--hover kp-table-align-middle kp-mb-0">
                    <thead>
                        <tr>
                            <th>任务</th>
                            <th>状态</th>
                            <th class="kp-text-end">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (IsLoading)
                        {
                            <tr>
                                <td colspan="3" class="kp-text-center kp-py-4 kp-text-muted">加载中</td>
                            </tr>
                        }
                        else if (TaskList.Count == 0)
                        {
                            <tr>
                                <td colspan="3" class="kp-text-center kp-py-4 kp-text-muted">暂无任务</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var task in TaskList)
                            {
                                <tr class="@(SelectedTask?.Id == task.Id ? "kp-table-row--primary" : null)">
                                    <td>
                                        <button class="kp-button kp-button--link kp-p-0 kp-text-start" type="button" @onclick="() => SelectTaskAsync(task.Id)" disabled="@IsBusy">
                                            <span class="kp-text-semibold">@Trim(task.KnowledgeScope, 40)</span>
                                        </button>
                                        <div class="kp-text-small kp-text-muted">@GetTypeText(task.Type) / @GetDifficultyText(task.Difficulty) / @task.GeneratedCount/@task.RequestedCount</div>
                                    </td>
                                    <td><span class="kp-badge @GetTaskStatusBadge(task.Status)">@GetTaskStatusText(task.Status)</span></td>
                                    <td class="kp-text-end">
                                        @if (task.Status == AiQuestionGenerationTaskStatus.Failed)
                                        {
                                            <button class="kp-button kp-button--primary-outline kp-button--sm" type="button" @onclick="() => RetryAsync(task.Id)" disabled="@IsBusy">重试</button>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="kp-col-xl-8">
        @* 右侧详情区展示任务状态、失败原因、候选题、citation 和审核操作。 *@
        @if (SelectedTask == null)
        {
            <div class="kp-card qb-ai-empty">
                <div class="kp-card__body kp-text-center kp-py-5">
                    <span class="qb-ai-empty__icon"><i class="fa-solid fa-wand-magic-sparkles"></i></span>
                    <div class="kp-text-semibold kp-mt-3">生成后在这里逐题确认</div>
                    <div class="kp-text-muted kp-text-small kp-mt-1">查看答案和引用依据，只采纳质量合格的候选题。</div>
                </div>
            </div>
        }
        else
        {
            @* 任务摘要只展示业务信息；模型和 prompt 版本继续保留在后端审计记录中。 *@
            <div class="kp-card kp-mb-3">
                <div class="kp-card__body">
                    <div class="kp-flex kp-flex-wrap kp-align-start kp-justify-between kp-gap-2">
                        <div>
                            <h2 class="kp-heading-6 kp-mb-1">@SelectedTask.KnowledgeScope</h2>
                            <div class="kp-text-small kp-text-muted">已生成 @SelectedTask.GeneratedCount / @SelectedTask.RequestedCount 道 · @GetTypeText(SelectedTask.Type) · @GetDifficultyText(SelectedTask.Difficulty)</div>
                        </div>
                        <span class="kp-badge @GetTaskStatusBadge(SelectedTask.Status)">@GetTaskStatusText(SelectedTask.Status)</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(SelectedTask.FailureReason))
                    {
                        <div class="kp-alert kp-alert--warning kp-mt-3 kp-mb-0">
                            @SelectedTask.FailureStage：@SelectedTask.FailureReason
                        </div>
                    }
                </div>
            </div>

            @if (SelectedTask.Candidates.Count == 0)
            {
                <div class="kp-card">
                    <div class="kp-card__body kp-text-center kp-text-muted kp-py-5">暂无候选题</div>
                </div>
            }
            else
            {
                <div class="kp-flex kp-flex-column kp-gap-3">
                    @foreach (var candidate in SelectedTask.Candidates)
                    {
                        @* 每张候选题卡都明确标记其候选状态，避免被误认为已经进入正式题库。 *@
                        <div class="kp-card">
                            <div class="kp-card__body">
                                <div class="kp-flex kp-flex-wrap kp-align-start kp-justify-between kp-gap-2">
                                    <div>
                                        <h3 class="kp-heading-6 kp-mb-1">@candidate.Title</h3>
                                        <div class="kp-text-small kp-text-muted">@GetTypeText(candidate.Type) / @GetDifficultyText(candidate.Difficulty)</div>
                                    </div>
                                    <div class="kp-flex kp-flex-wrap kp-gap-2">
                                        <span class="kp-badge @GetCandidateStatusBadge(candidate.Status)">@GetCandidateStatusText(candidate.Status)</span>
                                        @if (!candidate.LinkedQuestionId.HasValue)
                                        {
                                            <span class="kp-badge kp-bg-secondary">未入正式题库</span>
                                        }
                                        else
                                        {
                                            var linkedQuestion = GetLinkedQuestion(candidate);
                                            if (linkedQuestion == null)
                                            {
                                                <span class="kp-badge kp-bg-light kp-text-dark">已采纳为题库草稿</span>
                                            }
                                            else
                                            {
                                                <span class="kp-badge @GetQuestionStatusBadge(linkedQuestion.Status)">题库：@GetQuestionStatusText(linkedQuestion.Status)</span>
                                            }
                                        }
                                    </div>
                                </div>

                                <p class="kp-mt-3 kp-mb-2">@candidate.Stem</p>

                                @if (candidate.Options.Count > 0)
                                {
                                    <div class="kp-list kp-list--flush kp-mb-3">
                                        @foreach (var option in candidate.Options.OrderBy(x => x.DisplayOrder))
                                        {
                                            <div class="kp-list__item kp-px-0">
                                                <span class="kp-text-semibold">@option.OptionKey.</span> @option.Content
                                            </div>
                                        }
                                    </div>
                                }

                                <div class="kp-grid kp-grid-gap-2 kp-text-small">
                                    <div class="kp-col-md-6">
                                        <div class="kp-text-muted">标准答案</div>
                                        <div>@(candidate.Answers.Count == 0 ? "-" : string.Join(", ", candidate.Answers.OrderBy(x => x.DisplayOrder).Select(x => x.Value)))</div>
                                    </div>
                                    <div class="kp-col-md-6">
                                        <div class="kp-text-muted">知识点</div>
                                        <div>@(candidate.KnowledgePoints.Count == 0 ? "-" : string.Join(", ", candidate.KnowledgePoints))</div>
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(candidate.Analysis))
                                {
                                    <div class="kp-mt-3 kp-text-small">
                                        <div class="kp-text-muted">解析</div>
                                        <div>@candidate.Analysis</div>
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(candidate.ValidationErrors))
                                {
                                    <div class="kp-alert kp-alert--error kp-mt-3 kp-mb-0">@candidate.ValidationErrors</div>
                                }

                                @if (candidate.HighestSimilarityScore.HasValue)
                                {
                                    <div class="kp-alert kp-alert--warning kp-mt-3 kp-mb-0">
                                        @candidate.SimilaritySummary（相似度 @candidate.HighestSimilarityScore.Value.ToString("P0")）
                                    </div>
                                }

                                <div class="kp-mt-3">
                                    <div class="kp-text-semibold kp-text-small kp-mb-2">引用来源</div>
                                    @* citation 是候选题可采纳的必要条件，无 citation 时只允许排查。 *@
                                    @if (candidate.Citations.Count == 0)
                                    {
                                        <div class="kp-text-muted kp-text-small">无 citation</div>
                                    }
                                    else
                                    {
                                        <div class="kp-flex kp-flex-column kp-gap-2">
                                            @foreach (var citation in candidate.Citations.OrderBy(x => x.Rank))
                                            {
                                                <div class="kp-border kp-rounded kp-p-2 kp-text-small">
                                                    <div class="kp-text-semibold">[@citation.Rank] @citation.SourceTitle @GetPageText(citation.SourcePage)</div>
                                                    <div class="kp-text-muted">@citation.SourceExcerpt</div>
                                                    <div class="kp-text-muted">来自知识库检索依据</div>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="kp-flex kp-flex-wrap kp-gap-2 kp-mt-3">
                                    @if (CanAdopt(candidate))
                                    {
                                        <button class="kp-button kp-button--primary kp-button--sm" type="button" @onclick="() => AdoptCandidateAsync(candidate)" disabled="@IsBusy">采纳为草稿</button>
                                    }
                                    @if (candidate.LinkedQuestionId.HasValue)
                                    {
                                        <a class="kp-button kp-button--secondary kp-button--sm" href="@($"/question-bank/questions/{candidate.LinkedQuestionId.Value}/edit")">打开题目草稿</a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    // 页面一次加载的任务数量。MVP-2 页面以最近任务审核为主，暂不做复杂分页控件。
    private const int PageSize = 20;

    // 最近 AI 出题任务列表，点击后加载右侧详情。
    private readonly List<AiQuestionGenerationTaskDto> TaskList = new();

    // 岗位下拉选项，用于给生成任务指定适用岗位。
    private readonly List<PositionDto> PositionList = new();

    // 已采纳候选题关联的题库草稿，用于展示草稿状态。
    private readonly Dictionary<Guid, QuestionDto> LinkedQuestions = new();

    // 当前右侧正在查看的 AI 出题任务。
    private AiQuestionGenerationTaskDto? SelectedTask { get; set; }

    // 创建任务表单模型，和后端 CreateAiQuestionGenerationTaskDto 保持字段语义一致。
    private GenerationFormModel FormModel { get; set; } = new();

    // 全局忙碌状态，防止生成、重试、采纳等操作重复点击。
    private bool IsBusy { get; set; }

    // 首次或刷新任务列表时的加载状态。
    private bool IsLoading { get; set; }

    // 页面级错误提示，统一由 RunBusyAsync 捕获用户友好错误。
    private string? ErrorMessage { get; set; }

    // 页面级成功提示，操作完成后短文本反馈给审核人员。
    private string? SuccessMessage { get; set; }

    // 当前用户是否可读取题库草稿详情，用于展示候选题采纳后的题库状态。
    private bool CanViewQuestions { get; set; }

    // 页面初始化时先加载岗位，再加载任务列表；这样表单下拉和默认任务详情都能一次展示。
    protected override async Task OnInitializedAsync()
    {
        CanViewQuestions = await PermissionChecker.IsGrantedAsync(KnowPulsePermissions.QuestionBank.Questions);
        await LoadPositionsAsync();
        await LoadTasksAsync();
    }

    // 加载岗位列表。岗位只影响候选题适用范围，不改变 RAG 权限过滤。
    private async Task LoadPositionsAsync()
    {
        var positions = await PositionAppService.GetListAsync(new PagedAndSortedResultRequestDto { MaxResultCount = 200 });
        PositionList.Clear();
        PositionList.AddRange(positions.Items.OrderBy(x => x.Name));
    }

    // 刷新任务列表，并保持当前选中任务；没有选中任务时默认选择最新一条。
    private async Task LoadTasksAsync()
    {
        await RunBusyAsync(async () =>
        {
            IsLoading = true;
            var result = await AiQuestionGenerationAppService.GetListAsync(new GetAiQuestionGenerationTaskListInput
            {
                MaxResultCount = PageSize
            });

            TaskList.Clear();
            TaskList.AddRange(result.Items);
            if (SelectedTask == null && TaskList.Count > 0)
            {
                await SelectTaskCoreAsync(TaskList[0].Id);
            }
            else if (SelectedTask != null)
            {
                await SelectTaskCoreAsync(SelectedTask.Id);
            }
        });
    }

    // 用户点击任务列表时切换右侧详情。
    private async Task SelectTaskAsync(Guid taskId)
    {
        await RunBusyAsync(() => SelectTaskCoreAsync(taskId));
    }

    // 加载任务详情并同步其已关联题库草稿，确保审核按钮状态准确。
    private async Task SelectTaskCoreAsync(Guid taskId)
    {
        SelectedTask = await AiQuestionGenerationAppService.GetAsync(taskId);
        await LoadLinkedQuestionsAsync();
    }

    // 加载候选题已经采纳出的题库草稿。加载失败不阻断候选题查看。
    private async Task LoadLinkedQuestionsAsync()
    {
        LinkedQuestions.Clear();
        if (SelectedTask == null || !CanViewQuestions)
        {
            return;
        }

        foreach (var questionId in SelectedTask.Candidates
            .Where(x => x.LinkedQuestionId.HasValue)
            .Select(x => x.LinkedQuestionId!.Value)
            .Distinct())
        {
            try
            {
                LinkedQuestions[questionId] = await QuestionAppService.GetAsync(questionId);
            }
            catch
            {
                // 关联题状态只用于展示采纳结果。
            }
        }
    }

    // 创建 AI 出题任务。后端会同步执行 RAG 检索、模型调用和候选题校验。
    private async Task GenerateAsync()
    {
        await RunBusyAsync(async () =>
        {
            var task = await AiQuestionGenerationAppService.CreateAsync(new CreateAiQuestionGenerationTaskDto
            {
                Type = FormModel.Type,
                Difficulty = FormModel.Difficulty,
                RequestedCount = FormModel.RequestedCount,
                TopK = FormModel.TopK,
                KnowledgeScope = FormModel.KnowledgeScope.Trim(),
                KnowledgePointText = FormModel.KnowledgePointText,
                ApplicablePositionId = ParseNullableGuid(FormModel.ApplicablePositionIdText),
                SecurityLevel = FormModel.SecurityLevel,
                Tags = FormModel.Tags
            });

            SuccessMessage = "生成任务已完成";
            await LoadTasksCoreAsync(task.Id);
        });
    }

    // 重试任务。后端会清理该任务旧候选题后重新生成，调用日志仍保留审计历史。
    private async Task RetryAsync(Guid taskId)
    {
        await RunBusyAsync(async () =>
        {
            var task = await AiQuestionGenerationAppService.RetryAsync(taskId);
            SuccessMessage = "任务已重试";
            await LoadTasksCoreAsync(task.Id);
        });
    }

    // 重新加载任务列表并选中指定任务，用于生成、重试或采纳后的页面刷新。
    private async Task LoadTasksCoreAsync(Guid selectedTaskId)
    {
        var result = await AiQuestionGenerationAppService.GetListAsync(new GetAiQuestionGenerationTaskListInput
        {
            MaxResultCount = PageSize
        });

        TaskList.Clear();
        TaskList.AddRange(result.Items);
        await SelectTaskCoreAsync(selectedTaskId);
    }

    // 将可用候选题采纳为可编辑草稿，用户仍需进入草稿页确认并主动提交审核。
    private async Task AdoptCandidateAsync(AiQuestionCandidateDto candidate)
    {
        if (!await ConfirmAsync("确定采纳该 AI 候选题为可编辑草稿吗？"))
        {
            return;
        }

        await RunBusyAsync(async () =>
        {
            await AiQuestionGenerationAppService.AdoptCandidateAsDraftAsync(candidate.Id);
            SuccessMessage = "候选题已采纳为草稿，请检查后再提交审核";
            await SelectTaskCoreAsync(candidate.TaskId);
        });
    }

    // 页面异步操作统一包装：清空旧提示、设置忙碌状态、捕获友好错误并恢复 loading 标志。
    private async Task RunBusyAsync(Func<Task> action)
    {
        try
        {
            ErrorMessage = null;
            SuccessMessage = null;
            IsBusy = true;
            await action();
        }
        catch (Exception ex)
        {
            ErrorMessage = GetUserFriendlyErrorMessage(ex);
        }
        finally
        {
            IsBusy = false;
            IsLoading = false;
        }
    }

    // 浏览器确认框封装，避免危险动作误触。
    private async Task<bool> ConfirmAsync(string message)
    {
        return await Message.Confirm(message);
    }

    // 候选题只有生成成功、未采纳且没有校验错误时，才允许采纳为草稿。
    private bool CanAdopt(AiQuestionCandidateDto candidate)
    {
        return candidate.Status == AiQuestionCandidateStatus.Generated &&
               !candidate.LinkedQuestionId.HasValue &&
               string.IsNullOrWhiteSpace(candidate.ValidationErrors);
    }

    // 获取候选题已经采纳出的题库草稿；无题库查看权限时返回 null。
    private QuestionDto? GetLinkedQuestion(AiQuestionCandidateDto candidate)
    {
        return candidate.LinkedQuestionId.HasValue &&
               LinkedQuestions.TryGetValue(candidate.LinkedQuestionId.Value, out var question)
            ? question
            : null;
    }

    // 将岗位下拉的字符串值转换为可空 Guid。
    private static Guid? ParseNullableGuid(string? value)
    {
        return Guid.TryParse(value, out var id) ? id : null;
    }

    // citation 页码展示文本，非分页来源保持空字符串。
    private static string GetPageText(int? page)
    {
        return page.HasValue ? $"第 {page.Value} 页" : string.Empty;
    }

    // 裁剪长标题或 hash，避免任务列表和 citation 元信息撑开布局。
    private static string Trim(string value, int maxLength)
    {
        return value.Length <= maxLength ? value : value[..maxLength] + "...";
    }

