    private async Task LoadCurriculumChoicesAsync()
    {
        CurriculumChoices.Clear(); CurriculumError = null;
        try
        {
            var schools = await SchoolAppService.GetMySchoolsAsync();
            foreach (var school in schools.Items.Where(x => x.Roles.Contains(SchoolMemberRole.Teacher)))
            {
                try
                {
                    var context = await CurriculumAppService.GetContextAsync(school.Id);
                    var selections = await CurriculumAppService.GetMySelectionsAsync(school.Id);
                    foreach (var selection in selections.Items.Where(x => x.EndedAtUtc == null && x.TextbookStatus == TextbookVersionStatus.Published))
                        if (context.TeachingContexts.FirstOrDefault(x => x.Id == selection.TeachingAssignmentId) is { } assignment)
                            CurriculumChoices.Add(new CurriculumChoice(school, assignment, selection));
                }
                catch (Exception exception) { CurriculumError = GetUserFriendlyErrorMessage(exception); }
            }
        }
        catch (Exception exception) { CurriculumChoices.Clear(); CurriculumError = GetUserFriendlyErrorMessage(exception); }
    }
    private async Task LoadTextbookAsync(bool preserveMappings)
    {
        SelectedTextbook = null; ChapterIdText = string.Empty;
        if (!preserveMappings) { SelectedMappingIds.Clear(); PointScores.Clear(); }
        if (SelectedChoice is not { } choice) return;
        try
        {
            var book = await CurriculumAppService.GetTextbookAsync(choice.Selection.TextbookVersionId);
            if (book.Status != TextbookVersionStatus.Published || book.SchoolId != choice.School.Id || book.Grade != choice.Assignment.Grade || book.EducationSubjectId != choice.Assignment.EducationSubjectId)
                throw new InvalidOperationException(L["EducationGeneration:InvalidSelection"]);
            SelectedTextbook = book;
        }
        catch (Exception exception) { CurriculumError = GetUserFriendlyErrorMessage(exception); }
    }
    private async Task SelectionChangedAsync() => await RunBusyAsync(() => LoadTextbookAsync(preserveMappings: false));
    private async Task RefreshCurriculumAsync() => await RunBusyAsync(async () => { await LoadCurriculumChoicesAsync(); await LoadTextbookAsync(preserveMappings: true); });
    private void ToggleMapping(Guid id, ChangeEventArgs args)
    {
        if (EditorQuestionId.HasValue) return;
        if (args.Value is true)
        {
            SelectedMappingIds.Add(id);
            var mapping = SelectedTextbook?.Mappings.FirstOrDefault(x => x.Id == id);
            if (mapping != null && PointScores.All(x => x.MappingId != id)) PointScores.Add(new PointScoreRow { MappingId = id, Label = TextbookMappingLabel(mapping) });
        }
        else { SelectedMappingIds.Remove(id); PointScores.RemoveAll(x => x.MappingId == id); }
    }
