    private static bool CreatedContentMatches(SaveQuestionDraftDto input, QuestionDto saved)
    {
        // A replay returns the current draft. An edit in another window must not be confirmed
        // using a returned stamp while this window still displays the original submitted content.
        var scope = saved.Curriculum;
        if (scope == null || input.CurriculumScope == null || saved.Status != QuestionStatus.Draft || saved.CurriculumConfirmed ||
            saved.CurriculumPointWeights.Count > 0 || saved.CurriculumScore != input.CurriculumScore ||
            scope.TeacherTextbookSelectionId != input.CurriculumScope.TeacherTextbookSelectionId ||
            !scope.Mappings.Select(x => x.MappingId).ToHashSet().SetEquals(input.CurriculumScope.TextbookKnowledgePointMappingIds) ||
            saved.Type != input.Type || saved.Difficulty != input.Difficulty || saved.Title != input.Title || saved.Stem != input.Stem ||
            saved.ApplicablePositionId != input.ApplicablePositionId || saved.SecurityLevel != input.SecurityLevel ||
            saved.Tags != NormalizeTags(input.Tags) || saved.Analysis != TrimOptional(input.Analysis)) return false;
        if (saved.ScoringDefinition?.ToCanonicalJson() != input.ScoringDefinition?.ToCanonicalJson()) return false;
        return input.Options.OrderBy(x => x.DisplayOrder).Select(x => (x.OptionKey, x.Content, x.DisplayOrder))
                .SequenceEqual(saved.Options.OrderBy(x => x.DisplayOrder).Select(x => (x.OptionKey, x.Content, x.DisplayOrder))) &&
            input.Answers.OrderBy(x => x.DisplayOrder).Select(x => (x.Value, x.DisplayOrder))
                .SequenceEqual(saved.Answers.OrderBy(x => x.DisplayOrder).Select(x => (x.Value, x.DisplayOrder))) &&
            input.KnowledgePointNames.ToHashSet(StringComparer.OrdinalIgnoreCase).SetEquals(saved.KnowledgePoints.Select(x => x.Name)) &&
            input.Sources.Select(x => (x.KnowledgeItemId, x.KnowledgeVersionId, x.ChunkId, TrimOptional(x.SourceTitle), TrimOptional(x.SourceExcerpt), TrimOptional(x.SourceHash), TrimOptional(x.ManualSourceDescription)))
                .SequenceEqual(saved.Sources.Select(x => (x.KnowledgeItemId, x.KnowledgeVersionId, x.ChunkId, x.SourceTitle, x.SourceExcerpt, x.SourceHash, x.ManualSourceDescription)));
    }
    private static string? TrimOptional(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string? NormalizeTags(string? tags) => string.IsNullOrWhiteSpace(tags) ? null : string.Join(", ", tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Distinct(StringComparer.OrdinalIgnoreCase));
    private sealed record CurriculumChoice(MySchoolDto School, MyTeachingContextDto Assignment, TeacherTextbookSelectionDto Selection);
    private sealed class PointScoreRow { public Guid MappingId { get; set; } public string Label { get; set; } = string.Empty; public decimal Score { get; set; } }
    private sealed class CreateOperationReceipt { public CreateOperationReceipt() { } public Guid Id { get; set; } public string Signature { get; set; } = string.Empty; }
    private IReadOnlyDictionary<Guid, string> RuleMappingLabels => PointScores.ToDictionary(x => x.MappingId, x => x.Label);
    private bool UsesComponentAllocation => IsCurriculumQuestion && FormModel.Type is QuestionType.FillBlank or QuestionType.Subjective;
    private void ScoringChanged(QuestionScoringDefinition? definition) { FormModel.ScoringDefinition = definition; SynchronizeRulePointScores(); }
    private void SynchronizeRulePointScores()
    {
        if (!UsesComponentAllocation) return;
        var allocations = FormModel.Type == QuestionType.FillBlank
            ? (FormModel.ScoringDefinition?.Blanks ?? []).Select(x => (MappingId: x.TextbookKnowledgePointMappingId, x.Score))
            : (FormModel.ScoringDefinition?.ScoringPoints ?? []).Select(x => (MappingId: x.TextbookKnowledgePointMappingId, x.Score));
        var totals = allocations.Where(x => x.MappingId.HasValue).GroupBy(x => x.MappingId!.Value).ToDictionary(x => x.Key, x => x.Sum(row => row.Score));
        foreach (var point in PointScores) point.Score = totals.GetValueOrDefault(point.MappingId);
    }
    private static QuestionScoringDefinition? CloneScoringDefinition(QuestionScoringDefinition? definition) => definition == null ? null : JsonSerializer.Deserialize<QuestionScoringDefinition>(JsonSerializer.Serialize(definition));

    private void OnQuestionTypeChanged()
    {
        FormModel.ScoringDefinition = null;
        SynchronizeRulePointScores();
        if (IsChoiceQuestion)
        {
            EnsureChoiceOptions();
            if (FormModel.Type == QuestionType.SingleChoice && FormModel.Options.Count(x => x.IsCorrect) > 1)
            {
                var firstCorrect = FormModel.Options.First(x => x.IsCorrect);
                SelectSingleOption(firstCorrect);
            }
        }
    }

    private void EnsureChoiceOptions()
    {
        if (!IsChoiceQuestion)
        {
            return;
        }

        while (FormModel.Options.Count < 4)
        {
            FormModel.Options.Add(new OptionEditorRow());
        }
    }

    private void AddOption() => FormModel.Options.Add(new OptionEditorRow());

    private void SelectTrue() => FormModel.TrueFalseAnswer = "true";

    private void SelectFalse() => FormModel.TrueFalseAnswer = "false";

    private void RemoveOption(OptionEditorRow option)
    {
        if (FormModel.Options.Count > 2)
        {
            FormModel.Options.Remove(option);
        }
    }

    private void SelectSingleOption(OptionEditorRow selected)
    {
        foreach (var option in FormModel.Options)
        {
            option.IsCorrect = ReferenceEquals(option, selected);
        }
    }

    private static void ToggleMultipleOption(OptionEditorRow option, ChangeEventArgs args)
    {
        option.IsCorrect = args.Value is bool selected
            ? selected
            : bool.TryParse(args.Value?.ToString(), out var parsed) && parsed;
    }

    private static string NormalizeTrueFalseAnswer(string? value)
        => value is "false" or "错" ? "false" : "true";

    private static string GetOptionKey(int index)
        => ((char)('A' + index)).ToString();

    private static List<string> SplitValues(string? value)
        => (value ?? string.Empty)
            .Split(new[] { "\r\n", "\n", ",", "，", ";", "；" }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

    private class OptionEditorRow
    {
        public string Content { get; set; } = string.Empty;
        public bool IsCorrect { get; set; }
    }

    private class QuestionFormModel
    {
        [Range(typeof(decimal), "0.01", "1000")] public decimal CurriculumScore { get; set; } = 1;
        public QuestionCreationSource CreationSource { get; set; } = QuestionCreationSource.Manual;
        public QuestionType Type { get; set; } = QuestionType.SingleChoice;
        public QuestionDifficulty Difficulty { get; set; } = QuestionDifficulty.Normal;
        public string? ApplicablePositionIdText { get; set; }

        [Required, StringLength(256)]
        public string Title { get; set; } = string.Empty;

        [Required, StringLength(4000)]
        public string Stem { get; set; } = string.Empty;

        [Range(0, 10)]
