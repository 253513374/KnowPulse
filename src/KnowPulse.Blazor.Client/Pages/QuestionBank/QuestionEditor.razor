@page "/question-bank/questions/new"
@page "/question-bank/questions/{Id:guid}/edit"
@page "/teacher/questions/new"
@page "/teacher/questions/{Id:guid}/edit"
@attribute [Authorize(KnowPulsePermissions.QuestionBank.Questions)]
@inherits KnowPulseComponentBase
@using KnowPulse.Education
@using System.Text.Json
@using System.Security.Cryptography
@using System.Text
@inject IQuestionAppService QuestionAppService
@inject IQuestionWorkflowAppService QuestionWorkflow
@inject IDialogService TeacherDialogs
@inject IPositionAppService PositionAppService
@inject IEducationSchoolAppService SchoolAppService
@inject IEducationCurriculumAppService CurriculumAppService
@inject IPermissionChecker PermissionChecker
@inject IJSRuntime JSRuntime
@inject Volo.Abp.Users.ICurrentUser CurrentAccount
@inject Volo.Abp.MultiTenancy.ICurrentTenant CurrentTenantContext
@inject NavigationManager Navigation

<PageTitle>@(EditorQuestionId.HasValue ? "编辑题目草稿" : "新建人工题")</PageTitle>

<div class="@(IsTeacherWorkspace ? "teacher-page" : null)" data-teacher-section="@(IsTeacherWorkspace ? "questions" : null)">
@if (!IsTeacherWorkspace)
{
    <QuestionBankFlowNav ActiveStage="drafts" />
}
<NavigationLock OnBeforeInternalNavigation="ConfirmNavigationAsync" ConfirmExternalNavigation="@HasUnsavedChanges" />

<div class="kp-flex kp-flex-wrap kp-align-start kp-justify-between kp-gap-3 kp-mb-3">
    <div>
        <h1 class="kp-heading-4 kp-mb-1">@(EditorQuestionId.HasValue ? "编辑题目草稿" : "新建人工题")</h1>
        <div class="kp-text-muted kp-text-small">@(IsTeacherWorkspace ? "检查题干、答案与解析；经你本人确认后才可用于发布。" : "先把内容和依据补完整；保存只会更新草稿，不会自动送审。")</div>
    </div>
    <a class="kp-button kp-button--secondary kp-button--sm" href="@(IsTeacherWorkspace ? "/teacher/questions" : "/question-bank/drafts")">返回我的题库</a>
</div>

@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="kp-alert kp-alert--error" role="alert">@ErrorMessage</div>
}
@if (SuccessMessage != null) { <div class="kp-alert kp-alert--success" role="status">@SuccessMessage</div> }
@if (SavedQuestion != null)
{
    <div class="kp-alert kp-alert--info kp-flex kp-flex-wrap kp-gap-2 kp-align-center kp-justify-between" role="status"><span>@L["EducationQuestion:SavedQuestion", SavedQuestion.Title]</span><div class="kp-flex kp-gap-2 kp-align-center"><a href="@($"{(IsTeacherWorkspace ? "/teacher/questions" : "/question-bank/questions")}/{SavedQuestion.Id}/edit")">@L["EducationQuestion:OpenSaved"]</a><button type="button" class="kp-button kp-button--sm kp-button--secondary" @onclick="ReloadSavedAsync" disabled="@IsBusy">@L["EducationQuestion:ReloadSaved"]</button></div></div>
}
@if (CreateOperation != null && !EditorQuestionId.HasValue)
{
    <div class="kp-alert kp-alert--info" role="status"><span>@L["EducationQuestion:RecoverHint"]</span><button type="button" class="kp-button kp-button--sm kp-button--primary-outline ms-2" @onclick="RecoverCreateAsync" disabled="@IsBusy">@L["EducationQuestion:Recover"]</button></div>
}
@if (StorageNotice != null) { <p class="kp-text-small kp-text-warning">@StorageNotice</p> }

@if (IsLoading)
{
    <div class="kp-card"><div class="kp-card__body kp-text-center kp-text-muted kp-py-5">加载中</div></div>
}
else
{
    <EditForm EditContext="@(EditorContext!)" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <Microsoft.AspNetCore.Components.Forms.ValidationSummary />
        <fieldset disabled="@(IsBusy || SavedQuestion?.Status == QuestionStatus.Archived)">

        <div class="kp-grid kp-grid-gap-3">
            <div class="kp-col-xl-8">
                <div class="kp-card qb-editor-card">
                    <div class="kp-card__body kp-p-4">
                        <div class="kp-flex kp-align-center kp-justify-between kp-gap-2 kp-mb-3">
                            <div>
                                <div class="kp-text-primary kp-text-small kp-text-semibold kp-mb-1">STEP 1</div>
                                <h2 class="kp-heading-6 kp-mb-0">设计题目内容</h2>
                            </div>
                            <span class="kp-badge @(FormModel.CreationSource == QuestionCreationSource.AiGenerated ? "kp-bg-info" : "kp-bg-secondary")">
                                @(FormModel.CreationSource == QuestionCreationSource.AiGenerated ? "AI 采纳草稿" : "人工创建")
                            </span>
                        </div>

                        <div class="kp-grid kp-grid-gap-3">
                            <div class="kp-col-md-4">
                                <label class="kp-label" for="editor-type">题型</label>
                                <select id="editor-type" class="kp-select" @bind="FormModel.Type" @bind:after="OnQuestionTypeChanged">
                                    <option value="@QuestionType.SingleChoice">单选</option>
                                    <option value="@QuestionType.MultipleChoice">多选</option>
                                    <option value="@QuestionType.TrueFalse">判断</option>
                                    <option value="@QuestionType.FillBlank">填空</option>
                                    <option value="@QuestionType.Subjective" disabled="@(!IsCurriculumQuestion)">@L["QuestionType:Subjective"]</option>
                                </select>
                            </div>
                            <div class="kp-col-md-4">
                                <label class="kp-label" for="editor-difficulty">难度</label>
                                <select id="editor-difficulty" class="kp-select" @bind="FormModel.Difficulty">
                                    <option value="@QuestionDifficulty.Easy">简单</option>
                                    <option value="@QuestionDifficulty.Normal">普通</option>
                                    <option value="@QuestionDifficulty.Hard">困难</option>
                                </select>
                            </div>
                            <div class="kp-col-md-4">
                                @if (!IsCurriculumQuestion)
                                {
                                <label class="kp-label" for="editor-position">适用岗位</label>
                                <select id="editor-position" class="kp-select" @bind="FormModel.ApplicablePositionIdText">
                                    <option value="">不限岗位</option>
                                    @foreach (var position in Positions)
                                    {
                                        <option value="@position.Id">@position.Name</option>
                                    }
                                </select>
                                }
                            </div>
                        </div>

                        <div class="kp-mt-3">
                            <label class="kp-label" for="editor-title">标题</label>
                            <input id="editor-title" class="kp-input" @bind="FormModel.Title" @bind:event="oninput" placeholder="用于题库检索和审核识别" />
                            <ValidationMessage For="@(() => FormModel.Title)" />
                        </div>

                        <div class="kp-mt-3">
                            <label class="kp-label" for="editor-stem">题干</label>
                            <textarea id="editor-stem" class="kp-input" rows="5" @bind="FormModel.Stem" @bind:event="oninput" placeholder="写清楚问题，避免依赖考试之外的上下文"></textarea>
                            <ValidationMessage For="@(() => FormModel.Stem)" />
                        </div>

                        <div class="qb-answer-builder kp-mt-4">
                            <div class="kp-flex kp-flex-wrap kp-align-start kp-justify-between kp-gap-2 kp-mb-3">
                                <div>
                                    <h3 class="kp-heading-6 kp-mb-1">设置选项与答案</h3>
                                    <div class="kp-text-small kp-text-muted">直接勾选正确答案，不需要记忆文本格式。</div>
                                </div>
                                @if (IsChoiceQuestion)
                                {
                                    <button class="kp-button kp-button--sm kp-button--primary-outline" type="button" @onclick="AddOption">添加选项</button>
                                }
                            </div>

                            @if (IsChoiceQuestion)
                            {
                                <div class="kp-flex kp-flex-column kp-gap-2">
                                    @for (var index = 0; index < FormModel.Options.Count; index++)
                                    {
                                        var option = FormModel.Options[index];
                                        <div class="qb-option-row">
                                            @if (FormModel.Type == QuestionType.SingleChoice)
                                            {
                                                <input class="kp-check__input" type="radio" name="correct-option" checked="@option.IsCorrect" @onchange="() => SelectSingleOption(option)" aria-label="设为正确答案" />
                                            }
                                            else
                                            {
                                                <input class="kp-check__input" type="checkbox" checked="@option.IsCorrect" @onchange="args => ToggleMultipleOption(option, args)" aria-label="切换正确答案" />
                                            }
                                            <span class="qb-option-key">@GetOptionKey(index)</span>
                                            <input class="kp-input" @bind="option.Content" @bind:event="oninput" placeholder="填写选项内容" aria-label="选项 @GetOptionKey(index)" />
                                            <button class="kp-button kp-button--sm kp-button--link kp-text-danger" type="button" @onclick="() => RemoveOption(option)" disabled="@(FormModel.Options.Count <= 2)" aria-label="删除选项"><i class="fa-solid fa-trash-can"></i></button>
                                        </div>
                                    }
                                </div>
                                <div class="kp-help kp-mt-2">@(FormModel.Type == QuestionType.SingleChoice ? "选择一个正确答案。" : "至少选择两个正确答案。")</div>
                            }
                            else if (FormModel.Type == QuestionType.TrueFalse)
                            {
                                <div class="qb-true-false" role="radiogroup" aria-label="判断题答案">
                                    <button class="@(FormModel.TrueFalseAnswer == "true" ? "is-selected" : null)" type="button" @onclick="SelectTrue"><i class="fa-solid fa-check"></i><span>正确</span></button>
                                    <button class="@(FormModel.TrueFalseAnswer == "false" ? "is-selected" : null)" type="button" @onclick="SelectFalse"><i class="fa-solid fa-xmark"></i><span>错误</span></button>
                                </div>
                            }
                            else if (!IsCurriculumQuestion && FormModel.Type == QuestionType.FillBlank)
                            {
                                <label class="kp-label" for="editor-answers">标准答案</label>
                                <textarea id="editor-answers" class="kp-input" rows="3" @bind="FormModel.AnswerLines" @bind:event="oninput" placeholder="填写一个或多个可接受答案，每行一个"></textarea>
                                <div class="kp-help">多个等价答案可以换行填写。</div>
                            }
                        </div>

                        @if (IsCurriculumQuestion && (FormModel.Type is QuestionType.MultipleChoice or QuestionType.FillBlank or QuestionType.Subjective || FormModel.ScoringDefinition != null))
                        {
                            @if (FormModel.Type == QuestionType.FillBlank && SavedQuestion?.Answers.Count > 0) { <p class="kp-text-small kp-text-warning">@L["EducationScoring:LegacyAnswerHint"] <span>@string.Join("；", SavedQuestion.Answers.OrderBy(x => x.DisplayOrder).Select(x => x.Value))</span></p> }
                            <QuestionScoringEditor Type="FormModel.Type" Definition="FormModel.ScoringDefinition" DefinitionChanged="ScoringChanged" Mappings="RuleMappingLabels" Stem="FormModel.Stem" TotalScore="FormModel.CurriculumScore" />
                        }
                        <div class="kp-mt-3">
                            <label class="kp-label" for="editor-analysis">答案解析</label>
                            <textarea id="editor-analysis" class="kp-input" rows="4" @bind="FormModel.Analysis" @bind:event="oninput" placeholder="说明为什么是这个答案，帮助学习者理解"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="kp-col-xl-4">
                <div class="kp-card kp-mb-3 qb-editor-card"><div class="kp-card__body kp-p-4">
                    <h2 class="kp-heading-6">@L["EducationQuestion:CurriculumHeading"]</h2>
                    <label class="kp-label" for="editor-curriculum-mode">@L["EducationGeneration:Mode"]</label>
                    <select id="editor-curriculum-mode" class="kp-select" @bind="IsCurriculumQuestion" disabled="@EditorQuestionId.HasValue">
                        <option value="true">@L["EducationQuestion:CurriculumMode"]</option><option value="false">@L["EducationGeneration:EnterpriseMode"]</option>
                    </select>
                    @if (!IsCurriculumQuestion)
                    {
                        <p class="kp-text-small kp-text-muted kp-mt-2 kp-mb-0">@L[EditorQuestionId.HasValue ? "EducationQuestion:LegacyScopeHint" : "EducationGeneration:UnconfirmedHint"]</p>
                    }
                    else
                    {
                        @if (SavedQuestion?.Curriculum is { } frozen)
                        {
                            <p class="kp-text-small kp-mt-2">@SnapshotLabel(frozen)</p>
                            <p class="kp-text-small kp-text-muted">@L["EducationQuestion:FrozenScopeHint"]</p>
                            <ul class="kp-text-small">@foreach (var mapping in frozen.Mappings) { <li>@MappingLabel(mapping)</li> }</ul>
                        }
                        else
                        {
                            <label class="kp-label kp-mt-3" for="editor-selection">@L["EducationGeneration:Selection"]</label>
                            <select id="editor-selection" class="kp-select" @bind="SelectionIdText" @bind:after="SelectionChangedAsync"><option value="">@L["EducationCurriculum:Choose"]</option>@foreach (var choice in CurriculumChoices) { <option value="@choice.Selection.Id">@SelectionLabel(choice)</option> }</select>
                            @if (SelectedTextbook is { } book)
                            {
                                <p class="kp-text-small kp-text-muted kp-mt-2">@BookLabel(book)</p>
                                <label class="kp-label" for="editor-chapter">@L["EducationGeneration:ChapterFilter"]</label>
                                <select id="editor-chapter" class="kp-select" @bind="ChapterIdText"><option value="">@L["EducationGeneration:AllChapters"]</option>@foreach (var chapter in book.Chapters.OrderBy(x => x.DisplayOrder)) { <option value="@chapter.Id">@chapter.Code · @chapter.Title</option> }</select>
                                <div class="qb-curriculum-mappings kp-mt-2" role="group" aria-label="@L["EducationGeneration:Mappings"]">
                                    @foreach (var mapping in FilteredMappings) { <label class="kp-flex kp-gap-2 kp-align-start"><input type="checkbox" class="kp-check__input" checked="@SelectedMappingIds.Contains(mapping.Id)" @onchange="args => ToggleMapping(mapping.Id, args)" /><span>@TextbookMappingLabel(mapping)</span></label> }
                                </div>
                            }
                        }
                        <button type="button" class="kp-button kp-button--sm kp-button--secondary kp-mt-2" @onclick="RefreshCurriculumAsync">@L["EducationGeneration:RefreshSelections"]</button>
                        @if (CurriculumError != null) { <p class="kp-text-small kp-text-danger kp-mt-2" role="alert">@CurriculumError</p> }
                        @if (!HasCurrentCurriculumScope) { <p class="kp-text-small kp-text-warning kp-mt-2">@L["EducationQuestion:CurrentSelectionRequired"] <a href="/education/curriculum">@L["EducationGeneration:ManageSelections"]</a></p> }
                        <label class="kp-label kp-mt-3" for="editor-curriculum-score">@L["EducationQuestion:TotalScore"]</label><InputNumber id="editor-curriculum-score" class="kp-input" step="0.01" @bind-Value="FormModel.CurriculumScore" />
                        <p class="kp-text-small kp-text-muted kp-mt-2">@L["EducationQuestion:PointScoreHint"]</p>
                        <div class="kp-flex kp-flex-column kp-gap-2">
                            @foreach (var point in PointScores)
                            {
                                <label class="kp-text-small qb-point-score" @key="point.MappingId"><span>@point.Label</span><InputNumber class="kp-input" step="0.01" min="0" @bind-Value="point.Score" disabled="@UsesComponentAllocation" /></label>
                            }
                        </div>

                        <p class="kp-text-small kp-mt-2">@L["EducationQuestion:AllocatedScore", PointScores.Sum(x => x.Score), FormModel.CurriculumScore]</p>
                        @if (UsesComponentAllocation) { <p class="kp-text-small kp-text-muted">@L["EducationScoring:AllocationFromComponents"]</p> }
                        @if (SavedQuestion is { CurriculumConfirmed: true } confirmed) { <p class="kp-text-small @(HasUnsavedChanges ? "kp-text-warning" : "kp-text-success")">@L["EducationQuestion:PreviouslyConfirmed", confirmed.CurriculumConfirmedAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—"] @if (HasUnsavedChanges) { <span>@L["EducationScoring:ChangesNeedConfirmation"]</span> }</p> }
                        <p class="kp-text-small kp-text-muted kp-mb-0">@L["EducationQuestion:ContentChangeHint"]</p>
                    }
                </div></div>
                <div class="kp-card kp-mb-3 qb-editor-card">
                    <div class="kp-card__body kp-p-4">
                        <div class="kp-text-primary kp-text-small kp-text-semibold kp-mb-1">STEP 2</div>
                        <h2 class="kp-heading-6">补充适用范围与依据</h2>
                        @if (!IsCurriculumQuestion)
                        {
                        <div class="kp-mt-3">
                            <label class="kp-label" for="editor-points">知识点</label>
                            <input id="editor-points" class="kp-input" @bind="FormModel.KnowledgePointText" @bind:event="oninput" placeholder="例如：信息安全、请假制度" />
                            <div class="kp-help">多个知识点用逗号分隔。</div>
                        </div>
                        }

                        <div class="kp-mt-3">
                            <label class="kp-label" for="editor-tags">标签</label>
                            <input id="editor-tags" class="kp-input" @bind="FormModel.Tags" @bind:event="oninput" placeholder="用于搜索和运营分类" />
                        </div>

                        @if (FormModel.CreationSource == QuestionCreationSource.AiGenerated)
                        {
                            <div class="kp-alert kp-alert--info kp-text-small kp-mt-3 kp-mb-2">AI 引用会随草稿保留，审核人可以回看依据。</div>
                            @foreach (var source in OriginalSources)
                            {
                                <div class="kp-border kp-rounded kp-p-2 kp-text-small kp-mb-2">
                                    <div class="kp-text-semibold">@(source.SourceTitle ?? "知识库引用")</div>
                                    <div class="kp-text-muted">@source.SourceExcerpt</div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="kp-mt-3">
                                <label class="kp-label" for="editor-source-title">来源标题</label>
                                <input id="editor-source-title" class="kp-input" @bind="FormModel.SourceTitle" @bind:event="oninput" placeholder="制度、手册或课程名称" />
                            </div>
                            <div class="kp-mt-3">
                                <label class="kp-label" for="editor-source-description">来源说明</label>
                                <textarea id="editor-source-description" class="kp-input" rows="4" @bind="FormModel.ManualSourceDescription" @bind:event="oninput" placeholder="写明答案依据，便于审核人复核"></textarea>
                            </div>
                        }

                        <details class="kp-mt-3 qb-advanced">
                            <summary>高级设置</summary>
                            <div class="kp-mt-3">
                                <label class="kp-label" for="editor-security">安全等级</label>
                                <InputNumber id="editor-security" class="kp-input" @bind-Value="FormModel.SecurityLevel" />
                                <div class="kp-help">0 为默认。仅在题目包含受限内容时调整。</div>
                            </div>
                        </details>
                    </div>
                </div>

                <div class="kp-card qb-save-card">
                    <div class="kp-card__body kp-p-4">
                        <div class="kp-flex kp-align-center kp-gap-2 kp-text-semibold kp-mb-2"><i class="fa-regular fa-circle-check kp-text-primary"></i>保存前检查</div>
                        <ul class="kp-list-unstyled kp-text-small kp-text-muted kp-mb-3">
                            <li>题干能独立理解</li>
                            <li>已经设置标准答案</li>
                            <li>解析和来源足以支持审核</li>
                        </ul>
                        @if (IsTeacherWorkspace && !IsCurriculumQuestion)
                        {
                            <button class="kp-button kp-button--primary kp-full-width" type="submit" @onclick="() => _confirmAfterSave = true" disabled="@IsBusy">@(IsBusy ? "正在保存…" : "保存并确认")</button>
                            <button class="kp-button kp-button--secondary kp-full-width kp-mt-2" type="submit" @onclick="() => _confirmAfterSave = false" disabled="@IsBusy">仅保存草稿</button>
                            <div class="kp-text-center kp-text-muted kp-text-small kp-mt-2">由你本人确认，无需另一个审核员。</div>
                        }
                        else
                        {
                        <button class="kp-button kp-button--primary kp-full-width" type="submit" disabled="@IsBusy">@(IsBusy ? "正在保存…" : IsCurriculumQuestion ? L["EducationQuestion:SaveContent"].Value : "保存并返回草稿")</button>
                        @if (IsCurriculumQuestion) { <button class="kp-button kp-button--primary-outline kp-full-width kp-mt-2" type="button" @onclick="SaveAndConfirmAsync" disabled="@(IsBusy || !HasCurrentCurriculumScope)">@L["EducationQuestion:SaveAndConfirm"]</button> }
                        <div class="kp-text-center kp-text-muted kp-text-small kp-mt-2">保存后由你主动提交审核</div>
                        @if (IsCurriculumQuestion) { <p class="kp-text-small kp-text-muted kp-mt-2 kp-mb-0">@L["EducationQuestion:ConfirmHint"]</p> }
                        }
                    </div>
                </div>
            </div>
        </div>
        </fieldset>
    </EditForm>
}

</div>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private readonly List<PositionDto> Positions = new();
    private readonly List<QuestionSourceDto> OriginalSources = new();
    private QuestionFormModel FormModel { get; set; } = new();
    private EditContext? EditorContext;
    private QuestionDto? SavedQuestion;
    private Guid? EditorQuestionId => SavedQuestion?.Id ?? Id;
    private bool IsTeacherWorkspace => Navigation.ToBaseRelativePath(Navigation.Uri).StartsWith("teacher/", StringComparison.OrdinalIgnoreCase);
    private bool _confirmAfterSave = true;
    private bool RouteLoaded;
    private Guid? LoadedRouteId;
    private bool IsCurriculumQuestion = true;
    private string SelectionIdText = string.Empty, ChapterIdText = string.Empty;
    private TextbookVersionDto? SelectedTextbook;
    private readonly List<CurriculumChoice> CurriculumChoices = [];
    private readonly HashSet<Guid> SelectedMappingIds = [];
    private readonly List<PointScoreRow> PointScores = [];
    private string? CurriculumError, SuccessMessage, StorageNotice;
    private CreateOperationReceipt? CreateOperation;
    private string Baseline = string.Empty;
    private bool AllowNavigation;
    private bool RequiresReload;
    private bool HasUnsavedChanges => !AllowNavigation && Baseline.Length > 0 && FormState() != Baseline;
    private CurriculumChoice? SelectedChoice => CurriculumChoices.FirstOrDefault(x => x.Selection.Id.ToString() == SelectionIdText);
    private bool HasCurrentCurriculumScope
    {
        get
        {
            var choice = SelectedChoice; var book = SelectedTextbook; var original = SavedQuestion?.Curriculum;
            return choice != null && book is { Status: TextbookVersionStatus.Published } &&
                SelectedMappingIds.Count > 0 && SelectedMappingIds.All(id => book.Mappings.Any(x => x.Id == id)) &&
                (original == null || original.TextbookVersionId == book.Id && original.Mappings.Select(x => x.MappingId).ToHashSet().SetEquals(SelectedMappingIds));
        }
    }
    private IEnumerable<TextbookKnowledgePointMappingDto> FilteredMappings => SelectedTextbook is { } book ? book.Mappings.Where(x => string.IsNullOrWhiteSpace(ChapterIdText) || x.ChapterId.ToString() == ChapterIdText)
        .OrderBy(x => book.Chapters.FirstOrDefault(c => c.Id == x.ChapterId)?.DisplayOrder).ThenBy(x => x.KnowledgePointCode) : [];
    private bool IsLoading { get; set; }
    private bool IsBusy { get; set; }
    private string? ErrorMessage { get; set; }
    private bool IsChoiceQuestion => FormModel.Type is QuestionType.SingleChoice or QuestionType.MultipleChoice;

    protected override async Task OnInitializedAsync()
    {
        IsLoading = true;
        try
        {
            if (!IsTeacherWorkspace && await PermissionChecker.IsGrantedAsync(KnowPulsePermissions.Organization.Positions))
            {
                var positions = await PositionAppService.GetListAsync(new PagedAndSortedResultRequestDto { MaxResultCount = 200 });
                Positions.AddRange(positions.Items.OrderBy(x => x.Name));
            }
            await LoadCurriculumChoicesAsync();
        }
        catch (Exception ex)
        {
            ErrorMessage = GetUserFriendlyErrorMessage(ex);
        }
        finally
        {
            IsLoading = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (RouteLoaded && LoadedRouteId == Id) return;
        RouteLoaded = true; LoadedRouteId = Id; IsLoading = true;
        try
        {
            SavedQuestion = null; RequiresReload = false; OriginalSources.Clear(); SelectedMappingIds.Clear(); PointScores.Clear(); SelectedTextbook = null;
            SelectionIdText = ChapterIdText = string.Empty;
            if (Id.HasValue) await SetQuestionAsync(await QuestionAppService.GetAsync(Id.Value));
            else { FormModel = new(); IsCurriculumQuestion = !IsTeacherWorkspace; EnsureChoiceOptions(); }
            EditorContext = new EditContext(FormModel);
            Baseline = FormState();
        }
        catch (Exception exception) { ErrorMessage = GetUserFriendlyErrorMessage(exception); EditorContext = new EditContext(FormModel); }
        finally { IsLoading = false; }
    }

    private async Task SetQuestionAsync(QuestionDto question)
    {
        SavedQuestion = question;
        OriginalSources.Clear(); OriginalSources.AddRange(question.Sources);
        var answerValues = question.Answers.Select(x => x.Value).ToHashSet(StringComparer.OrdinalIgnoreCase);
        FormModel = new QuestionFormModel
        {
            CurriculumScore = question.CurriculumScore ?? 1,
            ScoringDefinition = CloneScoringDefinition(question.ScoringDefinition),
            CreationSource = question.CreationSource, Type = question.Type, Difficulty = question.Difficulty,
            Title = question.Title, Stem = question.Stem, ApplicablePositionIdText = question.ApplicablePositionId?.ToString(),
            SecurityLevel = question.SecurityLevel, Tags = question.Tags, Analysis = question.Analysis,
            AnswerLines = question.Type == QuestionType.FillBlank ? string.Join(Environment.NewLine, question.Answers.OrderBy(x => x.DisplayOrder).Select(x => x.Value)) : null,
            TrueFalseAnswer = question.Type == QuestionType.TrueFalse ? NormalizeTrueFalseAnswer(question.Answers.FirstOrDefault()?.Value) : "true",
            KnowledgePointText = string.Join(", ", question.KnowledgePoints.Select(x => x.Name)),
            SourceTitle = question.Sources.FirstOrDefault()?.SourceTitle, ManualSourceDescription = question.Sources.FirstOrDefault()?.ManualSourceDescription,
            Options = question.Options.OrderBy(x => x.DisplayOrder).Select(x => new OptionEditorRow { Content = x.Content, IsCorrect = answerValues.Contains(x.OptionKey) }).ToList()
        };
        EnsureChoiceOptions();
        IsCurriculumQuestion = question.Curriculum != null;
        SelectedMappingIds.Clear(); PointScores.Clear();
        if (question.Curriculum is { } snapshot)
        {
            SelectionIdText = snapshot.TeacherTextbookSelectionId.ToString();
            foreach (var mapping in snapshot.Mappings)
            {
                SelectedMappingIds.Add(mapping.MappingId);
                PointScores.Add(new PointScoreRow { MappingId = mapping.MappingId, Label = MappingLabel(mapping), Score = question.CurriculumPointWeights.FirstOrDefault(x => x.TextbookKnowledgePointMappingId == mapping.MappingId)?.Score ?? 0 });
            }
            await LoadTextbookAsync(preserveMappings: true);
        }
        SynchronizeRulePointScores();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var value = await JSRuntime.InvokeAsync<string?>("sessionStorage.getItem", OperationStorageKey);
            if (!string.IsNullOrWhiteSpace(value))
            {
                var receipt = JsonSerializer.Deserialize<CreateOperationReceipt>(value);
                if (receipt is { Id: var operationId } && operationId != Guid.Empty) CreateOperation = receipt;
                StateHasChanged();
            }
        }
        catch (Exception) { StorageNotice = L["EducationGeneration:StorageUnavailable"]; StateHasChanged(); }
    }

    private string OperationStorageKey => $"knowpulse.education.manual-question.{CurrentTenantContext.Id}.{CurrentAccount.Id}";
    private async Task PersistCreateOperationAsync()
    {
        try { await JSRuntime.InvokeVoidAsync("sessionStorage.setItem", OperationStorageKey, JsonSerializer.Serialize(CreateOperation)); }
        catch (Exception) { StorageNotice = L["EducationGeneration:StorageUnavailable"]; }
    }

    private async Task SaveAsync()
    {
        await SaveCoreAsync(confirmCurriculum: false);
    }

    private async Task SaveAndConfirmAsync()
    {
        if (EditorContext?.Validate() != true || !IsCurriculumQuestion) return;
        await SaveCoreAsync(confirmCurriculum: true);
    }

    private async Task SaveCoreAsync(bool confirmCurriculum)
    {
        if (IsBusy) return;
        if (RequiresReload) { ErrorMessage = L["EducationQuestion:SavedContentChanged"]; return; }
        SynchronizeRulePointScores();
        var validationMessage = ValidateDefinition() ?? (IsCurriculumQuestion ? ValidateCurriculum(confirmCurriculum) : null);
        if (validationMessage != null)
        {
            ErrorMessage = validationMessage;
            return;
        }

        try
        {
            ErrorMessage = null;
            SuccessMessage = null;
            IsBusy = true;
            var input = BuildInput();
            var editorId = EditorQuestionId;
            var creating = !editorId.HasValue;
            QuestionDto saved;
            if (IsTeacherWorkspace && !IsCurriculumQuestion)
            {
                saved = editorId.HasValue
                    ? await QuestionWorkflow.SaveDraftAsync(editorId.Value, input)
                    : await QuestionWorkflow.CreateManualDraftAsync(input);
                SavedQuestion = saved;
                if (_confirmAfterSave) saved = await QuestionWorkflow.ConfirmAsync(saved.Id);
            }
            else if (editorId.HasValue)
            {
                saved = await QuestionAppService.UpdateAsync(editorId.Value, input);
            }
            else
            {
                if (IsCurriculumQuestion)
                {
                    var signature = Convert.ToHexString(SHA256.HashData(Encoding.UTF8.GetBytes(JsonSerializer.Serialize(input))));
                    if (CreateOperation == null || CreateOperation.Signature != signature) CreateOperation = new CreateOperationReceipt { Id = Guid.NewGuid(), Signature = signature };
                    input.OperationId = CreateOperation.Id;
                    await PersistCreateOperationAsync();
                }
                saved = await QuestionAppService.CreateAsync(input);
            }
            // A confirmation failure must keep the known saved identity, including a just-created draft.
            SavedQuestion = saved;
            OriginalSources.Clear(); OriginalSources.AddRange(saved.Sources);
            if (confirmCurriculum)
            {
                if (creating && !CreatedContentMatches(input, saved))
                {
                    RequiresReload = true;
                    throw new InvalidOperationException(L["EducationQuestion:SavedContentChanged"]);
                }
                SavedQuestion = await QuestionAppService.ConfirmCurriculumAsync(saved.Id, new ConfirmQuestionCurriculumDto
                {
                    Scope = ScopeOf(saved.Curriculum!), ConcurrencyStamp = saved.ConcurrencyStamp,
                    Score = FormModel.CurriculumScore, PointWeights = BuildPointWeights()
                });
                SuccessMessage = L["EducationQuestion:Confirmed"];
                Baseline = FormState();
            }
            else { AllowNavigation = true; Navigation.NavigateTo(IsTeacherWorkspace ? "/teacher/questions" : "/question-bank/drafts"); }
        }
        catch (Exception ex)
        {
            ErrorMessage = GetUserFriendlyErrorMessage(ex);
        }
        finally
        {
            IsBusy = false;
        }
    }

    private UpdateQuestionDto BuildInput()
    {
        return new UpdateQuestionDto
        {
            CreationSource = FormModel.CreationSource,
            Type = FormModel.Type,
            Difficulty = FormModel.Difficulty,
            Title = FormModel.Title.Trim(),
            Stem = FormModel.Stem.Trim(),
            ApplicablePositionId = Guid.TryParse(FormModel.ApplicablePositionIdText, out var positionId) ? positionId : null,
            SecurityLevel = FormModel.SecurityLevel,
            Tags = FormModel.Tags,
            Analysis = FormModel.Analysis,
            ScoringDefinition = IsCurriculumQuestion ? CloneScoringDefinition(FormModel.ScoringDefinition) : SavedQuestion?.ScoringDefinition,
            Options = BuildOptions(),
            Answers = BuildAnswers(),
            KnowledgePointNames = SplitValues(FormModel.KnowledgePointText),
            Sources = BuildSources(),
            CurriculumScope = IsCurriculumQuestion && !EditorQuestionId.HasValue ? BuildScope() : null,
            CurriculumScore = FormModel.CurriculumScore,
            ConcurrencyStamp = SavedQuestion?.ConcurrencyStamp
        };
