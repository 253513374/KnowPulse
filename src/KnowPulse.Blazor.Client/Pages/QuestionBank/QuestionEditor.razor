    private List<CreateUpdateQuestionOptionDto> BuildOptions()
    {
        if (!IsChoiceQuestion)
        {
            return new List<CreateUpdateQuestionOptionDto>();
        }

        return FormModel.Options
            .Where(x => !string.IsNullOrWhiteSpace(x.Content))
            .Select((option, index) => new CreateUpdateQuestionOptionDto
            {
                OptionKey = GetOptionKey(index),
                Content = option.Content.Trim(),
                DisplayOrder = index + 1
            })
            .ToList();
    }

    private List<CreateUpdateQuestionAnswerDto> BuildAnswers()
    {
        if (FormModel.Type == QuestionType.Subjective || IsCurriculumQuestion && FormModel.Type == QuestionType.FillBlank && FormModel.ScoringDefinition != null) return [];
        IEnumerable<string> values = FormModel.Type switch
        {
            QuestionType.SingleChoice or QuestionType.MultipleChoice => FormModel.Options
                .Select((option, index) => new { option, index })
                .Where(x => x.option.IsCorrect && !string.IsNullOrWhiteSpace(x.option.Content))
                .Select(x => GetOptionKey(FormModel.Options
                    .Where(option => !string.IsNullOrWhiteSpace(option.Content))
                    .ToList()
                    .IndexOf(x.option))),
            QuestionType.TrueFalse => new[] { FormModel.TrueFalseAnswer },
            _ => SplitValues(FormModel.AnswerLines)
        };

        return values.Select((answer, index) => new CreateUpdateQuestionAnswerDto
        {
            Value = answer,
            DisplayOrder = index + 1
        }).ToList();
    }

    private List<CreateUpdateQuestionSourceDto> BuildSources()
    {
        if (FormModel.CreationSource == QuestionCreationSource.AiGenerated)
        {
            return OriginalSources.Select(x => new CreateUpdateQuestionSourceDto
            {
                KnowledgeItemId = x.KnowledgeItemId,
                KnowledgeVersionId = x.KnowledgeVersionId,
                ChunkId = x.ChunkId,
                SourceTitle = x.SourceTitle,
                SourceExcerpt = x.SourceExcerpt,
                SourceHash = x.SourceHash,
                ManualSourceDescription = x.ManualSourceDescription,
                SchoolKnowledgeShareId = x.SchoolKnowledgeShareId,
                CurriculumBindingIds = x.CurriculumBindingIds.ToList(),
                TextbookKnowledgePointMappingIds = x.TextbookKnowledgePointMappingIds.ToList()
            }).ToList();
        }

        if (string.IsNullOrWhiteSpace(FormModel.SourceTitle) && string.IsNullOrWhiteSpace(FormModel.ManualSourceDescription))
        {
            return new List<CreateUpdateQuestionSourceDto>();
        }

        return new List<CreateUpdateQuestionSourceDto>
        {
            new()
            {
                SourceTitle = FormModel.SourceTitle,
                ManualSourceDescription = FormModel.ManualSourceDescription
            }
        };
    }

    private string? ValidateDefinition()
    {
        if (!IsCurriculumQuestion && FormModel.Type == QuestionType.Subjective) return L["EducationScoring:CurriculumRequired"];
        if (IsChoiceQuestion)
        {
            var populated = FormModel.Options.Where(x => !string.IsNullOrWhiteSpace(x.Content)).ToList();
            if (populated.Count < 2)
            {
                return "请至少填写两个选项。";
            }

            var correctCount = populated.Count(x => x.IsCorrect);
            if (FormModel.Type == QuestionType.SingleChoice && correctCount != 1)
            {
                return "单选题需要选择一个正确答案。";
            }

            if (FormModel.Type == QuestionType.MultipleChoice && correctCount < 2)
            {
                return "多选题需要选择至少两个正确答案。";
            }
        }
        else if (!IsCurriculumQuestion && FormModel.Type == QuestionType.FillBlank && SplitValues(FormModel.AnswerLines).Count == 0)
        {
            return "请填写至少一个标准答案。";
        }

        return null;
    }

    private string? ValidateCurriculum(bool confirming)
    {
        if (FormModel.CurriculumScore <= 0 || FormModel.CurriculumScore > 1000 || decimal.Round(FormModel.CurriculumScore, 2) != FormModel.CurriculumScore)
            return L["EducationGeneration:ScorePrecision"];
        if ((!EditorQuestionId.HasValue || confirming) && !HasCurrentCurriculumScope) return L["EducationQuestion:CurrentSelectionRequired"];
        try { FormModel.ScoringDefinition?.ValidateDraft(); }
        catch (Volo.Abp.BusinessException) { return L["EducationScoring:InvalidDraft"]; }
        if (!confirming) return null;
        if (PointScores.Any(x => x.Score < 0 || decimal.Round(x.Score, 2) != x.Score) || PointScores.All(x => x.Score == 0) || PointScores.Sum(x => x.Score) != FormModel.CurriculumScore)
            return L["EducationQuestion:InvalidAllocation"];
        if (FormModel.Type is QuestionType.MultipleChoice or QuestionType.FillBlank or QuestionType.Subjective)
        {
            if (FormModel.ScoringDefinition == null) return L["EducationScoring:ConfirmationRequired"];
            try { FormModel.ScoringDefinition.ValidateForConfirmation(FormModel.Type, FormModel.Stem, FormModel.CurriculumScore, SelectedMappingIds.ToList(), BuildPointWeights()); }
            catch (Volo.Abp.BusinessException) { return L["EducationScoring:ConfirmationRequired"]; }
        }
        return null;
    }

    private List<QuestionCurriculumPointWeight> BuildPointWeights()
    {
        var rows = PointScores.Where(x => x.Score > 0).ToList();
        var result = new List<QuestionCurriculumPointWeight>();
        var allocatedWeight = 0m;
        for (var index = 0; index < rows.Count; index++)
        {
            var weight = index == rows.Count - 1 ? 1m - allocatedWeight : rows[index].Score / FormModel.CurriculumScore;
            allocatedWeight += weight;
            result.Add(new QuestionCurriculumPointWeight { TextbookKnowledgePointMappingId = rows[index].MappingId, Score = rows[index].Score, Weight = weight });
        }
        return result;
    }

