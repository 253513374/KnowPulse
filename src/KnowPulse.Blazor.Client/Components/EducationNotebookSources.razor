@inherits KnowPulseComponentBase
@using KnowPulse.Education
@using System.Text.Json
@inject IEducationNotebookSourceAppService Sources
@inject IJSRuntime JS
@inject Volo.Abp.Users.ICurrentUser Account
@inject Volo.Abp.MultiTenancy.ICurrentTenant Tenant

<section class="border-top mt-3 pt-3">
    <h4 class="h6">@L["EducationNotebook:Sources"]</h4>
    <p class="small text-muted">@L["EducationNotebook:ReferenceHint"]</p>
    <button class="btn btn-sm btn-outline-secondary" disabled="@(Busy || Disabled || Pending != null)" @onclick="LoadAsync">@L["EducationNotebook:LoadSources"]</button>
    @if (Error != null) { <p class="alert alert-danger mt-2" role="alert">@Error</p> }
    @if (StorageAttempted && !StorageReady && Pending == null) {
        <button class="btn btn-sm btn-outline-secondary" disabled="@(Busy || Disabled)" @onclick="AbandonAsync">@L["EducationReport:Abandon"]</button>
    }
    @if (Pending != null) {
        <div class="alert alert-info mt-2" role="status">@L["EducationGrading:Unknown"]
            <button class="btn btn-sm btn-outline-primary" disabled="@(Busy || Disabled)" @onclick="RecoverAsync">@L["EducationGrading:Recover"]</button>
            <button class="btn btn-sm btn-outline-primary" disabled="@(Busy || Disabled)" @onclick="RetryAsync">@L["EducationReport:RetryCommand"]</button>
            <button class="btn btn-sm btn-outline-secondary" disabled="@(Busy || Disabled)" @onclick="AbandonAsync">@L["EducationReport:Abandon"]</button>
        </div>
    }
    @if (State != null) {
        @if (State.Items.Count == 0) { <p class="small mt-2">@L["EducationNotebook:NoSources"]</p> }
        <ul class="mt-2">@foreach (var source in State.Items) {
            <li class="mb-2 text-break">
                @if (source.Available && source.OpenUrl != null) { <a href="@source.OpenUrl">@source.Title</a> }
                else { <span>@L["EducationNotebook:SourceUnavailable"]</span> }
                <button class="btn btn-sm btn-outline-secondary ms-2" disabled="@Locked" @onclick="(() => RemoveAsync(source.Id))">@L["EducationNotebook:RemoveSource"]</button>
            </li>
        }</ul>
        @if (HasSourceRequest) {
            @if (Preview?.Available == true && Preview.Source != null) {
                <p class="small">@L["EducationNotebook:PendingSource", Preview.Title ?? ""]</p>
                <button class="btn btn-sm btn-outline-primary" disabled="@(Locked || State.Items.Any(x => x.Source == Preview.Source))" @onclick="AddAsync">@L["EducationNotebook:AddSource"]</button>
            } else { <p class="small" role="status">@L["EducationNotebook:SourceUnavailable"]</p> }
        }
    }
</section>

@code {
    [Parameter] public Guid NoteItemId { get; set; }
    [Parameter] public Guid NoteVersionId { get; set; }
    [Parameter] public string? SourceKind { get; set; }
    [Parameter] public Guid? RecipientId { get; set; }
    [Parameter] public Guid? ComponentId { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private bool Busy, StorageReady, StorageAttempted;
    private string? Error;
    private EducationNotebookSourcesDto? State;
    private EducationNotebookSourcePreviewDto? Preview;
    private Command? Pending;
    private sealed record Command(Guid ItemId, AddEducationNotebookSourceDto? Add, Guid? RemoveId, RemoveEducationNotebookSourceDto? Remove);
    private bool HasSourceRequest => SourceKind != null || RecipientId.HasValue || ComponentId.HasValue;
    private bool Locked => Busy || Disabled || Pending != null || !StorageReady;
    private string StorageKey => $"education-notebook-source-v1:{Tenant.Id}:{Account.Id}:{NoteItemId}:{NoteVersionId}";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (StorageAttempted || Disabled) return;
        StorageAttempted = true;
        await RunAsync(async () => {
            var raw = await JS.InvokeAsync<string?>("sessionStorage.getItem", StorageKey);
            if (raw != null) { Pending = JsonSerializer.Deserialize<Command>(raw); ValidatePending(); }
            StorageReady = true;
        });
        StateHasChanged();
    }
    private async Task ReadAsync()
    {
        State = null; Preview = null;
        var state = await Sources.GetSourcesAsync(NoteItemId, NoteVersionId);
        if (Enum.TryParse<EducationNotebookSourceKind>(SourceKind, out var kind) && Enum.IsDefined(kind) && RecipientId is Guid recipient && ComponentId is Guid component)
            Preview = await Sources.PreviewSourceAsync(new() { Kind = kind, RecipientId = recipient, ComponentId = component });
        State = state;
    }
    private Task LoadAsync() => RunAsync(ReadAsync);
    private Task AddAsync() => RunAsync(async () => {
        if (LockedWithoutBusy || State == null || Preview?.Available != true || Preview.Source == null) return;
        Pending = new(NoteItemId, new() { OperationId = Guid.NewGuid(), NoteVersionId = NoteVersionId, ConcurrencyStamp = State.ConcurrencyStamp, Source = Preview.Source }, null, null);
        await PersistAndSendAsync();
    });
    private Task RemoveAsync(Guid sourceId) => RunAsync(async () => {
        if (LockedWithoutBusy || State == null) return;
        Pending = new(NoteItemId, null, sourceId, new() { OperationId = Guid.NewGuid(), NoteVersionId = NoteVersionId, ConcurrencyStamp = State.ConcurrencyStamp });
        await PersistAndSendAsync();
    });
    private bool LockedWithoutBusy => Disabled || Pending != null || !StorageReady;
    private void ValidatePending()
    {
        if (Pending is not { } p || p.ItemId != NoteItemId || (p.Add == null) == (p.Remove == null) ||
            p.Add != null && (p.RemoveId != null || p.Add.NoteVersionId != NoteVersionId || p.Add.OperationId == Guid.Empty) ||
            p.Remove != null && (p.RemoveId == null || p.RemoveId == Guid.Empty || p.Remove.NoteVersionId != NoteVersionId || p.Remove.OperationId == Guid.Empty))
            throw new InvalidOperationException(L["EducationNotebook:InvalidReceipt"]);
    }
    private async Task PersistAndSendAsync() { ValidatePending(); await JS.InvokeVoidAsync("sessionStorage.setItem", StorageKey, JsonSerializer.Serialize(Pending)); await SendAsync(); }
    private async Task SendAsync()
    {
        ValidatePending(); var p = Pending!;
        State = p.Add != null ? await Sources.AddSourceAsync(NoteItemId, p.Add) : await Sources.RemoveSourceAsync(NoteItemId, p.RemoveId!.Value, p.Remove!);
        await FinishAsync();
    }
    private async Task FinishAsync() { await JS.InvokeVoidAsync("sessionStorage.removeItem", StorageKey); Pending = null; await Changed.InvokeAsync(); await ReadAsync(); }
    private Task RetryAsync() => RunAsync(PersistAndSendAsync);
    private Task RecoverAsync() => RunAsync(async () => {
        ValidatePending(); var p = Pending!;
        var receipt = await Sources.GetSourceOperationAsync(NoteItemId, p.Add?.OperationId ?? p.Remove!.OperationId);
        if (receipt == null) return;
        if (receipt.NoteVersionId != NoteVersionId || (p.Add != null ? receipt.Id != p.Add.OperationId || receipt.Source != p.Add.Source : receipt.Id != p.RemoveId || !receipt.Removed))
            throw new InvalidOperationException(L["EducationNotebook:InvalidReceipt"]);
        await FinishAsync();
    });
    private Task AbandonAsync() => RunAsync(async () => {
        if (!await JS.InvokeAsync<bool>("confirm", L["EducationNotebook:AbandonReceipt"].Value)) return;
        await JS.InvokeVoidAsync("sessionStorage.removeItem", StorageKey); Pending = null; StorageReady = true; await ReadAsync();
    });
    private async Task RunAsync(Func<Task> action)
    {
        if (Busy || Disabled) return; Busy = true; Error = null;
        try { await action(); } catch (Exception ex) { State = null; Preview = null; Error = GetUserFriendlyErrorMessage(ex); }
        finally { Busy = false; }
    }
}
