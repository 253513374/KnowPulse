@inherits KnowPulseComponentBase
@implements IDisposable
@using KnowPulse.Education
@using System.Text.Json
@inject IEducationQuestionCollectionAppService Collections
@inject IJSRuntime JS
@inject Volo.Abp.Users.ICurrentUser Account
@inject Volo.Abp.MultiTenancy.ICurrentTenant Tenant

<section class="card card-body my-3" aria-busy="@Busy.ToString().ToLowerInvariant()">
    <h3 class="h6">@L["EducationCollection:Title"]</h3><p class="small text-muted">@L["EducationCollection:Hint"]</p>
    @if (Error != null) { <p class="alert alert-danger" role="alert">@Error</p> }
    @if (Notice != null) { <p class="alert alert-info" role="status">@Notice</p> }
    @if (State != null) {
        <p>@L[State.Current?.IsCollected == true ? "EducationCollection:Collected" : "EducationCollection:NotCollected"] @(State.Current == null ? "" : $"v{State.Current.RevisionNumber}")</p>
        @if (!CanAdd) { <p class="text-muted">@L[State.CanCollect ? "EducationCollection:ChooseSource" : "EducationCollection:Unavailable"]</p> }
        <button class="btn btn-outline-primary me-2" disabled="@(Busy || Pending != null || State.Current?.IsCollected != true && !CanAdd)" @onclick="ToggleAsync">@L[State.Current?.IsCollected == true ? "EducationCollection:Remove" : "EducationCollection:Collect"]</button>
    }
    <button class="btn btn-outline-secondary" disabled="@Busy" @onclick="ReloadAsync">@L["EducationGrading:Refresh"]</button>
    @if (Pending != null) {
        <div class="alert alert-info mt-3"><p>@L["EducationGrading:Unknown"] · @Pending.Input.OperationId</p>
            <button class="btn btn-sm btn-outline-primary me-2" disabled="@Busy" @onclick="RecoverAsync">@L["EducationGrading:Recover"]</button>
            <button class="btn btn-sm btn-outline-primary me-2" disabled="@Busy" @onclick="RetryAsync">@L["EducationGrading:Retry"]</button>
            <button class="btn btn-sm btn-outline-secondary" disabled="@Busy" @onclick="AbandonAsync">@L["EducationReport:Abandon"]</button></div>
    }
</section>

@code {
    [Parameter] public Guid SchoolId { get; set; }
    [Parameter] public Guid RecipientId { get; set; }
    [Parameter] public Guid QuestionId { get; set; }
    [Parameter] public Guid? ExpectedResultReleaseId { get; set; }
    [Parameter] public bool AllowCollect { get; set; }
    [Parameter] public EventCallback Changed { get; set; }
    private EducationQuestionCollectionStateDto? State;
    private EducationCollectionCommand? Pending;
    private bool Busy, Rendered, Disposed;
    private string? Error, Notice, LoadedSignature;
    private string Actor => $"{Tenant.Id}/{Account.Id}";
    private string? BoundActor;
    private string StorageKey => new EducationCollectionCommand { RecipientId = RecipientId, Input = new() { SchoolId = SchoolId, PaperQuestionId = QuestionId } }.Key(EducationCollectionCommand.Prefix(Tenant.Id, Account.Id));
    private string Signature => $"{StorageKey}/{ExpectedResultReleaseId}/{AllowCollect}";
    private bool CanAdd => State?.CanCollect == true && AllowCollect && State.ResultReleaseId == ExpectedResultReleaseId;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    { if (firstRender) { Rendered = true; await ReloadAsync(); StateHasChanged(); } }
    protected override async Task OnParametersSetAsync() { if (Rendered && Signature != LoadedSignature) await ReloadAsync(); }
    private void RequireActor()
    { if (Disposed || !Account.Id.HasValue || Actor != BoundActor || SchoolId == Guid.Empty || RecipientId == Guid.Empty || QuestionId == Guid.Empty) throw new InvalidOperationException(L["EducationCollection:Unavailable"]); }
    private Task ReloadAsync() => RunAsync(async () => {
        BoundActor ??= Actor; RequireActor(); var signature = Signature;
        var raw = await JS.InvokeAsync<string?>("sessionStorage.getItem", StorageKey); RequireActor();
        var pending = raw == null ? null : JsonSerializer.Deserialize<EducationCollectionCommand>(raw);
        if (pending != null) { pending.Validate(); if (pending.RecipientId != RecipientId || pending.Input.SchoolId != SchoolId || pending.Input.PaperQuestionId != QuestionId) throw new InvalidOperationException(L["EducationCollection:Unavailable"]); }
        Pending = pending;
        var state = await Collections.GetMyCollectionAsync(SchoolId, RecipientId, QuestionId); RequireActor();
        if (state.SchoolId != SchoolId || state.RecipientId != RecipientId || state.PaperQuestionId != QuestionId || Signature != signature) return;
        State = state; LoadedSignature = signature;
    });
    private Task ToggleAsync() => RunAsync(async () => {
        RequireActor(); if (State == null || Pending != null || State.Current?.IsCollected != true && !CanAdd) return;
        var wanted = State.Current?.IsCollected != true; var current = State.Current?.Id; var release = State.ResultReleaseId;
        if (!await JS.InvokeAsync<bool>("confirm", L[wanted ? "EducationCollection:ConfirmCollect" : "EducationCollection:ConfirmRemove"].Value)) return;
        RequireActor(); Pending = new() { RecipientId = RecipientId, Input = new() { SchoolId = SchoolId, PaperQuestionId = QuestionId, OperationId = Guid.NewGuid(),
            IsCollected = wanted, ExpectedCurrentOperationId = current, ExpectedResultReleaseId = wanted ? release : null } };
        await ExecuteAsync();
    });
    private async Task ExecuteAsync()
    {
        RequireActor(); if (Pending == null) return; Pending.Validate();
        await JS.InvokeVoidAsync("sessionStorage.setItem", StorageKey, JsonSerializer.Serialize(Pending)); RequireActor();
        await CompleteAsync(await Collections.SetMyCollectionAsync(RecipientId, Pending.Input));
    }
    private async Task CompleteAsync(EducationQuestionCollectionDto receipt)
    {
        RequireActor(); if (Pending == null || receipt.Id != Pending.Input.OperationId || receipt.SchoolId != SchoolId || receipt.RecipientId != RecipientId || receipt.PaperQuestionId != QuestionId || receipt.IsCollected != Pending.Input.IsCollected)
            throw new InvalidOperationException(L["EducationGrading:NoReceipt"]);
        await JS.InvokeVoidAsync("sessionStorage.removeItem", StorageKey); RequireActor(); Pending = null;
        State = await Collections.GetMyCollectionAsync(SchoolId, RecipientId, QuestionId); RequireActor();
        Notice = L["EducationGrading:Receipt", receipt.Id]; await Changed.InvokeAsync();
    }
    private Task RecoverAsync() => RunAsync(async () => { RequireActor(); if (Pending == null) return;
        var row = await Collections.GetMyCollectionOperationAsync(SchoolId, RecipientId, Pending.Input.OperationId);
        if (row == null) Notice = L["EducationGrading:Unknown"]; else await CompleteAsync(row);
    });
    private Task RetryAsync() => RunAsync(async () => { RequireActor(); if (Pending == null) return;
        var row = await Collections.GetMyCollectionOperationAsync(SchoolId, RecipientId, Pending.Input.OperationId);
        if (row != null) await CompleteAsync(row); else await ExecuteAsync();
    });
    private Task AbandonAsync() => RunAsync(async () => {
        RequireActor(); if (!await JS.InvokeAsync<bool>("confirm", L["EducationCollection:AbandonPrompt"].Value)) return;
        RequireActor(); await JS.InvokeVoidAsync("sessionStorage.removeItem", StorageKey); RequireActor(); Pending = null;
        State = await Collections.GetMyCollectionAsync(SchoolId, RecipientId, QuestionId); RequireActor(); await Changed.InvokeAsync();
    });
    private async Task RunAsync(Func<Task> action)
    { if (Busy || Disposed) return; Busy = true; Error = null; try { await action(); } catch (Exception e) { State = null; if (!Disposed) Error = GetUserFriendlyErrorMessage(e); } finally { Busy = false; } }
    public void Dispose() { Disposed = true; State = null; Pending = null; }
}
