@namespace KnowPulse.Blazor.Client.Components

<MudPaper Class="kp-page-header" Elevation="0">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="3">
        <MudStack Spacing="1">
            @if (!string.IsNullOrWhiteSpace(Eyebrow))
            {
                <MudText Typo="Typo.overline" Color="Color.Primary">@Eyebrow</MudText>
            }
            <MudText Typo="Typo.h4">@Title</MudText>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <MudText Typo="Typo.body1" Color="Color.Secondary">@Description</MudText>
            }
        </MudStack>
        @if (Actions is not null)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                @Actions
            </MudStack>
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? Eyebrow { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
