@namespace KnowPulse.Blazor.Client.Components

@if (TotalCount > PageSize)
{
    <MudPaper Class="kp-pager" Elevation="0">
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            第 @CurrentPage / @PageCount 页，共 @TotalCount 条
        </MudText>
        <MudPagination Count="@PageCount"
                       Selected="@CurrentPage"
                       SelectedChanged="OnPageChangedAsync"
                       Disabled="@IsBusy"
                       Color="Color.Primary"
                       Variant="Variant.Outlined" />
    </MudPaper>
}

@code {
    [Parameter]
    public int SkipCount { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 20;

    [Parameter]
    public long TotalCount { get; set; }

    [Parameter]
    public bool IsBusy { get; set; }

    [Parameter]
    public EventCallback<int> OnSkipCountChanged { get; set; }

    private int CurrentPage => TotalCount == 0 ? 1 : (SkipCount / PageSize) + 1;
    private int PageCount => Math.Max(1, (int)Math.Ceiling(TotalCount / (double)PageSize));

    private Task OnPageChangedAsync(int page)
    {
        return OnSkipCountChanged.InvokeAsync(Math.Max(0, page - 1) * PageSize);
    }
}
