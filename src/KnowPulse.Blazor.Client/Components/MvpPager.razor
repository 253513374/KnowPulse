@namespace KnowPulse.Blazor.Client.Components

@* MVP-0 复用分页组件：只暴露上一页/下一页，避免各管理页重复实现 SkipCount 计算。 *@
@if (TotalCount > PageSize)
{
    <div class="card-footer d-flex flex-wrap align-items-center justify-content-between gap-2">
        <div class="text-muted small">
            第 @CurrentPage / @PageCount 页，共 @TotalCount 条
        </div>
        <div class="btn-group btn-group-sm" role="group" aria-label="分页">
            <button class="btn btn-outline-secondary" type="button" @onclick="GoPreviousAsync" disabled="@(!CanGoPrevious || IsBusy)">上一页</button>
            <button class="btn btn-outline-secondary" type="button" @onclick="GoNextAsync" disabled="@(!CanGoNext || IsBusy)">下一页</button>
        </div>
    </div>
}

@code {
    // 当前页起始记录数，由父页面持有，组件只负责计算上一页和下一页目标值。
    [Parameter]
    public int SkipCount { get; set; }

    // 每页记录数，默认与 MVP-0 管理页约定保持一致。
    [Parameter]
    public int PageSize { get; set; } = 20;

    // 总记录数，用于计算总页数和下一页可用性。
    [Parameter]
    public long TotalCount { get; set; }

    // 父页面忙碌时禁用分页按钮，避免重复请求。
    [Parameter]
    public bool IsBusy { get; set; }

    // 分页变化回调，父页面收到新的 SkipCount 后自行加载数据。
    [Parameter]
    public EventCallback<int> OnSkipCountChanged { get; set; }

    private int CurrentPage => TotalCount == 0 ? 1 : (SkipCount / PageSize) + 1;
    private int PageCount => Math.Max(1, (int)Math.Ceiling(TotalCount / (double)PageSize));
    private bool CanGoPrevious => SkipCount > 0;
    private bool CanGoNext => SkipCount + PageSize < TotalCount;

    // 上一页不能小于 0。
    private Task GoPreviousAsync()
    {
        return OnSkipCountChanged.InvokeAsync(Math.Max(0, SkipCount - PageSize));
    }

    // 下一页直接把 SkipCount 前移一个 PageSize，是否可点击由 CanGoNext 控制。
    private Task GoNextAsync()
    {
        return OnSkipCountChanged.InvokeAsync(SkipCount + PageSize);
    }
}
