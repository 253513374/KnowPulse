@inherits KnowPulseComponentBase
@using KnowPulse.Education
@if (Model is { } row) {
    <section class="kp-card kp-card__body my-3">
        <h2 class="kp-heading-5">@L[Preview ? "EducationPractice:CheckCopy" : "EducationPractice:SubmittedCopy"]</h2>
        <p class="kp-text-small">@L["EducationPractice:PracticeOnly"]</p>
        @if (!row.SourceAvailable) { <p class="kp-alert kp-alert--warning" role="status">@L["EducationPractice:SourceUnavailable"]</p> }
        @if (row.Question is { } question) { <h3 class="kp-heading-6">@question.Title</h3><p class="text-break" style="white-space:pre-wrap">@question.Stem</p>
            @foreach (var option in question.Options) { <p>@option.OptionKey. @option.Content</p> }
        }
        @if (row.SubmittedResponse is { } response) {
            <p class="text-break" style="white-space:pre-wrap">@response.Text</p>
            @if (response.SelectedOptionKeys.Count != 0) { <p>@string.Join(" · ", response.SelectedOptionKeys)</p> }
            @foreach (var blank in response.Blanks) { <p class="text-break" style="white-space:pre-wrap">@(row.Question?.ResponseFields.FirstOrDefault(x => x.Id == blank.BlankId)?.StemMarker ?? L["EducationPractice:OriginalBlank"].Value): @blank.Text</p> }
            @foreach (var image in response.Images) { <button class="kp-button kp-button--sm kp-button--secondary kp-me-2 kp-mb-2" disabled="@Busy" @onclick="(() => OpenImageAsync(image.AttachmentId, image.RotationDegrees))">@L["EducationAttempt:ImagePosition", response.Images.IndexOf(image) + 1, image.RotationDegrees]</button> }
        }
        @if (row.Feedback is { } feedback) {
            <h3 class="kp-heading-6">@L["EducationPractice:Feedback"]</h3>
            <p>@(feedback.Evaluation.ObtainedScore.HasValue ? L["EducationPractice:AutomaticScore", feedback.Evaluation.ObtainedScore.Value, feedback.Evaluation.MaxScore] : L["EducationPractice:ManualCheck"])</p>
            <p>@string.Join(" · ", feedback.CorrectAnswers)</p>
            <p class="text-break" style="white-space:pre-wrap">@feedback.ScoringDefinition?.ReferenceAnswer</p>
            @if (feedback.ScoringDefinition is { } definition) {
                @foreach (var blank in definition.Blanks) { <p>@blank.StemMarker: @string.Join(" / ", blank.AllowedAnswers)</p> }
                @foreach (var point in definition.ScoringPoints) { <p>@point.Description (@point.Score)</p> }
            }
            <p class="text-break" style="white-space:pre-wrap">@feedback.Analysis</p>
        }
        @if (Error != null) { <p class="kp-alert kp-alert--error" role="alert">@Error</p> }
        <EducationAssessmentImagePreview ImageData="@ImageData" Rotation="Rotation" Alt="@L["EducationGrading:SubmittedImage"]" Closed="@(() => ImageData = null)" />
    </section>
}
@code {
    [Parameter] public EducationPracticeDto? Model { get; set; }
    [Parameter] public bool Preview { get; set; }
    [Parameter] public Func<Guid, Task<Volo.Abp.Content.IRemoteStreamContent>>? ReadImage { get; set; }
    private bool Busy; private string? Error, ImageData; private int Rotation; private EducationPracticeDto? Previous;
    protected override void OnParametersSet() { if (!ReferenceEquals(Previous, Model)) { Previous = Model; ImageData = null; Error = null; } }
    private async Task OpenImageAsync(Guid id, int rotation)
    {
        if (Busy || ReadImage == null) return; Busy = true; Error = null;
        try {
            var model = Model; using var file = await ReadImage(id); using var bytes = new System.IO.MemoryStream(); await file.GetStream().CopyToAsync(bytes);
            if (!ReferenceEquals(model, Model)) return; Rotation = rotation; ImageData = $"data:{file.ContentType};base64,{Convert.ToBase64String(bytes.ToArray())}";
        } catch (Exception error) { ImageData = null; Error = GetUserFriendlyErrorMessage(error); } finally { Busy = false; }
    }
}
