@inherits KnowPulseComponentBase
@using KnowPulse.Education
@inject IEducationTeachingMaterialAppService MaterialsApi
@inject IJSRuntime JS
@if (Materials.Count > 0) {
    <section class="card card-body my-3"><h3 class="h6">@L["EducationMaterial:Title"]</h3>
        <p>@L["EducationMaterial:ReadHint"]</p>
        @if (Error != null) { <p class="alert alert-danger" role="alert">@Error</p> }
        <ul>@foreach (var material in Materials) { <li class="mb-2 text-break">@material.Title <button class="btn btn-sm btn-outline-primary" disabled="@(Busy || Disabled)" @onclick="(() => OpenAsync(material.Id))">@L["EducationMaterial:Open"]</button></li> }</ul>
        @if (Content is { } content) {
            <h4 class="h6">@content.Title @if (content.VersionNumber is int version) { <span>· @L["EducationPlan:Version", version]</span> }</h4>
            @if (!content.IsAvailable) { <p class="alert alert-warning" role="status">@L["EducationMaterial:Unavailable"]</p> }
            else {
                <p class="text-break" style="white-space:pre-wrap">@content.ContentText</p>
                <ul>@foreach (var file in content.Attachments) { <li class="text-break">@file.FileName · @file.Size <button class="btn btn-sm btn-outline-primary" disabled="@(Busy || Disabled)" @onclick="(() => DownloadAsync(file.Id))">@L["SchoolKnowledge:Download"]</button></li> }</ul>
            }
        }
    </section>
}
@code {
    [Parameter] public IReadOnlyList<IEducationMaterialDisplay> Materials { get; set; } = [];
    [Parameter] public string? ContextKey { get; set; }
    [Parameter] public Func<Guid, Task<EducationMaterialContentDto>>? ReadMaterial { get; set; }
    [Parameter] public Func<Guid, Guid, Task<Volo.Abp.Content.IRemoteStreamContent>>? DownloadMaterial { get; set; }
    [Parameter] public Guid PlanId { get; set; }
    [Parameter] public Guid RevisionId { get; set; }
    [Parameter] public Guid? ActivityId { get; set; }
    [Parameter] public bool Disabled { get; set; }
    private bool Busy; private string? Error, Context; private EducationMaterialContentDto? Content;
    protected override void OnParametersSet() { var key = $"{ContextKey}:{PlanId}:{RevisionId}:{ActivityId}:{string.Join(',', Materials.Select(x => x.Id))}"; if (key != Context) { Context = key; Content = null; Error = null; } }
    private Task OpenAsync(Guid id) => RunAsync(async () => { Content = null; Content = ReadMaterial != null ? await ReadMaterial(id) : ActivityId is Guid activity ? await MaterialsApi.GetMyMaterialAsync(activity, id) : await MaterialsApi.GetTeacherMaterialAsync(PlanId, RevisionId, id); });
    private Task DownloadAsync(Guid id) => RunAsync(async () => {
        if (Content?.IsAvailable != true) return;
        using var file = DownloadMaterial != null ? await DownloadMaterial(Content.Id, id) : ActivityId is Guid activity ? await MaterialsApi.DownloadMyMaterialAsync(activity, Content.Id, id) : await MaterialsApi.DownloadTeacherMaterialAsync(PlanId, RevisionId, Content.Id, id);
        await using var stream = file.GetStream(); using var reference = new DotNetStreamReference(stream);
        await JS.InvokeVoidAsync("knowPulse.downloadFileFromStream", file.FileName, file.ContentType, reference);
    });
    private async Task RunAsync(Func<Task> action) { if (Busy || Disabled) return; Busy = true; Error = null; try { await action(); } catch (Exception ex) { Content = null; Error = GetUserFriendlyErrorMessage(ex); } finally { Busy = false; } }
}
