@inherits KnowPulseComponentBase

@if (ImageData != null) {
    <section class="card mt-3"><div class="card-body"><h2 class="h5">@L["EducationAttempt:PreviewImage"]</h2>
        <label>@L["EducationAttempt:ImageZoom", Zoom]<input class="form-range" type="range" min="100" max="300" step="25" @bind="Zoom" @bind:event="oninput" /></label>
        <button class="btn btn-outline-secondary ms-2 mb-2" @onclick="Closed">@L["EducationAttempt:CloseImage"]</button>
        @if (DecodeFailed) { <p class="alert alert-warning" role="alert">@L["EducationAttempt:ImageCannotDisplay"]</p> }
        <div style="overflow:auto;max-height:70vh">
            @* A square frame keeps every right-angle rotation inside positive scroll bounds. *@
            <div style="@($"position:relative;width:{Math.Clamp(Zoom, 100, 300)}%;aspect-ratio:1")">
                <img src="@ImageData" alt="@Alt" @onerror="(() => DecodeFailed = true)" style="@($"position:absolute;width:100%;height:100%;object-fit:contain;transform:rotate({Rotation}deg)")" />
            </div>
        </div>
    </div></section>
}

@code {
    [Parameter] public string? ImageData { get; set; }
    [Parameter] public int Rotation { get; set; }
    [Parameter] public string Alt { get; set; } = "";
    [Parameter] public EventCallback Closed { get; set; }
    private string? Previous; private int Zoom = 100; private bool DecodeFailed;
    protected override void OnParametersSet() { if (Previous == ImageData) return; Previous = ImageData; Zoom = 100; DecodeFailed = false; }
}
